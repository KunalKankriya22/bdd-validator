{
  "name": "blood-center-app",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4200 --open --proxy-config proxy.conf.json",
    "start:no-proxy": "ng serve --port=4200 --open",
    "start:dev": "ng serve --configuration development --port=4200 --open --proxy-config proxy.conf.json",
    "start:qa": "ng serve --configuration qa --port=4200 --open --proxy-config proxy.conf.json",
    "start:local": "ng serve --configuration local --port=4200 --open --proxy-config proxy.conf.json",
    "build": "set NODE_OPTIONS=--max-old-space-size=8192 && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npx jest --no-coverage",
    "test:changed": "npx jest --no-coverage --changedSince=main",
    "test:coverage": "npx jest",
    "test:ci": "npx jest --ci",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "build-local": "ng build --configuration=local",
    "build-qa": "ng build --configuration=qa",
    "build-dev": "ng build --configuration=development",
    "build-prod": "ng build --configuration=production",
    "build-stage": "ng build --configuration=staging"
  },
  "budgets": [
    {
      "type": "initial",
      "maximumWarning": "2mb",
      "maximumError": "4mb"
    }
  ],
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.14",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/localize": "^20.3.0",
    "@angular/material": "^20.2.14",
    "@angular/material-moment-adapter": "^20.2.14",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@okta/okta-angular": "^6.5.1",
    "@okta/okta-auth-js": "^7.14.1",
    "@wellsky/atlas-ui": "^20.3.4",
    "bootstrap": "^5.3.8",
    "codemirror": "^6.0.2",
    "jspdf": "^4.2.1",
    "moment": "^2.30.1",
    "ngx-cookie-service": "^20.1.1",
    "ngx-mat-select-search": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.13",
    "@angular/build": "^20.3.12",
    "@angular/cli": "^20.3.12",
    "@angular/compiler-cli": "^20.3.0",
    "@babel/runtime": "^7.28.4",
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-junit": "^17.0.0",
    "jest-preset-angular": "^17.0.0",
    "typescript": "~5.9.2"
  }
}
