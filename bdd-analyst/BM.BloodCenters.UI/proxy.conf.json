    "secure": false,
    "changeOrigin": true,
    "pathRewrite": {
      "^/local": ""
    },
    "logLevel": "debug"
  },
   "/api": {
    "target": "#{proxy_api_target_url}#",
    "secure": false,
    "changeOrigin": true,
