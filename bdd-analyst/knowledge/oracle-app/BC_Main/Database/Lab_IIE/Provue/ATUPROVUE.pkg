/* ************************************************************
  This is ProVue interface engine
  Created By        : Basker Edwin 
  Date Of Creation  : 12/14/10
  Version           : 03 [01/11/11]
                      04 [03/19/12] To get the chapter ID as input (SCR:19120)
  Last Modified By  : Edwin

  How it works: The file will have five segments(H,P,O,R,C)
  The program reads each line and parse the required data and
  upload into lifetrak tables This program will create a log file
  for each run and that will tell you the status of the run.

  *****************************************   */

CREATE OR REPLACE PACKAGE ATUPROVUE IS
  procedure add_log_entry(p_log_text in varchar2);
  procedure main_proc(file_name in varchar2,v_inst_id in varchar2,
                      pl_chapter_id in varchar2);
  procedure process;
  procedure readrecord;
  procedure get_column(txtline in varchar2, delimit in char,strt in number,
  endc in number,outcol out varchar2);
  procedure read_header_record;
  procedure read_unit_data;
  procedure read_test_data;
  procedure read_antigen_test;
  procedure read_result_record;
  procedure init_variables;
  procedure update_batch_information;
  procedure insert_instrument_log;
  procedure convert_unit_id(ok_status out varchar2) ;
  procedure update_rpt_parm;
  procedure rollback_and_exit ;
  temp_max_test_seq_no   NUMBER:=0;
  temp_coll_date         DATE;
  field_delimiter        VARCHAR2(1):='|';
  repeat_delimiter       VARCHAR2(1);
  component_delimiter    VARCHAR2(1);
  last_unit              VARCHAR2(15);
  escape_delimiter       VARCHAR2(1);
  logfile                UTL_FILE.FILE_TYPE;
  instfile               UTL_FILE.FILE_TYPE;
  LogDir                 VARCHAR2(50);
  logfilename            VARCHAR2(50);
  p_file_name            VARCHAR2(50);
  read_record            VARCHAR2(500);
  fetch_count            NUMBER:=0;
  complete               BOOLEAN:=false;
  plate_id               VARCHAR2(10);
  v_tb_id                VARCHAR2(64);
  well_count             NUMBER:=0;
  process_date_time      VARCHAR2(25);
  result_date_time       DATE;
  v_test_id              VARCHAR2(50);
  cut_off                VARCHAR2(10);
  kit_lot                VARCHAR2(30);
  v_machine_id           VARCHAR2(5);
  v_unit_id              VARCHAR2(20);
  v_test_type            VARCHAR2(1);
  well_number            VARCHAR2(4);
  result_status          VARCHAR2(4);
  negative_result        VARCHAR2(4);
  reactive_result        VARCHAR2(4);
  ratio                  VARCHAR2(7);
  codabar_unit_scheme    VARCHAR2(1);
  testing_lab_code       VARCHAR2(2);
  v_chapter_id           VARCHAR2(4);
  od_value               VARCHAR2(10);
  first_unit             BOOLEAN:=TRUE;
  batch_created          BOOLEAN:=FALSE;
  test_created           BOOLEAN:=FALSE;
  well_type              VARCHAR2(1);
  result_file_name       VARCHAR2(30);
  record_count           NUMBER:=0;
  pos_res_count          NUMBER:=0;
  neg_res_count          NUMBER:=0;
  upload_count           NUMBER:=0;
  good_unit              BOOLEAN;
  err_msg                VARCHAR2(300);
  temp_test_id           VARCHAR2(20);
  ncount                 NUMBER:=0;
  no_of_units            NUMBER:=0;
  p_chp_sys_date         DATE;
  g_local_time           DATE;
 
end ATUPROVUE;
/
create or replace package body ATUPROVUE is

PROCEDURE add_log_entry(p_log_text varchar2) is
BEGIN
         UTL_FILE.putf(logfile,'%s\n',p_log_text);
         UTL_FILE.fflush(logfile);
END add_log_entry;

procedure main_proc(file_name in varchar2, v_inst_id in varchar2,
                    pl_chapter_id in varchar2) is
 start_time   VARCHAR2(30);
 end_time     VARCHAR2(30);
Begin
      dbms_output.enable(50000000);
      v_machine_id:=v_inst_id;
      result_file_name:=file_name;
      v_chapter_id:=pl_chapter_id;
      p_chp_sys_date:=lifetrack_timezone_convert.get_local_time(v_chapter_id,
                                                                     sysdate);

      begin
           select code_desc into LogDir from master_codes
           where code_type='LOGDR' and code='ILOG' and p_chp_sys_date
	   between eff_date and nvl(term_date,sysdate+10);
      exception
           when utl_file.invalid_path then 
               dbms_output.put_line('Invalid path or filename');
	       raise;
           when others then 
           dbms_output.put_line('Error in prepare_log_filename');
	   raise;
       end;

      begin
       p_file_name:=substr(result_file_name,1,instr(result_file_name,'.',1)-1);
       select 'ATUPROVUE_'||p_file_name||'_'||
       decode(substr(user,1,4),'OPS$',substr(user,5),user)||'.r'
       into logfilename from dual;
      exception
	  when others then
	     dbms_output.put_line('Error in getting logfilename ... Aborting');
	     raise;
      end;

        begin
	   --start_time := to_char(sysdate,'mm-dd-yy hh24:mi:ss');

          g_local_time:=lifetrack_timezone_convert.get_local_time(v_chapter_id,
                                                                  sysdate);
          start_time := to_char(g_local_time,'mm-dd-yy hh24:mi:ss');

           logfile:=UTL_FILE.fopen(LogDir,logfilename, 'w');
           instfile:=UTL_FILE.fopen(LogDir,file_name, 'r');
           add_log_entry(' ProVue Instrument Interface Log');
           add_log_entry('----------------------------------');
           add_log_entry(' ');
	   add_log_entry('ProVue-Read Results  start time:'||start_time);
	   add_log_entry('File Name  : '||result_file_name);
	   add_log_entry('Log Name   : '||logfilename);
	   add_log_entry('----------------------------------------');

       exception
	  when utl_file.invalid_path then
	   dbms_output.put_line('Invalid path or filename'); raise;
        end;

          init_variables;
	  loop
	     process;
	     exit when complete;
	  end loop;
	  update_rpt_parm;
	  add_log_entry('No. of Results Read: '||to_char(no_of_units));
	  add_log_entry('No. of results uploaded :'||to_char(upload_count));
          add_log_entry('No. of results Rejected :'||
	  to_char(no_of_units - upload_count));
	  add_log_entry('ProVue-Read results program successfully completed');
          --end_time := to_char(sysdate,'mm-dd-yy hh24:mi:ss');

          g_local_time:=lifetrack_timezone_convert.get_local_time(v_chapter_id,
                                                                    sysdate);
          end_time := to_char(g_local_time,'mm-dd-yy hh24:mi:ss');
	  add_log_entry('Program End Time:'||end_time);
	  add_log_entry('*********************End****************************');
	  UTL_FILE.fclose(logfile);
End main_proc;

Procedure process is
   rec_type  VARCHAR2(1);
   process_exception EXCEPTION;
Begin
   readrecord;
   if not complete then
   Begin
      rec_type:=substr(read_record,1,1); 

      If rec_type in ('H','O','P','R') then 

        If nvl(rec_type,' ')!='H' then
           fetch_count:=fetch_count+1;
           record_count:=record_count+1;
        End If;

       /* If fetch_count=1  and nvl(rec_type,' ')!='H' then
            dbms_output.put_line('rec_type='||rec_type);
	    if rec_type is null or rec_type=' ' then
	       fetch_count:=0;
	       raise process_exception;
            else
	       add_log_entry(rec_type||' Sequencing Error');
	        rollback_and_exit;
            end if;
       */
  
      If fetch_count=1 and nvl(rec_type,' ')!='P' then
         dbms_output.put_line('1. rec_type='||rec_type); 
         add_log_entry(rec_type||' Sequencing Error');
	 rollback_and_exit;
      Elsif fetch_count=2 and nvl(rec_type,' ')!='O' then
          dbms_output.put_line('2. rec_type='||rec_type);
          add_log_entry(rec_type||' Sequencing Error');
	  rollback_and_exit;
      Elsif fetch_count=3 and nvl(rec_type,' ')!='R' then 
          dbms_output.put_line('3. rec_type='||rec_type);
          add_log_entry(rec_type||' Sequencing Error');
	  rollback_and_exit;
      Else 
	null;
      End if;

      If rec_type='H' then
	 read_header_record;
      End if;
      
      If rec_type='P' then
	    --good_unit:=true;
            --no_of_units:=no_of_units+1;
	    --read_unit_record;
             read_antigen_test;
      End if;
     
      If rec_type='O' then
         good_unit:=true;
         no_of_units:=no_of_units + 1;
         read_unit_data;
         If v_test_id='XX' then  -- read the test ID as well
           read_test_data;
         End If;
      End if;

      If rec_type='R' then
	 read_result_record;
          fetch_count:=0;     -- For every set of records, reset to 0.
      End If;
     
    End if;
   End;
   
  end if;
Exception 
    When process_exception then
	 null;
End process;

procedure readrecord is
 begin
   utl_file.get_line(instfile,read_record);
 exception
  when no_data_found then
    complete:=TRUE;
  when UTL_FILE.READ_ERROR then
     add_log_entry('Error reading file '||result_file_name);
     rollback_and_exit;
end readrecord;

Procedure get_column(txtline in varchar2, delimit in char,strt in number,
		     endc in number,outcol out varchar2) is
   stringend number;
 Begin
    if instr(txtline,delimit,1,endc) = 0 then
       stringend:=length(txtline);
   else
    stringend:=instr(txtline,delimit,1,endc) - instr(txtline,delimit,1,strt)-1;
  end if;
  outcol := substr(txtline,instr(txtline,delimit, 1, strt)+1,stringend);
End get_column;

procedure read_header_record is
 read_hdr    varchar2(250);
begin
  field_delimiter:='|';
  null;
  get_column(read_record,field_delimiter,13,14,process_date_time);
  dbms_output.put_line('process='||process_date_time);

  result_date_time:=to_date(process_date_time,'YYYY/MM/DDHH24:MI:SS');
End read_header_record;

Procedure read_unit_data is
  unit_details varchar2(20);
  read_antigen_test NUMBER:=0;
 unit_start_pos  NUMBER:=0;
 Begin
   get_column(read_record,field_delimiter,2,3,unit_details);

   v_unit_id:=null;
   -- Check if the test id is also part of the unit number
   If instr(unit_details,'^',1) > 0 then 
      unit_start_pos:=instr(unit_details,'^',1);
      v_unit_id:=substr(unit_details,unit_start_pos+1);
   Else
      v_unit_id:=unit_details;
   End If;

   If Length(v_unit_id) = 7 then
      null;
   Else
     v_unit_id:=substr(v_unit_id,2,13);
   End If;
   dbms_output.put_line('String='||unit_details||' Unit ID='||v_unit_id);
End read_unit_data;


Procedure read_test_data is
  test_details varchar2(50);
 Begin
   get_column(read_record,field_delimiter,4,5,test_details);
   v_test_id:=substr(test_details,5);
   dbms_output.put_line('v_test_id='||v_test_id);
   if v_test_id like '3 Cell%' then 
     v_test_id:=substr(v_test_id,1,6);
     v_test_type:='C';   --non antogen (Cell)
   end if;

   dbms_output.put_line('Test ID='||v_test_id);
End read_test_data;

Procedure read_antigen_test is
  szAntigen_ID varchar2(16);
 Begin
   get_column(read_record,field_delimiter,2,3,szAntigen_ID);
   If  Length(szAntigen_ID) < 6 then
       v_test_id:=szAntigen_ID;
       v_test_type:='A';
   Else
      v_test_id:='XX';
   End If;
   dbms_output.put_line('Antigen test ID='||szAntigen_ID);
End read_antigen_test;

Procedure read_result_record is
 function_result varchar2(200);
 rescode1   VARCHAR2(40);
 inst_test_id VARCHAR2(20);
 rescode2   VARCHAR2(40);
 abs_value  VARCHAR2(20);
 v_result  VARCHAR2(80);
 temp_x     VARCHAR2(1);
 v_loc_test VARCHAR2(5);
 v_max      NUMBER:=0;
 v_auto_sch_flag  VARCHAR2(1);
 v_next_max NUMBER:=0;
 result_details  varchar2(300);
 user_exception  EXCEPTION; 
 c_status         VARCHAR2(300);
 res_code_pos     NUMBER:=0;

BEGIN
 get_column(read_record,field_delimiter,3,4,result_details);
 

  If v_test_type='A' then    --antigen
    res_code_pos:=instr(result_details,'^',1);
    rescode1:=substr(result_details,res_code_pos+1);
    rescode1:=substr(rescode1,1,length(rescode1)-1);
    dbms_output.put_line('rescode1='||rescode1);
  End If;

  If v_test_type='C' then    -- non antigen
    rescode1:=substr(result_details,-5);
    rescode1:=substr(rescode1,2,3);
   dbms_output.put_line('rescode1='||rescode1);
  End If;

   v_result:=RTrim(ltrim(rescode1));

   If v_result='NRD' then 
     err_msg:='Unacceptable result:'||v_result;
     raise user_exception;
   End If;
 
 --Decode the test id as follows 

 /* select decode(upper(inst_test_id),'REFLEXABO','ABO',
				   'REFLEXFWD','FWD',
				   'POOL_CELL','IAT',
				   'CMV','CMV',
				   'SYPH','CAS',
				   'SYPH_RPT','CRS','GAL') into v_loc_test
				   from dual;
 
 */

 --Get the maximum number from the number generation table

 --If the batch id is not created ,create the id (just once)
 -- get the sequence number from the number generation table
 --and update the table as well

  inst_test_id:=v_test_id;

  If nvl(temp_test_id,' ')!=inst_test_id then
    batch_created:=FALSE;
   test_created:=FALSE;
  End If;

 If not batch_created then
   begin 
             SELECT nvl(max_number,0), nvl(max_number,0)+1
	     INTO  v_max , v_next_max FROM  number_generation
	     WHERE  chapter_id = v_chapter_id AND number_type = 'TB_ID'
	     FOR update of max_number ;
   exception
       when others then
           add_log_entry('Problem in Number Generation ... Aborting');
           rollback_and_exit;
   end;
   
    v_tb_id:=to_char(p_chp_sys_date,'MMDDYY')||'-'
             ||'PRO'||lpad(to_char(v_max),4,0);
   
    add_log_entry('Test Batch ID:'||v_tb_id);
    batch_created:=TRUE;  --reset the value to true to not to create again

    begin
       UPDATE number_generation set max_number = v_next_max
       where chapter_id = v_chapter_id and  number_type= 'TB_ID' ;
    exception
       when others then
	   add_log_entry('Update Number Generation Problem ... Aborting');
	   rollback_and_exit;
    end;

 End If;      --- For batch_created

 --Check the Test ID

  inst_test_id:=v_test_id;
  Begin
      select vit.test_id, nvl(auto_schedule,'N') into 
      v_test_id,v_auto_sch_flag
      from valid_instrument_tests vit, valid_tests vt where
      vit.test_id = vt.test_id and machine_id=rtrim(v_machine_id) and
      vit.chapter_id=v_chapter_id and 
      machine_test_id=rtrim(inst_test_id) and p_chp_sys_date between
      vit.eff_date and nvl(vit.term_date,sysdate+10)
      and p_chp_sys_date between vt.eff_date and nvl(vt.term_date,sysdate+10);
   Exception
     when no_data_found then
         v_auto_sch_flag := 'N';
	 add_log_entry('Invalid test ID '||inst_test_id||' in file for '||
	 v_machine_id || '..Aborting');
         good_unit:=FALSE;
	 rollback_and_exit;
   End;

    If not test_created then
       test_created:=TRUE;
       add_log_entry('Test ID: '||v_test_id);
    End If;

 --Check the result code
  Begin
     select result_status into result_status from
     valid_instrument_test_results where test_id=v_test_id and 
     machine_id=v_machine_id and machine_result_status=v_result and
     chapter_id=v_chapter_id and 
     p_chp_sys_date between eff_date and nvl(term_date,sysdate+100);
  Exception when others then
    good_unit:=FALSE;
    err_msg:='Error translating result code '||v_result||
	     ' for unit '||v_unit_id|| '  :'||sqlerrm;
     raise user_exception;
  End;

  --Check the unit id length
  If length(v_unit_id)=6 then 
     If ASCII(substr(v_unit_id,1,1)) not between 65 and 90 then
        err_msg:='Invalid Unit ';
        good_unit:=FALSE;
        raise user_exception;
     Else
       v_unit_id:=' '||v_unit_id;
     End If;
  End If;

  If length(v_unit_id) not in (7,13) then
     err_msg:='Invalid Unit Length';
     good_unit:=FALSE;
     raise user_exception;
  End if;

   If length(v_unit_id) in (6,7) then
    if codabar_unit_scheme='A' and ltrim(v_unit_id,'0123456789') is null then
       convert_unit_id(c_status);
       if nvl(c_status,' ')!='OK' then
          err_msg:=c_status;
	  good_unit:=FALSE;
	  raise user_exception;
       end if;
    end if;
   End If;

  If v_unit_id like '%TRL%' or v_unit_id like '%POS%' or
     v_unit_id like '%NEG%' then
     err_msg:='Control- Not a unit ID-';
     good_unit:=FALSE;
     raise user_exception;
  End If;
 
  If good_unit then
   begin
       If first_unit then
    	 update_batch_information;
         insert_instrument_log;
         first_unit:=FALSE;
         temp_test_id:=v_test_id;
       Else
          if temp_test_id!=inst_test_id then  --inserting for different test
             update_batch_information;
          end if;
       End if;
       
       last_unit:=v_unit_id;
       temp_test_id:=inst_test_id;

       /* If temp_test_id!=v_test_id then 
         add_log_entry('Multiple tests in file ... ');
	 good_unit:=FALSE;
	 rollback_and_exit;
       End if;

      */ 

       -------insert into UTRS table --------
       If v_auto_sch_flag = 'Y' then
        Begin
            temp_coll_date := null;
            select max(coll_date) into temp_coll_date
	    from units where unit_id =v_unit_id
            and  not exists 
		   (select 'x' from utrs
                    where unit_id = units.unit_id
                    and coll_date = units.coll_date
	            And test_id = v_test_id
	            and cancel_flag is null);
	    
	    If temp_coll_date is not null then
              Begin
	        temp_max_test_seq_no := 0;
	        begin
	             select nvl(max(nvl(test_seq_no,0)),0)
		      into temp_max_test_seq_no
		      from utrs where unit_id = v_unit_id
                      and coll_date = temp_coll_date
    		      and test_id = v_test_id;
 	              dbms_output.put_line('M='||to_char(temp_max_test_seq_no));
	      exception
		    when others then
	   	        temp_max_test_seq_no :=0;
										                end;
												 begin
                      insert into utrs
			   (unit_id, coll_date, chapter_id,
		            test_id, test_seq_no, program_id, insert_dats,
		            insert_user_id, test_mode,
			    test_chapter_id, tb_id)
			values
			     (v_unit_id, temp_coll_date, v_chapter_id,
			      v_test_id, temp_max_test_seq_no +1,
			      'ATUPROVUE', sysdate, substr(user, 5),
			      'M', v_chapter_id, null);
                 exception
	           when others then
		   add_log_entry('unit='||v_unit_id);
		   add_log_entry('coll='||to_char(temp_coll_date,
						  'mm-dd-yyyy hh24:mi'));
                   add_log_entry(v_chapter_id);
		   add_log_entry(v_test_id);
		   add_log_entry(to_char(temp_max_test_seq_no+1));
		   add_log_entry(v_chapter_id);
		   add_log_entry(sqlerrm);
		   add_log_entry('Error in inserting into utrs....Aborting');
	           rollback_and_exit;
	  	end;
	      End;
	      end if;
	  Exception
	     when others then
		  temp_coll_date := null;
         End;
      end if;
       --------------------------------------

       function_result := sbclib.load_holding_tests
				(v_unit_id,
				v_test_id,
				well_number,
				nvl(abs_value,'NA'),
				ratio,
				result_status,
				v_tb_id,
				v_machine_id,
				null,
				null,
				'ATUPROVUE',
                               result_date_time,
                               v_chapter_id);
		upload_count:=upload_count+1;
           if rtrim(function_result)!='0' then 
               add_log_entry('Error in load_holding_tests for unit'||v_unit_id);
               add_log_entry(function_result);
           end if;
     End;
   Else
	add_log_entry('unit '||v_unit_id||' Not uploaded');
    End if;

EXCEPTION When user_exception then
  add_log_entry('Error on '||v_unit_id||' : '||err_msg);
  when others then 
 add_log_entry('Error on '||v_unit_id||' :'||sqlerrm);
END read_result_record;

Procedure init_variables is
 v_galileo_id    varchar2(10);
Begin
   begin
      SELECT testing_lab_code into testing_lab_code
      from system_users where user_id = user and sysdate between eff_date and
      nvl(term_date,sysdate);
   exception when no_data_found then
      testing_lab_code:='99';
      --v_chapter_id:='WAD';
   end;

   begin
       select nvl(codabar_unit_scheme,'*') into  codabar_unit_scheme
       from institutions where sysdate between eff_date and
       nvl(term_date,sysdate);
   exception when no_data_found then
     add_log_entry('No institution data available .... Aborting');
     rollback_and_exit;
   end;

    begin
       select code into v_galileo_id from master_codes where
       code_type='INSTR' and code='GAL' and
       p_chp_sys_date between eff_date and nvl(term_date,sysdate+10);
    exception
	when no_data_found then
	   add_log_entry('Machine code not defined in the master codes');
	   rollback_and_exit;
    end;
End init_variables;

Procedure update_batch_information is
function_result varchar2(100);
temp_x varchar2(1);
Begin
     select distinct 'x'  into temp_x
		  from test_batch_hdr 
		  where tb_id = v_tb_id
		  and test_chapter_id = v_chapter_id
		  and group_test_id = v_test_id;
	add_log_entry('Duplicate batch '||v_tb_id||' ... Aborting');
	rollback_and_exit;
Exception when no_data_found then
   Begin
       select 'x'  into temp_x from dual 
		where exists (select 'x' from utrs 
			      where tb_id = v_tb_id
			      and test_id = v_test_id
			      and test_chapter_id = v_chapter_id)  or
		      exists (select 'x' from unit_test_base 
			      where tb_id = v_tb_id
			      and test_id = v_test_id
			      and test_chapter_id = v_chapter_id)  or
		      exists (select 'x' from holding_tests 
			      where tb_id = v_tb_id
			      and test_id = v_test_id
			      and test_chapter_id = v_chapter_id)  or
		      exists (select 'x' from test_voids 
			      where tb_id = v_tb_id
			      and test_id = v_test_id
			      and test_chapter_id = v_chapter_id);
         add_log_entry('Duplicate batch '||v_tb_id||' ...Aborting');
         rollback_and_exit;
   Exception when no_Data_found then 
     begin
         begin
             insert into test_batch_hdr( tb_id, test_chapter_id, group_test_id,
  	                                 first_unit_id, insert_dats, user_id)
             values (v_tb_id, v_chapter_id, v_test_id, v_unit_id, sysdate,
		     decode(substr(user,1,3),'OPS',substr(user,5), user));
	 exception when others then
	     add_log_entry('Problem inserting into test_batch_hdr... Aborting');
	     rollback_and_exit;
         end;
        
	 begin
             insert into test_batch_det(tb_id, test_chapter_id,
	     testing_lab_code, test_id, test_type, cut_off_value, station_no,
	     kit_lot_number)
	     values (v_tb_id, v_chapter_id, testing_lab_code, v_test_id, 'A',
	  	     cut_off, null, kit_lot);
       exception when others then
            add_log_entry('Problem inserting into test_batch_det.. Aborting');
            rollback_and_exit;
       end;
      
       begin
            function_result := sbclib.insert_test_parms (v_chapter_id, 
                            v_test_id, v_tb_id, v_machine_id, 'ATUPROVUE');
       end;
        if rtrim(function_result)!='0' then
        add_log_entry('Error inserting test parameters ... Aborting');
	add_log_entry(function_result);
	rollback_and_exit;
        end if;
    end;
  End;
    ---insert_instrument_log;
End;

Procedure insert_instrument_log is
temp_x varchar2(1);
Begin
 begin
    select 'x' into temp_x from instrument_log where
    file_name=substr(result_file_name,instr(result_file_name,'/',-1)+1);
    add_log_entry('File '||substr(result_file_name,
    instr(result_file_name,'/',-1)+1)||' already uploaded ..Aborting');
    rollback_and_exit;
 exception
    when no_data_found then
       null;
    when too_many_rows then 
     begin
        add_log_entry('File '||substr(result_file_name,
	instr(result_file_name,'/',-1)+1)||' already uploaded ..Aborting');
        rollback_and_exit;
     end;
    when others then 
     begin
        add_log_entry('Error verifying instrument_log ...Aborting');
        rollback_and_exit;
     end;
 end;

 begin
    insert into instrument_log ( tb_id, test_chapter_id, test_id, read_dats,
		           machine_id, station_no, xmt_status, status_dats,
			   file_name) 
    values (v_tb_id, v_chapter_id,v_test_id,result_date_time, v_machine_id,
            ' ', '70', sysdate, substr(result_file_name,
	    instr(result_file_name,'/',-1)+1));
  exception when others then
      add_log_entry('Error creating instrument log...Aborting');
      add_log_entry(sqlerrm);
      rollback_and_exit;
  end;
End insert_instrument_log;

procedure convert_unit_id(ok_status out varchar2) is
Begin
    select eye_read_trns||substr(v_unit_id,3) into
    v_unit_id from bar_code_prefixes where
    machine_code=substr(v_unit_id,1,2) and sysdate between 
    eff_date and nvl(term_date,sysdate);
    ok_status:='OK';
Exception 
    when others then
    ok_status:='bar code translation'||sqlerrm;
End convert_unit_id;

procedure rollback_and_exit is
end_time  varchar2(30);
Begin
rollback;
add_log_entry('Aborting');
UTL_FILE.fclose(logfile);
raise_application_error('-20000','Aborting');
End rollback_and_exit;

procedure update_rpt_parm is
Begin

begin
update test_batch_hdr set last_unit_id=last_unit where tb_id=v_tb_id;
exception 
   when others  then
	add_log_entry('Error updating test_batch_hdr');
end;

begin
   insert into rpt_parm (appl_id, user_name, report_name, parm_id,
			 parm_date, submit_date,report_status)
	values ('SBC', decode(substr(user,1,4),'OPS$',substr(user,5),user),
                'PROVUE', substr(p_file_name,1,20),sysdate, sysdate, 'C');
    exception 
	when others then 
	add_log_entry('Error inserting into rpt_parm');
	add_log_entry(sqlerrm);
end;
End update_rpt_parm;

END ATUPROVUE;
/
grant execute on ATUPROVUE to public
/
create public synonym ATUPROVUE for ATUPROVUE
/


