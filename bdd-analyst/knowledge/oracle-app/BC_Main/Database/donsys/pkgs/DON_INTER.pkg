/
CREATE OR REPLACE PACKAGE BODY DON_INTER IS
/* --------------------Global declarations---------------------------- */
 g_sysdate                    date     ;
 g_upm_flag                   varchar2(1);
 g_allow_multiple             varchar2(1);
 g_period_type                varchar2(8);
 g_period_number              number;
 g_inter_type                 varchar2(5);
 g_deferral_flag              varchar2(1);
 g_fixed_period               varchar2(1);
 g_minimum_period             number;
 g_inter_owner                varchar2(1);
 g_donor_inter_code           varchar2(5);
 g_term_reason_req            varchar2(1); 
/*  
---#######################################################################
    Program Name        : COMPUTE_TERM_DATE
    Date Creation       : 11-13-97
    Program Author      : Chandra
---#######################################################################
*/
/* --------------------------------------------------------------------- */
/* NAME : COMPUTE_TERM_DATE
 -----------------------------------------------------------------
 Desc:This procedure computes the termination date depending upon
     fixed_period, period_type, period_number etc. It computes
     the term_date from the incident_date passed to it.
 Inp: fixed_period,period_type,period_number,incident_date,term_date
 Out: p_final_term_date,p_status
      p_status is OK if successfully computed else contains error
 Err: from Err1 to Err2
 -----------------------------------------------------------------
*/
 PROCEDURE      compute_term_date
                       (p_sysdate              IN      date,
                        p_fixed_period         IN      varchar2,
                        p_period_type          IN      varchar2,
                        p_period_number        IN      number,
                        p_minimum_period       IN      number,
                        p_incident_date        IN      date,
                        p_term_date            IN      date,
                        p_final_term_date      OUT     date,
                        p_status               OUT     varchar2
  )  IS
   no_of_days      varchar2(4);
   min_term_date   date;
   compute_date    date;
   lp_term_date    date;
   final_term_date date;
Begin
    if p_term_date < p_sysdate then   /* no need of checking */
       if p_incident_date > p_term_date then
          p_status := 'Err1. Incident date greater than term date';
          return;
       end if;
       p_final_term_date := p_term_date;
       p_status := 'OK1';
       return;
    end if;
    if (p_period_type = 'P'  or p_period_type is null ) then
       if p_term_date < p_sysdate then -- V13 -- IM 579
          p_final_term_date := p_term_date;
       else
          p_final_term_date := null;
       end if;
       p_status := 'OK1.1';
       return;
    end if;
 -- If p_term_date is past date then check with sysdate 

   if p_term_date < p_sysdate then -- V13 -- IM 579
      p_final_term_date := p_term_date;
      p_status := 'OK2';
      return;
   end if;

      /* compute when only term_date is future date */
BEGIN  
    SELECT nvl(numeral_value,1)
      INTO no_of_days
      FROM valid_master_codes
     WHERE code_type = 'PRTYP'
       AND substr(code,1,1) = substr(p_period_type,1,1)
       AND p_sysdate between eff_date and nvl(term_date, p_sysdate+1);
EXCEPTION
    WHEN no_Data_found then
         p_status := 'Err 0.1  Period_type is not defined.';
         return;
    WHEN too_many_rows then
         SELECT max(nvl(numeral_value,1))
           INTO no_of_days
           FROM valid_master_codes
          WHERE code_type = 'PRTYP'
            AND substr(code,1,1) = substr(p_period_type,1,1)
            AND p_sysdate between eff_date and 
                                  nvl(term_date, p_sysdate+1);
    WHEN others then
         p_status := 'Err 0.2  Period_type sql failed.';
         return;
END;

   if p_period_number is null and p_minimum_period is null then
      p_final_term_date := NULL;
      p_status := 'OK4';
      return;
   end if;
-- case II
   if p_period_number is null and p_minimum_period is not null then
      min_term_date := p_incident_date +
                              to_number(no_of_days) * p_minimum_period ;
      if p_fixed_period = 'Y' then 
         p_final_term_date := min_term_date;
      else
         p_final_term_date := compute_max_date(p_term_date,min_term_date);
      end if;
      p_status := 'OK5';
      return;
   end if;
-- case III
   if p_period_number is not null and p_minimum_period is null then
      compute_date := p_incident_date + to_number(no_of_days) * p_period_number;
      if p_fixed_period = 'Y' then
         p_final_term_date := compute_date;
      else   /* fixed period  is N */
         p_final_term_date := compute_max_date(p_term_date,compute_date);
      end if;
      p_status := 'OK6';
      return;
   end if;
-- case IV
   if p_period_number is not null and p_minimum_period is not null then
      compute_date := p_incident_date + to_number(no_of_days) * p_period_number;
      min_term_date := p_incident_date+to_number(no_of_days)*p_minimum_period ;
      if p_fixed_period = 'Y' then
         p_final_term_date := compute_date;
      else   /* fixed period  is N */
         p_final_term_date := compute_max_date(p_term_date,min_term_date);
      end if;
      p_status := 'OK7';
      return;
   end if;
    
   p_status := 'Err2. Can not compute final_term_date';
 End compute_term_date;
/* ++++++++++++++++++procedure compute term date ends +++++++++++++++ */

/* Name : COMPUTE_MAX_DATE
   Created : 11-05-97
 -----------------------------------------------------------------------
 Desc:This function returns max of two dates
 Inp: date1,date2
 Out: max date
 -----------------------------------------------------------------------
 */
 FUNCTION compute_max_date(date1      IN       date,
                           date2      IN       date ) RETURN date
  IS
 BEGIN
     if date1 is null or date2 is null then
              return date1;
     else
         if date1 > date2 then
              return date1;
         else
              return date2;
         end if;
     end if;
 END compute_max_date;
/* ++++++++++++++++++ compute max date ends +++++++++++++++ */
/*  
---#######################################################################
    Program Name        : GENERATE_NOTE
    Date Creation       : 11-13-97
    Program Author      : Chandra
---#######################################################################
*/
/* Name : GENERATE_NOTE
 -----------------------------------------------------------------------
 Desc:This procedure generates the note_id if it is null. It aslo
      generate the note_sequence as per the number of note attached,
      by taking the max(note_sequence0 and adding one to it.
 Inp: p_comments,p_chapter_id,p_program_id,user_id,note_id
 Out: note_id , p_status
      p_status is OK if successfully attached note else contains error.
 Err: from Err3 to Err6
 -----------------------------------------------------------------------
 */
 PROCEDURE generate_note
                (p_comments             IN              varchar2,
                 p_chapter_id           IN              varchar2,
                 p_program_id           IN              varchar2,
                 p_user_id              IN              varchar2,
                 p_note_id              IN OUT          varchar2,
                 p_status               OUT             varchar2
                )
 IS
 t_seq_no               number;
 t_note_id      varchar2(10);
 err_flag       varchar2(1);
 err_msg        varchar2(50);
 Begin
      if p_comments is null then
                p_status := 'OK';
                return;
      end if;
      if  p_chapter_id is null or
          p_program_id is null then
          p_status := 'Err3. Chapter_ID or Program ID is NULL';
          return;
      end if;
      if p_note_id is null then  /* generate new note id */
         begin
            Select to_char(note_sequence.nextval)
                 into t_note_id from dual;
         exception
            when others then
               p_status := 'Err4. Could not generate note_sequence '
                                ||substr(sqlerrm,1,100);
         end;
         p_note_id := t_note_id;
      --end if;
         t_seq_no := 1;
      else             /*          old note id exists*/
          begin
              select max(note_sequence) into t_seq_no
                from central_notes
               where note_id = p_note_id;
              t_seq_no := t_seq_no +1;
          exception
              when no_data_found then
                  t_seq_no := 1;
          end;
      end if;  
      Begin
          Insert  into central_notes
                ( NOTE_ID,NOTE_SEQUENCE ,PROGRAM_ID,INSERT_DATE,
                 INSERT_USER ,CHAPTER_ID, NOTE )
          values
                (p_note_id,t_seq_no,p_program_id,g_sysdate,p_user_id,
                 p_chapter_id,p_comments);
          if sql%notfound then
                p_status := 'Err5. Unable to insert note in central notes '
                            ||substr(sqlerrm,1,100);
                return;
           end if;
      Exception
          When others then
                p_status := 'Err6. Unable to Insert note '
                             ||substr(sqlerrm,1,100);
                return;
      End;
      p_status := 'OK';
 End generate_note;
/* ++++++++++++++++++++++++++++ generate note ends +++++++++++++++++++++++++++ */
/*  
---#######################################################################
    Program Name        : INSERT_IN_DONOR_INTER
    Date Creation       : 11-13-97
    Program Author      : Chandra
---#######################################################################
*/
/* Name : INSERT_IN_DONOR_INTER
 -----------------------------------------------------------------------
 Desc:This procedure insert in donor interdictions table, by generating
      note_id for comments passed.
 Inp: p_donor_id,p_inter_code,user_id,program_id,incident_date,etc
      except: release_user,release_date,audit-key
 Out: populates the donor_interdictions and central notes.
      p_status is OK if successfully validated else contains error.
 Err: from Err? to Err?
 -----------------------------------------------------------------------
 */
 PROCEDURE INSERT_IN_DONOR_INTER(
                                 l_DONOR_ID            IN   VARCHAR2,
                                 l_CHAPTER_ID          IN   VARCHAR2,
                                 l_INTER_CODE          IN   VARCHAR2,
                                 l_EFF_DATE            IN   DATE,
                                 l_INTER_TYPE          IN   VARCHAR2,
                                 l_TRANSACTION_ID      IN   VARCHAR2,
                                 l_NOTIFICATION_STATUS IN   VARCHAR2,
                                 l_comments            IN   VARCHAR2 , --NOTE_ID
                                 l_UNIT_ID             IN   VARCHAR2 ,
                                 l_UPM_DISPOSITION     IN   VARCHAR2,
                                 l_ORIGINATED_FROM     IN   VARCHAR2 ,
                                 l_REASON_CODE         IN   VARCHAR2 ,
                                 l_GROUP_ID            IN   VARCHAR2,
                                 l_LETTER_SEQ_NO       IN   VARCHAR2 ,
                                 l_GROUP_MODE          IN   VARCHAR2,
                                 l_TERM_DATE           IN   DATE,
                                 l_PROGRAM_ID          IN   VARCHAR2,
                                 l_INSERT_DATE         IN   DATE,
                                 l_INSERT_USER         IN   VARCHAR2 ,
                                 out_note_id          OUT   VARCHAR2,
                                    ret_stat          OUT   VARCHAR2)
 IS
    tmp_status         varchar2(250);
    l_note_id          varchar2(10);
    t_multi_chapter    varchar2(1);
    t_chapter_id       varchar2(4);
 BEGIN
 /*     begin
          select note_id into l_note_id
            from donor_interdictions
           where donor_id = l_donor_id and
                 --g_sysdate between eff_date and nvl(term_date,g_sysdate+1) and
                 note_id is not null and
                 rownum < 2;
     exception
          when others then
                null;
     end;
  */
     generate_note(l_comments,l_chapter_id,l_program_id,
                           l_insert_user,l_note_id,tmp_status );
     if tmp_status != 'OK' then
           ret_stat := tmp_status;
           return;
     end if;
     out_note_id := l_note_id;

     -- Added by Kishore on 03/18/2011. IM 4903
     begin
       select nvl(multi_chapter, 'N')
         into t_multi_chapter
         from lt_application_config
        where rownum = 1;
     exception
       when others then
         ret_stat := 'Err17.5. Unable to retrive multi chapter flag '||
                             substr(sqlerrm,1,100);
       return;
     end;

     if nvl(t_multi_chapter, 'N') = 'Y' then
       t_chapter_id := 'ALL';
     else
       t_chapter_id := l_chapter_id;
     end if;
     -- End of change

     begin
         INSERT INTO DONOR_INTERDICTIONS (
                                 DONOR_ID    ,
                                 CHAPTER_ID     ,
                                 INTER_CODE   ,
                                 EFF_DATE      ,
                                 INTER_TYPE     ,
                                 TRANSACTION_ID    ,
                                 NOTIFICATION_STATUS ,
                                 NOTE_ID,
                                 UNIT_ID  ,
                                 UPM_DISPOSITION ,
                                 ORIGINATED_FROM   ,
                                 REASON_CODE    ,
                                 GROUP_ID      ,
                                 LETTER_SEQ_NO  ,
                                 GROUP_MODE     ,
                                 TERM_DATE    ,
                                 PROGRAM_ID     ,
                                 INSERT_DATE    ,
                                 INSERT_USER    )
          VALUES                 (
                                 l_DONOR_ID  ,
                                 t_chapter_id  , -- l_CHAPTER_ID -- Changed by Kishore on 03/18/2011. IM 4903
                                 l_INTER_CODE  ,
                                 l_EFF_DATE   ,
                                 l_INTER_TYPE    ,
                                 l_TRANSACTION_ID   ,
                                 l_NOTIFICATION_STATUS ,
                                 l_note_id          , --NOTE_ID
                                 l_UNIT_ID           ,
                                 l_UPM_DISPOSITION  ,
                                 l_ORIGINATED_FROM   ,
                                 l_REASON_CODE      ,
                                 l_GROUP_ID       ,
                                 l_LETTER_SEQ_NO   ,
                                 l_GROUP_MODE     ,
                                 l_TERM_DATE      ,
                                 l_PROGRAM_ID      ,
                                 l_INSERT_DATE    ,
                                 l_INSERT_USER     );
     Exception
         when others then
               ret_stat := 'Err17. Unable to insert in donor interdiction '||
                           substr(sqlerrm,1,100);
               return;
     End;
     ret_stat := 'OK';         /* if success */
 END INSERT_IN_DONOR_INTER;
/*+++++++++++++++++++++ INSERT IN DONOR INTER ends ++++++++++++++++++++++ */
/*  
---#######################################################################
    Program Name        : INSERT_IN_INTER_TRAN
    Date Creation       : 11-13-97
    Program Author      : Chandra
---#######################################################################
*/
/* Name : INSERT_IN_INTER_TRAN
 -----------------------------------------------------------------------
 Desc:This procedure insert in inter transactions table, note is simply inserted
      without inserting in central_notes.
 Inp: p_donor_id,p_inter_code,user_id,program_id,incident_date,etc
      except: release_user,release_date,audit-key
 Out: populates the donor_interdictions and central notes.
      p_status is OK if successfully validated else contains error.
 Err: from Err? to Err?
 -----------------------------------------------------------------------
 */
 PROCEDURE INSERT_IN_INTER_TRAN(
                                 l_DONOR_ID            IN   VARCHAR2,
                                 l_CHAPTER_ID          IN   VARCHAR2,
                                 l_INTER_CODE          IN   VARCHAR2,
                                 l_EFF_DATE            IN   DATE,
                                 l_INTER_TYPE          IN   VARCHAR2,
                                 l_TRANSACTION_ID      IN   VARCHAR2,
                                 l_NOTIFICATION_STATUS IN   VARCHAR2,
                                 l_note_id             IN   VARCHAR2 , --NOTE_ID
                                 l_UNIT_ID             IN   VARCHAR2 ,
                                 l_UPM_DISPOSITION     IN   VARCHAR2,
                                 l_ORIGINATED_FROM     IN   VARCHAR2 ,
                                 l_REASON_CODE         IN   VARCHAR2 ,
                                 l_GROUP_ID            IN   VARCHAR2,
                                 l_LETTER_SEQ_NO       IN   VARCHAR2 ,
                                 l_GROUP_MODE          IN   VARCHAR2,
                                 l_TERM_DATE           IN   DATE,
                                 l_PROGRAM_ID          IN   VARCHAR2,
                                 l_INSERT_DATE         IN   DATE,
                                 l_INSERT_USER         IN   VARCHAR2 ,
                                 ret_stat              OUT   VARCHAR2) IS

   t_multi_chapter      varchar2(1);
   t_chapter_id         varchar2(4);
 BEGIN
    -- Added by Kishore on 03/18/2011. IM 4903
    begin
      select nvl(multi_chapter, 'N')
        into t_multi_chapter
        from lt_application_config
       where rownum = 1;
    exception
      when others then
        ret_stat := 'Err17.51. Unable to retrive multi chapter flag '||
                            substr(sqlerrm,1,100);
      return;
    end;

    if nvl(t_multi_chapter, 'N') = 'Y' then
      t_chapter_id := 'ALL';
    else
      t_chapter_id := l_chapter_id;
    end if;
    -- End of change

    begin
         INSERT INTO INTER_TRANSACTIONS (
                                 DONOR_ID    ,
                                 CHAPTER_ID     ,
                                 INTER_CODE   ,
                                 EFF_DATE      ,
                                 INTER_TYPE     ,
                                 TRANSACTION_ID    ,
                                 NOTIFICATION_STATUS ,
                                 NOTE_ID,
                                 UNIT_ID  ,
                                 UPM_DISPOSITION ,
                                 ORIGINATED_FROM   ,
                                 REASON_CODE    ,
                                 GROUP_ID      ,
                                 LETTER_SEQ_NO  ,
                                 GROUP_MODE     ,
                                 TERM_DATE    ,
                                 PROGRAM_ID     ,
                                 INSERT_DATE    ,
                                 INSERT_USER    )
          VALUES                 (
                                 l_DONOR_ID  ,
                                 t_chapter_id , -- l_CHAPTER_ID , -- Changed by Kishore on 03/18/2011. IM 4903
                                 l_INTER_CODE  ,
                                 l_EFF_DATE   ,
                                 l_INTER_TYPE    ,
                                 l_TRANSACTION_ID   ,
                                 l_NOTIFICATION_STATUS ,
                                 l_note_id          , --NOTE_ID
                                 l_UNIT_ID           ,
                                 l_UPM_DISPOSITION  ,
                                 l_ORIGINATED_FROM   ,
                                 l_REASON_CODE      ,
                                 l_GROUP_ID       ,
                                 l_LETTER_SEQ_NO   ,
                                 l_GROUP_MODE     ,
                                 l_TERM_DATE      ,
                                 l_PROGRAM_ID      ,
                                 l_INSERT_DATE    ,
                                 l_INSERT_USER     );
     Exception
         when others then
               ret_stat := 'Err18. Unable to insert in inter transactions '||
                           substr(sqlerrm,1,100);
               return;
     End;
     ret_stat := 'OK';          /* if success */
 END INSERT_IN_INTER_TRAN;
/*+++++++++++++++++++++ INSERT IN INTER TRAN ends ++++++++++++++++++++++ */
/*  
---#######################################################################
    Program Name        : VALIDATE_PARAMETERS
    Date Creation       : 11-13-97
    Program Author      : Chandra
---#######################################################################
*/
/* Name : VALIDATE_PARAMETERS
 -----------------------------------------------------------------------
 Desc:This procedure validates the input parameters to the place and
      remove interdiction routine. this is generic so as to maintain the
      error conditions in the absence of any parameters.
 Inp: p_donor_id,p_inter_code,user_id,program_id,incident_date
 Out: populates the global parameters- related to inter_code like
      g_upm_flag,g_allow_multiple,g_period_type,g_period_number,
      g_inter_type,g_deferral_flag,g_fixed_period,g_minimum_period,
      g_inter_owner,g_donor_inter_code
      p_status is OK if successfully validated else contains error.
 Err: from Err7 to Err15
 -----------------------------------------------------------------------
 */
 PROCEDURE validate_parameters
                        (p_donor_id             IN      varchar2,
                         p_chapter_id           IN      varchar2,
                         p_inter_code           IN      varchar2,
                         p_user_id              IN      varchar2,
                         p_program_id           IN      varchar2,
                         p_incident_date        IN      date,
                         p_status               OUT     varchar2
                         )
 IS
 x varchar2(1);
 Begin
     if p_chapter_id is null then
        p_status := 'Err7.1. chapter id can not be null';
        return;
     end if;

     if p_inter_code is null then
        p_status := 'Err7. Inter Code can not be NULL';
        return;
     end if;
     if p_donor_id is null then
        p_status := 'Err8. Donor ID can not be NULL';
        return;
     end if;
     begin
        select 'X'
          into  x
          from  donors 
          where donor_id = p_donor_id
            and decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id;  -- chapter_id = p_chapter_id; -- Changed by Kishore on 03/18/2011. IM 4903
     exception
        when no_data_found then
             p_status := 'Err8.1 Donor ID Cannot be identified';
             return;
        when others then
             p_status := 'Err8.2 Donor ID Unidentifiable';
             return;
     end;
     if p_user_id is null then
        p_status := 'Err9. User ID can not be NULL';
        return;
     end if;
     if p_program_id is null then
        p_status := 'Err10. Program ID can not be NULL';
        return;
     end if;
     -- if  p_incident_date > g_sysdate then -- Commented by Kishore on 05/03/2011. IM 5421
     if p_incident_date > v_local_sysdate then -- Added by Kishore on 05/03/2011. IM 5421
        p_status := 'Err11. Incident date can not be more than sysdate';
        return;
     end if;
     Begin
        Select  nvl(upm_flag,'N'),nvl(allow_multiple,'N'),period_type,
                period_number,inter_type,deferral_flag,fixed_period,
                minimum_period,inter_owner,donor_inter_code,term_reason_req
        into    g_upm_flag,g_allow_multiple,g_period_type,g_period_number,
                g_inter_type,g_deferral_flag,g_fixed_period,g_minimum_period,
                g_inter_owner,g_donor_inter_code,g_term_reason_req
        from valid_interdictions
        where  inter_code = p_inter_code and
               g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
     Exception
        when no_data_found then
                p_status := 'Err12. Inter Code not defined '||
                             substr(sqlerrm,1,100);
                return;
        when too_many_rows then
                p_status := 'Err13. Too many rows in valid interdictions '||
                             substr(sqlerrm,1,100);
                return;
        when others then
                p_status := 'Err14. SQL failed '||substr(sqlerrm,1,100);
                return;
     End;
     if g_inter_owner = 'U' then
                p_status := 'Err15. This inter code is unit related';
                return;
     end if;
     p_status := 'OK';   /* all critical parameters validated */
 End validate_parameters;
/* +++++++++++++++++++ validate_parameters ends +++++++++++++++++++++++++ */

/*  
---#######################################################################
    Program Name        : INTER_TEMP_PLACE
    Date Creation       : 11-13-97
    Program Author      : Chandra
---#######################################################################
*/
/* Name : INTER_TEMP_PLACE
 -----------------------------------------------------------------------
 Desc:This procedure is called to place an interdiction code on don_inter_temp
      This procedure takes care of all the various possibilities like
      upgrading the interdiction, placing of multiple interdictions etc.
 Inp: p_donor_id,p_inter_code,user_id,program_id,incident_date,comments
      + check the parameters below
 Out: populates donor_interdiction table and may populate inter_transaction
      table, comments are stored in central_notes.
      p_status is OK if successfully validated else contains error.
 Err: from Err16 to Err29
 -----------------------------------------------------------------------
 */
  PROCEDURE inter_temp_place(
                            p_sysdate             IN              date,
                            p_DONOR_ID            IN              VARCHAR2,
                            p_CHAPTER_ID          IN              VARCHAR2,
                            p_RUN_ID              IN              VARCHAR2,
                            p_INTER_CODE          IN              VARCHAR2,
                            p_TRANSACTION_ID      IN              VARCHAR2,
                            p_NOTIFICATION_STATUS IN              VARCHAR2,
                            p_NOTE_ID             IN              VARCHAR2,
                            p_RELEASE_USER        IN              VARCHAR2,
                            p_RELEASE_DATE        IN              DATE,
                            p_INTER_TYPE          IN              VARCHAR2,
                            p_UNIT_ID             IN              VARCHAR2,
                            p_UPM_DISPOSITION     IN              VARCHAR2,
                            p_LAST_MODIFIED_DATE  IN              DATE,
                            p_ORIGINATED_FROM     IN              VARCHAR2,
                            p_REASON_CODE         IN              VARCHAR2,
                            p_GROUP_ID            IN              VARCHAR2,
                            p_GROUP_MODE          IN              VARCHAR2,
                            p_EFF_DATE            IN              DATE,
                            p_TERM_DATE           IN              DATE,
                            p_TERM_REASON         IN              VARCHAR2,
                            p_PROGRAM_ID          IN              VARCHAR2,
                            p_INSERT_DATE         IN              DATE,
                            p_INSERT_USER         IN              VARCHAR2,
                            p_status             OUT              varchar2
                           )
 IS
    /* local global declarations */
    l_status            varchar2(250);
    return_status       varchar2(250);
    pg_fixed_period     varchar2(1);
    pg_period_type      varchar2(8);
    pg_period_number    number;
    pg_inter_type       varchar2(5);
    pg_upm_flag         varchar2(1);
    pg_allow_multiple   varchar2(1);
    pg_minimum_period   number;

  FUNCTION local_validate_parameters(
                                    t_inter_code in varchar2)
                                    RETURN VARCHAR2
  IS
  BEGIN
    begin
      SELECT period_type,period_number,inter_type,fixed_period,
             upm_flag,allow_multiple,minimum_period
        into pg_period_type,pg_period_number,pg_inter_type,pg_fixed_period,
             pg_upm_flag,pg_allow_multiple,pg_minimum_period
        from VALID_INTERDICTIONS
       where inter_code = t_inter_code and
             p_sysdate between eff_date and nvl(term_date,p_sysdate+1);
      return 'OK';
    exception
      when others then
           return 'Errt36. Local validation failed '||
                  substr(sqlerrm,1,100);
    end;
  END local_validate_parameters;

 /* Function place_inter_c11 called from call_upm_flagN function */
 /* called when inter_code does not exists on donor */
  FUNCTION insert_don_inter_temp(
                            K_DONOR_ID            IN           VARCHAR2,
                            K_CHAPTER_ID          IN           VARCHAR2,
                            K_RUN_ID              IN           VARCHAR2,
                            K_INTER_CODE          IN           VARCHAR2,
                            K_TRANSACTION_ID      IN           VARCHAR2,
                            K_NOTIFICATION_STATUS IN           VARCHAR2,
                            K_NOTE_ID             IN           VARCHAR2,
                            K_RELEASE_USER        IN           VARCHAR2,
                            K_RELEASE_DATE        IN           DATE,
                            K_INTER_TYPE          IN           VARCHAR2,
                            K_UNIT_ID             IN           VARCHAR2,
                            K_UPM_DISPOSITION     IN           VARCHAR2,
                            K_LAST_MODIFIED_DATE  IN           DATE,
                            K_ORIGINATED_FROM     IN           VARCHAR2,
                            K_REASON_CODE         IN           VARCHAR2,
                            K_GROUP_ID            IN           VARCHAR2,
                            K_GROUP_MODE          IN           VARCHAR2,
                            K_EFF_DATE            IN           DATE,
                            K_final_TERM_DATE     IN           DATE,
                            K_TERM_REASON         IN           VARCHAR2,
                            K_PROGRAM_ID          IN           VARCHAR2,
                            K_INSERT_DATE         IN           DATE,
                            K_INSERT_USER         IN           VARCHAR2
                                ) RETURN VARCHAR2
  IS
  BEGIN
    INSERT INTO DON_INTER_TEMP
                     (
                     DONOR_ID,
                     CHAPTER_ID,
                     RUN_ID,
                     INTER_CODE,
                     TRANSACTION_ID,
                     NOTIFICATION_STATUS,
                     NOTE_ID,
                     RELEASE_USER,
                     RELEASE_DATE,
                     INTER_TYPE,
                     UNIT_ID,
                     UPM_DISPOSITION,
                     LAST_MODIFIED_DATE,
                     ORIGINATED_FROM,
                     REASON_CODE,
                     GROUP_ID,
                     GROUP_MODE,
                     EFF_DATE,
                     TERM_DATE,
                     TERM_REASON,
                     PROGRAM_ID,
                     INSERT_DATE,
                     INSERT_USER
                     )
    VALUES
          (
           K_DONOR_ID,
           K_CHAPTER_ID,
           K_RUN_ID,
           K_INTER_CODE,
           K_TRANSACTION_ID,
           K_NOTIFICATION_STATUS,
           K_NOTE_ID,
           K_RELEASE_USER,
           K_RELEASE_DATE,
           K_INTER_TYPE,
           K_UNIT_ID,
           K_UPM_DISPOSITION,
           K_LAST_MODIFIED_DATE,
           K_ORIGINATED_FROM,
           K_REASON_CODE,
           K_GROUP_ID,
           K_GROUP_MODE,
           K_EFF_DATE,
           k_final_term_date,
           K_TERM_REASON,
           K_PROGRAM_ID,
           K_INSERT_DATE,
           K_INSERT_USER
          );
    return 'OK';
   EXCEPTION
       when others then
          return 'Errt20. Can not insert in don_inter_temp'||
                 substr(sqlerrm,1,100);
  END insert_don_inter_temp;

  FUNCTION c12_allow_mulN return varchar2 /* sub function of place_inter_c12*/
     IS                                       /* i.e C.1.2.2  clause*/
       ret_stat         varchar2(250);
       final_term_date  date;
       old_term_date    date;
       max_term_date    date;
       l_note_id        varchar2(10);
       old_rowid        rowid;
  BEGIN
       compute_term_date(p_sysdate,pg_fixed_period,
                                  pg_period_type ,
                                  pg_period_number,
                                  pg_minimum_period,
                                  p_eff_date ,
                                  p_term_date     ,
                                  final_term_date ,
                                  ret_stat );
      if substr(ret_stat,1,2) != 'OK' then   /* to debug compute_term_date */
           return ret_stat;
      end if;
      begin     /* get the term date of existing interdiction */
          select term_date,rowid
            into old_term_date,old_rowid
            from don_inter_temp
           where donor_id = p_donor_id and
                 inter_code = p_inter_code and
                 nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                 nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                 nvl(group_id,' ') = nvl(p_group_id,' ') and
                 nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                 p_sysdate between eff_date and nvl(term_date,p_sysdate+1) and
                 rownum < 2;
      exception
          when others then
             return 'Errt20.1. Inter code does not exits '||
                    substr(sqlerrm,1,100);
      end;
      /* compute max term date */
      max_term_date := compute_max_date(old_term_date,final_term_date);
     /* insert a row in donor_interdiction with max term date */
      ret_stat := insert_don_inter_temp( 
                                     p_DONOR_ID,
                                     p_CHAPTER_ID,
                                     p_RUN_ID,
                                     p_INTER_CODE,
                                     p_TRANSACTION_ID,
                                     p_NOTIFICATION_STATUS,
                                     p_NOTE_ID,
                                     p_RELEASE_USER,
                                     p_RELEASE_DATE,
                                     p_INTER_TYPE,
                                     p_UNIT_ID,
                                     p_UPM_DISPOSITION,
                                     p_LAST_MODIFIED_DATE,
                                     p_ORIGINATED_FROM,
                                     p_REASON_CODE,
                                     p_GROUP_ID,
                                     p_GROUP_MODE,
                                     p_EFF_DATE,
                                     max_term_date,        --  p_TERM_DATE,
                                     p_TERM_REASON,
                                     p_PROGRAM_ID,
                                     p_INSERT_DATE,
                                     p_INSERT_USER
                                     );
      if ret_stat != 'OK' then
            return ret_stat;
      end if;
    /* Terminate the old inter code as only one should be effective */
       begin
         UPDATE DON_INTER_TEMP SET
            term_date = p_sysdate,
            release_date = p_sysdate,
            term_reason = 'UPGRD',
            release_user = decode(substr(LT_USER_SESSION.get_userid,1,4), 'OPS$', substr(LT_USER_SESSION.get_userid,5,6),
                                                            substr(LT_USER_SESSION.get_userid,1,6))
         WHERE rowid = old_rowid;
       exception
         when others then
           return 'Errt21. Cannot update don inter Temp table '||
                   substr(sqlerrm,1,100);
       end;
      return 'OK';
  END c12_allow_mulN;    /*  function ends */

/* this function takes care of part C.0 onwards ...
     from the req. specs. */
  FUNCTION call_upm_flagN return varchar2
  IS
    return_status       varchar2(250);
    chk_count           number;
  BEGIN
     /* C.1 check if intercode already exists */
     Begin
         Select count(*) into chk_count
           from don_inter_temp
          where  donor_id = p_donor_id and
                 decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                 inter_code = p_inter_code and
                 nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                 nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                 nvl(group_id,' ') = nvl(p_group_id,' ') and
                 nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                 p_sysdate between eff_date and nvl(term_date,p_sysdate+1);
         if chk_count = 0 then
                               /* C.1.1 interdiction is not effective */
                return_status := insert_don_inter_temp
                                     (
                                        p_DONOR_ID,
                                        p_CHAPTER_ID,
                                        p_RUN_ID,
                                        p_INTER_CODE,
                                        p_TRANSACTION_ID,
                                        p_NOTIFICATION_STATUS,
                                        p_NOTE_ID,
                                        p_RELEASE_USER,
                                        p_RELEASE_DATE,
                                        p_INTER_TYPE,
                                        p_UNIT_ID,
                                        p_UPM_DISPOSITION,
                                        p_LAST_MODIFIED_DATE,
                                        p_ORIGINATED_FROM,
                                        p_REASON_CODE,
                                        p_GROUP_ID,
                                        p_GROUP_MODE,
                                        p_EFF_DATE,
                                        p_TERM_DATE,
                                        p_TERM_REASON,
                                        p_PROGRAM_ID,
                                        p_INSERT_DATE,
                                        p_INSERT_USER
                                     );
         else
                return_status := c12_allow_mulN; /* check specs C.1.2 */
         end if;
         return return_status;
     Exception
         when others then
              return 'Errt16. SQL failed on don_inter_temp'||
                      substr(sqlerrm,1,100);
     End;
  END; /* function call_upm_flagN ends */

  /* this function is called from call_upm_flagY
     D.2 function coded  */
  FUNCTION insert_action_inter(p_int_on       IN     varchar2)
    RETURN varchar2
    IS
    s_upm_flag                    varchar2(1);
    s_allow_multiple              varchar2(1);
    s_period_type                 varchar2(5);
    s_period_number               number;
    s_inter_type                  varchar2(5);
    s_deferral_flag               varchar2(1);
    s_fixed_period                varchar2(1);
    s_minimum_period              number;
    s_inter_owner                 varchar2(1);
    s_donor_inter_code            varchar2(5);
    ret_stat                      varchar2(250);
    old_term_date                 date;
    max_term_date                 date;
    old_rowid                     rowid;
    l_note_id                     varchar2(10);
    final_term_date               date;
    chk_count                     number;
    t_upm_disposition             varchar2(1);
  BEGIN
     Begin
        Select  nvl(upm_flag,'N'),nvl(allow_multiple,'N'),period_type,
                period_number,inter_type,deferral_flag,fixed_period,
                minimum_period,inter_owner,donor_inter_code
        into    s_upm_flag,s_allow_multiple,s_period_type,s_period_number,
                s_inter_type,s_deferral_flag,s_fixed_period,s_minimum_period,
                s_inter_owner,s_donor_inter_code
        from valid_interdictions
        where  inter_code = p_int_on and
               p_sysdate between eff_date and nvl(term_date,p_sysdate+1);
     Exception
        when no_data_found then
                return 'Errt23. Inter Code not defined '||
                             substr(sqlerrm,1,100);
        when too_many_rows then
                return 'Errt24. Too many rows in valid interdictions '||
                             substr(sqlerrm,1,100);
        when others then
                return 'Errt25. SQL failed '||substr(sqlerrm,1,100);
     End;
    /* check if this intercode already exists  on the donor */
     /* assumption allow_multiple is N so if exists terminate and insert*/
    Begin
       Select count(*) into chk_count
         from don_inter_temp
        where donor_id = p_donor_id and
              decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
              inter_code = p_int_on and
              p_sysdate between eff_date and nvl(term_date,p_sysdate+1);
    Exception
       When others then
            return 'Errt26. SQL failed '||substr(sqlerrm,1,100);
    End;
    if chk_count > 0 then
       /* get the old_term_date and then update ,terminate */
       begin
          select term_date,rowid
            into old_term_date,old_rowid
            from don_inter_temp
            where donor_id = p_donor_id and
                  decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                  inter_code = p_int_on and
                  nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                  nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                  nvl(group_id,' ') = nvl(p_group_id,' ') and
                  nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                  p_sysdate between eff_date and nvl(term_date,p_sysdate+1);
       exception
            When others then
                return 'Errt27. Unalbe to get single termdate '||
                       substr(sqlerrm,1,100);
       end;
       begin
          UPDATE DON_INTER_TEMP SET
              term_date = p_sysdate,
              release_date = p_sysdate,
              term_reason = 'UPGRD',
            release_user = decode(substr(LT_USER_SESSION.get_userid,1,4), 'OPS$', substr(LT_USER_SESSION.get_userid,5,6),
                                                            substr(LT_USER_SESSION.get_userid,1,6))
          WHERE
              rowid = old_rowid;
       exception
          When others then
              return 'Errt28. Unable to terminate in doninter_temp'||
                      substr(sqlerrm,1,100);
       end;
    end if; /* chk_count > o condition ends */
   /* now insert in don_inter_temp */
    compute_term_date(p_sysdate,s_fixed_period,
                               s_period_type ,
                               s_period_number,
                               s_minimum_period,
                               p_eff_date ,
                               p_term_date     ,
                               final_term_date ,
                               ret_stat );
    if substr(ret_stat,1,2) != 'OK' then   /* to debug compute_term_date */
           return ret_stat;
    end if;
    /* compute max term date */
    if chk_count > 0 then
      max_term_date := compute_max_date(old_term_date,final_term_date);
    else
      max_term_date := final_term_date;
    end if;
    /* insert a row in donor_interdiction with max term date */
    /* check if code to be placed is source or derived */
    select decode(p_int_on,p_inter_code,'S','D')
      into t_upm_disposition
      from dual;
    ret_stat := insert_don_inter_temp(
                                     p_DONOR_ID,
                                     p_CHAPTER_ID,
                                     p_RUN_ID,
                                     p_int_on,      --p_INTER_CODE,
                                     p_TRANSACTION_ID,
                                     p_NOTIFICATION_STATUS,
                                     p_NOTE_ID,
                                     p_RELEASE_USER,
                                     p_RELEASE_DATE,
                                     p_INTER_TYPE,
                                     p_UNIT_ID,
                                     t_UPM_DISPOSITION,
                                     p_LAST_MODIFIED_DATE,
                                     p_ORIGINATED_FROM,
                                     p_REASON_CODE,
                                     p_GROUP_ID,
                                     p_GROUP_MODE,
                                     p_EFF_DATE,
                                     max_term_date,        --  p_TERM_DATE,
                                     p_TERM_REASON,
                                     p_PROGRAM_ID,
                                     p_INSERT_DATE,
                                     p_INSERT_USER
                                     );
    return ret_stat;
  END insert_action_inter;

  /* this function is called from call_upm_flagY
     D.5 function coded  */
  FUNCTION delete_action_inter(p_int_off       IN     varchar2)
    RETURN varchar2
    IS
  BEGIN
       begin
          UPDATE DON_INTER_TEMP SET
              term_date = p_sysdate,
              release_date = p_sysdate,
              term_reason = 'UPGRD',
            release_user = decode(substr(LT_USER_SESSION.get_userid,1,4), 'OPS$', substr(LT_USER_SESSION.get_userid,5,6),
                                                            substr(LT_USER_SESSION.get_userid,1,6))
          WHERE
              donor_id = p_donor_id and
              decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
              inter_code = p_int_off and
              nvl(originated_from,' ')=nvl(p_originated_from,' ') and
              nvl(reason_code,' ')=nvl(p_reason_code,' ') and
              nvl(group_id,' ') = nvl(p_group_id,' ') and
              nvl(group_mode,' ')=nvl(p_group_mode,' ') and
              p_sysdate between eff_date and nvl(term_date,p_sysdate+1) and
              rownum < 2;  -- only one to be removed
       exception
          When others then
              return 'Errt29. Unable to terminate in doninter_temp'||
                      substr(sqlerrm,1,100);
       end;
       return 'OK';
  END delete_action_inter;

 /* this function takes care of part D.1 onwards ...
     from the req. specs. */
  FUNCTION call_upm_flagY return varchar2
    IS
    CURSOR inter_upgrade IS
       SELECT  action_inter ,action
       FROM valid_inter_upgrades
       WHERE source_inter = p_inter_code and
             exist_inter IN
                      ( Select distinct inter_code
                          from don_inter_temp
                         where donor_id = p_donor_id and
                               decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                               (p_sysdate between eff_date and
                                 nvl(term_date,p_sysdate+1) ) ) and
             p_sysdate between eff_date and nvl(term_date,p_sysdate+1)
                  -- the then validation data 
       ORDER BY action;    -- first places all inter and then terminates
    tmp_status         varchar2(250);
    final_term_date    date;
    l_note_id          varchar2(10);
    cur_open_flag      varchar2(1);
  BEGIN   /* call_upm_flagY main program */
      if pg_allow_multiple = 'Y' then
          return 'Errt22. This is limitation! upm_flag Y and allow_mul Y';
      end if;
      /* D.1 insert source inter in inter transaction table */
      compute_term_date(p_sysdate,pg_fixed_period,
                                 pg_period_type ,
                                 pg_period_number,
                                 pg_minimum_period,
                                 p_eff_date ,
                                 p_term_date     ,
                                 final_term_date ,
                                 tmp_status );
      if substr(tmp_status,1,2) != 'OK' then   /* to debug compute_term_date */
           return tmp_status;
      end if;
      cur_open_flag  := 'N';
      FOR c1 IN inter_upgrade LOOP
          tmp_status := NULL;
          if c1.action = 'P' then    /* D.2 tec specs */
                tmp_status := insert_action_inter(c1.action_inter);
                if tmp_status != 'OK' then
                    return tmp_status;
                end if;
          elsif c1.action = 'R' then /* D.5 tec specs */
                tmp_status := delete_action_inter(c1.action_inter);
                if tmp_status != 'OK' then
                    return tmp_status;
                end if;
          end if;
          cur_open_flag := 'Y';
      END LOOP;
      if cur_open_flag = 'N' then
          tmp_status := insert_action_inter(p_inter_code);
          if tmp_status != 'OK' then
              return tmp_status;
          end if;
      end if;
      return 'OK';
  END; /* function call_upm_flagY ends */

 BEGIN /* main of inter_temp_place */
  return_status := local_validate_parameters(p_inter_code);
  if return_status != 'OK' then
      p_status := return_status;
      return;
  end if;
  /* B.0 check for upm_flag */
  /* C.0 call if upm_flag is N */
   if pg_upm_flag = 'N' then
         return_status := call_upm_flagN;
         if return_status != 'OK' then
                 p_status := return_status;
                 return;
         end if;
   end if;
   /* D.0 call if upm_flag is Y */
   if pg_upm_flag = 'Y' then
         return_status := call_upm_flagY;
         if return_status != 'OK' then
                 p_status := return_status;
                 return;
         end if;
   end if;
   p_status := return_status;
 END inter_temp_place;
/* ++++++++++++++++++++++ inter_tempplace ends +++++++++++++++++++ */

/*  
---#######################################################################
    Program Name        : INTER_UPGRADE_PLACE
    Date Creation       : 11-13-97
    Program Author      : Chandra
---#######################################################################
*/

/* Name : INTER_UPGRADE_PLACE
 -----------------------------------------------------------------------
 Desc:This procedure is called to place an interdiction code on the donor.
      This procedure takes care of all the various possibilities like
      upgrading the interdiction, placing of multiple interdictions etc.
 Inp: p_donor_id,p_inter_code,user_id,program_id,incident_date,comments
      + check the parameters below
 Out: populates donor_interdiction table and may populate inter_transaction
      table, comments are stored in central_notes.
      p_status is OK if successfully validated else contains error.
 Err: from Err16 to Err29
 -----------------------------------------------------------------------
 */
 PROCEDURE inter_upgrade_place
                        (P_DONOR_ID             IN      VARCHAR2,
                         P_CHAPTER_ID           IN      VARCHAR2,
                         P_UNIT_ID              IN      VARCHAR2,
                         P_TRANSACTION_ID       IN      VARCHAR2,
                         P_INTER_CODE           IN      VARCHAR2,
                         P_ORIGINATED_FROM      IN      VARCHAR2,
                         P_REASON_CODE          IN      VARCHAR2,
                         P_USER_ID              IN      VARCHAR2,
                         P_GROUP_MODE           IN      VARCHAR2,
                         P_GROUP_ID             IN      VARCHAR2,
                         P_PROGRAM_ID           IN      VARCHAR2 ,
                         P_INCIDENT_DATE        IN      DATE   ,
                         P_TERM_DATE            IN      DATE   ,
                         P_COMMENTS             IN      VARCHAR2 ,
                         P_STATUS               OUT     VARCHAR2
                         )
 IS
    /* local global declarations */
    l_status            varchar2(250);
    return_status       varchar2(250);
    t_chp_id		varchar2(4);

 /* Function place_inter_c11 called from call_upm_flagN function */
 /* called when inter_code does not exists on donor */
  FUNCTION place_inter_c11 RETURN VARCHAR2
  IS
    ret_stat         varchar2(250);
    final_term_date  date;
    l_note_id        varchar2(10);
  BEGIN
    compute_term_date(g_sysdate,g_fixed_period,
                               g_period_type ,
                               g_period_number,
                               g_minimum_period,
                               p_incident_date ,
                               p_term_date     ,
                               final_term_date ,
                               ret_stat );
    if substr(ret_stat,1,2) != 'OK' then   /* to debug compute_term_date */
         return ret_stat;
    end if;
    insert_in_donor_inter(          p_DONOR_ID,
                                    p_CHAPTER_ID,
                                    p_INTER_CODE,
                                    p_incident_date,
                                    g_INTER_TYPE ,
                                    p_TRANSACTION_ID,
                                    null,           --NOTIFICATION_STATUS
                                    p_comments ,    --NOTE_ID
                                    p_UNIT_ID  ,
                                    null  ,         --UPM_DISPOSITION
                                    p_ORIGINATED_FROM  ,
                                    p_REASON_CODE     ,
                                    p_GROUP_ID       ,
                                    null         ,    --LETTER_SEQ_NO
                                    p_GROUP_MODE ,
                                    final_term_date  , --TERM_DATE
                                    p_PROGRAM_ID   ,
                                    g_sysdate     ,         --INSERT_DATE
                                    p_user_id    ,          --INSERT_USER
                                    l_note_id,            -- out parameter
                                    ret_stat);            -- out parameters
    if ret_stat != 'OK' then
         return ret_stat;
    end if;
    /* only inter_type of INTER,HOLDS,SURV should go in tran table
       and allow multiple is N should go in transaction table */
    if g_inter_type != 'INFOR' and  g_inter_type != 'DR' and
       g_allow_multiple = 'N' then
              insert_in_inter_tran( p_DONOR_ID,
                                    p_CHAPTER_ID,
                                    p_INTER_CODE,
                                    p_incident_date,
                                    g_INTER_TYPE ,
                                    p_TRANSACTION_ID,
                                    null,           --NOTIFICATION_STATUS
                                    l_NOTE_ID,      -- previous computed
                                    p_UNIT_ID  ,
                                    null  ,         --UPM_DISPOSITION
                                    p_ORIGINATED_FROM  ,
                                    p_REASON_CODE     ,
                                    p_GROUP_ID       ,
                                    null         ,     --LETTER_SEQ_NO
                                    p_GROUP_MODE ,
                                    final_term_date  , --TERM_DATE
                                    p_PROGRAM_ID   ,
                                    g_sysdate     ,         --INSERT_DATE
                                    p_user_id    ,          --INSERT_USER
                                    ret_stat);            -- out parameters
         if ret_stat != 'OK' then
              return ret_stat;
         end if;
    end if;
    return 'OK';
  END place_inter_c11;

  FUNCTION c12_allow_mulY return varchar2 /* sub function of place_inter_c12*/
      IS                                     /* i.e C.1.2.1  clause */
      ret_stat         varchar2(250);
      final_term_date  date;
      l_note_id        varchar2(10);
  BEGIN
      compute_term_date(g_sysdate,g_fixed_period,
                               g_period_type ,
                               g_period_number,
                               g_minimum_period,
                               p_incident_date ,
                               p_term_date     ,
                               final_term_date ,
                               ret_stat );
      if substr(ret_stat,1,2) != 'OK' then   /* to debug compute_term_date */
           return ret_stat;
      end if;
      insert_in_donor_inter(       p_DONOR_ID,
                                    p_CHAPTER_ID,
                                    p_INTER_CODE,
                                    p_incident_date,
                                    g_INTER_TYPE ,
                                    p_TRANSACTION_ID,
                                    null,           --NOTIFICATION_STATUS
                                    p_comments ,    --NOTE_ID
                                    p_UNIT_ID  ,
                                    null  ,         --UPM_DISPOSITION
                                    p_ORIGINATED_FROM  ,
                                    p_REASON_CODE     ,
                                    p_GROUP_ID       ,
                                    null         ,    --LETTER_SEQ_NO
                                    p_GROUP_MODE ,
                                    final_term_date  , --TERM_DATE
                                    p_PROGRAM_ID   ,
                                    g_sysdate     ,         --INSERT_DATE
                                    p_user_id    ,          --INSERT_USER
                                    l_note_id,            -- out parameter
                                    ret_stat);            -- out parameters
      return ret_stat;
  END c12_allow_mulY;    /* sub function ends */

  FUNCTION c12_allow_mulN return varchar2 /* sub function of place_inter_c12*/
     IS                                       /* i.e C.1.2.2  clause*/
       ret_stat         varchar2(250);
       final_term_date  date;
       old_term_date    date;
       max_term_date    date;
       l_note_id        varchar2(10);
       old_rowid        rowid;
  BEGIN
       compute_term_date(g_sysdate,g_fixed_period,
                               g_period_type ,
                               g_period_number,
                               g_minimum_period,
                               p_incident_date ,
                               p_term_date     ,
                               final_term_date ,
                               ret_stat );
      if substr(ret_stat,1,2) != 'OK' then   /* to debug compute_term_date */
           return ret_stat;
      end if;
      begin     /* get the term date of existing interdiction */
          select term_date,rowid
            into old_term_date,old_rowid
            from donor_interdictions
           where donor_id = p_donor_id and
                 inter_code = p_inter_code and
                 nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                 nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                 nvl(group_id,' ') = nvl(p_group_id,' ') and
                 nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                 (term_date is null or term_date > p_incident_date) and
              --(term_date is null or term_date > eff_date) and for SCR:175209
              --g_sysdate between eff_date and nvl(term_date,g_sysdate+1) and
                 rownum < 2;
      exception
          when others then
             return 'Err20. Inter code does not exits '||substr(sqlerrm,1,100);
      end;
      /* compute max term date */
      max_term_date := compute_max_date(old_term_date,final_term_date);
     /* insert a row in donor_interdiction with max term date */
      insert_in_donor_inter(        p_DONOR_ID,
                                    p_CHAPTER_ID,
                                    p_INTER_CODE,
                                    p_incident_date,
                                    g_INTER_TYPE ,
                                    p_TRANSACTION_ID,
                                    null,           --NOTIFICATION_STATUS
                                    p_comments ,    --NOTE_ID
                                    p_UNIT_ID  ,
                                    null  ,         --UPM_DISPOSITION
                                    p_ORIGINATED_FROM  ,
                                    p_REASON_CODE     ,
                                    p_GROUP_ID       ,
                                    null         ,    --LETTER_SEQ_NO
                                    p_GROUP_MODE ,
                                    max_term_date  , --TERM_DATE
                                    p_PROGRAM_ID   ,
                                    g_sysdate     ,         --INSERT_DATE
                                    p_user_id    ,          --INSERT_USER
                                    l_note_id,            -- out parameter
                                    ret_stat);            -- out parameters
      if ret_stat != 'OK' then
            return ret_stat;
      end if;
    /* Terminate the old inter code as only one should be effective */
       begin
         UPDATE DONOR_INTERDICTIONS SET
            term_date = g_sysdate,
            release_date = g_sysdate,
            term_reason = 'UPGRD',
            release_user = decode(substr(LT_USER_SESSION.get_userid,1,4),
                           'OPS$', substr(LT_USER_SESSION.get_userid,5,6),
                           substr(LT_USER_SESSION.get_userid,1,6))
         WHERE rowid = old_rowid;
       exception
         when others then
           return 'Err21. Cannot update donor interdiction'||
                   substr(sqlerrm,1,100);
       end;
     /* only inter_type of INTER,HOLDS,SURV should go in tran table */
      if g_inter_type != 'INFOR' and  g_inter_type != 'DR' then
           insert_in_inter_tran(    p_DONOR_ID,
                                    p_CHAPTER_ID,
                                    p_INTER_CODE,
                                    p_incident_date,
                                    g_INTER_TYPE ,
                                    p_TRANSACTION_ID,
                                    null,           --NOTIFICATION_STATUS
                                    l_NOTE_ID,      -- previous computed
                                    p_UNIT_ID  ,
                                    null  ,         --UPM_DISPOSITION
                                    p_ORIGINATED_FROM  ,
                                    p_REASON_CODE     ,
                                    p_GROUP_ID       ,
                                    null         ,     --LETTER_SEQ_NO
                                    p_GROUP_MODE ,
                                    final_term_date  , --TERM_DATE
                                    p_PROGRAM_ID   ,
                                    g_sysdate     ,         --INSERT_DATE
                                    p_user_id    ,          --INSERT_USER
                                   ret_stat);            -- out parameters
          if ret_stat != 'OK' then
              return ret_stat;
          end if;
      end if;     /* inserted in tran table */
      return 'OK';
  END c12_allow_mulN;    /*  function ends */

/* Function place_inter_c11 called from call_upm_flagN function */
 /* called when inter_code do exists on donor */
  FUNCTION place_inter_c12 RETURN VARCHAR2
  IS
    pret_stat           varchar2(250);
  BEGIN /* function place_inter_c12 main program */
    if g_allow_multiple = 'Y' then
        pret_stat := c12_allow_mulY;
    end if;
    if g_allow_multiple = 'N' then
        pret_stat := c12_allow_mulN;
    end if;
    return pret_stat;
  END place_inter_c12;

/* this function takes care of part C.0 onwards ...
     from the req. specs. */
  FUNCTION call_upm_flagN return varchar2
  IS
  return_status       varchar2(250);
  chk_count           number;
  BEGIN
     /* C.1 check if intercode already exists */
     Begin
         Select count(*) into chk_count
           from donor_interdictions
          where donor_id = p_donor_id and
                chapter_id = p_chapter_id and
               inter_code = p_inter_code and
                 nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                 nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                 nvl(group_id,' ') = nvl(p_group_id,' ') and
                 nvl(group_mode,' ')=nvl(p_group_mode,' ') and
               (term_date is null or term_date > p_incident_date); --SCR:175209
               --(term_date is null or term_date > eff_date);
               --g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
         if chk_count = 0 then
                               /* C.1.1 interdiction is not effective */
                return_status := place_inter_c11; /*check specs C.1.1 */
         else
                return_status := place_inter_c12; /* check specs C.1.2 */
         end if;
         return return_status;
     Exception
         when others then
              return 'Err16. SQL failed on donor_interdictions'||
                      substr(sqlerrm,1,100);
     End;
  END; /* function call_upm_flagN ends */

  /* this function is called from call_upm_flagY
     D.2 function coded  */
  FUNCTION insert_action_inter(p_int_on       IN     varchar2)
    RETURN varchar2
    IS
    s_upm_flag                    varchar2(1);
    s_allow_multiple              varchar2(1);
    s_period_type                 varchar2(5);
    s_period_number               number;
    s_inter_type                  varchar2(5);
    s_deferral_flag               varchar2(1);
    s_fixed_period                varchar2(1);
    s_minimum_period              number;
    s_inter_owner                 varchar2(1);
    s_donor_inter_code            varchar2(5);
    ret_stat                      varchar2(250);
    old_term_date                 date;
    max_term_date                 date;
    old_rowid                     rowid;
    l_note_id                     varchar2(10);
    final_term_date               date;
    chk_count                     number;
    t_upm_disposition             varchar2(1);
  BEGIN
     Begin
        Select  nvl(upm_flag,'N'),nvl(allow_multiple,'N'),period_type,
                period_number,inter_type,deferral_flag,fixed_period,
                minimum_period,inter_owner,donor_inter_code
        into    s_upm_flag,s_allow_multiple,s_period_type,s_period_number,
                s_inter_type,s_deferral_flag,s_fixed_period,s_minimum_period,
                s_inter_owner,s_donor_inter_code
        from valid_interdictions
        where  inter_code = p_int_on and
               g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
     Exception
        when no_data_found then
                return 'Err23. Inter Code not defined '||
                             substr(sqlerrm,1,100);
        when too_many_rows then
                return 'Err24. Too many rows in valid interdictions '||
                             substr(sqlerrm,1,100);
        when others then
                return 'Err25. SQL failed '||substr(sqlerrm,1,100);
     End;
    /* check if this intercode already exists  on the donor */
     /* assumption allow_multiple is N so if exists terminate and insert*/ 
    Begin
       Select count(*) into chk_count
         from donor_interdictions
        where donor_id = p_donor_id and
              chapter_id = p_chapter_id and     
              inter_code = p_int_on and
             (term_date is null or 
               term_date > nvl(p_incident_date,g_sysdate+1)); --SCR:175209
             --(term_date is null or term_date > eff_date);
              --g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
    Exception
       When others then
            return 'Err26. SQL failed '||substr(sqlerrm,1,100);
    End;
    if chk_count > 0 then
       /* get the old_term_date and then update ,terminate */
       Begin
          select term_date,rowid
            into old_term_date,old_rowid
            from donor_interdictions
            where donor_id = p_donor_id and
                  chapter_id = p_chapter_id and
                 inter_code = p_int_on and
                 nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                 nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                 nvl(group_id,' ') = nvl(p_group_id,' ') and
                 nvl(group_mode,' ')=nvl(p_group_mode,' ') and
               (term_date is null or 
                  term_date > nvl(p_incident_date,g_sysdate+1)); --SCR:175209
               ---(term_date is null or term_date > eff_date); --4.7
                 --g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
       Exception
             -- the below exception was added for IM: 58 06/02/15
          When too_many_rows then
             begin 
               select term_date,rowid
                into old_term_date,old_rowid
                from donor_interdictions
                where donor_id = p_donor_id and
                chapter_id = p_chapter_id and
                inter_code = p_int_on and
                nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                nvl(group_id,' ') = nvl(p_group_id,' ') and
                nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                term_date is null and rownum=1; 
              exception when others then 
                 return 'Err27.0 Unalbe to get termdate '||
                 substr(sqlerrm,1,100);
               end;

          When others then 
              return 'Err27. Unalbe to get single termdate '||
                     substr(sqlerrm,1,100);
       End;

       begin
          UPDATE DONOR_INTERDICTIONS SET
              term_date = g_sysdate,
              release_date = g_sysdate,
              term_reason = 'UPGRD',
            release_user = decode(substr(LT_USER_SESSION.get_userid,1,4),
             'OPS$', substr(LT_USER_SESSION.get_userid,5,6),
              substr(LT_USER_SESSION.get_userid,1,6))
          WHERE
              rowid = old_rowid;
       exception
          When others then
              return 'Err28. Unable to terminate in donor interdiction'||
                      substr(sqlerrm,1,100);
       end;
    end if; /* chk_count > o condition ends */
   
   /* now insert in donor interdictions */
    compute_term_date(g_sysdate,s_fixed_period,
                               s_period_type ,
                               s_period_number,
                               s_minimum_period,
                               p_incident_date ,
                               p_term_date     ,
                               final_term_date ,
                               ret_stat );
    if substr(ret_stat,1,2) != 'OK' then   /* to debug compute_term_date */
           return ret_stat;
    end if;
    /* compute max term date */
    if chk_count > 0 then
          max_term_date := compute_max_date(old_term_date,final_term_date);
    else
          max_term_date := final_term_date;
    end if;
    /* insert a row in donor_interdiction with max term date */
    /* check if code to be placed is source or derived */
    select decode(p_int_on,p_inter_code,'S','D')
      into t_upm_disposition
      from dual;
    insert_in_donor_inter( p_DONOR_ID,
                           p_CHAPTER_ID,
                           p_int_on,
                           p_incident_date,
                           s_INTER_TYPE ,
                           p_TRANSACTION_ID,
                           null,           --NOTIFICATION_STATUS
                           p_comments ,    --NOTE_ID
                           p_UNIT_ID  ,
                           t_upm_disposition,                  --UPM_DISPOSITION
                           p_ORIGINATED_FROM  ,
                           p_REASON_CODE     ,
                           p_GROUP_ID       ,
                           null         ,    --LETTER_SEQ_NO
                           p_GROUP_MODE ,
                           max_term_date  , --TERM_DATE
                           p_PROGRAM_ID   ,
                           g_sysdate     ,         --INSERT_DATE
                           p_user_id    ,          --INSERT_USER
                           l_note_id,            -- out parameter
                           ret_stat);            -- out parameters
    return ret_stat;
  END insert_action_inter;
 
  /* this function is called from call_upm_flagY
     D.5 function coded  */
  FUNCTION delete_action_inter(p_int_off       IN     varchar2)
    RETURN varchar2
    IS
  BEGIN
       begin
          UPDATE DONOR_INTERDICTIONS SET
              term_date = g_sysdate,
              release_date = g_sysdate,
              term_reason = 'UPGRD',
            release_user = decode(substr(LT_USER_SESSION.get_userid,1,4),
            'OPS$', substr(LT_USER_SESSION.get_userid,5,6),
             substr(LT_USER_SESSION.get_userid,1,6))
          WHERE
              donor_id = p_donor_id and
              chapter_id = p_chapter_id and
              inter_code = p_int_off and
                 nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                 nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                 nvl(group_id,' ') = nvl(p_group_id,' ') and
                 nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                --g_sysdate between eff_date and nvl(term_date,g_sysdate+1) and
                (term_date is null or 
                 term_date > nvl(p_incident_date,g_sysdate+1)) and 
              rownum < 2;  -- only one to be removed
       exception
          When others then
              return 'Err29. Unable to terminate in donor interdiction'||
                      substr(sqlerrm,1,100);
       end;
       return 'OK';
  END delete_action_inter;

 /* this function takes care of part D.1 onwards ...
     from the req. specs. */
  FUNCTION call_upm_flagY return varchar2
    IS
    CURSOR inter_upgrade IS
       SELECT  action_inter ,action
       FROM valid_inter_upgrades
       WHERE source_inter = p_inter_code and
             exist_inter IN
                      ( Select distinct inter_code
                          from donor_interdictions
                         where donor_id = p_donor_id and
                               chapter_id = p_chapter_id and
                           (term_date is null or
                            term_date > nvl(p_incident_date,sysdate+1)) ) and
                            ---term_date > eff_date) ) and  SCR# 175209
                                -- nvl(term_date,sysdate+1) ) ) and 4.7.0
             sysdate between eff_date and nvl(term_date,sysdate+1)
       ORDER BY action;    -- first places all inter and then terminates
    tmp_status      varchar2(250);
    final_term_date date;
    l_note_id       varchar2(10);
    cur_open_flag                 varchar2(1);
  BEGIN   /* call_upm_flagY main program */
      if g_allow_multiple = 'Y' then
          return 'Err22. This is limitation! upm_flag Y and allow_mul Y';
      end if;
      /* D.1 insert source inter in inter transaction table */
      compute_term_date(g_sysdate,g_fixed_period,
                               g_period_type ,
                               g_period_number,
                               g_minimum_period,
                               p_incident_date ,
                               p_term_date     ,
                               final_term_date ,
                               tmp_status );
      if substr(tmp_status,1,2) != 'OK' then   /* to debug compute_term_date */
           return tmp_status;
      end if;
      generate_note (p_comments ,p_chapter_id,
                     p_program_id , p_user_id  ,
                     l_note_id   ,  tmp_status );
      if tmp_status != 'OK' then
          return tmp_status;
      end if;
      insert_in_inter_tran(         p_DONOR_ID,
                                    p_CHAPTER_ID,
                                    p_INTER_CODE,
                                    p_incident_date,
                                    g_INTER_TYPE ,
                                    p_TRANSACTION_ID,
                                    null,           --NOTIFICATION_STATUS
                                    l_NOTE_ID,      -- previous computed
                                    p_UNIT_ID  ,
                                    'S'  ,         --UPM_DISPOSITION
                                    p_ORIGINATED_FROM  ,
                                    p_REASON_CODE     ,
                                    p_GROUP_ID       ,
                                    null         ,     --LETTER_SEQ_NO
                                    p_GROUP_MODE ,
                                    final_term_date  , --TERM_DATE
                                    p_PROGRAM_ID   ,
                                    g_sysdate     ,       --INSERT_DATE
                                    p_user_id    ,        --INSERT_USER
                                    tmp_status);          -- out parameters
      if tmp_status != 'OK' then
           return tmp_status;
      end if;
      cur_open_flag  := 'N';
      FOR c1 IN inter_upgrade LOOP
          tmp_status := NULL;
          if c1.action = 'P' then    /* D.2 tec specs */
                tmp_status := insert_action_inter(c1.action_inter);
                if tmp_status != 'OK' then
                   return tmp_status;
                end if;
          elsif c1.action = 'R' then /* D.5 tec specs */
                tmp_status := delete_action_inter(c1.action_inter);
                if tmp_status != 'OK' then
                   return tmp_status;
                end if;
          end if;
          cur_open_flag := 'Y';
      END LOOP;
      if cur_open_flag = 'N' then
          tmp_status := insert_action_inter(p_inter_code);
          if tmp_status != 'OK' then
              return tmp_status;
          end if;
      end if;
      return 'OK';
  END; /* function call_upm_flagY ends */
 
 BEGIN /* main of inter_upgrade_place */
   -- Added by Kishore on 05/03/2011. IM 5421
   begin
     select	nvl(time_zone_enabled, 'N')  
       into v_timezone_active
       from	lt_application_config;
   exception
     when others then
       p_status := 'Err100. Time Zone not found' || substr(sqlerrm, 1, 100);
   end;

   begin
     select chapter_id
       into t_chp_id
       from system_users
      where user_id = p_user_id;
   exception
     when others then
       p_status := 'Err101. Chapter not found' || substr(sqlerrm, 1, 100);
   end;

   if v_timezone_active = 'Y' then
     Lifetrack_timezone_convert.get_local_time(t_chp_id, sysdate, 
                                v_local_sysdate);
   else
     v_local_sysdate := sysdate;
   end if;
   -- End of change

   --g_sysdate := to_date(to_char(sysdate,'MM-DD-YYYY HH24:MI:SS'),
   --                      'MM-DD-YYYY HH24:MI:SS'); commented by Edwin 

  g_sysdate := to_date(to_char(v_local_sysdate,'MM-DD-YYYY HH24:MI:SS'),
                              'MM-DD-YYYY HH24:MI:SS');
 
   
   /* A.0 general validation and populating the global variables */
   validate_parameters (
                           p_donor_id ,
                           p_chapter_id,
                           p_inter_code,
                           p_user_id  ,
                           p_program_id,
                           p_incident_date,
                           l_status
                           );
   if l_status != 'OK' then
         p_status := l_status;
         return;
   end if;
  /* B.0 check for upm_flag */
  /* C.0 call if upm_flag is N */
   if g_upm_flag = 'N' then
         return_status := call_upm_flagN;
         if return_status != 'OK' then
                 p_status := return_status;
                 return;
         end if;
   end if;
   /* D.0 call if upm_flag is Y */
   if g_upm_flag = 'Y' then
         return_status := call_upm_flagY;
         if return_status != 'OK' then
                 p_status := return_status;
                 return;
         end if;
   end if;
   p_status := return_status;
 END inter_upgrade_place;
/* ++++++++++++++++++++++ inter_upgrade_place ends +++++++++++++++++++ */


/*  
---#######################################################################
    Program Name        : INTER_UPGRADE_REMOVE
    Date Creation       : 11-20-97
    Program Author      : Chandra
---#######################################################################
*/
/* Name : INTER_UPGRADE_REMOVE
   Created : 11-11-97
 -----------------------------------------------------------------------
 Desc:This procedure is called to remove an interdiction code on the donor.
      This procedure takes care of all the various possibilities like
      down_grading the interdiction.
 Inp: p_donor_id,p_inter_code,user_id,program_id,incident_date,comments
      + check the parameters below
 Out: populates donor_interdiction table and may populate inter_transaction
      table, comments are stored in central_notes.
      p_status is OK if successfully completes else contains error.
 Err: from Err30 to Err?
 -----------------------------------------------------------------------
 */
 PROCEDURE inter_upgrade_remove
                (
                  p_DONOR_ID          IN               VARCHAR2,
                  p_CHAPTER_ID        IN               VARCHAR2,
                  P_UNIT_ID           IN               VARCHAR2,
                  P_TRANSACTION_ID    IN               VARCHAR2,
                  P_INTER_CODE        IN               VARCHAR2,
                  P_ORIGINATED_FROM   IN               VARCHAR2,
                  P_REASON_CODE       IN               VARCHAR2,
                  P_USER_ID           IN               VARCHAR2,
                  P_GROUP_MODE        IN               VARCHAR2,
                  P_GROUP_ID          IN               VARCHAR2,
                  P_PROGRAM_ID        IN               VARCHAR2,
                  P_INCIDENT_DATE     IN               DATE,
                  p_INSERT_DATE       IN OUT           DATE,
                  P_TERM_DATE         IN               DATE,
                  P_TERM_REASON       IN               VARCHAR2,
                  P_COMMENTS          IN               VARCHAR2,
                  P_STATUS            OUT              VARCHAR2
                        )
 IS
   l_status        varchar2(250); 
   return_status   varchar2(250);
   l_note_id       varchar2(10);
   t_chp_id        varchar2(4);

   CURSOR di_cur IS SELECT * FROM DONOR_INTERDICTIONS;
   CURSOR dit_cur IS SELECT * FROM DON_INTER_TEMP;
   TYPE di_table_type IS TABLE OF di_cur%ROWTYPE
           INDEX BY BINARY_INTEGER;

   FUNCTION delete_from_donor_inter
                             ( d_inter_code       IN     varchar2,
                               d_originated_from  IN     varchar2,
                               d_reason_code      IN     varchar2,
                               d_group_id         IN     varchar2,
                               d_group_mode       IN     varchar2,
                               d_note_id          IN     varchar2,
                               d_comments         IN     varchar2,
                               d_term_reason      IN     varchar2,
                               d_insert_date      IN     date
                             ) RETURN varchar2
   IS
   t_note_id         varchar2(10);
   t_inter_type      donor_interdictions.inter_type%type; -- Added by Kishore on 08/13/2014. SCR 20277
   t_status          varchar2(250);
   BEGIN
       begin
          select note_id, inter_type -- Added "inter_type" by Kishore on 08/13/2014. SCR 20277
            into t_note_id, t_inter_type -- Added "t_inter_type" by Kishore on 08/13/2014. SCR 20277
            from donor_interdictions
            where donor_id = p_donor_id and
                  decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                  inter_code = d_inter_code and
                  nvl(originated_from,' ')=nvl(d_originated_from,' ') and
                  nvl(reason_code,' ')=nvl(d_reason_code,' ') and
                  nvl(group_id,' ') = nvl(d_group_id,' ') and
                  nvl(group_mode,' ')=nvl(d_group_mode,' ') and
                  trunc(insert_date) = trunc(d_insert_date) and
                  rownum < 2;

       exception
            when others then
                return 'Err41. Inter code could not be retrieved'||
                        substr(sqlerrm,1,100);
       end;
       --t_note_id := d_note_id;  /* as t_note_id used as out parameter */
       generate_note(d_comments  ,
                     p_chapter_id ,  
                     p_program_id  ,
                     p_user_id    ,
                     t_note_id   ,
                     t_status   
                     );
       if t_status != 'OK' then
            return t_status;
       end if;

       if nvl(t_inter_type, '*') in ('INFOR', 'DR') then -- Added by Kishore on 08/13/2014. SCR 20277
         -- Added by Kishore on 08/13/2014. SCR 20277
         begin
           UPDATE DONOR_INTERDICTIONS SET
              term_date = trunc(g_sysdate),
              release_date = g_sysdate,
              term_reason = d_term_reason,
              release_user = p_user_id
           WHERE
              donor_id = p_donor_id and
              decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
              inter_code = d_inter_code and 
              nvl(originated_from,' ')=nvl(d_originated_from,' ') and
              nvl(reason_code,' ')=nvl(d_reason_code,' ') and
              nvl(group_id,' ') = nvl(d_group_id,' ') and
              nvl(group_mode,' ')=nvl(d_group_mode,' ') and
              trunc(insert_date) = trunc(d_insert_date) and
              release_date is null and
              rownum < 2;
              --g_sysdate between eff_date and nvl(term_date,g_sysdate+1); 
              --rownum < 2;  -- only one to be removed
         exception
           When others then
              return 'Err33. Unable to terminate in donor interdiction'||
                      substr(sqlerrm,1,100);
         end;
         -- End of change from Kishore on 08/13/2014
       else -- Added by Kishore on 08/13/2014. SCR 20277
         /* change by JMC 07/15/99,  added nvl in update,  commented sysdate check */
         begin
           UPDATE DONOR_INTERDICTIONS SET
              term_date = NVL(term_date, trunc(g_sysdate)),
              release_date = g_sysdate,
              term_reason = d_term_reason,
              release_user = p_user_id
           WHERE
              donor_id = p_donor_id and
              decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
              inter_code = d_inter_code and 
              nvl(originated_from,' ')=nvl(d_originated_from,' ') and
              nvl(reason_code,' ')=nvl(d_reason_code,' ') and
              nvl(group_id,' ') = nvl(d_group_id,' ') and
              nvl(group_mode,' ')=nvl(d_group_mode,' ') and
              trunc(insert_date) = trunc(d_insert_date) and
              release_date is null and
              rownum < 2;
              --g_sysdate between eff_date and nvl(term_date,g_sysdate+1); 
              --rownum < 2;  -- only one to be removed
         exception
           When others then
              return 'Err33. Unable to terminate in donor interdiction'||
                      substr(sqlerrm,1,100);
         end;
       end if; -- Added by Kishore on 08/13/2014. SCR 20277

       return 'OK';
   END delete_from_donor_inter;

   /* This procedure checks the don_inter_temp row with full table of
      donor_interdictions passed as table type to this routine.
      INP: row of don_inter_temp
         : PLSQL table of effective inter of donor_interdictions
      OUT: action_to_do: --DELETE this can not be returned (done at calling end)
                         INSERT
                         BOTH
                         NOTHING
           table_rowid:  which row to insert or delete of donor_interdictions
           c_status   :  'OK" if successfull.
   */
   PROCEDURE  local_exist_in(c2row          IN   dit_cur%ROWTYPE ,
                             do_table       IN   di_table_type,
                             action_to_do   OUT   varchar2 ,
                             table_rowid    OUT  number    ,
                             c_status       OUT  varchar2)
   IS
   BEGIN /* local exists in main program */
     FOR i IN 1..do_table.count LOOP
       if c2row.inter_code = do_table(i).inter_code and
          c2row.insert_date = do_table(i).insert_date then
              action_to_do := 'NOTHING';
              table_rowid := i;
              c_status := 'OK';
              return;
       end if;
       if c2row.inter_code = do_table(i).inter_code and
          c2row.insert_date != do_table(i).insert_date then
              action_to_do := 'BOTH';
              table_rowid := i;
              c_status := 'OK';
              return;
       end if;
     END LOOP; /* do_table count ends */
     table_rowid := NULL;
     action_to_do := 'INSERT';
     c_status := 'OK';
     return;
   END local_exist_in;

   /* COMPARE TWO TABLES
       1. donor_interdictions
       2. don_inter_temp
    The interdiction which is not present on don_inter_temp should be 
    terminated in donor interdictions table.
    The interdiction which is extra and effective in don_inter_temp
    should be placed on donor_interdictions.
    */
   FUNCTION compare_two_tables (
                               t_run_id   IN  varchar2,
                               t_upm_flag IN varchar2) RETURN VARCHAR2
   IS
     CURSOR dit_cursor IS
        SELECT * from don_inter_temp
           WHERE
              donor_id = p_donor_id and
              run_id = t_run_id and
              g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
     CURSOR di_upm IS
        SELECT di.* from donor_interdictions di,valid_interdictions vi
           WHERE
             di.inter_code = vi.inter_code and
             g_sysdate between vi.eff_date and nvl(vi.term_date,g_sysdate+1) and
             vi.upm_flag = t_upm_flag and
             vi.inter_type != 'DR' and
             vi.inter_type != 'INFOR' and
             vi.allow_multiple = 'N' and
             di.donor_id = p_donor_id and
             (di.term_date is null or
                di.term_date > nvl(p_incident_date,g_sysdate+1));  
             ---di.term_date>di.eff_date);  --SCR 175209
             --g_sysdate between di.eff_date and nvl(di.term_date,g_sysdate+1);
     CURSOR delete_cursor IS
        SELECT di.* from donor_interdictions di,valid_interdictions vi
           WHERE
             di.inter_code = vi.inter_code and
             g_sysdate between vi.eff_date and nvl(vi.term_date,g_sysdate+1) and
             vi.upm_flag = t_upm_flag and
             vi.inter_type != 'DR' and
             vi.inter_type != 'INFOR' and
             vi.allow_multiple = 'N' and
             di.donor_id = p_donor_id and
             (di.term_date is null or
                 di.term_date > nvl(p_incident_date, g_sysdate+1))
              -- di.term_date > di.eff_date) -- SCR: 175209
           --g_sysdate between di.eff_date and nvl(di.term_date,g_sysdate+1) 4.7
             and di.inter_code NOT IN 
                     (select inter_code from don_inter_temp
                       where donor_id = p_donor_id and
                        run_id = t_run_id and
                         (term_date is null or 
                           term_date > nvl(p_incident_date,g_sysdate+1)));
                             -- term_date > eff_date)); case# 175209
                             --  g_sysdate between eff_date and
                             --             nvl(term_date,g_sysdate+1)) ;
     di_table     di_table_type; 
  --   c2temp       dit_cursor%ROWTYPE;
     cnt          number;
     action_to_do varchar2(20);      
     table_rowid  number;
     c_status     varchar2(250);
     out_note_id  varchar2(10);
   BEGIN /* compare two tables main prog */
     cnt := 1;    
     FOR c1 IN di_upm LOOP
           di_table(cnt) := c1;
           cnt := cnt + 1;
     END LOOP;
     /* -populating in PLSQL table over */
     FOR c2 IN dit_cursor LOOP
        --c2temp := c2;
        local_exist_in(c2,
                       di_table,
                       action_to_do,
                       table_rowid,
                       c_status);
        if c_status != 'OK' then
            return c_status;
        end if;
        if action_to_do = 'INSERT' then
            INSERT_IN_DONOR_INTER(
                                 c2.DONOR_ID,
                                 c2.CHAPTER_ID,
                                 c2.INTER_CODE,
                                 c2.EFF_DATE,
                                 c2.INTER_TYPE,
                                 c2.TRANSACTION_ID,
                                 c2.NOTIFICATION_STATUS,
                                 p_comments,
                                 c2.UNIT_ID,
                                 c2.UPM_DISPOSITION,
                                 c2.ORIGINATED_FROM,
                                 c2.REASON_CODE,
                                 c2.GROUP_ID,
                                 c2.LETTER_SEQ_NO,
                                 c2.GROUP_MODE,
                                 c2.TERM_DATE,
                                 c2.PROGRAM_ID,   --'UP_RMOVE',      
                                 c2.INSERT_DATE,  --g_sysdate
                                 c2.INSERT_USER,   --p_user_id
                                 out_note_id,
                                 c_status);
            if c_status != 'OK' then
               return c_status;
            end if;
        end if;
        if action_to_do = 'BOTH' then
            c_status := delete_from_donor_inter
                             ( di_table(table_rowid).inter_code, 
                               di_table(table_rowid).originated_from,
                               di_table(table_rowid).reason_code,
                               di_table(table_rowid).group_id,
                               di_table(table_rowid).group_mode,
                               di_table(table_rowid).note_id,
                               p_comments,
                               di_table(table_rowid).term_reason,
                               di_table(table_rowid).insert_date
                             );
            if c_status != 'OK' then
               return c_status;
            end if;
            INSERT_IN_DONOR_INTER(
                                 c2.DONOR_ID,
                                 c2.CHAPTER_ID,
                                 c2.INTER_CODE,
                                 c2.EFF_DATE,
                                 c2.INTER_TYPE,
                                 c2.TRANSACTION_ID,
                                 c2.NOTIFICATION_STATUS,
                                 p_comments,
                                 c2.UNIT_ID,
                                 c2.UPM_DISPOSITION,
                                 c2.ORIGINATED_FROM,
                                 c2.REASON_CODE,
                                 c2.GROUP_ID,
                                 c2.LETTER_SEQ_NO,
                                 c2.GROUP_MODE,
                                 c2.TERM_DATE,
                                 c2.PROGRAM_ID,      --'UP_RMOVE',     
                                 c2.INSERT_DATE,     --g_sysdate,       
                                 c2.INSERT_USER,     --p_user_id,       
                                 out_note_id,
                                 c_status);
            if c_status != 'OK' then
               return c_status;
            end if;
        end if;
     END LOOP; /* dit cursor ends */
     FOR c3 in delete_cursor LOOP -- this is when certain interdictions are
                                 -- in donor_interdictions and not in 
                                 -- don_inter_temp;others are taken care above
            c_status := delete_from_donor_inter
                             ( c3.inter_code, 
                               c3.originated_from,
                               c3.reason_code,
                               c3.group_id,
                               c3.group_mode,
                               c3.note_id,
                               p_comments,
                               c3.term_reason,
                               c3.insert_date
                             );
            if c_status != 'OK' then
               return c_status;
            end if;
     END LOOP; /* delete cursor */
     /* remove the comments once debugging is over dddd */ 
  
    begin
       DELETE FROM DON_INTER_TEMP
             WHERE donor_id = p_donor_id;
     exception
       when others then
             null;
     end;
     di_table.DELETE;   /* delete local PL/SQL table- release memory*/
     return 'OK';
   END compare_two_tables;


/* * 
   This function works for both cases, if inter code is allowed multiple
   or not.
   INP: note_id
   OUP: returns a string OK if success else error message
*/
   FUNCTION call_upm_flagN(l_note_id IN varchar2) return varchar2
   IS
     CURSOR it_upmN_allowN IS
       Select *
         from inter_transactions
         where donor_id = p_donor_id and
               inter_code in (
                             Select inter_code
                               from valid_interdictions
                               where upm_flag = 'N' and
                                     allow_multiple = 'N' and
                                     inter_type != 'DR' and
                                     inter_type != 'INFOR' and
                                   (term_date is null or term_date>eff_date)
                                     --g_sysdate between eff_date and
                                    --         nvl(term_date,g_sysdate+1)
                             ) 
       Order by insert_date;
       tmp_status           varchar2(250);
       local_run_id         varchar2(20);
       cur_open_flag        varchar2(1);
   BEGIN
     /* case 3.1.1 i.e allow mul is Y then do following */ 
     if g_allow_multiple = 'Y' then
           return   delete_from_donor_inter(
                                            p_inter_code,
                                            p_originated_from,
                                            p_reason_code,
                                            p_group_id,
                                            p_group_mode,
                                            l_note_id,
                                            p_comments,
                                            p_term_reason,
                                            p_insert_date
                                             );
     end if;/* end allow multiple = Y case */
     local_run_id := p_user_id||to_char(g_sysdate,'HH24MISS');
     /* case 3.1.2 when allow multiple is N - rebuliding case */
     /* first delete from inter transactions */
     begin
       Delete from inter_transactions 
       where donor_id = p_donor_id and
              decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
              inter_code = p_inter_code and 
              nvl(originated_from,' ')=nvl(p_originated_from,' ') and
              nvl(reason_code,' ')=nvl(p_reason_code,' ') and
              nvl(group_id,' ') = nvl(p_group_id,' ') and
              nvl(group_mode,' ')=nvl(p_group_mode,' ') and
              trunc(insert_date) = trunc(p_insert_date);
              -- g_sysdate between eff_date and nvl(term_date,g_sysdate+1) and
              -- rownum < 2;   only one to be removed
     Exception
           when others then
               return 'Err37. Unable to delete from inter transactions '||
                       substr(sqlerrm,1,100);
     End;
     cur_open_flag := 'N';
     FOR c1 IN it_upmN_allowN LOOP
        /* place each interdiction on don_inter_temp */
           cur_open_flag := 'Y';
           inter_temp_place(
                            c1.insert_date,   -- goning as p_sysdate,
                            c1.DONOR_ID,
                            c1.CHAPTER_ID,
                            local_run_id,      -- going for c1.RUN_ID,
                            c1.INTER_CODE,
                            c1.TRANSACTION_ID,
                            c1.NOTIFICATION_STATUS,
                            c1.NOTE_ID,
                            c1.RELEASE_USER,
                            c1.RELEASE_DATE,
                            c1.INTER_TYPE,
                            c1.UNIT_ID,
                            c1.UPM_DISPOSITION,
                            c1.LAST_MODIFIED_DATE,
                            c1.ORIGINATED_FROM,
                            c1.REASON_CODE,
                            c1.GROUP_ID,
                            c1.GROUP_MODE,
                            c1.EFF_DATE,
                            c1.TERM_DATE,
                            c1.TERM_REASON,
                            c1.PROGRAM_ID,
                            c1.INSERT_DATE,
                            c1.INSERT_USER,
                            tmp_status
                           );
         if tmp_status != 'OK' then
             return tmp_status;
         end if;
     END LOOP; /* it_upmN_allowN ends */
     if cur_open_flag = 'Y' then
           return compare_two_tables(local_run_id,g_upm_flag);
     else
           return   delete_from_donor_inter(
                                            p_inter_code,
                                            p_originated_from,
                                            p_reason_code,
                                            p_group_id,
                                            p_group_mode,
                                            l_note_id,
                                            p_comments,
                                            p_term_reason,
                                            p_insert_date
                                             );
          
     end if;
    --return 'OK'; 
   END call_upm_flagN;

   FUNCTION call_upm_flagY(l_note_id    IN  VARCHAR2)
            return varchar2
   IS
     CURSOR it_upmY_allowN IS
       Select *
         from inter_transactions
         where donor_id = p_donor_id and
           inter_code in (
                         Select inter_code
                         from valid_interdictions
                         where upm_flag = 'Y' and
                         allow_multiple = 'N' and
                         inter_type != 'DR' and
                         inter_type != 'INFOR' and
                         (term_date is null or
                          term_date > nvl(p_incident_date,g_sysdate+1))
                          --- term_date > eff_date) ---SCR:175209
                              --g_sysdate between eff_date and
                               --        nvl(term_date,g_sysdate+1)
                             ) 
       Order by insert_date;
       tmp_status           varchar2(250);
       local_run_id         varchar2(20);
       cur_open_flag        varchar2(1);
   BEGIN /* main of call_upm_flagY */
     if g_allow_multiple = 'Y' then
        return 'Err40. Intercode, upm_flag=Y, allow_mul=Y cannot be handled';
     end if;
     local_run_id := p_user_id||to_char(g_sysdate,'HH24MISS');
     /* case 3.2.3 when allow multiple is N - rebuliding case */
     /* first delete from inter transactions */
     begin
       Delete from inter_transactions 
        where donor_id = p_donor_id and
              decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
              inter_code = p_inter_code and 
              nvl(originated_from,' ')=nvl(p_originated_from,' ') and
              nvl(reason_code,' ')=nvl(p_reason_code,' ') and
              nvl(group_id,' ') = nvl(p_group_id,' ') and
              nvl(group_mode,' ')=nvl(p_group_mode,' ') and
              trunc(insert_date) = trunc(p_insert_date);
              -- g_sysdate between eff_date and nvl(term_date,g_sysdate+1) and
              -- rownum < 2;   only one to be removed
     Exception
           when others then
               return 'Err41. Unable to delete from inter transactions '||
                       substr(sqlerrm,1,100);
     End;
     cur_open_flag := 'N';
     FOR c1 IN it_upmY_allowN LOOP
        /* place each interdiction on don_inter_temp */
           cur_open_flag := 'Y';
           inter_temp_place(
                            c1.insert_date,   -- goning as p_sysdate,
                            c1.DONOR_ID,
                            c1.CHAPTER_ID,
                            local_run_id,      -- going for c1.RUN_ID,
                            c1.INTER_CODE,
                            c1.TRANSACTION_ID,
                            c1.NOTIFICATION_STATUS,
                            c1.NOTE_ID,
                            c1.RELEASE_USER,
                            c1.RELEASE_DATE,
                            c1.INTER_TYPE,
                            c1.UNIT_ID,
                            c1.UPM_DISPOSITION,
                            c1.LAST_MODIFIED_DATE,
                            c1.ORIGINATED_FROM,
                            c1.REASON_CODE,
                            c1.GROUP_ID,
                            c1.GROUP_MODE,
                            c1.EFF_DATE,
                            c1.TERM_DATE,
                            c1.TERM_REASON,
                            c1.PROGRAM_ID,
                            c1.INSERT_DATE,
                            c1.INSERT_USER,
                            tmp_status
                           );
         if tmp_status != 'OK' then
             return tmp_status;
         end if;
     END LOOP; /* it_upmN_allowN ends */
     if cur_open_flag = 'Y' then
           return compare_two_tables(local_run_id,g_upm_flag);
     else
           return   delete_from_donor_inter(
                                            p_inter_code,
                                            p_originated_from,
                                            p_reason_code,
                                            p_group_id,
                                            p_group_mode,
                                            l_note_id,
                                            p_comments,
                                            p_term_reason,
                                            p_insert_date
                                             );
          
     end if;
     return 'OK'; 
   END call_upm_flagY;

   /* this function is for local validation which populates the
      p_insert_date if it is passed as null
      */
   FUNCTION local_validation_for_remove(l_note_id out varchar2)
            RETURN varchar2
   IS
   BEGIN
     if g_term_reason_req = 'Y' and p_term_reason is null then
         return 'Err49. Term reason can not be null.';
     end if;
     /* local insert_date check */
     if p_insert_date is null then
        begin
           SELECT insert_date INTO p_insert_date
             FROM DONOR_INTERDICTIONS
            WHERE donor_id = p_donor_id and
                  inter_code = p_inter_code and
                  decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                  nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                  nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                  nvl(group_id,' ') = nvl(p_group_id,' ') and
                  nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                 (term_date is null or 
                   --term_date > eff_date) and  for SCR:175209
                   term_date > nvl(p_incident_date,g_sysdate+1)) and
                 --g_sysdate between eff_date and nvl(term_date,g_sysdate+1) and
                  release_date is null       --Edwin PR#001.032812
                  and rownum < 2;
        exception
            when others then
                begin
                  SELECT max(insert_date) INTO p_insert_date
                    FROM INTER_TRANSACTIONS
                   WHERE donor_id = p_donor_id and
                         inter_code = p_inter_code and
                         decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                         nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                         nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                         nvl(group_id,' ') = nvl(p_group_id,' ') and
                         nvl(group_mode,' ')=nvl(p_group_mode,' '); 
                exception
                    when others then
                        return 'Err50. Can not get correct insert_date.'||
                               substr(sqlerrm,1,100);
                end; /* inside no data found */
        end; /* donor interdiction select ends */
     end if; /* p_insert date if null ends */
     /* check if intercode is effective on donor */
     /* changed by JMC,  07/15/99 commented sysdate check */
     if g_allow_multiple = 'Y' then
        declare
          t_upm_disposition varchar2(1);
        begin
          SELECT upm_disposition,note_id
            INTO t_upm_disposition,l_note_id
            FROM donor_interdictions
           WHERE donor_id = p_donor_id and
                inter_code = p_inter_code and
                decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                nvl(group_id,' ') = nvl(p_group_id,' ') and
                nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                trunc(insert_date) = trunc(p_insert_date) and
                release_date is null and
                rownum < 2;
                ---g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
           if t_upm_disposition = 'D' then
               return 'Err43. Derived inter code can not be removed '||
                            substr(sqlerrm,1,100);
           end if;
       exception
          when no_data_found then
             return 'Err44. Interdiction not on donor, chk insert date '||
                     substr(sqlerrm,1,100);
          when others then
             return 'Err45. inconsistent data '||
                          substr(sqlerrm,1,100);
       end;
    end if; /* allow mul check over */
   
    /* check if intercode is on inter transaction */
    if( ((g_allow_multiple = 'N' and g_upm_flag = 'N') or
         (g_allow_multiple = 'N' and g_upm_flag = 'Y' ) ) and 
         (g_inter_type NOT IN ('DR','INFOR') )  ) then
         declare
           t_upm_disposition varchar2(1);
         begin
           SELECT upm_disposition,note_id
             INTO t_upm_disposition,l_note_id
             FROM inter_transactions
            WHERE donor_id = p_donor_id and
                  inter_code = p_inter_code and
                  decode(chapter_id, 'ALL', p_chapter_id, chapter_id) = p_chapter_id and -- chapter_id = p_chapter_id and -- Changed by Kishore on 03/18/2011. IM 4903
                  nvl(originated_from,' ')=nvl(p_originated_from,' ') and
                  nvl(reason_code,' ')=nvl(p_reason_code,' ') and
                  nvl(group_id,' ') = nvl(p_group_id,' ') and
                  nvl(group_mode,' ')=nvl(p_group_mode,' ') and
                  trunc(insert_date) = trunc(p_insert_date) and
                  release_date is null and
                  rownum < 2;
                  --g_sysdate between eff_date and nvl(term_date,g_sysdate+1);
            if t_upm_disposition = 'D' then
                 return 'Err46. Derived inter code can not be removed '||
                          substr(sqlerrm,1,100);
            end if;
         exception
            when no_data_found then
               return 'Err47. Interdiction not on donor, chk insert date '||
                      substr(sqlerrm,1,100);
            when others then
               return 'Err48. inconsistent data '||
                          substr(sqlerrm,1,100);
         end;
       end if; /* allow mul check over */
       return 'OK';
   END local_validation_for_remove; 

 BEGIN /* main program of inter_upgrade-remove */
   savepoint my_point;
   g_sysdate := to_date(to_char(sysdate,'MM-DD-YYYY HH24:MI:SS'),
                         'MM-DD-YYYY HH24:MI:SS');
   /* A.0 general validation and populating the global variables */

   -- Added by Edwin 05/11/2011. IM 5421

   begin
     select     nvl(time_zone_enabled, 'N')
       into v_timezone_active
       from     lt_application_config;
   exception
     when others then
       v_timezone_active:='N';
   end;

   begin
     select chapter_id
       into t_chp_id
       from system_users
     where user_id = p_user_id;
   exception
     when others then
       p_status := 'Err101. Chapter not found' || substr(sqlerrm, 1, 100);
   end;

   if v_timezone_active = 'Y' then
     Lifetrack_timezone_convert.get_local_time(t_chp_id, sysdate,
                                v_local_sysdate);
   else
     v_local_sysdate := sysdate;
   end if;
   -- End of change

   g_sysdate := to_date(to_char(v_local_sysdate,'MM-DD-YYYY HH24:MI:SS'),
                              'MM-DD-YYYY HH24:MI:SS');

   validate_parameters ( p_donor_id ,
                           p_chapter_id,
                           p_inter_code,
                           p_user_id  ,
                           p_program_id,
                           p_incident_date,
                           l_status
                           );
   if l_status != 'OK' then
         p_status := l_status;
         rollback to my_point;
         return;
   end if;
   /* check local validation */
   l_status := local_validation_for_remove(l_note_id);
   if l_status != 'OK' then
         p_status := l_status;
         rollback to my_point;
         return;
   end if;
   if g_inter_type in ('DR','INFOR') then
           l_status := delete_from_donor_inter(
                                            p_inter_code,
                                            p_originated_from,
                                            p_reason_code,
                                            p_group_id,
                                            p_group_mode,
                                            l_note_id,
                                            p_comments,
                                            p_term_reason,
                                            p_insert_date
                                             );
           if l_status != 'OK' then
              rollback to my_point;
           end if;
           p_status := l_status;
           return;
   end if;
  /* B.0 check for upm_flag */
  /* C.0 call if upm_flag is N */
   if g_upm_flag = 'N' then
         return_status := call_upm_flagN(l_note_id);
         if return_status != 'OK' then
                 p_status := return_status;
                 rollback to my_point;
                 return;
         end if;
   end if;
   /* D.0 call if upm_flag is Y */
   if g_upm_flag = 'Y' then
         return_status := call_upm_flagY(l_note_id);
         if return_status != 'OK' then
                 p_status := return_status;
                 rollback to my_point;
                 return;
         end if;
   end if;
   p_status := return_status;
 END inter_upgrade_remove;
/* ++++++++++++++++++++INTER UPGRADE REMOVE ENDS +++++++++++++++++*/
/*  
---#######################################################################
    Program Name        : PLACE_INTER_UNIT
    Date Creation       : 10-03-97
    Program Author      : Chandra
---#######################################################################
*/
PROCEDURE place_inter_unit 
                (
                p_unit_id               IN      VARCHAR2,
                p_deferral_id           IN      VARCHAR2,
                p_coll_date             IN      DATE    ,
                p_chapter_id            IN      VARCHAR2,
                p_transaction_id        IN      VARCHAR2,
                p_inter_code            IN      VARCHAR2,
                p_originated_from       IN      VARCHAR2,
                p_reason_code           IN      VARCHAR2,
                p_source_code           IN      varchar2,
                p_user_id               IN      varchar2,
                p_group_mode            IN      varchar2,
                p_group_id              IN      VARCHAR2,
                p_program_id            IN      VARCHAR2,
                p_incident_date         IN      DATE,
                p_term_date             IN      DATE,
                p_status                OUT     VARCHAR2,
                p_comment               IN      VARCHAR2 := ' ' )
IS
--Amit B
 int_on          varchar2(5);
 int_off         varchar2(5);
 counter         number;
 cur_open_flag   varchar2(1);
 final_term_date date;
 tmp_status      varchar2(250);
 chk_status      varchar2(250);
 p_donor_id      varchar2(10);
 p_inter_type    varchar2(5);
 p_sysdate       date;
 gt_inter_type           varchar2(5);
 gt_donor_inter_code     varchar2(5);
 gt_allow_mul            varchar2(1);
 gt_fixed_period         varchar2(1);
 gt_period_type          varchar2(8);
 gt_period_number        Number;
 gt_minimum_period       Number;
 gt_term_date            Date;
 gt_upm_flag             varchar2(1);
 gt_disposition          varchar2(1);
 gt_inter_owner          varchar2(1);
 t_chp_id		varchar2(4);
 FUNCTION insert_inter_unit   
                RETURN VARCHAR2
 IS
 l_status  varchar2(250);
 final_term_date date;
 BEGIN
    compute_term_date (p_sysdate,          
                       gt_fixed_period,   
                       gt_period_type  , 
                       gt_period_number ,
                       gt_minimum_period ,
                       p_incident_date    ,
                       p_term_date         , 
                       final_term_date     ,
                       l_status            
                         );
    if substr(l_status,1,2) != 'OK' then
         return l_status;
    end if;
    begin
      select count(*) into counter 
       from donation_interdictions 
       where transaction_id =  p_transaction_id and
           coll_date = p_coll_date and
           inter_code = p_inter_code and
           nvl(originated_from,' ') = nvl(p_originated_from,' ') and
           nvl(reason_code,' ') = nvl(p_reason_code,' ') and
           nvl(group_id,' ') = nvl(p_group_id,' ') and
           nvl(group_mode,' ') = nvl(p_group_mode,' ') and
           p_sysdate between insert_date and nvl(term_date,p_sysdate+1);
    exception
        when others then
           return 'Err70. SQL Failed of donation_interdiction'||
                  substr(sqlerrm,1,100);
    end;
      if counter = 0 then
           
           Begin  /* insert into donation interdictions*/
                        insert into donation_interdictions 
                           (unit_id,coll_date,program_id,inter_code,source_code,
                           inter_type,transaction_id,
                           originated_from,reason_code,group_mode,group_id,
                          insert_user,insert_date,term_date,chapter_id,comments)                      
                        values
                           (p_unit_id,p_coll_date,p_program_id,p_inter_code,
                           p_source_code,
                           gt_inter_type,p_transaction_id,
                           p_originated_from,p_reason_code,p_group_mode,
                           p_group_id, p_user_id,p_sysdate,p_term_date,
                           p_chapter_id, p_comment);
                        
             Exception
                  When others then
                      return 'Err71. Unable to Insert in Donation Interdiction'
                                ||substr(sqlerrm,1,200);
             End;
     end if;
        /* placed interdiction */
           return 'OK';
    END; /* insert_inter unit procedure */   

 PROCEDURE validate_parameters
                ( t_status      OUT     varchar2)
 IS
 counter        number;
 x              varchar2(1);
 Begin
     if p_coll_date is null then
         t_status := 'Err60. Collection date can not be null';
         return;
     end if; 
     if p_inter_code is null then
        t_status := 'Err61. Inter Code can not be NULL';
        return;
     end if;
     if p_transaction_id is null then
        t_status := 'Err61.1 Transaction ID can not be NULL';
        return;
     end if;

     -- check for valid unit ID or Deferral ID
 
     if p_unit_id is null and
        p_deferral_id is null then
            t_status := 'Err62.1 Both Unit/Deferral ID can not be NULL';
            return;
     end if;
     if p_unit_id is not null and
        p_deferral_id is not null then
            t_status := 'Err62.2 Both Unit/Deferral ID can not be NOT NULL';
            return;
     end if;
     if p_unit_id is not null then
        Begin
           Select 'x' into x
             from donations
             where transaction_id = p_transaction_id 
               and coll_date = p_coll_date
               and unit_id = p_unit_id;
        Exception
           When no_data_found then
                t_status := 'Err62.3 Unit ID is not registered ';
                return;
           When others then
                t_status := 'Err62.4 Unit ID is not registered '||
                            substr(sqlerrm,1,50);
                return;
        End;   
     end if;    
     if p_deferral_id is not null then
        Begin
           Select 'x' into x
             from donations
             where transaction_id = p_transaction_id 
               and coll_date = p_coll_date
               and deferral_id = p_deferral_id;
        Exception
           When no_data_found then
                t_status := 'Err62.5 Deferral ID is not registered ';
                return;
           When others then
                t_status := 'Err62.6 Deferral ID is not registered '||
                            substr(sqlerrm,1,50);
                return;
        End;   
     end if;    
     if p_user_id is null then
        t_status := 'Err63. User ID can not be NULL';
        return;
     end if;    
     if p_program_id is null then
        t_status := 'Err64. Program ID can not be NULL';
        return;
     end if;    
     /*
     if  nvl(p_term_date,sysdate+1 ) < trunc(sysdate) then      
        t_status := 'Term date can not be less than sysdate';
        return;
     end if; 
     */
     begin        
         select inter_type, donor_inter_code,allow_multiple,upm_flag,
                fixed_period,period_type,period_number,minimum_period ,
                inter_owner
           into gt_inter_type, gt_donor_inter_code,gt_allow_mul,
                gt_upm_flag, gt_fixed_period,gt_period_type,
                gt_period_number,gt_minimum_period,gt_inter_owner
           from valid_interdictions 
          where inter_code = p_inter_code and           
                    --(sysdate between eff_date and nvl(term_date,sysdate+1) )
		    (v_local_sysdate between eff_date and nvl(term_date,v_local_sysdate+1) ) --Ashok; IM:5326 --05/17/2011
                    and rownum < 2 ;
     exception
         when no_data_found then
                t_status:= 'Err65. Inter code not exist'||
                       substr(sqlerrm,1,100);
                       return;
         when others then
                 t_status:=  'Err66. Inter code SQL Failed'||
                       substr(sqlerrm,1,100); 
                       return;
     end;
     if gt_inter_owner NOT IN ('U','B') then
         t_status := 'Err67. Inter code can only be placed on donor.';
         return;
     end if;
     t_status := 'OK';
 End validate_parameters;

 Procedure place_on_donor
                ( p_don_inter_code      IN      varchar2,
                  tmp_status             OUT     varchar2 )
 IS
 l_status  varchar2(250);
 Begin
      Begin
         Select donor_id into p_donor_id
         from donations
         where
                unit_id = p_unit_id and
                coll_date = p_coll_date;
      Exception
         When no_data_found then
                tmp_status := 'Err70. No unit with that trans id exist.'||
                               substr(sqlerrm,1,100);
                               return;
         When others then
                tmp_status := 'Err71. SQL on donations failed '||
                              substr(sqlerrm,1,100);
                              return;
      End;                      
        --call the stored procedure 
      if p_donor_id is not null then
         inter_upgrade_place(p_donor_id,p_chapter_id,p_unit_id,p_transaction_id,
                            p_don_inter_code,p_originated_from,
                            p_reason_code,p_user_id,p_group_mode,p_group_id,
                            p_program_id,p_incident_date,p_term_date,
                            'FROM place_inter_unit'||p_unit_id, --comments
                            l_status);
                            -- comments field passed as NULL
         if l_status != 'OK' then
                tmp_status := l_status;
                return;
         end if;
      end if;
      tmp_status := 'OK';
 End Place_on_donor;

BEGIN   /* main prog - place inter unit*/

   -- Added by Ashok on 05/17/2011. IM 5326
   begin
     select     nvl(time_zone_enabled, 'N')
       into v_timezone_active
       from     lt_application_config;
   exception
     when others then
       v_timezone_active:='N';
   end;

   begin
     select chapter_id
       into t_chp_id
       from system_users
     where user_id = p_user_id;
   exception
     when others then
       p_status := 'Err102. Chapter not found' || substr(sqlerrm, 1, 100);
   end;

   if v_timezone_active = 'Y' then
     Lifetrack_timezone_convert.get_local_time(t_chp_id, sysdate,
                                v_local_sysdate);
   else
     v_local_sysdate := sysdate;
   end if;
   -- End of change

  p_sysdate := v_local_sysdate;  --sysdate;

  validate_parameters(chk_status); 
  if chk_status != 'OK' then
        p_status := chk_status;
        return;
  end if;
  if gt_donor_inter_code is not null then
        place_on_donor(gt_donor_inter_code ,chk_status);
        if chk_status != 'OK' then
                p_status := chk_status;
                return;
        end if;
  end if;
  chk_status := insert_inter_unit;
  p_status := chk_status;
END; /* main prog*/

/*------------------------------------------------------------------------*/
/*  
---#######################################################################
    Program Name        : REMOVE_INTER_UNIT
    Date Creation       : 10-03-97
    Program Author      : Chandra
---#######################################################################
*/
PROCEDURE remove_inter_unit
                (
                p_unit_id               IN      VARCHAR2,
                p_deferral_id           IN      VARCHAR2,
                p_coll_date             IN      date,
                p_chapter_id            IN      varchar2,
                p_transaction_id        IN      VARCHAR2,
                p_inter_code            IN      VARCHAR2,
                p_originated_from       IN      VARCHAR2,
                p_reason_code           IN      VARCHAR2,
                p_source_code           IN      VARCHAR2,
                p_user_id               IN      varchar2,
                p_group_mode            IN      varchar2,
                p_group_id              IN      VARCHAR2,
                p_program_id            IN      VARCHAR2,
                p_incident_date         IN      DATE,
                p_term_date             IN      DATE,
                p_term_reason           IN      varchar2,
                p_status                OUT     VARCHAR2 )
IS

int_on          varchar2(5);
int_off         varchar2(5);
counter         number;
cur_open_flag   varchar2(1);
final_term_date date;
tmp_status      varchar2(250);
chk_status      varchar2(250);
t_don_int_code  varchar2(5);
p_donor_id      varchar2(10);
p_inter_type    varchar2(5);
 gt_inter_type           varchar2(5);
 gt_donor_inter_code     varchar2(5);
 gt_allow_mul            varchar2(1);
 gt_fixed_period         varchar2(1);
 gt_period_type          varchar2(8);
 gt_period_number        Number;
 gt_minimum_period       Number;
 gt_term_date            Date;
 gt_upm_flag             varchar2(1);
 gt_disposition          varchar2(1);
 gt_inter_owner          varchar2(1);
 gt_term_reason          varchar2(1);
    t_chp_id		varchar2(4);
 FUNCTION delete_inter (p_int_off       IN      varchar2)
 RETURN varchar2
 IS
 loc_date       date;
 BEGIN
    /* Changed by JMC, 07/15/99 commented out sysdate check */
    /* remove interdiction */
    --loc_date := sysdate;	 -- commented by ASHOK; 05/25/2011;
    loc_date := v_local_sysdate; -- Added by ASHOK; 05/25/2011; IM:5654
    if p_int_off is not null then
        begin
           update donation_interdictions set
                term_date = nvl(p_term_date,loc_date),
                term_reason = p_term_reason,
                release_user = p_user_id,
                release_date = loc_date
            where
                 transaction_id =  p_transaction_id and
                coll_date = p_coll_date and
                inter_code = p_int_off  and
                nvl(originated_from,' ') = nvl(p_originated_from,' ') and
                nvl(reason_code,' ') = nvl(p_reason_code,' ') and
                nvl(group_id,' ') = nvl(p_group_id,' ') and
                release_date is null and
                nvl(group_mode,' ') = nvl(p_group_mode,' ');
                ---sysdate between insert_date and nvl(term_date,sysdate+1);
         exception
            when others then
                return 'Err90. Can not Update donation interdictions'||
                       substr(sqlerrm,1,100);
         end; 
    end if;  /* removed interdiction */         
    return 'OK';
 END;   /* delete inter function */

 PROCEDURE validate_parameters
                ( t_status      OUT     varchar2)
 IS
 counter        number;
 x              varchar2(1); 
 Begin
     begin        
         select inter_type, donor_inter_code,allow_multiple,upm_flag,
                fixed_period,period_type,period_number,minimum_period ,
                inter_owner,term_reason_req
           into gt_inter_type, gt_donor_inter_code,gt_allow_mul,
                gt_upm_flag, gt_fixed_period,gt_period_type,
                gt_period_number,gt_minimum_period,gt_inter_owner,
                gt_term_reason
           from valid_interdictions 
          where inter_code = p_inter_code and           
                    --(sysdate between eff_date and nvl(term_date,sysdate+1) )
		    (v_local_sysdate between eff_date and nvl(term_date,v_local_sysdate+1) ) -- Ashok;IM:5326	
                    and rownum < 2 ;
     exception
         when no_data_found then
                t_status:= 'Err165. Inter code not exist'||
                       substr(sqlerrm,1,100);
                       return;
         when others then
                 t_status:=  'Err166. Inter code SQL Failed'||
                       substr(sqlerrm,1,100); 
                       return;
     end;
     if p_coll_date is null then
        t_status := 'Err80. Collection date can not be null.';
        return;
     end if;
     if p_transaction_id is null then
        t_status := 'Err80.1 Transaction ID can not be NULL';
        return;
     end if;
     if p_coll_date > v_local_sysdate then -- Added by Ashok on 05/17/2011. IM 5326
     --if p_coll_date > sysdate then
        t_status := 'Err81. Collection date can not be future date.';
        return;
     end if;
     if p_inter_code is null then
        t_status := 'Err83. Inter Code can not be NULL';
        return;
     end if;    
     -- check for valid unit ID or Deferral ID
 
     if p_unit_id is null and
        p_deferral_id is null then
            t_status := 'Err84.1 Both Unit/Deferral ID can not be NULL';
            return;
     end if;
     if p_unit_id is not null and
        p_deferral_id is not null then
            t_status := 'Err84.2 Both Unit/Deferral ID can not be NOT NULL';
            return;
     end if;
     if p_unit_id is not null then
        Begin
           Select 'x' into x
             from donations
             where transaction_id = p_transaction_id 
               and coll_date = p_coll_date
               and unit_id = p_unit_id;
        Exception
           When no_data_found then
                t_status := 'Err84.3 Unit ID is not registered ';
                return;
           When others then
                t_status := 'Err84.4 Unit ID is not registered '||
                            substr(sqlerrm,1,50);
                return;
        End;   
     end if;    
     if p_deferral_id is not null then
        Begin
           Select 'x' into x
             from donations
             where transaction_id = p_transaction_id 
               and coll_date = p_coll_date
               and deferral_id = p_deferral_id;
        Exception
           When no_data_found then
                t_status := 'Err84.5 Deferral ID is not registered ';
                return;
           When others then
                t_status := 'Err84.6 Deferral ID is not registered '||
                            substr(sqlerrm,1,50);
         End;
     end if;
     if gt_term_reason = 'Y' then
        if p_term_reason is null then
           t_status := 'Err85. Term reason can not be NULL';
            return;
        end if;
     end if;
     if p_user_id is null then
        t_status := 'Err86. User ID can not be NULL';
        return;
     end if;    
     if p_program_id is null then
        t_status := 'Err87. Program ID can not be NULL';
        return;
     end if;    
/*     if  nvl(p_term_date,sysdate+1 ) < trunc(sysdate) then      
        t_status := 'Term date can not be less than sysdate';
        return;
     end if; 
 */
    /* Changed by JMC, 07/15/99 commented out sysdate check */
     Begin
       select count(*) into counter
         from donation_interdictions
        where   transaction_id =  p_transaction_id and
                coll_date = p_coll_date and
                inter_code = p_inter_code and
                nvl(originated_from,' ') = nvl(p_originated_from,' ') and
                nvl(reason_code,' ') = nvl(p_reason_code,' ') and
                nvl(group_id,' ') = nvl(p_group_id,' ') and
                release_date is null and
                nvl(group_mode,' ') = nvl(p_group_mode,' ');
                ---sysdate between insert_date and nvl(term_date,sysdate+1); 
     Exception
        when others then
               t_status := 'Err88. SQL failed on donation_interdiction'||
                           substr(sqlerrm,1,100);
                           return;
     End;
     if counter = 0 then
        t_status := 'Err89. Unit does not have that inter code';
        return;
     end if;
     t_status := 'OK';
 End;


BEGIN   /* main prog - remove inter unit*/
   -- Added by Ashok on 05/17/2011. IM 5326

   begin
     select     nvl(time_zone_enabled, 'N')
       into v_timezone_active
       from     lt_application_config;
   exception
     when others then
       v_timezone_active:='N';
   end;

   begin
     select chapter_id
       into t_chp_id
       from system_users
     where user_id = p_user_id;
   exception
     when others then
       p_status := 'Err102. Chapter not found' || substr(sqlerrm, 1, 100);
   end;

   if v_timezone_active = 'Y' then
     Lifetrack_timezone_convert.get_local_time(t_chp_id, sysdate,
                                v_local_sysdate);
   else
     v_local_sysdate := sysdate;
   end if;
   -- End of change

  validate_parameters(chk_status); 
  if chk_status != 'OK' then
        p_status := chk_status;
        return;
  end if;

  chk_status := delete_inter(p_inter_code);
  p_status := chk_status;
END; /* main prog*/
/*-----------------------------------------------------------------------*/
END DON_INTER ; /*-- Package body --*/
/

CREATE OR REPLACE PUBLIC SYNONYM DON_INTER FOR DON_INTER 
/
GRANT EXECUTE ON DON_INTER TO LT_DONOR,UTIL,OPS$VISTA,LTAPI 
/
