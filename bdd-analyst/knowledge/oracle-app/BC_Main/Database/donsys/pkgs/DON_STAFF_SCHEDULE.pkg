/

CREATE OR REPLACE PACKAGE BODY DON_STAFF_SCHEDULE IS
  curdate       date ;
  g_start_date  date ;
  g_end_date    date ;
  g_actual_bod  date ;
  g_actual_eod  date ;
  g_save_bod    date ;
  g_save_eod    date ;
  g_schedule_id varchar2(20) ;
  g_chapter_id  varchar2(4) ;
  g_sch_name    varchar2(200) ;
  suitable_team varchar2(5) ;
  selection     varchar2(1) ;
  g_log_handle utl_file.file_type ;
  g_comments    varchar2(500) ;
-- This is the main procedure which calls the other procedures
procedure main_proc (start_date in date,end_date in date,schedule_id in varchar2,chapter_id in varchar2, sch_name in varchar2) is
  loop_count number ;
  l_mixfc    number := 0;
  l_mixtm    number := 0;
  l_nooff    number := 0;
  l_ovtim    number := 0;
  l_untim    number := 0;
  l_parta    number := 0;
  l_recov    number := 0;
  err_flag   varchar2(5) ;
begin
  dbms_output.enable(1000000);
  curdate := start_date ;
  g_start_date := start_date ;
  g_end_date := end_date ;
  g_schedule_id := schedule_id ;
  g_chapter_id := chapter_id ;
  g_sch_name := sch_name ;
  g_comments := null ;
  prepare_log_filehandle ;
  loop_count := end_date - start_date + 1 ; -- Number of days for scheduling
  create_header_entry ;
  read_parameters ;
  create_employee_list ;
  /*-- If the first date is an even number, reverse the list --*/
--  if mod(to_number(to_char(curdate,'DD')),2) = 0 then
--     reverse_emplist_order ;
--  end if ;
  --print_employees ;
  for i_days in 1..loop_count loop
     for i_temp in 1..emplist.count loop
         check_vacations(i_temp) ;
     end loop ;
     if drvlist.count > 0 then
        drvlist.delete ;
     end if ;
     for i_temp in 1..emplist.count loop
         emplist(i_temp).off_day_candidate := 'N' ;
         emplist(i_temp).assigned_curdate := 'N' ;
     end loop ;
     prepare_drive_list(curdate) ;
     /*-- If no drives, then go to next iteration --*/
     if drvlist.count = 0 then
        goto next_iter_main ;
     end if ;
     for j in 1..drvlist.count loop
       write_log(drvlist(j).drive_id||' '||to_char(drvlist(j).proj_draw));
     end loop ;
     potential_staff_off_day('TMLDR') ;
     write_log('After potential_staff_off TMLDR');
     potential_staff_off_day('MEMBR') ;
     write_log('OFF list for '||to_char(curdate,'MM-DD-YYYY'));
     for x in 1..emplist.count loop
        if emplist(x).off_day_candidate = 'Y' then
           write_log(emplist(x).staff_no);
        end if ;
     end loop ;
     write_log('After potential_off') ;
     /*- Check all pre-assignments for that day and first assign those staff -*/
     do_pre_assignments ;
     write_log('After pre_assignments') ;
     /*-- For each drive on the day, assign TL and Team member --*/
     for i_drives in 1..drvlist.count loop
         write_log('Before assign_tl doing .'||drvlist(i_drives).drive_id);
         assign_tl(i_drives) ;
         write_log('After assign_tl doing index no.'||to_char(i_drives));
         assign_team_member(i_drives) ;
         write_log('After assign_team_member index no.'||to_char(i_drives));
     end loop ;
     if piggylist.count > 0 then
       schedule_piggyback_drives ;
       piggylist.delete ;
     end if ;
     reverse_emplist_order ;
     <<next_iter_main>>
     curdate := curdate + 1 ;
  end loop ; -- End of i in 1 to 7 loop
  print_assignment ;
  l_mixfc := mix_facility;
  l_mixtm := mix_team;
  l_nooff := no_off;
  l_parta := partial_assignments;
  l_recov := recovery_time;
  overtime_undertime(l_ovtim, l_untim);
  update staff_schedule_hdr
     set mixfc = l_mixfc,
         mixtm = l_mixtm,
         nooff = l_nooff,
         ovtim = l_ovtim,
         untim = l_untim,
         parta = l_parta,
         recov = l_recov
   where schedule_id = g_schedule_id
     and start_date  = g_start_date
     and end_date    = g_end_date
     and chapter_id  = g_chapter_id;
  commit ;
  exception
    when others then write_log('Error occurred 1');write_log(to_char(sqlcode)||' '||sqlerrm);return;
end main_proc;
procedure prepare_log_filehandle is
 log_dir varchar2(50) ;
 log_file varchar2(100) ;
begin
 begin
         select lower(parameter_value) into log_dir
         from   valid_parameters
         where  parameter_code = 'SLOG';
--         and    chapter_id = g_chapter_id ;
 exception
  when others then dbms_output.put_line('Error in SQL:'||sqlcode||substr(sqlerrm,1,100));raise;
 end ;
 log_file := g_schedule_id||'_'||to_char(sysdate,'MMDDYYYY')||'.log' ;
 g_log_handle := utl_file.fopen(log_dir,log_file,'w');
exception
 when utl_file.invalid_path then dbms_output.put_line('Invalid path or filename');raise;
 when others then dbms_output.put_line('Error in prepare_log_filename');raise;
end prepare_log_filehandle ;
procedure write_log (log_msg in varchar2) is
begin
 utl_file.put_line(g_log_handle,log_msg) ;
 utl_file.fflush(g_log_handle) ;
exception
 when others then dbms_output.put_line('Error in writing to logfile');raise;
end write_log;
/*---- This procedure creates an entry in the staff_schedule_hdr table  --*/
procedure create_header_entry is
begin
 begin
   insert into staff_schedule_hdr
   (chapter_id,schedule_id,start_date,end_date,status,last_modified_date,program_id, comments)
   values
   (g_chapter_id,g_schedule_id,g_start_date,g_end_date,'TENTV',sysdate,'PROC', g_sch_name) ;
 exception
   when others then write_log('Error in create_header_entry '||sqlcode||substr(sqlerrm,1,100)); raise;
 end ;
end create_header_entry;
procedure read_parameters is
 cursor param is
 select parameter_code,parameter_value
 from valid_parameters
 where parameter_code in ('TLOFF','TMOFF','OCDAY','OCHR','AVGHR','RECOV','AVGSK');-- and chapter_id = g_chapter_id ;
 counter number := 1 ;
begin
 for paramrec in param loop
     paramlist(counter).parameter_code := paramrec.parameter_code ;
     paramlist(counter).parameter_value := paramrec.parameter_value ;
     counter := counter + 1 ;
 end loop ;
 exception
   when others then write_log('Error in read_parameters '||sqlcode||' '||substr(sqlerrm,1,100)); raise;
end read_parameters ;
function get_parameter (parameter_code in varchar2) return varchar2 is
begin
  for i in 1..paramlist.count loop
      if paramlist(i).parameter_code = parameter_code then
          return paramlist(i).parameter_value ;
      end if ;
  end loop ;
  return null ;
end get_parameter ;
-- This procedure selects the drives and sequences them as required
procedure prepare_drive_list (curdate in date) is
  v_drive_id varchar2(10) ;
  counter number := 1;
  piggy_counter number := 1;
  facility_counter number := 1 ;
  cur_start_time date ;
  cur_end_time date ;
  startup_bkdown date ;
  travel_time number ;
  no_skillrtg_counter number:=0 ; --cnt of drives with no min skill rtg spcfied
  pb_id varchar2(10) ;
  pb_drive_id varchar2(10) ;
  cursor drv is
  select drives.drive_id drive_id,drive_type,
         nvl(min_skill_rating,1) min_skill_rating, schedule_start_time,
         schedule_end_time, nvl(schedule_stup_bkdown_time,0)
         schedule_stup_bkdown_time, location_id,nvl(number_reqd,0) number_reqd
    from drives,drive_estimated_resources
   where drive_date = curdate
     and drive_type in ('I','C')
     and status = 'CNFRM'
     and drive_estimated_resources.drive_id=drives.drive_id
     and drives.chapter_id = g_chapter_id
     and drive_estimated_resources.chapter_id = g_chapter_id
     and resource_code='STAFF'
   order by nvl(number_reqd,0), nvl(min_skill_rating,-99) desc ;
/*
  cursor res is
  select resource_code,nvl(number_reqd,0) number_reqd
  from drive_estimated_resources
  where drive_id = v_drive_id
  and   chapter_id = g_chapter_id ;
*/
  cursor cur_facil is
  select facility_code from drive_facilities
  where drive_id = v_drive_id
  and   chapter_id = g_chapter_id ;
begin
  if facility_list.count > 0 then
     facility_list.delete ;
  end if ;
 /*-------- Select the drives --------*/
 for drvrec in drv loop
   for piggy_count in 1..piggylist.count loop
       if piggylist(piggy_count).piggyback_drive = drvrec.drive_id then
          goto next_drive_iter ; /*-- Skip this drive --*/
       end if ;
   end loop ;
   /*-- Check if drive is a piggyback --*/
   begin
     select drive_group_id into pb_id
     from drive_groups
     where drive_group_type = 'PIGGY'
     and   drive_id = drvrec.drive_id
     and   chapter_id = g_chapter_id ;
     begin
       select drive_id into pb_drive_id
       from drive_groups
       where drive_group_type = 'PIGGY'
       and   drive_group_id = pb_id
       and   drive_id  != drvrec.drive_id
       and   chapter_id = g_chapter_id ;
       piggylist(piggy_counter).piggyback_drive := pb_drive_id ;
       piggylist(piggy_counter).piggybacked_to := drvrec.drive_id ;
       piggy_counter := piggy_counter + 1 ;
     exception
       when others then write_log('Error 290 '||sqlcode||' '||substr(sqlerrm,1,100)) ; raise ;
     end ;
   exception
     when no_data_found then null ;
     when others then write_log('Error 290 '||sqlcode||' '||substr(sqlerrm,1,100)) ; raise ;
   end ;
   drvlist(counter).drive_id := drvrec.drive_id ;
   drvlist(counter).min_skill_rating := drvrec.min_skill_rating ;
   drvlist(counter).drive_type := drvrec.drive_type ;
   v_drive_id := drvrec.drive_id ;
/*   for resrec in res loop
       if resrec.resource_code = 'STAFF' then
          drvlist(counter).staff_reqd := resrec.number_reqd ;
       end if ;
   end loop ;*/
   begin
     select facility_code into drvlist(counter).drive_facility
     from drive_facilities
     where drive_id = v_drive_id
     and   chapter_id = g_chapter_id
     and rownum < 2;
   exception
     when no_data_found then null;
   end;
   drvlist(counter).staff_reqd := drvrec.number_reqd;
   begin
    select nvl(sum(projected_draw),0) into drvlist(counter).proj_draw
    from drive_sponsors
    where drive_id = drvlist(counter).drive_id
    and   chapter_id = g_chapter_id ;
    exception
      when others then write_log('Error 1 '||sqlcode||' '||substr(sqlerrm,1,100)) ; raise ;
   end ;
   if drvlist(counter).min_skill_rating = 0 then
       no_skillrtg_counter := no_skillrtg_counter + 1 ;
   end if ;
   /*--- Get travel time ---*/
   begin
     select (nvl(travel_time,0)/60)/24 into travel_time
     from locations
     where location_id = drvrec.location_id
     and   chapter_id = g_chapter_id ;
    exception
      when no_data_found then write_log('Drive '||drvrec.drive_id||' has invalid location');raise ;
      when others then write_log('Error 2 '||sqlcode||' '||substr(sqlerrm,1,100)) ; raise ;
   end ;
   /*---- Calculate actual drive hours ----*/
   drvlist(counter).drive_start_time := drvrec.schedule_start_time - travel_time - (drvrec.schedule_stup_bkdown_time/2/60/24) ;
   drvlist(counter).drive_end_time := drvrec.schedule_end_time + travel_time + (drvrec.schedule_stup_bkdown_time/2/60/24) ;
   counter := counter + 1 ;
   for cur_facilrec in cur_facil loop
       facility_list(facility_counter).drive_id := v_drive_id ;
       facility_list(facility_counter).facility_code := cur_facilrec.facility_code ;
       facility_counter := facility_counter + 1 ;
   end loop ;
   <<next_drive_iter>>
   null ;
 end loop ; -- End of cursor drv loop
 /*-- Sort the drives (without any min. skill rating)
      in the descending order of proj. draw  -------*/
 sort_drvlist(no_skillrtg_counter) ;
end prepare_drive_list ;
procedure sort_drvlist(sort_count in number) is
 big number ;
 placeholder number ;
 temp number ;
 start_index number ;
begin
  write_log('Sorting drive list for '||to_char(curdate,'MM-DD-YYYY')||' Count in list:'||to_char(drvlist.count)||' sort_count:'||to_char(sort_count));
  start_index := drvlist.count - sort_count + 1 ;
  for k in start_index..drvlist.count
  loop
    big := drvlist(k).proj_draw ;
    placeholder := k ;
    for l in k+1..drvlist.count loop
      if drvlist(l).proj_draw > big then
        big := drvlist(l).proj_draw ;
        placeholder := l;
      end if ;
    end loop ;-- end for l loop
    swap_drvlist(k,placeholder) ;
  end loop ; -- end for k loop
end sort_drvlist ;
procedure swap_drvlist(first_index in number,second_index in number) is
 temp drvrectyp ;
begin
 temp := drvlist(first_index) ;
 drvlist(first_index) := drvlist(second_index) ;
 drvlist(second_index) := temp ;
end swap_drvlist ;
/*-- This procedure creates list of all Collection Services employees
     and also their job areas ------------*/
procedure create_employee_list is
 v_staff_no varchar2(6) ;
 u_staff_no varchar2(6) ;
 counter number := 1 ;
 emptemplist emptabtemp ;
 facility_counter number := 1 ;
 cursor c1 is
 select staff_no,nvl(team_id,'X') team_id,nvl(term_date,sysdate+1000) term_date,
        facility_code, nvl(mix_team,'N') mix_team
 from employees
---- where emp_class = 'MSTAF'  -- commented by MG, added following instead
 where emp_class in (select code from valid_master_codes
                where code_type = 'AUTAS'
                  and sysdate between eff_date and nvl(term_date, sysdate+2))
 -------------------------------------------------------------------------
 and chapter_id=g_chapter_id
 and sysdate between eff_date and nvl(term_date,sysdate+1)
 and nvl(schedule_from_date,g_start_date+1) <= g_start_date
 order by team_id, team_seq ;
 /*
 select emp1.staff_no,nvl(emp1.team_id,'X') team_id,
        nvl(emp1.term_date,sysdate+1000) term_date,emp1.facility_code,
        nvl(emp1.mix_team,'N') mix_team,count(emp2.staff_no)
 from employees emp2, employees emp1
 where emp1.emp_class = 'MSTAF'
 and emp1.chapter_id=g_chapter_id
 and emp2.emp_class = 'MSTAF'
 and emp2.chapter_id=g_chapter_id
 and sysdate between emp1.eff_date and nvl(emp1.term_date,sysdate+1)
 and sysdate between emp2.eff_date and nvl(emp2.term_date,sysdate+1)
 and nvl(emp1.schedule_from_date,sysdate+1) <= g_start_date
 and nvl(emp2.schedule_from_date,sysdate+1) <= g_start_date
 and nvl(emp1.team_id,'X')=nvl(emp2.team_id,'X')
 group by emp1.staff_no,nvl(emp1.team_id,'X') ,
          nvl(emp1.term_date,sysdate+1000) ,emp1.facility_code,
          nvl(emp1.mix_team,'N') ,emp2.team_id
 order by 6 desc,2;
 */
 cursor job is
 select job_code,nvl(skill_rating,1) skill_rating
 from employee_jobs
 where staff_no = v_staff_no
 and chapter_id=g_chapter_id
 and sysdate between eff_date and nvl(term_date,sysdate+1) ;
 cursor c_facility is
 select facility_code from emp_facilities
 where  staff_no = v_staff_no
 and    chapter_id=g_chapter_id
 and    sysdate between eff_date and nvl(term_date,sysdate+1) ;
begin
 counter := 1 ;
 /*---------------------------------------------------------------------------
 This delete is done because I found a possible bug with PL/SQL tables. It
 does not clear the tables every time the procedure is completed.
 ---------------------------------------------------------------------------*/
 if emplist.count > 0 then
   emplist.delete ;
 end if ;
 for c1rec in c1 loop
     emplist(counter).staff_no := c1rec.staff_no ;
     emplist(counter).team_id := c1rec.team_id ;
     emplist(counter).tl_skill := 0 ;
     emplist(counter).coach_driver_skill := 0 ;
     emplist(counter).van_driver_skill := 0 ;
     emplist(counter).atl_skill := 0 ;
     emplist(counter).overall_skill := 0 ;
     emplist(counter).hours := 0 ;
     emplist(counter).term_date := c1rec.term_date ;
     emplist(counter).facility_code := c1rec.facility_code ;
     emplist(counter).mix_team := c1rec.mix_team ;
     v_staff_no := c1rec.staff_no ;
     for jobrec in job loop
         if jobrec.job_code = 'TMLDR' then
             emplist(counter).tl_skill := jobrec.skill_rating ;
         elsif jobrec.job_code = 'CDRVR' then
             emplist(counter).coach_driver_skill := jobrec.skill_rating ;
         elsif jobrec.job_code = 'VDRVR' then
             emplist(counter).van_driver_skill := jobrec.skill_rating ;
         elsif jobrec.job_code = 'ATL' then
             emplist(counter).atl_skill := jobrec.skill_rating ;
         elsif jobrec.job_code = 'OVRAL' then
             emplist(counter).overall_skill := jobrec.skill_rating ;
         end if ;
     end loop ;
     for c_facilrec in c_facility loop
         emp_facility(facility_counter).staff_no := v_staff_no ;
         emp_facility(facility_counter).facility_code := c_facilrec.facility_code ;
         facility_counter := facility_counter + 1 ;
     end loop ;
     counter := counter + 1 ;
 end loop ; /*-- End emprec loop --*/
 write_log('#employees found=counter:'||to_char(counter)||'emplist.count:'||to_char(emplist.count));
exception
 when others then write_log('Error in create_employee_list '||sqlcode||' '||substr(sqlerrm,1,100)); raise;
end create_employee_list ;
/*-- This procedure checks whether the staff belongs the facility of the drive --*/
function check_facility(p_staff_no in varchar2,p_drive_id in varchar2) return boolean is
 type temp_facility_type is table of varchar2(5) index by binary_integer ;
 temp_facility temp_facility_type ;
 counter number := 0 ;
 facility_counter number := 1 ;
begin
 if temp_facility.count > 0 then
    temp_facility.delete ;
 end if ;
 for a_temp in 1..emp_facility.count loop
    if emp_facility(a_temp).staff_no = p_staff_no then
       temp_facility(facility_counter) := emp_facility(a_temp).facility_code ;
       facility_counter := facility_counter + 1 ;
    end if ;
 end loop ;
 if temp_facility.count = 0 then
    return FALSE ;
 end if ;
 for loop_facil in 1..facility_list.count loop
     if facility_list(loop_facil).drive_id = p_drive_id then
      for loop_emp_facil in 1..temp_facility.count loop
        if temp_facility(loop_emp_facil) = facility_list(loop_facil).facility_code then
           return TRUE ;
        end if ;
      end loop ;
     end if ;
 end loop ;
 return FALSE ;
end ;
/*-- This procedure checks unavailability of the staff -- */
procedure check_vacations(emp_index in number) is
begin
     begin
       emplist(emp_index).unavl_start_time := 'NONE' ;
       emplist(emp_index).unavl_end_time := 'NONE' ;
       select nvl(to_char(from_time,'HH24:MI'),'ALL'),
              nvl(to_char(to_time,'HH24:MI'),'ALL')
      into emplist(emp_index).unavl_start_time,emplist(emp_index).unavl_end_time
       from staff_off_day
       where staff_no = emplist(emp_index).staff_no
       and chapter_id=g_chapter_id
       and   unavail_date = curdate ;
     exception
       when no_data_found then null ;
/*
---   Added by JMC, 10/11/99.
*/
       WHEN too_many_rows THEN
            emplist(emp_index).unavl_start_time := 'ALL';
            emplist(emp_index).unavl_end_time := 'ALL';
/*
---END of addition by JMC,  10/11/99
*/
       when others then write_log('Error in check_vacations '||sqlcode||' '||substr(sqlerrm,1,100));raise;
     end ;
end check_vacations;
