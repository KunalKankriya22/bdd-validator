  PROCEDURE FIND_TBV(pl_ht        in varchar2,
                     pl_wt        in varchar2,
                     pl_sex       in varchar2,
                     pl_chapter   in varchar2,
                     pl_TOT_BLOOD out number) IS
  
    ht_feet        number := 0;
    ht_inch        number := 0;
    inch_pos       number := 0;
    temp_inch      varchar2(10);
    temp_feet      varchar2(10);
    weight_in_kg   number := 0;
    first_value    number := 0;
    last_value     number := 0;
    middle_value   number := 0;
    middle_string  varchar2(150);
    formula_string varchar2(240);
    local_date     date;
    tot_height     number;
    ht_meter       number := 0;
  
  Begin
  
    temp_ht     := pl_ht;
    temp_weight := pl_wt;
    temp_gender   := pl_sex;
  
    local_date := lifetrack_timezone_convert.get_local_time(pl_chapter,
                                                            sysdate);
  
    -- Get the formula string
  
    begin
      select description
        into formula_string
        from valid_master_codes
       where code_type = 'TBV'
         and code = decode(temp_gender, 'M', 'MALE', 'FEMAL')
         and local_date between eff_date and
             nvl(term_date, local_date + 10);
    
    exception
      when no_data_found then
        pl_TOT_BLOOD := 0;
        return;
    end;
  
    If (temp_ht is null) or (temp_weight is null) then
      pl_TOT_BLOOD := 0;
      return;
    End If;
  
    select replace(temp_ht, '''', ' ') into temp_ht from dual;
    select replace(temp_ht, '"', ' ') into temp_ht from dual;
    dbms_output.put_line('Height=' || temp_ht);
  
    -- calculate the height value  
  
    temp_feet := SUBSTR(LTrim(temp_ht), 1, 1);
    select to_number(temp_feet) into ht_feet from dual;
    dbms_output.put_line('Feet=' || to_char(ht_feet));
  
    temp_inch := LTRIM(substr(temp_ht, 2));
    ht_inch   := TO_NUMBER(LTRIM(substr(temp_ht, 2)));
  
    If ht_inch is null then
      ht_inch := 0;
    End If;
    dbms_output.put_line('Inch=' || to_char(ht_inch));
  
    ht_meter := (ht_feet * .3048) + (ht_inch * .0254); --+ 0.0254;
    dbms_output.put_line('Ht_meter=' || to_char(ht_meter));
  
    tot_height := ht_meter * ht_meter * ht_meter;
    dbms_output.put_line('Tot height=' || to_char(tot_height, '999.999'));
  
    weight_in_kg := temp_weight / 2.205;
    dbms_output.put_line('Tot Weight=' || to_char(weight_in_kg, '999.999'));
  
    -- Get the first multiplication value
  
    first_value := To_number(substr(formula_string,
                                    1,
                                    instr(formula_string, ' ', 1) - 1));
    --dbms_output.put_line('First value='||to_char(first_value));
  
    last_value := to_number(substr(formula_string,
                                   instr(formula_string, ' ', -1) + 1));
    --dbms_output.put_line('last value='||to_char(last_value));
  
    middle_string := LTrim(substr(formula_string,
                                  instr(formula_string, '+', 1) + 1));
    --dbms_output.put_line('Middle string ='||middle_string);
  
    middle_value := To_number(substr(middle_string,
                                     1,
                                     instr(middle_string, ' ', 1) - 1));
    --dbms_output.put_line('Middle value='||to_char(middle_value));
  
    pl_TOT_BLOOD := (first_value * tot_height) +
                    (middle_value * weight_in_kg) + last_value;
  
    dbms_output.put_line('Total Blood Volume =' ||
                         to_char(pl_TOT_BLOOD, '999.999'));
  
  End FIND_TBV;

END DON_TBV; /*-- Package body --*/
/
