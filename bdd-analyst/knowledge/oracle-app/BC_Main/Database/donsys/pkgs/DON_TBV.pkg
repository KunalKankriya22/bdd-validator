create or replace
PACKAGE DON_TBV IS

/* ---------------- Version History--------------------------------------------------------------------------

Modified By         Ver          Date            Comments
===============================================================================================================

B. Edwin             01          01/18/19        Original version created to calculate the total blood volume
B. Edwin             02          06/02/19        To add another call for invoking the package without donor ID
Ashok                03          10/03/19        calc_donor_tbv modified.
B. Edwin             04          03/17/20        Sending out the formated TBV [MLT- 3118]
B. Edwin             05          04/29/20       LTrim was applied to the T_TBV final value
------------------------------------------------------------------------------------------------ ------------ */

PROCEDURE CALC_DONOR_TBV    (pl_donor_id   in varchar2,
                             pl_chapter_id in varchar2,
                             pl_donor_ht   in varchar2,
                             pl_donor_wt   in varchar2,
                             pl_donor_sex  in varchar2,
                             pl_TBV        out varchar2);
/*
PROCEDURE CALC_DONOR_TBV
     (
           pl_donor_id     in varchar2,
           pl_chapter_id   in varchar2,
           pl_TBV          out varchar2
      );

PROCEDURE CALC_DONOR_TBV_OPT2
     (
           pl_donor_ht     in varchar2,
           pl_donor_wt     in varchar2,
           pl_donor_sex    in varchar2,
           pl_chapter_id   in varchar2,
           pl_TBV          out varchar2
      );

*/
PROCEDURE FIND_TBV (pl_ht in varchar2,
                   pl_wt in varchar2,
                   pl_sex in varchar2,
                   pl_chapter in varchar2,
                   pl_TOT_BLOOD out number);


temp_ht        varchar2(10);
temp_weight    number:=0;
temp_gender      varchar2(1);
pl_TOT_BLOOD_VOL  number:=0;


END DON_TBV;
/
create or replace PACKAGE BODY DON_TBV IS

  PROCEDURE CALC_DONOR_TBV(pl_donor_id   in varchar2,
                               pl_chapter_id in varchar2,
                               pl_donor_ht   in varchar2,
                               pl_donor_wt   in varchar2,
                               pl_donor_sex  in varchar2,
                               pl_TBV        out varchar2) is
  
    strBloodVol varchar2(10);
    temp_TBV    number := 0;
  Begin
    -- get ht, wt, gender from donors table.
    if pl_donor_id is not null then
      select height, donor_weight, gender
        into temp_ht, temp_weight, temp_gender
        from donors
       where donor_id = pl_donor_id;      
    end if;
    -- use donor table values if the input paramters are null.
    -- if donor ht is passed from UI.
    if pl_donor_ht is not null then
      temp_ht := replace(pl_donor_ht, '-', ' ');
    end if;
    
    if NVL(pl_donor_wt, '0') <> '0' then
      temp_weight := pl_donor_wt;
    end if;

    temp_gender := NVL(pl_donor_sex, temp_gender);
  
    pl_TOT_BLOOD_VOL := 0;
    FIND_TBV(temp_ht,
             temp_weight,
             temp_gender,
             pl_chapter_id,
             pl_TOT_BLOOD_VOL);
  
    temp_TBV := Round(pl_TOT_BLOOD_VOL, 2);
  
    strBloodVol := to_char(temp_TBV);
  
    If Length(substr(to_char(mod(temp_TBV, 10)), 3)) = 1 then
      strBloodVol := to_char(temp_TBV) || '0';
    End If;
  
    pl_TBV := to_char(strBloodVol,'99.09');   --- MLT- 3118

    pl_TBV:=LTrim(pl_TBV);
  
    --dbms_output.put_line('TBV ='||pl_TBV);
  
  END calc_donor_TBV;

/*
