create or replace
PACKAGE ONSITE_OBJECTS AS

/***********************************************************
 Package     : DON_ONSITE
 Developed By: Basker Edwin
 Purpose     : All the online related packages would be
	       incorporated
 Created Date: 07.15.02
 Modify  Date: 10/02/2013
 Version     : 04 -- SCR 11920; New parameter added; 
 		  -- pABBR_ELIG_STATUS added to pass to donor card.
 		  -- ABBR_ELIG_STATUS column added to new_donor_temp table;
 		  -- Dt: 10/02/2013
************************************************************ */

  PROCEDURE POPULATE_NEW_DONOR_TEMP(
			 pLAST_NAME        in VARCHAR2,
			 pSSN              in VARCHAR2,
			 pDONOR_ID         in VARCHAR2,
			 pDATE_OF_BIRTH    in DATE,
			 pFIRST_NAME       in VARCHAR2,
			 pMIDDLE_NAME      in VARCHAR2,
			 pGENDER           in VARCHAR2,
			 pSTREET_NAME      in VARCHAR2,
			 pSUITE_APT        in VARCHAR2,
			 pCITY             in VARCHAR2,
			 pSTATE            in VARCHAR2,
			 pZIP              in VARCHAR2,
			 pADDRESS_FLAG     in VARCHAR2,
		 	 pB_AREA_CODE      in VARCHAR2,
			 pB_PHONE_NO       in VARCHAR2,
			 pH_AREA_CODE      in VARCHAR2,
			 pH_PHONE_NO       in VARCHAR2,
			 pEXTENSION        in VARCHAR2,
			 pEMAIL            in VARCHAR2,
			 pEMP_SCHOOL       in VARCHAR2,
			 pNEW_DONOR_FLAG   in VARCHAR2,
			 pETHNIC_GROUP     in VARCHAR2,
			 pINSERT_DATE      in DATE,
			 pINSERT_USER      in VARCHAR2,
			 pPROGRAM_ID       in VARCHAR2,
			 pSESSION_ID       in VARCHAR2,
			 pPRINT_STATUS     in VARCHAR2,
			 pDEFERRAL_STATUS  in VARCHAR2,
			 pPRINT_DATE       in DATE,
			 pDRIVE_ID         in VARCHAR2,
			 pUNIT_ID          in VARCHAR2,
			 pBLOOD_TYPE_DES   in VARCHAR2,
			 pHEIGHT           in VARCHAR2,
			 pWEIGHT           in NUMBER,
			 pALTERNATE_ID     in VARCHAR2,
			 pALTERNATE_ID_TYPE in VARCHAR2,
			 pSCAN_ID          in  VARCHAR2,
                         pCREDIT_SPONSOR   in VARCHAR2,
                         pLAST_SUFFIX      in VARCHAR2,
                         pALIAS            in VARCHAR2,
			 pID_VERIFIED      in VARCHAR2,
                         pintl_addr1	   in VARCHAR2,
                         pintl_addr2       in VARCHAR2,
                         pintl_addr3       in VARCHAR2,
                         pintl_addr4	   in VARCHAR2,
                         pintl_zip         in VARCHAR2,
			 pcountry          in VARCHAR2,
                         pintl_home_ph     in VARCHAR2,
                         pintl_work_ph     in VARCHAR2,
                         pintl_work_ph_ext in VARCHAR2,
                         pintl_mobile_ph   in VARCHAR2,
                         pintl_fax_no      in VARCHAR2,                         
                         pintl_flag        in VARCHAR2,
                         pABBR_ELIG_STATUS in VARCHAR2); -- SCR 11920

END ONSITE_OBJECTS;
/

CREATE OR REPLACE PACKAGE BODY ONSITE_OBJECTS AS

Procedure POPULATE_NEW_DONOR_TEMP(
			 pLAST_NAME        in VARCHAR2,
			 pSSN              in VARCHAR2,
			 pDONOR_ID         in VARCHAR2,
			 pDATE_OF_BIRTH    in DATE,
			 pFIRST_NAME       in VARCHAR2,
			 pMIDDLE_NAME      in VARCHAR2,
			 pGENDER           in VARCHAR2,
			 pSTREET_NAME      in VARCHAR2,
			 pSUITE_APT        in VARCHAR2,
			 pCITY             in VARCHAR2,
			 pSTATE            in VARCHAR2,
			 pZIP              in VARCHAR2,
			 pADDRESS_FLAG     in VARCHAR2,
		 	 pB_AREA_CODE      in VARCHAR2,
			 pB_PHONE_NO       in VARCHAR2,
			 pH_AREA_CODE      in VARCHAR2,
			 pH_PHONE_NO       in VARCHAR2,
			 pEXTENSION        in VARCHAR2,
			 pEMAIL            in VARCHAR2,
			 pEMP_SCHOOL       in VARCHAR2,
			 pNEW_DONOR_FLAG   in VARCHAR2,
			 pETHNIC_GROUP     in VARCHAR2,
			 pINSERT_DATE      in DATE,
			 pINSERT_USER      in VARCHAR2,
			 pPROGRAM_ID       in VARCHAR2,
			 pSESSION_ID       in VARCHAR2,
			 pPRINT_STATUS     in VARCHAR2,
			 pDEFERRAL_STATUS  in VARCHAR2,
			 pPRINT_DATE       in DATE,
			 pDRIVE_ID         in VARCHAR2,
			 pUNIT_ID          in VARCHAR2,
			 pBLOOD_TYPE_DES   in VARCHAR2,
			 pHEIGHT           in VARCHAR2,
			 pWEIGHT           in NUMBER,
			 pALTERNATE_ID     in VARCHAR2,
			 pALTERNATE_ID_TYPE in VARCHAR2,
			 pSCAN_ID          in  VARCHAR2,
                         pCREDIT_SPONSOR   in VARCHAR2,
                         pLAST_SUFFIX      in VARCHAR2,
                         pALIAS            in VARCHAR2,
			 pID_VERIFIED      in VARCHAR2,
                         pintl_addr1	   in VARCHAR2,
                         pintl_addr2       in VARCHAR2,
                         pintl_addr3       in VARCHAR2,
                         pintl_addr4	   in VARCHAR2,
                         pintl_zip         in VARCHAR2,
			 pcountry          in VARCHAR2,
                         pintl_home_ph     in VARCHAR2,
                         pintl_work_ph     in VARCHAR2,
                         pintl_work_ph_ext in VARCHAR2,
                         pintl_mobile_ph   in VARCHAR2,
                         pintl_fax_no      in VARCHAR2,                         
                         pintl_flag        in VARCHAR2,
                         pABBR_ELIG_STATUS in VARCHAR2) IS -- SCR 11920

 nCOUNT  NUMBER:=0;
 Begin

     -- Delete if the same donor information existis in the database

     If pSSN is not null then
	  select count(*) into nCount from new_donor_temp where
	      SSN=pSSN and LAST_NAME=plast_name and
	      DATE_OF_BIRTH=pdate_of_birth and gender=pgender;
     Else
         select count(*) into nCount from new_donor_temp where
  	         ALTERNATE_ID=palternate_id   and
		 LAST_NAME=plast_name         and
		 DATE_OF_BIRTH=pdate_of_birth and
		 gender=pgender;
    End if;

   If nCount > 0 then
     If pSSN is not null then

	 DELETE from NEW_DONOR_TEMP where SSN=pssn and
	             LAST_NAME =plast_name  and
	             DATE_OF_BIRTH  =pdate_of_birth and
                     GENDER =pgender;
      Else
  	 DELETE from NEW_DONOR_TEMP where alternate_id=palternate_id and
	             LAST_NAME =plast_name  and
	             DATE_OF_BIRTH  =pdate_of_birth and
                     GENDER =pgender;
      End If;
  End if;
  ---Delete over

    INSERT into new_donor_temp(
				LAST_NAME,
                                SSN,
                                DONOR_ID,
                                DATE_OF_BIRTH  ,
                                FIRST_NAME     ,
				MIDDLE_NAME    ,
				GENDER         ,
			        STREET_NAME    ,
				SUITE_APT      ,
			        CITY           ,
				STATE          ,
			        ZIP            ,
				ADDRESS_FLAG   ,
				B_AREA_CODE    ,
				B_PHONE_NO     ,
			        H_AREA_CODE    ,
				H_PHONE_NO     ,
			        EXTENSION      ,
				EMAIL          ,
			        EMP_SCHOOL     ,
				NEW_DONOR_FLAG ,
			        ETHNIC_GROUP   ,
				INSERT_DATE    ,
			        INSERT_USER    ,
				PROGRAM_ID     ,
		                SESSION_ID     ,
				PRINT_STATUS   ,
			        DEFERRAL_STATUS,
				PRINT_DATE     ,
			        DRIVE_ID       ,
				BLOOD_TYPE_DES ,
				HEIGHT         ,
				WEIGHT         ,
				ALTERNATE_ID   ,
				ALTERNATE_ID_TYPE,
				SCAN_ID,
                                CREDIT_SPONSOR,
                                LAST_NAME_SUFFIX,
                                ALIAS,
				DONOR_ID_VERIFIED,
				INTL_ADDRESS_1,
				INTL_ADDRESS_2,
				INTL_ADDRESS_3,
				INTL_ADDRESS_4,
				INTL_POSTAL_CODE,
				COUNTRY_NAME,
				INTL_HOME_PHONE_NO,
				INTL_WORK_PHONE_NO,
				INTL_WORK_PHONE_EXT,
				INTL_MOBILE_PHONE_NO,
				INTL_FAX_NO,
				INTL_ADDR_FLAG,
				ABBR_ELIG_STATUS	 -- SCR 11920			
				)
		VALUES
			 (plast_name,
			  pssn,
			  pdonor_id,
			  pdate_of_birth,
		          pfirst_name,
			  pmiddle_name,
			  pgender,
			  pstreet_name,
			  psuite_apt,
			  pcity,
			  pstate,
			  pzip,
			  null,             -- address flag
		  	  pB_AREA_CODE    ,
			  pB_PHONE_NO     ,
			  pH_AREA_CODE    ,
			  pH_PHONE_NO     ,
			  pEXTENSION      ,
		 	  pEMAIL          ,
			  pEMP_SCHOOL     ,
			  pNEW_DONOR_FLAG ,
			  pETHNIC_GROUP   ,
			  pINSERT_DATE    ,
			  pINSERT_USER    ,
			  pPROGRAM_ID     ,
		          pSESSION_ID     ,
			  pPRINT_STATUS   ,
			  pDEFERRAL_STATUS,
			  pPRINT_DATE     ,
			  pDRIVE_ID       ,
			  pBLOOD_TYPE_DES ,
			  pHEIGHT         ,
			  pWEIGHT         ,
			  pALTERNATE_ID   ,
			  pALTERNATE_ID_TYPE,
			  pSCAN_ID,
                          pCREDIT_SPONSOR,
                          pLAST_SUFFIX ,
                          pALIAS,
			  pID_VERIFIED,
                          pintl_addr1,
                          pintl_addr2,
                          pintl_addr3,
                          pintl_addr4,
                          pintl_zip,
			  pcountry,
                          pintl_home_ph,
                          pintl_work_ph,
                          pintl_work_ph_ext,
                          pintl_mobile_ph,
                          pintl_fax_no,                         
                          pintl_flag,
                          pABBR_ELIG_STATUS); -- SCR 11920

  COMMIT;

 END POPULATE_NEW_DONOR_TEMP;

END ONSITE_OBJECTS;
/