 -- OLD Code commented
 /*
  select decode(instr(t_string,'DAA', 1, 1), 
                  0, 
                  decode(instr(t_string,'DAB', 1, 1), 
                         0, 
                         decode(instr(t_string,'DCS', 1, 1), 
                                0, null, 
			              substr(t_string, 
			                     (instr(t_string, 'DCS', 1, 1) + 3), 
					         (instr(t_string, '%', (instr(t_string, 'DCS', 1, 1) + 3), 1) - 1) - 
                                                             (instr(t_string, 'DCS', 1, 1) + 3) + 1)), 
			       substr(t_string, 
			              (instr(t_string, 'DAB', 1, 1) + 3), 
					  (instr(t_string, '%', (instr(t_string, 'DAB', 1, 1) + 3), 1) - 1) - 
                                                      (instr(t_string, 'DAB', 1, 1) + 3) + 1)), 
			substr(t_string, 
			       (instr(t_string, 'DAA', 1, 1) + 3), 
			       (instr(t_string, ',', (instr(t_string, 'DAA', 1, 1) + 3), 1) - 1) - 
                                               (instr(t_string, 'DAA', 1, 1) + 3) + 1))
      into p_last_name
      from dual;

    select decode(instr(t_string, 'DAA', 1, 1),
                  0, 
                  decode(instr(t_string, 'DAC', 1, 1),
                         0, 
                         decode(instr(t_string, 'DCT', 1, 1),
                                0, null, 
			              substr(t_string, (instr(t_string, 'DCT', 1, 1) + 3), 
                                       (instr(t_string,  '%', (instr(t_string, 'DCT', 1, 1) + 3), 1)) -
			                     (instr(t_string, 'DCT', 1, 1) + 3))), 
			       substr(t_string, (instr(t_string, 'DAC', 1, 1) + 3), 
                                (instr(t_string,  '%', (instr(t_string, 'DAC', 1, 1) + 3), 1)) -
			              (instr(t_string, 'DAC', 1, 1) + 3))), 
			substr(t_string, (instr(t_string,  ',', (instr(t_string, 'DAA', 1, 1) + 3), 1) + 1), 
			       (instr(t_string,  ',', (instr(t_string, 'DAA', 1, 1) + 3), 2) - 1) - 
				 (instr(t_string,  ',', (instr(t_string, 'DAA', 1, 1) + 3), 1))))
      into p_first_name
      from dual;

    dbms_output.put_line('FIRST NAME ' || p_first_name);


    select decode(instr(t_string, 'DAA', 1, 1),
                  0, 
			decode(instr(t_string, 'DAD', 1, 1),
                         0, null,
			       substr(t_string, (instr(t_string, 'DAD', 1, 1) + 3), 
                                (instr(t_string,  '%', (instr(t_string, 'DAD', 1, 1) + 3), 1)) -
			              (instr(t_string, 'DAD', 1, 1) + 3))),
			substr(t_string, (instr(t_string,  ',', (instr(t_string, 'DAA', 1, 1) + 3), 2) + 1), 
                         (instr(t_string,  ',', (instr(t_string, 'DAA', 1, 1) + 3), 3)) -
			       (instr(t_string,  ',', (instr(t_string, 'DAA', 1, 1) + 3), 2) + 1)))
      into p_mid_name
      from dual;

       dbms_output.put_line(' Mid name ' || p_mid_name);
    
    select decode(instr(t_string, 'DCU', 1, 1),
                  0, 
			decode(instr(t_string, 'DAE', 1, 1),
                         0, null,
			       substr(t_string, (instr(t_string, 'DAE', 1, 1) + 3), 
                                (instr(t_string,  '%', (instr(t_string, 'DAE', 1, 1) + 3), 1)) -
			              (instr(t_string, 'DAE', 1, 1) + 3))),
			substr(t_string, (instr(t_string, 'DCU', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DCU', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DCU', 1, 1) + 3)))
      into p_suffix
      from dual;
    dbms_output.put_line(' suffix ' || p_suffix);

    select decode(instr(t_string, 'DCL', 1, 1),
                  0, 
			null,
			substr(t_string, (instr(t_string, 'DCL', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DCL', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DCL', 1, 1) + 3)))
      into p_ethnic_grp
      from dual;
   dbms_output.put_line('ethnic ' || p_ethnic_grp);

    select decode(instr(t_string, 'DAG', 1, 1),
                  0, 
			decode(instr(t_string, 'DAL', 1, 1),
                         0, null,
			       substr(t_string, (instr(t_string, 'DAL', 1, 1) + 3), 
                                (instr(t_string,  '%', (instr(t_string, 'DAL', 1, 1) + 3), 1)) -
			              (instr(t_string, 'DAL', 1, 1) + 3))),
			substr(t_string, (instr(t_string, 'DAG', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DAG', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DAG', 1, 1) + 3)))
      into p_street
      from dual;
    dbms_output.put_line('STREET ' || p_street);

    select decode(instr(t_string, 'DAH', 1, 1),
                  0, 
			decode(instr(t_string, 'DAM', 1, 1),
                         0, null,
			       substr(t_string, (instr(t_string, 'DAM', 1, 1) + 3), 
                                (instr(t_string,  '%', (instr(t_string, 'DAM', 1, 1) + 3), 1)) -
			              (instr(t_string, 'DAM', 1, 1) + 3))),
			substr(t_string, (instr(t_string, 'DAH', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DAH', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DAH', 1, 1) + 3)))
      into p_apt_suite
      from dual;
    dbms_output.put_line('Apt Suite ' || p_apt_suite);
    select decode(instr(t_string, 'DAI', 1, 1),
                  0, 
			decode(instr(t_string, 'DAN', 1, 1),
                         0, null,
			       substr(t_string, (instr(t_string, 'DAN', 1, 1) + 3), 
                                (instr(t_string,  '%', (instr(t_string, 'DAN', 1, 1) + 3), 1)) -
			              (instr(t_string, 'DAN', 1, 1) + 3))),
			substr(t_string, (instr(t_string, 'DAI', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DAI', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DAI', 1, 1) + 3)))
      into p_city
      from dual;
    dbms_output.put_line('CITY ' || p_city);

    select decode(instr(t_string, 'DAJ', 1, 1),
                  0, 
			null,
			substr(t_string, (instr(t_string, 'DAJ', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DAJ', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DAJ', 1, 1) + 3)))
      into p_state
      from dual;
    dbms_output.put_line('state ' || p_state);
    select decode(instr(t_string, 'DAK', 1, 1),
                  0, 
			decode(instr(t_string, 'DAP', 1, 1),
                         0, null,
			       substr(t_string, (instr(t_string, 'DAP', 1, 1) + 3), 
                                (instr(t_string,  '%', (instr(t_string, 'DAP', 1, 1) + 3), 1)) -
			              (instr(t_string, 'DAP', 1, 1) + 3))),
			substr(t_string, (instr(t_string, 'DAK', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DAK', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DAK', 1, 1) + 3)))
      into p_zip
      from dual;
    dbms_output.put_line('ZIP ' || p_zip);
    select decode(instr(t_string, 'DCG', 1, 1),
                  0, 
			null,
			substr(t_string, (instr(t_string, 'DCG', 1, 1) + 3), 
                         (instr(t_string,  '%', (instr(t_string, 'DCG', 1, 1) + 3), 1)) -
			       (instr(t_string, 'DCG', 1, 1) + 3)))
      into p_country
      from dual;
    dbms_output.put_line('Country ' || p_country);
 */
 end EXTRACT_AAMVA_PDF417;


  procedure EXTRACT_CREDIT_CARD is
  begin
    null;
  end EXTRACT_CREDIT_CARD;


  procedure EXTRACT_AAMVA_MAG_STRIPE is
  begin
    null;
  end EXTRACT_AAMVA_MAG_STRIPE;


  procedure DETERMINE_STR_TYPE(p_string          in  varchar2,
                               p_string_type	 out varchar2,
                               p_status          out varchar2) is
    t_str_type              varchar2(20);
    t_status                varchar2(200);
  begin
    p_status := 'OK';

    if length(p_string) > 1 then
      if length(p_string) in (88,89,90,99) and 
         substr(p_string, 1, 1) not in ('@', '%') then
        t_str_type := 'CAC_PDF417';
      elsif length(p_string) = 18 and 
            substr(p_string, 1, 1) not in ('@', '%') then
        t_str_type := 'CAC_CODE39';
      elsif substr(p_string, 1, 1) = '@' then
        t_str_type := 'AAMVA_PDF417';
      elsif substr(p_string, 1, 1) = '%' then
        if substr(p_string, 2, 1) = 'B' then
          t_str_type := 'CREDIT_CARD';
        else
          t_str_type := 'AAMVA_MAG_STRIPE';
        end if;
      end if;
    else
      p_status := 'Error: Invalid String';
    end if;
    
    p_string_type := t_str_type;
  end DETERMINE_STR_TYPE;


  procedure EXTRACT_DONOR_DATA(p_string          in  varchar2,
                               p_string_type     out varchar2,
                               p_last_name       out varchar2,
                               p_first_name      out varchar2,
                               p_dob             out date,
                               p_ssn             out varchar2,
                               p_sex             out varchar2,
                               p_alt_id          out varchar2,
                               p_alt_type        out varchar2,
                               p_addr1           out varchar2,
                               p_addr2           out varchar2,
                               p_addr3           out varchar2,
                               p_city            out varchar2,
                               p_state           out varchar2,
                               p_zip             out varchar2,
                               p_country         out varchar2,
                               p_status          out varchar2) is
    t_bar_code_ver_code     varchar2(1);
    t_pdi                   varchar2(9);
    t_pd_type_code          varchar2(1);
    t_edipi                 varchar2(10);
    t_first_name            varchar2(20);
    t_surname               varchar2(26);
    t_dob                   date;
    t_personnel_cat_code    varchar2(1);
    t_branch_code           varchar2(1);
    t_pect                  varchar2(2);
    t_rank                  varchar2(6);
    t_pay_plan_code         varchar2(2);
    t_pay_plan_grade_code   varchar2(2);
    t_card_issue_date       date;
    t_card_exp_date         date;
    t_card_inst_idt         varchar2(1);
    t_str_type		    varchar2(20);
    t_ssn                   varchar2(9);
    t_alt_id                varchar2(15);
    t_ssn_aamva             varchar2(9);
    t_last_name             varchar2(50);
    t_first_name_aamva      varchar2(50);
    t_mid_name              varchar2(30);
    t_dob_aamva             date;
    t_sex                   varchar2(1);
    t_height                varchar2(10);
    t_alt_id_aamva          varchar2(30);
    t_alias                 varchar2(70);
    t_suffix                varchar2(50);
    t_ethnic_grp            varchar2(50);
    t_street                varchar2(100);
    t_apt_suite             varchar2(50);
    t_city                  varchar2(50);
    t_state                 varchar2(2);
    t_zip                   varchar2(20);
    t_country               varchar2(70);
    t_status                varchar2(200);
  begin
    DETERMINE_STR_TYPE(p_string, t_str_type, t_status);
    p_string_type := t_str_type;
    p_last_name := null;
    p_first_name := null;
    p_dob := null;
    p_ssn := null;
    p_sex := null;
    p_alt_id := null;
    p_alt_type := null;
    p_addr1 := null;
    p_addr2 := null;
    p_addr3 := null;
    p_city := null;
    p_state := null;
    p_zip := null;
    p_country := null;

    if t_status = 'OK' then
      if t_str_type = 'CAC_PDF417' then
        extract_cac_pdf417(p_string,
                           t_bar_code_ver_code,
				   t_pdi,
        			   t_pd_type_code,
				   t_edipi,
				   t_first_name,
				   t_surname,
				   t_dob,
				   t_personnel_cat_code,
				   t_branch_code,
				   t_pect,
				   t_rank,
				   t_pay_plan_code,
				   t_pay_plan_grade_code,
				   t_card_issue_date,
				   t_card_exp_date,
				   t_card_inst_idt,
                           t_status);

        p_last_name := t_surname;
        p_first_name := t_first_name;
        p_dob := t_dob;
        p_ssn := t_pdi;
        p_alt_id := t_edipi;
        p_status := t_status;

        /*dbms_output.put_line('Bar Code Version Code: ' || t_bar_code_ver_code);
        dbms_output.put_line('PDI: ' || t_pdi);
        dbms_output.put_line('PD Type COde: ' || t_pd_type_code);
        dbms_output.put_line('EDIPI: ' || t_edipi);
        dbms_output.put_line('First Name: ' || t_first_name);
        dbms_output.put_line('Surname: ' || t_surname);
        dbms_output.put_line('Date of Birth: ' || to_char(t_dob, 'MM-DD-YYYY'));
        dbms_output.put_line('Personnel Cat Code: ' || t_personnel_cat_code);
        dbms_output.put_line('Branch Code: ' || t_branch_code);
        dbms_output.put_line('PECT: ' || t_pect);
        dbms_output.put_line('Rank: ' || t_rank);
        dbms_output.put_line('Pay Plan Code: ' || t_pay_plan_code);
        dbms_output.put_line('Pay Plan Grade Code: ' || t_pay_plan_grade_code);
        dbms_output.put_line('Card Issue Date: ' || to_char(t_card_issue_date, 'MM-DD-YYYY'));
        dbms_output.put_line('Card Exp Date: ' || to_char(t_card_exp_date, 'MM-DD-YYYY'));
        dbms_output.put_line('Card Inst Identifier: ' || t_card_inst_idt);*/
      elsif t_str_type = 'CAC_CODE39' then
        extract_cac_code39(p_string,
				   t_ssn,
				   t_alt_id,
                           t_status);

        p_ssn := t_ssn;
        p_alt_id := t_alt_id;
        p_status := t_status;

        /*dbms_output.put_line('SSN: ' || t_ssn);
        dbms_output.put_line('Alt ID: ' || t_alt_id);*/
      elsif t_str_type = 'AAMVA_PDF417' then
        extract_aamva_pdf417(p_string,
				     t_ssn_aamva,
                             t_last_name,
                             t_first_name_aamva,
                             t_mid_name,
                             t_dob_aamva,
                             t_sex,
                             t_height,
                             t_alt_id_aamva,
                             t_alias,
                             t_suffix,
                             t_ethnic_grp,
                             t_street,
                             t_apt_suite,
                             t_city,
                             t_state,
                             t_zip,
                             t_country,
                             t_status);

        p_last_name := t_last_name;
        p_first_name := t_first_name_aamva;
        p_dob := t_dob_aamva;
        p_ssn := t_ssn_aamva;
        p_sex := t_sex;
        p_alt_id := t_alt_id_aamva;
        p_addr1 := t_street;
        p_city := t_city;
        p_state := t_state;
        p_zip := t_zip;
        p_country := t_country;
        p_status := t_status;

        dbms_output.put_line('SSN: ' || t_ssn_aamva);
        dbms_output.put_line('Last Name: ' || t_last_name);
        dbms_output.put_line('First Name: ' || t_first_name_aamva);
        dbms_output.put_line('Mid Name: ' || t_mid_name);
        dbms_output.put_line('Date of Birth: ' || to_char(t_dob_aamva, 'MM-DD-YYYY'));
        dbms_output.put_line('Sex: ' || t_sex);
        dbms_output.put_line('Height: ' || t_height);
        dbms_output.put_line('Alt ID: ' || t_alt_id_aamva);
        dbms_output.put_line('Alias: ' || t_alias);
        dbms_output.put_line('Suffix: ' || t_suffix);
        dbms_output.put_line('Ethnic Group: ' || t_ethnic_grp);
        dbms_output.put_line('Street: ' || t_street);
        dbms_output.put_line('Apt / Suite: ' || t_apt_suite);
        dbms_output.put_line('City: ' || t_city);
        dbms_output.put_line('State: ' || t_state);
        dbms_output.put_line('Zip: ' || t_zip);
        dbms_output.put_line('Country: ' || t_country);
      elsif t_str_type = 'AAMVA_MAG_STRIPE' then
        extract_aamva_mag_stripe;
      else
        extract_credit_card;
      end if;
    else
      p_status := t_status;
      dbms_output.put_line(p_status);
    end if;
  exception
    when others then
      p_status := substr(sqlerrm, 1, 100);
      dbms_output.put_line(p_status);

  end EXTRACT_DONOR_DATA;

end DOD_DONOR_INFO;

