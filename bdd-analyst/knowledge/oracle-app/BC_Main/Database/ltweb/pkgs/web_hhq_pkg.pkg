create or replace PACKAGE WEB_HHQ_PKG
AUTHID CURRENT_USER AS
/* ----------------------------------------
*
||    Program Name                : web_hhq_pkg
||    Date Creation               : LT2013
||    Current Version             : 01 : Initial version
                                  : 02 : wdr_random_insert added in filter_questions routine.  IM:9859; 01/07/2014
                                  : 03 : filter_questions routine modified for SCR 20609;
                                  : 04 : donor_questionnaire.calc_qtype signature modified.
                                  : 05 : fiter_questions routine modified to fix the sort_sequence value. 12/30/2014; -- IM 10283 
                                  : 01 : IM 720 (gender value is being passed incorrectly from ADF software.  Modified filter_questions
                                       : to use ID Type and Online ID to figure out the gender type.
                                  :02  : MLT 3369 (Added screener ask flag check)    
*/

-------------------------------------------- */
 PROCEDURE generate_questions(don_type_in IN VARCHAR2, online_id_out OUT VARCHAR2);
 PROCEDURE gen_questions(online_id_in IN VARCHAR2);
 FUNCTION abbr_enabled RETURN BOOLEAN;
 PROCEDURE filter_questions(online_id_in IN VARCHAR2, gender_in IN VARCHAR2);
 PROCEDURE send_mail (p_to        IN VARCHAR2,
                     p_from      IN VARCHAR2,
                     p_subject   IN VARCHAR2,
                     p_text_msg  IN VARCHAR2 DEFAULT NULL,
                     p_html_msg  IN VARCHAR2 DEFAULT NULL,
                     p_smtp_host IN VARCHAR2,
                     p_smtp_port IN NUMBER DEFAULT 25);
 PROCEDURE validate_ID(id_type_in IN VARCHAR2,
                       id_in IN VARCHAR2,
                       id_dob_in IN DATE,
                       fname_out OUT VARCHAR2,
                       lname_out OUT VARCHAR2,
                       is_valid_out OUT VARCHAR2,
                       error_out OUT VARCHAR2);
END WEB_HHQ_PKG;
/
create or replace PACKAGE BODY         "WEB_HHQ_PKG" AS
  PROCEDURE generate_questions(don_type_in IN VARCHAR2, online_id_out OUT VARCHAR2)
  /* not being used - Delete later */
  AS
    PRAGMA autonomous_transaction;
    nextval VARCHAR2(10);
  BEGIN
    SELECT web_online_id_seq.NEXTVAL
      INTO nextval
      FROM dual;

    nextval := 'ON' || LPAD(nextval,8,'0');

    INSERT INTO web_donor_responses
        (online_id,
         question_code,
         question_description,
         insert_date,
         sort_sequence
         )
      SELECT nextval,
             hht.question_code,
             hht.question_description,
             systimestamp,
             sort_sequence
        FROM health_history_template hht
       WHERE hht.donation_type = 'AL'
         AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE+1);

     COMMIT;
     online_id_out := nextval;

  END generate_questions;


  PROCEDURE gen_questions(online_id_in IN VARCHAR2)
  /* not being used - Delete later */
  AS
    PRAGMA autonomous_transaction;
    nextval VARCHAR2(10);
  BEGIN
    INSERT INTO web_donor_responses
        (online_id,
         template_id,
         question_code,
         question_description,
         gender,
         sub_question_flag,
         parent_question_code,
         insert_date,
         sort_sequence
         )
      SELECT online_id_in,
             template_id,
             hht.question_code,
             hht.question_description,
             hht.gender,
             sub_question_flag,
             parent_question_code,
             systimestamp,
             sort_sequence
        FROM health_history_template hht
       WHERE hht.donation_type = 'AL'
         AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE+1);

     COMMIT;

  END gen_questions;

  FUNCTION abbr_enabled RETURN BOOLEAN IS
   CURSOR hh_template_cur IS
    SELECT 1
      FROM health_history_template
     WHERE donation_type = 'AL'
       AND NVL(abbr_flag, 'N') = 'Y'
       AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE +1);
   l_dummy PLS_INTEGER;
   l_cur_found BOOLEAN;
 BEGIN
 	OPEN hh_template_cur;
 	FETCH hh_template_cur INTO l_dummy;
 	l_cur_found := hh_template_cur%FOUND;
 	CLOSE hh_template_cur;

 	RETURN l_cur_found;
 END abbr_enabled;
 ---
  PROCEDURE filter_questions(online_id_in IN VARCHAR2, gender_in IN VARCHAR2)
  AS
    PRAGMA autonomous_transaction;
    nextval VARCHAR2(10);

    CURSOR hh_template_cur IS
    SELECT hht.randomization_flag
      FROM health_history_template hht
     WHERE hht.donation_type = 'AL'
       AND SYSDATE BETWEEN hht.eff_date AND NVL(hht.term_date, SYSDATE+1);

    CURSOR donor_type_cur(p_onlineID VARCHAR2) IS
      SELECT id_type, id
        FROM web_donor_responses_hdr
       WHERE online_id = p_onlineID;

     CURSOR gender_cur(p_donorID VARCHAR2, p_scanID VARCHAR2, p_altID VARCHAR2) IS
       SELECT gender, donor_id -- Abbr SCR
         FROM donors
        WHERE donor_id = NVL(p_donorID, donor_id)
          AND NVL(scan_id,'@#') = NVL(p_scanID, NVL(scan_id, '@#')) -- IM: 9512; 08/14/2013
          AND NVL(alternate_id,'@#') = NVL(p_altID, NVL(alternate_id, '@#')); --IM:9512; 08/14/2013

    l_id_type VARCHAR2(5);
    l_id VARCHAR2(2000);
    l_random_flag VARCHAR2(1);
    l_donor_gender VARCHAR2(1);
    l_abbr_flag VARCHAR2(1); -- Abbr SCR
    l_donor_id  VARCHAR2(10);-- Abbr SCR
    l_qtype_calc VARCHAR2(1);-- Abbr SCR
    l_qtype_actual VARCHAR2(1);-- Abbr SCR
    l_qtype_comments VARCHAR2(1000);-- Abbr SCR
    l_qtype_reset_flag VARCHAR2(1);-- Abbr SCR
    l_error VARCHAR2(2000); --Abbr SCR

    -- SCR 20609; 07/15/2014
    -- This function returns abbreviated question description if it is configured in valid_hh_questions table, otherwise returns NULL;
    FUNCTION abbr_QDesc(qCode_in IN VARCHAR2) RETURN VARCHAR2 IS
      CURSOR hht_cur IS
       SELECT abbr_flag
         FROM health_history_template
        WHERE question_code =  qCode_in
          AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE+1);

      CURSOR vhq_cur IS
      SELECT question_description
        FROM valid_hh_questions
       WHERE question_code = qCode_in || '-A';

      l_qDesc VARCHAR2(1000) := NULL;
      l_abbrFlag VARCHAR2(1);
    BEGIN
        -- check if the question is setup for abbreviated questionnaire in health_history_template.
        OPEN hht_cur;
        FETCH hht_cur INTO l_abbrFlag;
        CLOSE hht_cur;

        IF NVL(l_abbrFlag,'N') = 'Y' THEN
          -- Get abbreviated question description if it is configured from valid_hh_quesetions table
          OPEN vhq_cur;
          FETCH vhq_cur INTO l_qDesc;
          CLOSE vhq_cur;
        END IF;
      RETURN l_qDesc;
    END abbr_QDesc;
    ------------------

    PROCEDURE wdr_random_insert IS
      /* Get the sequence number and question code for parent quesiton that have child questions */
       CURSOR wdr_cur IS
         SELECT sort_sequence, question_code
           FROM web_donor_responses
          WHERE online_id = online_id_in
            AND sub_question_flag = 'Y' ;
    BEGIN
      /* Insert only parent questions - do not insert child quesitons */
      INSERT INTO web_donor_responses
              (online_id,
               template_id,
               question_code,
               question_description,
               gender,
               sub_question_flag,
               parent_question_code,
               insert_date,
               sort_sequence
               )
            SELECT online_id_in,
                   hht.template_id,
                   hht.question_code,
                   hht.question_description,
                   hht.gender,
                   hht.sub_question_flag,
                   hht.parent_question_code,
                   systimestamp,
                   ROW_NUMBER() OVER (PARTITION BY 1 ORDER BY dbms_random.value)
              FROM health_history_template hht
             WHERE hht.donation_type = 'AL'
               --AND (hht.gender = 'A' OR hht.gender = NVL(gender_in, l_donor_gender)) -- Gender Filteration. ('A' and 'M'/'F')
               AND (hht.gender = 'A' OR hht.gender = NVL(l_donor_gender, gender_in)) -- IM 720    
               AND NVL(abbr_flag, 'N') IN ('Y', NVL(l_abbr_flag, 'N')) -- Abbr SCR
               AND NVL(hht.screener_ask, 'X') = 'D' -- MLT 3369
               AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE+1)
               AND parent_question_code IS NULL;

      /* For each parent question that has child questions, insert the child quesitons.  If parent question has sequence 5, child
      question will have sequence 5.1, 5.2 ...  */
      FOR wdr_rec IN wdr_cur LOOP
          INSERT INTO web_donor_responses
            (online_id,
             template_id,
             question_code,
             question_description,
             gender,
             sub_question_flag,
             parent_question_code,
             insert_date,
             sort_sequence
             )
          SELECT   online_id_in,
                   hht.template_id,
                   hht.question_code,
                   hht.question_description,
                   hht.gender,
                   hht.sub_question_flag,
                   hht.parent_question_code,
                   systimestamp,
                   wdr_rec.sort_sequence || '.' || ROW_NUMBER() OVER (PARTITION BY PARENT_QUESTION_CODE ORDER BY hht.sort_sequence)
              FROM health_history_template hht
             WHERE hht.donation_type = 'AL'
               AND (hht.gender = 'A' OR hht.gender = NVL(gender_in, l_donor_gender)) -- Gender Filteration. ('A' and 'M'/'F')
               AND NVL(abbr_flag, 'N') IN ('Y', NVL(l_abbr_flag, 'N')) -- Abbr SCR
               AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE+1)
               AND parent_question_code = wdr_rec.question_code;
     END LOOP;
    END wdr_random_insert;

  BEGIN
    -- Get the gender for existing donor.
    --For this, get the ID type, so that we can search the donors table based on the ID used.
    l_id_type := NULL;
    l_id := NULL;
    OPEN donor_type_cur(online_id_in);
    FETCH donor_type_cur INTO l_id_type, l_id;
    CLOSE donor_type_cur;

    IF l_id_type IS NOT NULL THEN
      l_donor_gender := NULL;
			IF l_ID_type = 'DNRID' THEN -- Donor ID;
				OPEN gender_cur(l_id, NULL, NULL);
				FETCH gender_cur INTO l_donor_gender, l_donor_id; --Abbr SCR
        CLOSE gender_cur;
			ELSIF l_ID_type = 'SCNID' THEN -- Scan ID;
				OPEN gender_cur(NULL, l_id, NULL);
				FETCH gender_cur INTO l_donor_gender, l_donor_id; --Abbr SCR
        CLOSE gender_cur;
			ELSIF l_ID_type = 'DRVID' THEN -- Driver's License ID;
				OPEN gender_cur(l_id, NULL, NULL);
				FETCH gender_cur INTO l_donor_gender, l_donor_id; --Abbr SCR
        CLOSE gender_cur;
			END IF;
    ELSE
      l_donor_gender := gender_in; -- IM 720 (NEW DONOR scenario where ID TYPE is not entered)
    END IF;

    ------------------ Abbr SCR
    IF abbr_enabled THEN
      IF l_donor_id IS NOT NULL THEN
        donor_questionnaire.calc_qtype( donor_id_in => l_donor_id ,
                                       coll_date_in => SYSDATE,
                                       don_type_in => 'AL', -- V04;
                                       qtype_out => l_qtype_calc,
                                       comments_out => l_qtype_comments,
                                       reset_flag_out => l_qtype_reset_flag,
                                       err_out => l_error
                                       );
        IF l_error IS NOT NULL THEN
          l_qtype_calc := 'F';
          l_qtype_comments := l_error;
        END IF;
      ELSE -- New Donor.
        l_qtype_calc := 'F';
      END IF;

      l_qtype_actual := l_qtype_calc;
      --
      INSERT INTO donor_hhq_history
      (donor_id, transaction_id, online_id, calc_af_qtype, actual_af_qtype,
      reset_flag, comments, program_id, insert_date, insert_user, audit_key)
      VALUES
      (l_donor_id, null, online_id_in, l_qtype_calc, l_qtype_actual,
       l_qtype_reset_flag, l_qtype_comments, 'WEB_HHQ_PKG', SYSDATE, USER, NULL
      );
    ELSE -- abbr is not enabled
      l_qtype_calc := 'F';
    END IF;

    IF l_qtype_calc = 'A' THEN
      l_abbr_flag := 'Y';
    ELSE
      l_abbr_flag := 'N';
    END IF;
    ------------------------------

    l_random_flag := 'N';

    OPEN hh_template_cur;
    FETCH hh_template_cur INTO l_random_flag;
    CLOSE hh_template_cur;

    IF l_random_flag = 'Y' THEN
      /* procedure added to insert questions in random order.  Modified this logic to fix the issue where
        child questions are displayed before parent questions
      */
      wdr_random_insert;
      /*
      INSERT INTO web_donor_responses
          (online_id,
           template_id,
           question_code,
           question_description,
           gender,
           sub_question_flag,
           parent_question_code,
           insert_date,
           sort_sequence
           )
        SELECT online_id_in,
               hht.template_id,
               hht.question_code,
               hht.question_description,
               hht.gender,
               hht.sub_question_flag,
               hht.parent_question_code,
               systimestamp,
               ROW_NUMBER() OVER (PARTITION BY 1 ORDER BY dbms_random.value)
          FROM health_history_template hht
         WHERE hht.donation_type = 'AL'
           AND (hht.gender = 'A' OR hht.gender = NVL(gender_in, l_donor_gender)) -- Gender Filteration. ('A' and 'M'/'F')
           AND NVL(abbr_flag, 'N') IN ('Y', NVL(l_abbr_flag, 'N')) -- Abbr SCR
           AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE+1);
         */
     ELSE
      INSERT INTO web_donor_responses
          (online_id,
           template_id,
           question_code,
           question_description,
           gender,
           sub_question_flag,
           parent_question_code,
           insert_date,
           sort_sequence
           )
        SELECT online_id_in,
               hht.template_id,
               hht.question_code,
               hht.question_description,
               hht.gender,
               hht.sub_question_flag,
               hht.parent_question_code,
               systimestamp,
               hht.display_order -- hht.sort_sequence -- IM 10283 --12/30/2014 -- V05 -- LifeTrak sorts by display_order so insert this into sort_sequence which is used for sorting in FTRAK.
          FROM health_history_template hht
         WHERE hht.donation_type = 'AL'
           --AND (hht.gender = 'A' OR hht.gender = NVL(gender_in, l_donor_gender)) -- Gender Filteration. ('A' and 'M'/'F')
           AND (hht.gender = 'A' OR hht.gender = NVL(l_donor_gender, gender_in)) -- IM 720
           AND NVL(abbr_flag, 'N') IN ('Y', NVL(l_abbr_flag, 'N')) -- Abbr SCR
           AND NVL(hht.screener_ask, 'X') = 'D' -- MLT 3369
           AND SYSDATE BETWEEN hht.eff_date AND NVL(hht.term_date, SYSDATE+1);
     END IF;

     -- SCR 20609; 07/15/2014
     IF NVL(l_abbr_flag,'N') = 'Y' THEN -- abbreviated questionnaire will be administered.
       DECLARE
          CURSOR wdr_cur IS
            SELECT question_code
              FROM web_donor_responses
             WHERE online_id = online_id_in;
          l_QDesc VARCHAR2(2000) := NULL;
       BEGIN
          FOR wdr_rec IN wdr_cur
          LOOP
             l_QDesc := abbr_QDesc(wdr_rec.question_code); -- returns abbreviated Question Description if configured, otherwise returns NULL.
             IF l_QDesc IS NOT NULL THEN
                -- Update descriptions with the new abbreivated descriptions
                UPDATE web_donor_responses
                   SET question_description = l_QDesc
                 WHERE online_id = online_id_in
                   AND question_code = wdr_rec.question_code;
             END IF;
          END LOOP;
       END;
     END IF;

     COMMIT;

  END filter_questions;

PROCEDURE send_mail (p_to        IN VARCHAR2,
                                       p_from      IN VARCHAR2,
                                       p_subject   IN VARCHAR2,
                                       p_text_msg  IN VARCHAR2 DEFAULT NULL,
                                       p_html_msg  IN VARCHAR2 DEFAULT NULL,
                                       p_smtp_host IN VARCHAR2,
                                       p_smtp_port IN NUMBER DEFAULT 25)
AS
/* not being used - Delete later */
  l_mail_conn   UTL_SMTP.connection;
  l_boundary    VARCHAR2(50) := '----=*#abc1234321cba#*=';
BEGIN
  l_mail_conn := UTL_SMTP.open_connection(p_smtp_host, p_smtp_port);
  UTL_SMTP.helo(l_mail_conn, p_smtp_host);
  UTL_SMTP.mail(l_mail_conn, p_from);
  UTL_SMTP.rcpt(l_mail_conn, p_to);

  UTL_SMTP.open_data(l_mail_conn);

  UTL_SMTP.write_data(l_mail_conn, 'Date: ' || TO_CHAR(SYSDATE, 'DD-MON-YYYY HH24:MI:SS') || UTL_TCP.crlf);
  UTL_SMTP.write_data(l_mail_conn, 'To: ' || p_to || UTL_TCP.crlf);
  UTL_SMTP.write_data(l_mail_conn, 'From: ' || p_from || UTL_TCP.crlf);
  UTL_SMTP.write_data(l_mail_conn, 'Subject: ' || p_subject || UTL_TCP.crlf);
  UTL_SMTP.write_data(l_mail_conn, 'Reply-To: ' || p_from || UTL_TCP.crlf);
  UTL_SMTP.write_data(l_mail_conn, 'MIME-Version: 1.0' || UTL_TCP.crlf);
  UTL_SMTP.write_data(l_mail_conn, 'Content-Type: multipart/alternative; boundary="' || l_boundary || '"' || UTL_TCP.crlf || UTL_TCP.crlf);

  IF p_text_msg IS NOT NULL THEN
    UTL_SMTP.write_data(l_mail_conn, '--' || l_boundary || UTL_TCP.crlf);
    UTL_SMTP.write_data(l_mail_conn, 'Content-Type: text/plain; charset="iso-8859-1"' || UTL_TCP.crlf || UTL_TCP.crlf);

    UTL_SMTP.write_data(l_mail_conn, p_text_msg);
    UTL_SMTP.write_data(l_mail_conn, UTL_TCP.crlf || UTL_TCP.crlf);
  END IF;

  IF p_html_msg IS NOT NULL THEN
    UTL_SMTP.write_data(l_mail_conn, '--' || l_boundary || UTL_TCP.crlf);
    UTL_SMTP.write_data(l_mail_conn, 'Content-Type: text/html; charset="iso-8859-1"' || UTL_TCP.crlf || UTL_TCP.crlf);

    UTL_SMTP.write_data(l_mail_conn, p_html_msg);
    UTL_SMTP.write_data(l_mail_conn, UTL_TCP.crlf || UTL_TCP.crlf);
  END IF;

  UTL_SMTP.write_data(l_mail_conn, '--' || l_boundary || '--' || UTL_TCP.crlf);
  UTL_SMTP.close_data(l_mail_conn);

  UTL_SMTP.quit(l_mail_conn);
END send_mail;


PROCEDURE validate_ID(id_type_in IN VARCHAR2,  -- type if ID - Donor ID, Drivers License, Scan ID
                      id_in IN VARCHAR2,       -- ID value
                      id_dob_in IN DATE, -- Date of Birth of ID to confirm the Donor.
                      fname_out OUT VARCHAR2,
                      lname_out OUT VARCHAR2,
                      is_valid_out OUT VARCHAR2,
                      error_out OUT VARCHAR2)
                      -- Originally thought of using Boolean for return variable, but needs additional coding in Java
                      -- for Boolean type as it is not supported in JDBC.  Modified it to VARCHAR2.
                      -- Returns ('VALID' or 'INVALID');
IS
  l_dummy PLS_INTEGER;
  l_cur_found BOOLEAN;

  FUNCTION get_error(err_code_in VARCHAR2) RETURN VARCHAR2
  IS
    l_error VARCHAR2(70);
    CURSOR error_cur IS
      SELECT error
        FROM valid_errors
       WHERE error_code = err_code_in;
  BEGIN
    l_error := NULL;
    OPEN error_cur;
    FETCH error_cur INTO l_error;
    CLOSE error_cur;

    l_error := 'Err:' || err_code_in || ': ' || NVL(l_error, 'Error Missing');

    RETURN(l_error);

  END get_error;

  FUNCTION is_valid_drvlicID(lic_id_in IN VARCHAR2, firstName_out OUT VARCHAR2, lastName_out OUT VARCHAR2, err_out OUT VARCHAR2) RETURN BOOLEAN
  IS
    l_string VARCHAR2(2000);
    l_string_type VARCHAR2(100);
    l_last_name VARCHAR2(100) ;
    l_first_name VARCHAR2(100);
    l_dob DATE;
    l_ssn VARCHAR2(100);
    l_sex VARCHAR2(100);
    l_alt_id VARCHAR2(100);
    l_alt_type VARCHAR2(100);
    l_addr1 VARCHAR2(100);
    l_addr2 VARCHAR2(100);
    l_addr3 VARCHAR2(100);
    l_city VARCHAR2(100);
    l_state VARCHAR2(100);
    l_zip VARCHAR2(10);
    l_country VARCHAR2(10);
    l_status VARCHAR2(10);
    l_err_code VARCHAR2(20);
    l_dummy PLS_INTEGER;
    l_valid_donor BOOLEAN;
    error_exit EXCEPTION;
    CURSOR donorID_cur(altID_in VARCHAR2, donor_dob_in DATE) IS
    SELECT first_name, last_name
      FROM donors
     WHERE alternate_id = altID_in
       AND date_of_birth = NVL(donor_dob_in, date_of_birth);
  BEGIN

        l_valid_donor := FALSE;
        OPEN donorID_cur(lic_id_in, id_dob_in);
        FETCH donorID_cur INTO firstName_out, lastName_out;
        l_valid_donor := donorID_cur%FOUND;
        CLOSE donorID_cur;

        IF NOT l_valid_donor THEN
          err_out := get_error('18031');
        END IF;

        RETURN l_valid_donor;

/*
		  l_string := UPPER(lic_id_in);
		  l_string := REPLACE(lic_id_in, CHR(10), '');

		  -- get the values from package.
			DOD_DONOR_INFO.EXTRACT_DONOR_DATA(l_string,
		                               l_string_type,
		                               l_last_name,
		                               l_first_name,
		                               l_dob,
		                               l_ssn, --- 9 digit or 4 digits;
		                               l_sex,
		                               l_alt_id,
		                               l_alt_type,
		                               l_addr1,
		                               l_addr2,
		                               l_addr3,
		                               l_city,
		                               l_state,
		                               l_zip,
		                               l_country,
		                               l_status);

    IF l_status <> 'OK' OR l_alt_id IS NULL THEN
      l_err_code := '21094';
      RAISE error_exit;
    ELSE
      IF l_string_type IS NULL OR l_string_type LIKE 'CAC%' THEN
        l_err_code := '21094';
        RAISE error_exit;
      ELSIF l_string_type = 'AAMVA_PDF417' THEN
        l_valid_donor := FALSE;
        OPEN donorID_cur(l_alt_id, id_dob_in);
        FETCH donorID_cur INTO l_dummy;
        l_valid_donor := donorID_cur%FOUND;
        CLOSE donorID_cur;

        IF NOT l_valid_donor THEN
          err_out := get_error('18031');
        END IF;

        RETURN l_valid_donor;
      END IF;
    END IF;
 */
  EXCEPTION
    WHEN error_exit THEN
      err_out := get_error(l_err_code);
      RETURN FALSE;
    WHEN OTHERS then
      err_out := 'Err: ' || SQLCODE || '-' || SUBSTR(SQLERRM,1,100);
      RETURN FALSE;
  END is_valid_drvlicID;

  FUNCTION is_valid_donor(donor_id_in IN VARCHAR2, firstName_out OUT VARCHAR2, lastName_out OUT VARCHAR2, err_out OUT VARCHAR2) RETURN BOOLEAN
  IS
    l_dummy PLS_INTEGER;
    l_valid_donor BOOLEAN;
    CURSOR donorID_cur(donorID_in VARCHAR2, donor_dob_in DATE) IS
    SELECT first_name, last_name
      FROM donors
     WHERE donor_id = donorID_in
       AND date_of_birth = NVL(donor_dob_in, date_of_birth);
  BEGIN
    err_out := NULL;
    l_valid_donor := FALSE;
    OPEN donorID_cur(donor_id_in, id_dob_in);
    FETCH donorID_cur INTO firstName_out, lastName_out;
    l_valid_donor := donorID_cur%FOUND;
    CLOSE donorID_cur;

    IF NOT l_valid_donor THEN
      err_out := get_error('18031');
    END IF;

    RETURN l_valid_donor;

  END is_valid_donor;

  FUNCTION is_valid_scanID(scan_id_in IN VARCHAR2, firstName_out OUT VARCHAR2, lastName_out OUT VARCHAR2, err_out OUT VARCHAR2) RETURN BOOLEAN
  IS
    l_bc_scan_re VARCHAR2(30);
    l_cur_found BOOLEAN;
    l_error VARCHAR2(70) := NULL;
    l_err_code VARCHAR2(20);
    l_final_scan VARCHAR2(30);
    l_str_stream VARCHAR2(20);
    l_sNochkdgt VARCHAR2(20);
    l_chkDigit VARCHAR2(2);
    l_bc_scan_id VARCHAR2(30);
    l_valid_donor BOOLEAN;
    l_dummy PLS_INTEGER;
    error_exit EXCEPTION;

    CURSOR param_cur(param_code_in VARCHAR2) IS
      SELECT UPPER(parameter_value)
        FROM valid_parameters
       WHERE parameter_code = param_code_in
         AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE+1);

    CURSOR donors_cur(scanID_in VARCHAR2, dob_in DATE) IS
    SELECT first_name, last_name
      FROM DONORS
     WHERE scan_id = scanID_in
       AND date_of_birth = NVL(dob_in, date_of_birth);

    FUNCTION get_modulo_10_chkdgt(plStream in varchar2 ) RETURN CHAR IS
       RefNumber NUMBER;
       SumRefNo  Number:=0;
       szRemain  NUMBER;
      szCheckDigit  NUMBER;
    BEGIN
        --Weight (2,1) algorithm is used to calculate the checkdigit.
        --Multiple the add numbers by 2 and the even numbers by 1
        --For complete algorithm check www.n-barcode.com

         FOR I in 1 .. Length(plStream) Loop
             -- step 1: Get the weight either 2 or 1
             If Mod(I,2) <> 0 then
                RefNumber:=2;
             Else
                RefNumber:=1;
             End If;
             sumRefNo:=SumRefNo + (  TO_NUMBER(substr(plstream,I,1)) * RefNumber);
         END LOOP;
         --message('sum='||to_char(sumRefNo));pause;
         szRemain:=MOD(sumRefNo,10);
         szCheckDigit:= szRemain;

        /* szCheckDigit:= 10 - szRemain;
           If szCheckDigit = 10 then
             szCheckDigit:=0;
           End If;
       */

         return (to_char(szCheckDigit));
    END get_modulo_10_chkdgt;

  BEGIN

    l_bc_scan_re := NULL;
    -- BC SCAN RE Check
    OPEN param_cur('BC_SCAN_RE');
    FETCH param_cur INTO l_bc_scan_re;
    l_cur_found := param_cur%FOUND;
    CLOSE param_cur;

    IF NOT l_cur_found OR NVL(l_bc_scan_re,'N') = 'N' THEN
      l_err_code := '21088';
      RAISE error_exit;
    END IF;
    ---- BC_SCAN_RE Check complete.

    -- BC_SCAN_ID;
    OPEN param_cur('BC_SCAN_ID');
    FETCH param_cur INTO l_bc_scan_id;
    l_cur_found := param_cur%FOUND;
    CLOSE param_cur;

    IF NOT l_cur_found OR NVL(l_bc_scan_id,'N') = 'N' THEN
      l_err_code := '21086';
      RAISE error_exit;
    END IF;

  -- Validate Scan ID;
    -- Check 1
    IF LENGTH(scan_id_in) != 15 THEN
      l_err_code := '21085'; --Invalid scan length for donor Scan ID
      RAISE error_exit;
    END IF;

    -- Check 2
    IF SUBSTR(scan_id_in, 1, 1) != '*' OR SUBSTR(scan_id_in, 15, 1) != '*' THEN
      l_err_code := '21094'; -- Invalid Donor Scan ID
      RAISE error_exit;
    END IF;
    --DBMS_OUTPUT.PUT_LINE('END CHECK 2');
    -- Check 3
    l_str_stream := SUBSTR(scan_id_in, 2, 13);
    l_sNochkdgt := SUBSTR(l_str_stream, 1, 8) || SUBSTR(l_str_stream, 10, 4);
    -- BC_DATA_CHECK_IS_OK
    IF SUBSTR(l_str_stream, 1, 4) != LTRIM(l_bc_scan_id) THEN
      l_err_code := '21089'; --Invalid Donor Scan ID prefix.
      RAISE error_exit;
    END IF;
    --
    --DBMS_OUTPUT.PUT_LINE('IN CHECK 3');
    l_chkDigit := GET_MODULO_10_CHKDGT(l_sNochkdgt);
    IF l_chkDigit = SUBSTR(l_str_stream,9,1) THEN
      l_final_scan := l_str_stream;
    ELSE
      l_err_code := '21097';
      RAISE error_exit;
    END IF;
    --DBMS_OUTPUT.PUT_LINE('END CHECK 3');
    -- End Check 3;
  -- End Validate Scan ID;

  -- Final Check for confirmation field (DoB)
  IF id_dob_in IS NOT NULL THEN
    OPEN donors_cur(l_final_scan, id_dob_in);
    FETCH donors_cur INTO firstName_out, lastName_out;
    l_valid_donor := donors_cur%FOUND;
    CLOSE donors_cur;
    --DBMS_OUTPUT.PUT_LINE('SCAN ID ' ||l_final_scan || '-' || to_char(id_dob_in, 'mmddyyyy'));
    IF NOT l_valid_donor THEN
      err_out := get_error('21094'); -- Invalid Donor Scan ID;
    END IF;

    RETURN l_valid_donor;
  END IF;

    RETURN TRUE;

  EXCEPTION
  WHEN error_exit THEN
    err_out := get_error(l_err_code);
    --err_out := 'Err:' || l_err_code || ': ' || NVL(l_error, 'Error Missing');
    RETURN FALSE;
  WHEN OTHERS then
    err_out := 'Err: ' || SQLCODE || '-' || SUBSTR(SQLERRM,1,100);
    RETURN FALSE;
  END is_valid_scanID;

BEGIN
  IF id_type_in = 'DNRID' THEN
    IF is_valid_donor(id_in, fname_out, lname_out, error_out) THEN
      is_valid_out := 'VALID';
    ELSE
      is_valid_out := 'INVALID';
    END IF;
  END IF;

  IF id_type_in = 'SCNID' THEN
    IF is_valid_scanID(id_in, fname_out, lname_out, error_out) THEN
      is_valid_out := 'VALID';
    ELSE
      is_valid_out := 'INVALID';
    END IF;
  END IF;

  IF id_type_in = 'DRVID' THEN
    IF is_valid_drvlicID(id_in, fname_out, lname_out, error_out) THEN
      is_valid_out := 'VALID';
    ELSE
      is_valid_out := 'INVALID';
    END IF;
  END IF;
END validate_ID;

END WEB_HHQ_PKG;
/
