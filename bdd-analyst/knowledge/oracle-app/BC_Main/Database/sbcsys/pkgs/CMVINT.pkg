CREATE OR REPLACE PACKAGE CMVINT IS

   PROCEDURE donor_to_lab_unit_data
             (in_unit_id          IN      VARCHAR2,
              in_chapter_id       IN      VARCHAR2,
              in_from_date        IN      DATE,
              in_to_date          IN      DATE,
              io_interface_id     IN OUT  VARCHAR2);

END CMVINT;
/
CREATE OR REPLACE PACKAGE BODY CMVINT IS
   PROCEDURE donor_to_lab_unit_data
                (in_unit_id          IN      VARCHAR2,
                 in_chapter_id       IN      VARCHAR2,
                 in_from_date        IN      DATE,
                 in_to_date          IN      DATE,
                 io_interface_id     IN OUT  VARCHAR2)
   IS
      session_id              date;
      number_of_rejects       number(8);
      number_of_success       number(8);
      interface_id            varchar2(10);
      new_interface_id        number(8);
   BEGIN
     null;
   END donor_to_lab_unit_data;
END CMVINT;
/

Create or replace public synonym CMVINT for OPS$DONSYS.CMVINT
/

Grant execute on OPS$DONSYS.CMVINT to UTIL,DBADMN,LT_DONOR,LTAPI
/




