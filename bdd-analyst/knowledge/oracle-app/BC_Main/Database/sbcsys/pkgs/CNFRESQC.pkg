create or replace package CNFRESQC is

  -- Author  : ASHOKV
  -- Created : 9/6/2018 4:51:45 PM
  -- Purpose : Schedule tests using test series configuration table
  
  -- Public type declarations
  
  -- Public constant declarations

  -- Public variable declarations
  --TYPE units_rt IS RECORD(unit_id VARCHAR2(15), chapter_id VARCHAR2(4), coll_date DATE, qc_reason VARCHAR2(200));
  --TYPE units_aat IS TABLE OF units_rt INDEX BY BINARY_INTEGER; 
  TYPE units_cnt_rt IS RECORD(total_units NUMBER, skipped_units NUMBER, incomp_res_units NUMBER, SQC_units  NUMBER);
  
  /*
  -- Public function and procedure declarations
  PROCEDURE compute_qc_test_flag(p_test_series_id IN VARCHAR2, 
                                p_test_id         IN VARCHAR2, 
                                p_chapter_id      IN VARCHAR2, 
                                p_units_qc        OUT units_aat, 
                                p_units_cnt       OUT units_cnt_rt,
                                p_status          OUT VARCHAR2  -- status -- 'OK' or error msg.
                                );

 */                                
  procedure gen_Exception_log(p_session_id IN VARCHAR2,
                                 p_chapter_id IN VARCHAR2,
                                 p_user_id    IN VARCHAR2, 
                                 p_status OUT VARCHAR2);
                                 

  PROCEDURE compute_qc( p_session_id    IN VARCHAR2,
                        p_chapter_id    IN VARCHAR2,
                        p_series_id     IN VARCHAR2, 
                        p_test_id       IN VARCHAR2,
                        p_qc_totals     OUT units_cnt_rt,
                        p_status        OUT VARCHAR2);
                        
                    
end CNFRESQC;
/
create or replace package body CNFRESQC is
  -- Author  : ASHOKV
  -- Created : 9/6/2018 4:51:45 PM
  -- Purpose : Calculate QC flag, Backend pkg for CNFRESQC.fmb
  -- Versions:
     -- 01: Initial version
     -- 02: Error routines added.
     -- 03: changes made to include checkin units only
     -- 04: Count queries fixed.
     -- 05: cnf_checkin_flag can be Y or S.
     -- 06: New routine compute_qc added.
     
  -- Private type declarations
   --TYPE lines_t IS TABLE OF VARCHAR2(20000) INDEX BY BINARY_INTEGER; 
   TYPE units_rt IS RECORD(unit_id        VARCHAR2(15), 
                           chapter_id     VARCHAR2(4), 
                           coll_date      DATE, 
                           qc_reason      VARCHAR2(200));
   TYPE units_aat IS TABLE OF units_rt INDEX BY BINARY_INTEGER; 
  -- Private constant declarations

  -- Private variable declarations
  -- output       lines_t;
  
  gd_sysdate DATE;
  gv_chapter_id VARCHAR2(4);
  

 procedure clean_temp_tables(p_session_id IN VARCHAR2) is
 begin
   DELETE FROM cnf_qc_units
   WHERE session_id = p_session_id;
   
   COMMIT;
 end clean_temp_tables;
  

  procedure gen_Exception_log(p_session_id IN VARCHAR2,
                                 p_chapter_id IN VARCHAR2,
                                 p_user_id    IN VARCHAR2, 
                                 p_status OUT VARCHAR2) is
    log_file     utl_file.file_type;
    lv_file_name VARCHAR2(500);
    
    log_loc    master_codes.code_desc%TYPE := NULL;
    handle_error EXCEPTION;
    exit_process EXCEPTION;
  
    -- Get log directory location
    procedure get_log_loc is
    begin
      begin
        select code_desc into log_loc
          from master_codes
         where code_type = 'LOGDR'
           and code = 'LOGDR'
           and SYSDATE between eff_date and nvl(term_date, SYSDATE + 1);
      exception
        when no_data_found then
          p_status := 'Log Dir not maintained';
          raise handle_error;
        when others then
          p_status := 'Error in fetching Log Dir: ' || substr(sqlerrm, 1, 300);
          raise handle_error;
      end;
    end get_log_loc;
  
    procedure open_log_file is
    begin
      if utl_file.is_open(log_file) then
        utl_file.fclose(log_file);
      end if;
      lv_file_name := 'CFIRESQC_' || TO_CHAR(SYSDATE, 'MMDDYYHH24MISS') || '.log';
    
      begin
        log_file := utl_file.fopen(log_loc, lv_file_name, 'w');      
      exception
        when others then
          p_status := 'Failure to write output to ' || log_loc || '/' || lv_file_name;
          UTL_FILE.fclose(log_file);          
          raise handle_error;
      end;
    end open_log_file;
  
    procedure close_log_file is
    begin
      if utl_file.is_open(log_file) then
        utl_file.fclose(log_file);
      end if;
    end close_log_file;
    
    procedure write_log_file is
      cursor qc_cur is
        select unit_id, chapter_id, coll_date, test_series_id, test_id, qc_reason
          from cnf_qc_units
         where session_id = p_session_id
           and qc_reason <> 'OK'
           and qc_flag is not null
        order by coll_date, unit_id;
     lv_hdr_line1 VARCHAR2(200);
     lv_hdr_line2 VARCHAR2(200);
     lv_hdr_line3 VARCHAR2(200);
     lv_subtitle1 VARCHAR2(200);
     lv_subtitle2 VARCHAR2(200);
     lv_line      VARCHAR2(600);   
     lv_title     VARCHAR2(100);
     lb_rec_found BOOLEAN;
    begin
      
      lv_title     :=   'QC Exception Log';
      lv_subtitle1 :=    'Generated Time  : ' || lifetrack_timezone_convert.get_local_time(p_chapter_id, SYSDATE);
      lv_subtitle2 :=    'File Name       : ' || lv_file_name;   
      
      lv_hdr_line1 :=   RPAD('-', 105, '-');
      lv_hdr_line2 :=   RPAD('Unit ID',15, ' ') || 
                        RPAD('Chapter ID',15,' ') ||
                        RPAD('Coll. Date',15, ' ') ||
                        RPAD('Series ID', 15, ' ') ||
                        RPAD('Test ID', 15, ' ') ||
                        RPAD('QC Reason', 50, ' ');
      lv_hdr_line3 :=   RPAD('-', 105, '-');
      
      UTL_FILE.PUT_LINE(log_file, lv_title);
      UTL_FILE.PUT_LINE(log_file, lv_subtitle1);
      UTL_FILE.PUT_LINE(log_file, lv_subtitle2);
      UTL_FILE.PUT_LINE(log_file, lv_hdr_line1);
      UTL_FILE.PUT_LINE(log_file, lv_hdr_line2);
      UTL_FILE.PUT_LINE(log_file, lv_hdr_line3);     
      lb_rec_found := FALSE;
                  
      for qc_rec in qc_cur loop
        lb_rec_found := TRUE;
        lv_line  :=       RPAD(qc_rec.unit_id, 18, ' ')   || 
                          RPAD(qc_rec.chapter_id, 13, ' ') || 
                          RPAD(TO_CHAR(qc_rec.coll_date,'MM-DD-YYYY'), 15, ' ') ||
                          RPAD(NVL(qc_rec.test_series_id, ' '), 15, ' ') ||
                          RPAD(NVL(qc_rec.test_id, ' '), 15, ' ') ||
                          qc_rec.qc_reason;
                              
         UTL_FILE.PUT_LINE(log_file, lv_line);     
      end loop;                
      
      if lb_rec_found then
        NULL;
      else
         UTL_FILE.PUT_LINE(log_file, 'No Exceptions found.'); 
      end if;
      
    end write_log_file;

      -- Insert record into report parameters for retrieval of log file
    procedure insert_parm_id is
      rpt_parm_cnt NUMBER;
      lv_parm_id   VARCHAR2(50);
    begin
      lv_parm_id := 'CNFQC_EXCP_' || p_session_id;
      --lv_parm_id := p_session_id;
      begin
        select count(*)
          into rpt_parm_cnt
          from rpt_parm
         where appl_id = 'DON'
           and report_name = 'CFIRESQC'
           and user_name = p_user_id 
           and chapter_id = p_chapter_id
           and parm_id = lv_parm_id;
      end;
      
      if rpt_parm_cnt > 0 then
        -- Check if record already exists in RPT_PARM table
        begin
          update rpt_parm
             set submit_date   = sysdate,
                 report_status = 'C',
                 output_file   = lv_file_name 
           where appl_id = 'DON'
             and report_name = 'CFIRESQC'
             and user_name = p_user_id 
             and chapter_id = p_chapter_id
             and parm_id = lv_parm_id;
        end;
      else
        begin
          insert into rpt_parm (appl_id, user_name, report_name, parm_id,
                              parm_date, submit_date, report_status, output_file,
                               chapter_id) 
          values
            ('DON', p_user_id, 'CFIRESQC', lv_parm_id,
             sysdate, sysdate, 'C', lv_file_name,
             p_chapter_id
             ); 
        end;
      end if;
      
    end insert_parm_id;
    

  begin
    get_log_loc;
    open_log_file;
    write_log_file;
    close_log_file;
  
    insert_parm_id;
    --clean_temp_tables(p_session_id);
    COMMIT;
    p_status := 'OK';
  exception
    when handle_error then
      null;
    when exit_process then
      p_status := 'OK';  
    when others then
      p_status := SUBSTR(SQLERRM, 1, 400);  
  end gen_Exception_log;

/*  
