  PROCEDURE compute_qc_test_flag(p_test_series_id IN VARCHAR2, 
                                p_test_id         IN VARCHAR2, 
                                p_chapter_id      IN VARCHAR2, 
                                p_units_qc        OUT units_aat, 
                                p_units_cnt       OUT units_cnt_rt,
                                p_status          OUT VARCHAR2  -- status -- 'OK' or error msg.
                                ) IS
    /* 
       Pass either test series id or test id to this routine
       Returns table with unit ID as index and value as qc reason.
       
       QC Reasons where flag is calculated as N.
          Test(s) not resulted in UTRS
          Unit on Hold
          Test(s) found in UTB
          Test(s) found in holding_tests
          Repeat Test count mismatch             
    */                                
    nCnt NUMBER;
    lv_final_flag VARCHAR2(1);
    lv_qc_reason  VARCHAR2(200);
    nResPendCnt   NUMBER;
    nHoldCnt      NUMBER;
    nUTBCnt       NUMBER;
    nHoldTests    NUMBER;
    indx          BINARY_INTEGER;
    exit_error EXCEPTION;
    qc_fail    EXCEPTION;  
    gv_status_msg VARCHAR2(2000) := 'OK';                              
  BEGIN
     gv_chapter_id := p_chapter_id; -- NULL value indicates across chapters.     
     
     gd_sysdate := lifetrack_timezone_convert.get_local_time(NVL(p_chapter_id, lt_user_session.get_chapter_id), SYSDATE);    
     
     if p_test_series_id is null and p_test_id is null then
        gv_status_msg := 'Any of the test series id or test id must be paassed as input parameter';
        raise exit_error;
     end if;
     
     -- check input parameters.
     if p_test_series_id is not null then
        if p_test_id is not null then
          gv_status_msg := 'Either test series ID or test ID must be passed to this routine';
          raise exit_error;
        end if;
        select COUNT(1) into nCnt
          from valid_series_test_config
         where test_series_id = p_test_series_id
           and gd_sysdate between eff_date and NVL(term_date, gd_sysdate + 1);  
        if nCnt = 0 then
          gv_status_msg := 'Invalid test series ID';
          raise exit_error;           
        end if;
     end if;
     
     if p_test_id is not null then
        select COUNT(1) INTO nCnt
          from valid_tests
         where test_id = p_test_id 
           and test_group in --('CNFRM', 'SUPP')
                          ( SELECT mc.code
                              FROM master_codes mc
                             WHERE mc.code_type = 'TSTGP'
                               AND gd_sysdate between mc.eff_date and nvl(mc.term_date, gd_sysdate+1)
                          )              
           and sysdate between eff_date and nvl(term_date, sysdate + 1);
        
        if nCnt = 0 then
          gv_status_msg := 'Invalid test ID - must be from TSTGP master code group ';
          raise exit_error;
        end if;   
     end if;
     ---------------------------------------------------  
      --pl('starting process...');
      -- Start processing. 
      FOR rec in (
        select distinct unit_id, chapter_id, coll_date
          from utrs
         where chapter_id = NVL(gv_chapter_id, chapter_id)
           and qc_test_date IS NULL
          and ( (test_series_id is not null and test_series_id = p_test_series_id)
                OR 
                (test_series_id is null and test_id = p_test_id)
               )
           and result_status_1 is not null  -- V06  
           and cancel_flag is null    
           and (unit_id, coll_date, chapter_id) not in
               (select unit_id, coll_date, chapter_id
                  from RGT_CONFIRM_SKIP_SAMPLES
                 where reset_date is null
                   and reason_code != 'SQC')
           and exists (
               select 1
                  from units
                 where unit_id = utrs.unit_id
                   and cnf_checkin_flag IN ('Y','S')
                 )
           order by utrs.coll_date desc, utrs.unit_id desc        
          )
      LOOP
        BEGIN
         --pl('Unit ID ' || rec.unit_id);
         --pl('Chapter ID ' || rec.chapter_id);
         --pl('Coll Date ' || to_char(rec.coll_date, 'MMDDYYYY'));                  
         lv_qc_reason := 'OK';

        -- for test series id only, call the confirm_test_Results pkg and get the final status;
        if p_test_series_id is not null then
          --pl('Calling confirm test series pkg to get final flag');
          -- check if test series is completed.
          confirm_test_results.check_series_config
                                   (p_unit_id        => rec.unit_id,
                                    p_chapter_id     => rec.chapter_id,
                                    p_test_series_id => p_test_series_id,
                                    p_program_id     => 'CNFRESQC',
                                    p_final_flag     => lv_final_flag,
                                    p_status         => gv_status_msg
                                    );
          --PL('CTR PKG status ' || gv_status_msg);
          if gv_status_msg <> 'OK' then
            --pl('Error in confirm_test_results pkg - status ' || gv_status_msg); 
            RAISE exit_error;
          end if;      
          
          if NVL(lv_final_flag,'N') = 'N' then
            -- set qc reason to test series pending (TPEND) -- QC FLAG TO N
            lv_qc_reason := 'Incomplete test series';
            RAISE qc_fail;
          end if;
        end if;

        -- check all tests are resulted or not. 
        select COUNT(1) into nResPendCnt
          from utrs
         where unit_id = rec.unit_id
           and chapter_id = rec.chapter_id
           and coll_date = rec.coll_date
           and qc_test_date IS NULL
          and ( (test_series_id is not null and test_series_id = p_test_series_id)
                OR 
                (test_series_id is null and test_id = p_test_id)
               )
           and result_status_1 is null
           and cancel_flag is null;
           /*
           and not exists (select 'x'
                             from rgt_interim_results
                            where unit_id = rec.unit_id
                              and coll_date = rec.coll_date
                              and chapter_id = rec.chapter_id
                              and test_id = utrs.test_id);
          */     
            
        if nResPendCnt <> 0 then
          lv_qc_reason := 'Results not reconciled';
          RAISE qc_fail;            
        end if;

        
        -- all tests are resulted. -- check for HOLDS.
        select count(1) into nHoldCnt
          from unit_interdictions
         where unit_id =rec.unit_id
           and coll_date = rec.coll_date
           and chapter_id = rec.chapter_id
           and inter_code in
               (select inter_code
                  from valid_interdictions_lab
                 where inter_type = 'H');        
        
        if nHoldCnt <> 0 then
          lv_qc_reason := 'Unit on Hold';
          RAISE qc_fail;
        end if;

       
        -- check EXTRA TEST UTRS
        
        if p_test_series_id is not null then
          -- check if any test from the test series is present outside the series.
          select count(1) into nCnt
            from utrs
           where unit_id = rec.unit_id
             and coll_date = rec.coll_date
             and chapter_id = rec.chapter_id 
             and nvl(cancel_flag, 'N') = 'N'
             and nvl(test_series_id,'@#') <> p_test_series_id
             and test_id in (select test_id
                               from utrs
                              where unit_id =  rec.unit_id
                                and coll_date = rec.coll_date
                                and chapter_id = rec.chapter_id 
                                and test_series_id = p_test_series_id
                                and nvl(cancel_flag,'N') = 'N'
                             );
        elsif p_test_id is not null then
         -- check if any stand alone test is present in any other test series.
         select count(1) into nCnt
            from utrs
           where unit_id = rec.unit_id
             and coll_date = rec.coll_date
             and chapter_id = rec.chapter_id 
             and nvl(cancel_flag, 'N') = 'N'
             and test_series_id is not null
             and test_id = p_test_id;          
        end if;
        
        if nCnt <> 0 then
           lv_qc_reason := 'Extra Test in UTRS'; 
          RAISE qc_fail;          
        end if;
                                                                

        -- All tests resulted and no holds., check for extra test.
        select count(1) into nUTBCnt
          from unit_test_base
         where unit_id = rec.unit_id
           and coll_date = rec.coll_date
           and chapter_id = rec.chapter_id 
           and nvl(cancel_flag, 'N') = 'N'
           and test_id in (select test_id
                             from utrs
                            where unit_id = rec.unit_id
                              and coll_date = rec.coll_date
                              and chapter_id = rec.chapter_id
                              and ( (test_series_id is not null and test_series_id = p_test_series_id)
                                    OR 
                                    (test_series_id is null and test_id = p_test_id)
                                   )
                              and nvl(cancel_flag,'N') = 'N'
                           );
        
        if nUTBCnt <> 0 then
          lv_qc_reason := 'Unscheduled tests found'; 
          RAISE qc_fail;          
        end if;        
        
        -- check for holding tests.
        select count(1) into nHoldTests
          from holding_tests
         where unit_id = rec.unit_id
           and chapter_id = rec.chapter_id
           and result_status_1 is not null 
           and holding_status is null
           and test_id in (select test_id
                             from utrs
                            where unit_id = rec.unit_id
                              and coll_date = rec.coll_date
                              and chapter_id = rec.chapter_id
                              and ( (test_series_id is not null and test_series_id = p_test_series_id)
                                    OR 
                                    (test_series_id is null and test_id = p_test_id)
                                   )
                              and nvl(cancel_flag,'N') = 'N'
                           );

        if nHoldTests <> 0 then
          lv_qc_reason := 'Holding Tests found';
          RAISE qc_fail;
        end if;   
      
        -- check for repeat counts
        declare
           lv_reac_res      VARCHAR2(4); 
           nRepeatRqdCnt    NUMBER;
           nRepeatCnt       NUMBER;
           nNonReact        NUMBER;
           nIntRes          NUMBER;
           cursor utrs_cur is
             select distinct unit_id, test_id
               from utrs
              where unit_id = rec.unit_id
                and cancel_flag is null
                and chapter_id = rec.chapter_id
                and ( (test_series_id is not null and test_series_id = p_test_series_id)
                      OR 
                      (test_series_id is null and test_id = p_test_id)
                     )
                and exists (
                       select 1
                          from units
                         where unit_id = utrs.unit_id
                           and cnf_checkin_flag IN ('Y','S')
                         );        
        begin
           for utrs_rec in utrs_cur
           loop
             begin
               -- check if the test has reactive result;
               select distinct result_status_1 into lv_reac_res
                 from utrs
                where unit_id = rec.unit_id
                  and chapter_id = rec.chapter_id
                  and test_id = utrs_rec.test_id
                  and cancel_flag is null
                  and ( (test_series_id is not null and test_series_id = p_test_series_id)
                        OR 
                        (test_series_id is null and test_id = p_test_id)
                       )                  
                  and result_status_1 in (select code 
                                            from master_codes 
                                           where code_type = 'REAC'
                                             and gd_sysdate between eff_date and NVL(term_date, gd_sysdate+1)
                                          );
             
               -- check the number of repeats required.
               select SUM(nvl(number_of_repeats,0)) into nRepeatRqdCnt
                 from valid_test_results
                where test_id = utrs_rec.test_id
                  and result_status = lv_reac_res
                  and gd_sysdate between eff_date and NVL(term_date, gd_sysdate+1);
                  
               -- check the number of repeats done.
               select COUNT(1) into nRepeatCnt
                 from utrs
                where unit_id = rec.unit_id
                  and test_id = utrs_rec.test_id
                  and chapter_id = rec.chapter_id
                  and result_status_1 is not null
                  and cancel_flag is null
                  and ( (test_series_id is not null and test_series_id = p_test_series_id)
                        OR 
                        (test_series_id is null and test_id = p_test_id)
                       );                  
                 
               if nRepeatRqdCnt + 1 <> nRepeatCnt then -- (added 1 to include original test as well)
                 lv_qc_reason := 'Repeat Test count mismatch for ' || utrs_rec.test_id;
                 raise qc_fail;
               end if;
             exception
               when no_data_found then
                 SELECT COUNT(1) INTO nNonReact
                   FROM utrs
                  WHERE unit_id = rec.unit_id
                    AND test_id =  utrs_rec.test_id
                    AND chapter_id = rec.chapter_id
                    AND result_status_1 IS NOT NULL
                    AND cancel_flag IS NULL
                    and ( (test_series_id is not null and test_series_id = p_test_series_id)
                          OR 
                          (test_series_id is null and test_id = p_test_id)
                         ) ;
                  if nNonReact <> 1 then
                    SELECT COUNT(1) INTO nIntRes
                      FROM RGT_INTERIM_RESULTS
                     WHERE unit_id = rec.unit_id
                       AND test_id = utrs_rec.test_id
                       AND chapter_id = rec.chapter_id
                       AND result_code IS NOT NULL;
                       
                     if nIntRes = 0 then
                       lv_qc_reason := 'Repeat Test count mismatch for ' || utrs_rec.test_id || '. Not found in rgt_interim_results';
                       raise qc_fail;
                     end if;  
                  end if;   
               when too_many_rows then
                 lv_qc_reason := 'Repeat Test count mismatch for ' || utrs_rec.test_id || '. Multiple results';
                 raise qc_fail;
             end;
           end loop;
        end;      
          
         indx := NVL(p_units_qc.LAST,0) + 1;
         p_units_qc(indx).unit_id   := rec.unit_id;
         p_units_qc(indx).chapter_id := rec.chapter_id;
         p_units_qc(indx).coll_date := rec.coll_date;       
         p_units_qc(indx).qc_reason := lv_qc_reason;  --'OK'
         
      EXCEPTION
        WHEN qc_fail THEN
          --pl(lv_qc_reason);
         -- populate out table with NULL qc reasons.
         indx := NVL(p_units_qc.LAST,0) + 1;
         p_units_qc(indx).unit_id   := rec.unit_id;
         p_units_qc(indx).chapter_id := rec.chapter_id;
         p_units_qc(indx).coll_date := rec.coll_date;       
         p_units_qc(indx).qc_reason := lv_qc_reason;            
      END;    
    END LOOP; 
    

      -- Skip Count             
      select count(distinct unit_id) into p_units_cnt.skipped_units
        from utrs
       where chapter_id = NVL(gv_chapter_id, chapter_id)
         and qc_test_date IS NULL
         and cancel_flag is null
        and ( (test_series_id is not null and test_series_id = p_test_series_id)
              OR 
              (test_series_id is null and test_id = p_test_id)
             )
         and result_status_1 is not null  -- V06     
         and exists (select 'x'
                from RGT_CONFIRM_SKIP_SAMPLES
               where unit_id = utrs.unit_id
                 and coll_date = utrs.coll_date
                 and chapter_id = utrs.chapter_id
                 and reset_date is null
                 and reason_code != 'SQC')
         and exists (
               select 1
                  from units
                 where unit_id = utrs.unit_id
                   and cnf_checkin_flag IN ('Y','S')
                 );
        
      -- Total unit count       
      select count(distinct unit_id) into p_units_cnt.total_units
        from utrs
       where chapter_id = NVL(gv_chapter_id, chapter_id)
         and qc_test_date IS NULL
         and cancel_flag is null
         and result_status_1 is not null  -- V06 
        and ( (test_series_id is not null and test_series_id = p_test_series_id)
              OR 
              (test_series_id is null and test_id = p_test_id)
             )
            and exists (
               select 1
                  from units
                 where unit_id = utrs.unit_id
                   and cnf_checkin_flag IN ('Y','S')
                 );
        
      -- SQC count   
      select count(distinct unit_id) into p_units_cnt.SQC_units
        from utrs
       where chapter_id = NVL(gv_chapter_id, chapter_id)
         and qc_test_date IS NULL
         and cancel_flag is NULL
         and result_status_1 is not null  -- V06 
        and ( (test_series_id is not null and test_series_id = p_test_series_id)
              OR 
              (test_series_id is null and test_id = p_test_id)
             )
         and exists (select 'x'
                from rgt_confirm_skip_samples
               where unit_id = utrs.unit_id
                 and coll_date = utrs.coll_date
                 and chapter_id = utrs.chapter_id
                 and reset_date is null
                 and reason_code = 'SQC')
        and exists (
               select 1
                  from units
                 where unit_id = utrs.unit_id
                   and cnf_checkin_flag IN ('Y','S')
                 );           


      -- No results count           
      select count(distinct unit_id) into p_units_cnt.incomp_res_units
        from utrs
       where chapter_id = NVL(gv_chapter_id, chapter_id)
         and qc_test_date IS NULL
         and cancel_flag is NULL
          and ( (test_series_id is not null and test_series_id = p_test_series_id)
                OR 
                (test_series_id is null and test_id = p_test_id)
               )
         and (
              result_status_1 is null and cancel_flag is null
              OR
              result_status_1 is not null and cancel_flag is not null
              )
         and not exists (select 'x'
                          from rgt_confirm_skip_samples
                         where unit_id = utrs.unit_id
                           and coll_date = utrs.coll_date
                           and chapter_id = utrs.chapter_id
                           and reset_date is null)
          and exists (
             select 1
                from units
               where unit_id = utrs.unit_id
                 and cnf_checkin_flag IN ('Y','S')
               )  ;                         
                           
        /*                   
         and not exists (select 'x'
                           from rgt_interim_results
                          where unit_id = utrs.unit_id
                            and coll_date = utrs.coll_date
                            and chapter_id = utrs.chapter_id
                            and test_id = utrs.test_id);  
        */                                                         
      ----------------
        
    --pl('Close process..');
    p_status := 'OK';
    --dump_output;
    
  EXCEPTION
    WHEN exit_error THEN
      --pl(gv_status_msg);
      p_status := gv_status_msg;
      --dump_output;
    WHEN OTHERS THEN
      p_status := SUBSTR(sqlerrm,1, 200);
      --pl(p_status);
      --dump_output;
  END compute_qc_test_flag;                               


 
 PROCEDURE compute_qc( p_session_id    IN VARCHAR2,
                        p_chapter_id    IN VARCHAR2,
                        p_series_id     IN VARCHAR2, 
                        p_test_id       IN VARCHAR2,
                        p_qc_totals     OUT units_cnt_rt,
                        p_status        OUT VARCHAR2) IS

    CURSOR qc_cur IS    
        select distinct 'SRSID' lbl, test_series_id ts_id
          from utrs
         where chapter_id = NVL(p_chapter_id, chapter_id)
           and qc_test_date IS NULL
           and test_series_id is not null 
           and cancel_flag is null
           and result_status_1 is not null    
           and (unit_id, coll_date, chapter_id) not in
               (select unit_id, coll_date, chapter_id
                  from RGT_CONFIRM_SKIP_SAMPLES
                 where reset_date is null
                   and reason_code != 'SQC')
           and exists (
               select 1
                  from units
                 where unit_id = utrs.unit_id
                   and cnf_checkin_flag IN ('Y','S')
                 )
         UNION
        select distinct 'TSTID' lbl, test_id ts_id
          from utrs
         where chapter_id = NVL(p_chapter_id, chapter_id)
           and qc_test_date IS NULL
           and test_series_id is null 
           and cancel_flag is null    
           and result_status_1 is not null   
           and (unit_id, coll_date, chapter_id) not in
               (select unit_id, coll_date, chapter_id
                  from RGT_CONFIRM_SKIP_SAMPLES
                 where reset_date is null
                   and reason_code != 'SQC')
           and exists (
               select 1
                  from units
                 where unit_id = utrs.unit_id
                   and cnf_checkin_flag IN ('Y','S')
                 )
           and exists(
               select 1
                 from valid_tests vt
                where vt.test_id = utrs.test_id 
                 and vt.test_group in --('CNFRM', 'SUPP')
                                    ( SELECT mc.code
                                        FROM master_codes mc
                                       WHERE mc.code_type = 'TSTGP'
                                         AND gd_sysdate between mc.eff_date and nvl(mc.term_date, gd_sysdate+1)
                                    )                    
                 and sysdate between vt.eff_date and nvl(vt.term_date, sysdate + 1)
               ) ;
    lp_series_id     VARCHAR2(10);
    lp_test_id        VARCHAR2(10);
    lp_chapter_id     VARCHAR2(4);
    lp_status         VARCHAR2(2000);
    units_qc_tab      units_aat;
    units_cnt_rec     units_cnt_rt;
    exit_Err        EXCEPTION;
    report_err      EXCEPTION;
    lv_rep_status   VARCHAR2(2000);
    procedure init_variables is
    begin
       units_qc_tab.DELETE;
       units_cnt_rec. total_units := 0;
       units_cnt_rec.skipped_units := 0;
       units_cnt_rec.incomp_res_units := 0;
       units_cnt_rec.SQC_units := 0;      
    end init_variables;
    
    procedure cnf_qc_units_insert is   
      --lc_5_spaces VARCHAR2(5)     := RPAD(' ', 5, ' ');
      --lc_10_spaces  VARCHAR2(10)  := RPAD(' ', 10, ' ');
    begin
      for i in 1 .. units_qc_tab.COUNT loop
        insert into cnf_qc_units(session_id, unit_id, chapter_id, 
                                 coll_date, test_series_id, test_id, 
                                 qc_reason)
        values (p_session_id, units_qc_tab(i).unit_id, units_qc_tab(i).chapter_id,
                units_qc_tab(i).coll_date, lp_series_id, lp_test_id,
                units_qc_tab(i).qc_reason);
        
        /*
        if units_qc_tab(i).qc_reason <> 'OK' then
            if lv_hdr_line1 is null then
              lv_hdr_line1 := RPAD('-', 105, '-');
              lv_hdr_line2 :=   RPAD('Unit ID',15, ' ') || 
                                RPAD('Chapter ID',15,' ') ||
                                RPAD('Coll. Date',15, ' ') ||
                                RPAD('Series ID', 15, ' ') ||
                                RPAD('Test ID', 15, ' ') ||
                                RPAD('QC Reason', 50, ' ');
              lv_hdr_line3 :=  RPAD('-', 105, '-');
            end if;
              
            rep_output(NVL(rep_output.LAST,0)+1) := 
                              units_qc_tab(i).unit_id   || lc_5_spaces ||
                              units_qc_tab(i).chapter_id || lc_10_spaces ||
                              TO_CHAR(units_qc_tab(i).coll_date,'MM-DD-YYYY') || lc_5_spaces ||
                              nvl(RPAD(lp_series_id, 10, ' '), lc_10_spaces) || lc_5_spaces ||
                              nvl(RPAD(lp_test_id, 10, ' '), lc_10_spaces)  || lc_5_spaces ||
                              units_qc_tab(i).qc_reason;
        end if;
        */ 
      end loop;       
      
    end cnf_qc_units_insert;    
  BEGIN
    lp_series_id      := p_series_id;
    lp_test_id        := p_test_id;
    lp_chapter_id     := p_chapter_id;
    
    -- if test series ID only needs to be processed.
    if p_series_id is not null then
         init_variables;          
	       compute_qc_test_flag( 	p_test_series_id  => lp_series_id,
                                p_test_id         => NULL,
                                p_chapter_id			=> lp_chapter_id,
                                p_units_qc        => units_qc_tab, 
                                p_units_cnt				=> units_cnt_rec,
                                p_status          => lp_status
                             );      
        if lp_status = 'OK' then
          cnf_qc_units_insert;
          p_status    := 'OK';
          p_qc_totals := units_cnt_rec;          
        else
          raise exit_Err;
        end if;                         
    end if;
    
    -- if test_id only needs to be precessed.
    if p_test_id is not null then
	       init_variables;
         compute_qc_test_flag( 	p_test_series_id  => NULL,
                                p_test_id         => lp_test_id,
                                p_chapter_id			=> lp_chapter_id,
                                p_units_qc        => units_qc_tab, 
                                p_units_cnt				=> units_cnt_rec,
                                p_status          => lp_status
                             );            
        if lp_status = 'OK' then
          cnf_qc_units_insert;
          p_status    := 'OK';
          p_qc_totals := units_cnt_rec;           
        else
          raise exit_Err;
        end if; 
    end if;    
    
    -- check if all test series id and test ID needs to be processed.
    if p_series_id is null and p_test_id is null then

       gd_sysdate := lifetrack_timezone_convert.get_local_time(NVL(p_chapter_id, lt_user_session.get_chapter_id), SYSDATE);        
       
    
       for qc_rec in qc_cur loop
           init_variables;                     
           if qc_rec.lbl = 'SRSID' then
             lp_series_id := qc_rec.ts_id;
             lp_test_id   := null;
             compute_qc_test_flag( 	p_test_series_id  => lp_series_id,
                                    p_test_id         => NULL,
                                    p_chapter_id			=> lp_chapter_id,
                                    p_units_qc        => units_qc_tab, 
                                    p_units_cnt				=> units_cnt_rec,
                                    p_status          => lp_status
                                 );  
           elsif qc_rec.lbl = 'TSTID' then
             lp_series_id := null;
             lp_test_id   := qc_rec.ts_id;
             compute_qc_test_flag( 	p_test_series_id  => NULL,
                                    p_test_id         => lp_test_id,
                                    p_chapter_id			=> lp_chapter_id,
                                    p_units_qc        => units_qc_tab, 
                                    p_units_cnt				=> units_cnt_rec,
                                    p_status          => lp_status
                                 );   
           end if;            
 
           --pl('Status ' || lp_Status);   
           --pl('count ' || units_qc_tab.count);
           if lp_status = 'OK' then
             cnf_qc_units_insert;
             p_status    := 'OK';
             p_qc_totals.total_units       :=  NVL(p_qc_totals.total_units,0) + units_cnt_rec.total_units;
             p_qc_totals.skipped_units     :=  NVL(p_qc_totals.skipped_units,0) + units_cnt_rec.skipped_units;
             p_qc_totals.incomp_res_units  :=  NVL(p_qc_totals.incomp_res_units,0) + units_cnt_rec.incomp_res_units;
             p_qc_totals.SQC_units         :=  NVL(p_qc_totals.SQC_units ,0) + units_cnt_rec.SQC_units;
           else
             raise exit_Err;
           end if;              
       end loop;
    end if;
    
    /*
    COMMIT;
    
    gen_exception_report(lv_rep_status);
    
    IF lv_rep_status <> 'OK' THEN
      lv_rep_status := 'Err in generating log ' || lv_rep_status;
      RAISE report_err;
    END IF;
    */
    --dump_output;
  EXCEPTION 
    WHEN exit_Err THEN
      ROLLBACK;
      p_status := lp_status;
      --dump_output;
    WHEN report_err THEN
      p_status := lv_rep_status;
  END compute_qc;

begin
  -- Initialization
  null;
end CNFRESQC;
/
