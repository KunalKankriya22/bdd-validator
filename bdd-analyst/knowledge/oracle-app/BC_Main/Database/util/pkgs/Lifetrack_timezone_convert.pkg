CREATE OR REPLACE PACKAGE lifetrack_timezone_convert AS
/*-----------------------------------------------------------------------------
PROCEDURE : Lifetrack_timezone_convert
PURPOSE   : Converting time zone from GMT to Local and Local to GMT time
PARAMETERS: Warehouse_id
DEVELOPER : Akthar Hussain
DEV. DATE : Jan 2011
NOTES     : Initial package creation.
Ver       : 01

Revision History
-------------------------------------------------------------------------------
Author		Date    Version	Remarks
-------------------------------------------------------------------------------
Arun	03-22-2011	  02	Changed the lookup table to
                            LT_APPLICATION_CONFIG to ensure
                            consistency , on March 22, 2011
Kishore	05/17/2011    03	Added two new functions to get
                            local time and GMT time
Arun	02/24/2012    04    Added new function (is_current_date) to find
                            validity of a passed in date
Arun	03/02/2012    05	Logic error in new function (is_current_date)
                            fixed.  (IM 7173)
Edwin   04/23/2012    06    chnages in the is_current_date check
Ashok	10/31/2013    07    IM:9443, 9445; Unable to use boolean return
                            function timezone_enabled in SQL query,
                            so added timezone_enabled_yn function i
                            wrapper for timezone_enabled which returns 'Y' or 'N';
Ashok   06/04/2015   08     IM 15, LT2013R3, get_lcl_time function added
Ashok   11/09/2017   09     LT2018 (Terminated chapter is causing issue in reports query.
Ashok   06/29/2021   10     New wrapper routine added to get local sysdate.(for Onsite .NET) (MLT-4389)
-----------------------------------------------------------------------------*/

/* Below procedure convert GMT time to Local time  based on chapter
timezone*/

    PROCEDURE get_local_time (
        p_chapter_id  IN   VARCHAR2,
        p_gmt_time    IN   DATE,
        p_local_time  OUT  DATE
    );

/* Below procedure convert local time to GMT standard time  based on chapter
	timezone*/

    PROCEDURE get_gmt_time (
        p_chapter_id  IN   VARCHAR2,
        p_local_time  IN   DATE,
        p_gmt_time    OUT  DATE
    );

      /* Below function convert local time to GMT standard time i
         based on chapter timezone*/

      -- Added by Kishore on 05/07/2011. IM 5356

    FUNCTION get_gmt_time (
        p_chapter_id  IN  VARCHAR2,
        p_local_time  IN  DATE
    ) RETURN DATE;

      /* Below function convert GMT time to Local time  based on chapter
	timezone*/

      -- Added by Kishore on 05/07/2011. IM 5356

    FUNCTION get_local_time (
        p_chapter_id  IN  VARCHAR2,
        p_gmt_time    IN  DATE
    ) RETURN DATE;

    /**
    Get local time for SYSDATE.

    --@param   in_chapter  Chapter ID to get the local time.
    --@return  datetime   Local chapter datetime for SYSDATE.
    --@throws

    <b>Call Example:</b>
    <pre>
       select lifetrack_timezone_convert.get_local_time('DAL') from dual;
    </pre>
    */

    FUNCTION get_local_time (
        in_chapter IN VARCHAR2
    ) RETURN DATE;

	/* Below procedure convert GMT time to Local standard time  and
           returns the date and time based on chapter timezone*/

    FUNCTION get_report_local_time (
        p_chapter_id IN VARCHAR2
    ) RETURN DATE;

	/* Function to check if time zone is enabled	*/
    FUNCTION is_timezone_enabled RETURN BOOLEAN;

	/* Function to check if time zone is enabled	*/
    FUNCTION timezone_enabled_yn RETURN VARCHAR2;

	/* Function to retrieve chapter id	*/

    FUNCTION get_chapter_id_db (
        p_user_id IN VARCHAR2
    ) RETURN VARCHAR2;

     /* Below function added on 06/04/2015. IM 15 (LT2013R3).
        Detailed notes are in the pkg body*/

    FUNCTION get_lcl_time (
        p_tz_enabled  IN  VARCHAR2,
        p_tz_offset   IN  VARCHAR2,
        p_gmt_time    IN  DATE
    ) RETURN DATE;

	/* Function to validate passed in date */
    FUNCTION is_current_date (
        chpid       IN  VARCHAR2,
        v_effd      IN  DATE,
        v_termd     IN  DATE,
        v_check_dt  IN  DATE DEFAULT sysdate
    ) RETURN VARCHAR2;

END lifetrack_timezone_convert;
/


CREATE OR REPLACE PACKAGE BODY lifetrack_timezone_convert AS

    v_time_zone          VARCHAR2(15);
    v_local_time         DATE;
    v_gmt_time           DATE;
    v_report_local_time  DATE;
    v_timezone_active    CHAR;

    PROCEDURE get_local_time (
        p_chapter_id  IN   VARCHAR2,
        p_gmt_time    IN   DATE,
        p_local_time  OUT  DATE
    ) IS

	/*  Converting local time

      p_chapter_id = The chapter id is associate login user's chapter id
      p_gmt_time   = sysdate
      p_local_time = is out parameter which converted gmt standard time to local

	*/

    BEGIN
        SELECT
            time_zone
        INTO v_time_zone
        FROM
            chapters
        WHERE
                chapter_id = p_chapter_id
            AND sysdate BETWEEN eff_date AND nvl(term_date, sysdate + 1);

        IF v_time_zone IS NULL THEN
            raise_application_error(-20005, 'Time zone definition is missing for the chapter');
        END IF;
	--      v_timezone := '-06:00' ; '-hh:mi)

        SELECT
            p_gmt_time + ( substr(v_time_zone, 1, 1)
                           || '1' ) * to_dsinterval('0 '
                                                    || substr(v_time_zone, 2, 5)
                                                    || ':00')
        INTO v_local_time
        FROM
            dual;

        p_local_time := v_local_time;
    EXCEPTION
        WHEN no_data_found THEN
            raise_application_error(-20005, 'Invalid chapter-1' || p_chapter_id);
    END get_local_time;

    PROCEDURE get_gmt_time (
        p_chapter_id  IN   VARCHAR2,
        p_local_time  IN   DATE,
        p_gmt_time    OUT  DATE
    ) IS

	/*  Converting GMT time

	p_chapter_id = The chapter id is associate login user's chapter id
	p_gmt_time   = sysdate
	p_local_time = is out parameter which converted gmt standard time to local

	*/
    BEGIN
        SELECT
            time_zone
        INTO v_time_zone
        FROM
            chapters
        WHERE
                chapter_id = p_chapter_id
            AND sysdate BETWEEN eff_date AND nvl(term_date, sysdate + 1);

        IF v_time_zone IS NULL THEN
            raise_application_error(-20005, 'Time zone definition is missing for the chapter');
        END IF;

		-- Converting local time to GMT time.

        SELECT
            p_local_time - ( substr(v_time_zone, 1, 1)
                             || '1' ) * to_dsinterval('0 '
                                                      || substr(v_time_zone, 2, 5)
                                                      || ':00')
        INTO v_gmt_time
        FROM
            dual;

        p_gmt_time := v_gmt_time;
    EXCEPTION
        WHEN no_data_found THEN
            raise_application_error(-20005, 'Invalid chapter-2' || p_chapter_id);
    END get_gmt_time;

      -- Added by Kishore on 05/07/2011
    FUNCTION get_local_time (
        p_chapter_id  IN  VARCHAR2,
        p_gmt_time    IN  DATE
    ) RETURN DATE IS

	/*  Converting local time

	p_chapter_id = The chapter id is associate login user's chapter id
	p_gmt_time   = sysdate
	p_local_time = is out parameter which converted gmt standard time to local

	*/

    BEGIN
        IF is_timezone_enabled THEN
            SELECT
                time_zone
            INTO v_time_zone
            FROM
                chapters
            WHERE
                chapter_id = p_chapter_id
		--AND SYSDATE BETWEEN eff_date AND nvl(term_date, SYSDATE + 1) -- LT 2018
                ;

            IF v_time_zone IS NULL THEN
                raise_application_error(-20005, 'Time zone definition is missing for the chapter');
            END IF;
		--      v_timezone := '-06:00' ; '-hh:mi)

            SELECT
                p_gmt_time + ( substr(v_time_zone, 1, 1)
                               || '1' ) * to_dsinterval('0 '
                                                        || substr(v_time_zone, 2, 5)
                                                        || ':00')
            INTO v_local_time
            FROM
                dual;

        ELSE
            v_local_time := p_gmt_time;
        END IF;

        RETURN v_local_time;
    EXCEPTION
        WHEN no_data_found THEN
            raise_application_error(-20005, 'Invalid chapter-3' || p_chapter_id);
    END get_local_time;

    FUNCTION get_local_time (
        in_chapter IN VARCHAR2
    ) RETURN DATE IS
    BEGIN
        RETURN get_local_time(in_chapter, sysdate);
    END get_local_time;

    FUNCTION get_lcl_time (
        p_tz_enabled  IN  VARCHAR2,
        p_tz_offset   IN  VARCHAR2,
        p_gmt_time    IN  DATE
    ) RETURN DATE

  /*
  This function was created as part of IM 15 in LT2013R3 project.
  Purpose: Existing get_local_time function is very performance intensive and when called
  in a sql query, it runs for each record.  It checks lt_application_config table (for timezone enabled)
  and chapters table (for timezone offset) for every record that the query scans.  To overcome this,
  we created a new function by adding additional input parameters and removing the sql's.  The SQL's
  were moved to login screen in the application where global variables tz_enabled and tz_offset are populated.
  These variables are passed as input parameters to the new function.

  CAUTION: While replacing with this function, check if the chapter variable being passed to the existing function
  is the user's chapter or not.  Replace with this function only when the user's logged in chapter is being passed.
  DO NOT REPLACE with this function if the table's chapter ID is being passed.

  USAGE:
  Existing Function (Here chapter ID being passed is the user's logged in chapter ID):
  SELECT pick_slip_id, lifetrack_timezone_convert.get_local_time(:ctrl_blk_1.g_chapter_id, insert_date) insert_date
    FROM pick_slips
    WHERE .......

  New Function:
  SELECT pick_slip_id, lifetrack_timezone_convert.get_lcl_time(:GLOBAL.tz_enabled, :GLOBAL.tz_offset, insert_date) insert_date
  FROM pick_slips
  WHERE .......

  */ IS
   --  Converting local time
   -- p_tz_enabled = Timezone Enabled or not -> as stored in lt_application_config table.
   -- p_tz_offset = Timezone offset from GMT -> as stored in chapters table.
   -- p_gmt_time   = sysdate

    BEGIN
        IF p_tz_enabled = 'Y' THEN
            IF p_tz_offset IS NULL THEN
                raise_application_error(-20005, 'Time zone definition is missing for the chapter');
            END IF;
            v_local_time := p_gmt_time + ( substr(p_tz_offset, 1, 1)
                                           || '1' ) * to_dsinterval('0 '
                                                                    || substr(p_tz_offset, 2, 5)
                                                                    || ':00');

        ELSE
            v_local_time := p_gmt_time;
        END IF;

        RETURN v_local_time;
    END get_lcl_time;

    FUNCTION get_gmt_time (
        p_chapter_id  IN  VARCHAR2,
        p_local_time  IN  DATE
    ) RETURN DATE IS

	/*  Converting GMT time

	p_chapter_id = The chapter id is associate login user's chapter id
	p_gmt_time   = sysdate
	p_local_time = is out parameter which converted gmt standard time to local

	*/
    BEGIN
        IF is_timezone_enabled THEN
            SELECT
                time_zone
            INTO v_time_zone
            FROM
                chapters
            WHERE
                    chapter_id = p_chapter_id
                AND sysdate BETWEEN eff_date AND nvl(term_date, sysdate + 1);

            IF v_time_zone IS NULL THEN
                raise_application_error(-20005, 'Time zone definition is missing for the chapter');
            END IF;

		-- Converting local time to GMT time.

            SELECT
                p_local_time - ( substr(v_time_zone, 1, 1)
                                 || '1' ) * to_dsinterval('0 '
                                                          || substr(v_time_zone, 2, 5)
                                                          || ':00')
            INTO v_gmt_time
            FROM
                dual;

        ELSE
            v_gmt_time := p_local_time;
        END IF;

        RETURN v_gmt_time;
    EXCEPTION
        WHEN no_data_found THEN
            raise_application_error(-20005, 'Invalid chapter-4' || p_chapter_id);
    END get_gmt_time;
      -- End of change

    FUNCTION get_report_local_time (
        p_chapter_id IN VARCHAR2
    ) RETURN DATE IS

		/*  Getting time only from Local time

		p_chapter_id = The chapter id is associate login user's chapter id
		v_report_local_time = which return local date and time

		*/

        v_report_local_time DATE;
    BEGIN

		-- Check the time zone active flag is turned or not

        BEGIN
			/*
			SELECT	time_zone_active
			INTO	v_timezone_active
			FROM	time_zone_enabled
			;
			*/

            SELECT
                nvl(time_zone_enabled, 'N')
            INTO v_timezone_active
            FROM
                lt_application_config;

        EXCEPTION
            WHEN no_data_found THEN
                v_report_local_time := sysdate;
        END;

        IF v_timezone_active = 'Y' THEN
            get_local_time(p_chapter_id, sysdate, v_local_time);
            v_report_local_time := v_local_time;
        ELSE
            v_report_local_time := sysdate;
        END IF;

        RETURN v_report_local_time;
    END get_report_local_time;


	/* Function to check if time zone is enabled	*/

    FUNCTION is_timezone_enabled RETURN BOOLEAN IS
        v_timezone_active CHAR(1);
    BEGIN
		/*
		SELECT	time_zone_active
		INTO	v_timezone_active
		FROM	time_zone_enabled
		;
		*/

        SELECT
            nvl(time_zone_enabled, 'N')
        INTO v_timezone_active
        FROM
            lt_application_config;

        IF v_timezone_active = 'Y' THEN
            RETURN true;
        ELSE
            RETURN false;
        END IF;
    EXCEPTION
        WHEN no_data_found THEN
            RETURN false;
        WHEN OTHERS THEN
            RETURN false;
    END;

    FUNCTION timezone_enabled_yn RETURN VARCHAR2 IS
        v_timezone_active CHAR(1);
    BEGIN
        SELECT
            nvl(time_zone_enabled, 'N')
        INTO v_timezone_active
        FROM
            lt_application_config;

        IF v_timezone_active = 'Y' THEN
            RETURN 'Y';
        ELSE
            RETURN 'N';
        END IF;
    EXCEPTION
        WHEN no_data_found THEN
            RETURN 'N';
        WHEN OTHERS THEN
            RETURN 'N';
    END;

	/* Function to retrieve chapter id	*/

    FUNCTION get_chapter_id_db (
        p_user_id IN VARCHAR2
    ) RETURN VARCHAR2 IS
        l_chapter VARCHAR2(4);
    BEGIN
        SELECT
            chapter_id
        INTO l_chapter
        FROM
            system_users
        WHERE
                decode(substr(user_id, 1, 3), 'OPS', substr(user_id, 5), user_id) = p_user_id
            AND ROWNUM = 1;

        RETURN l_chapter;
    EXCEPTION
        WHEN OTHERS THEN
            RETURN 'WAD';
    END;

	/* Function to validate passed in date */
    FUNCTION is_current_date (
        chpid       IN  VARCHAR2,
        v_effd      IN  DATE,
        v_termd     IN  DATE,
        v_check_dt  IN  DATE DEFAULT sysdate
    ) RETURN VARCHAR2 IS
	--chpid			VARCHAR2(4) := 'DAL';
        effd       DATE;
        termd      DATE;
        check_dt   DATE;
        tzone      NUMBER(4, 2) := 0;	 -- To store time zone factor
        tzone_chk  NUMBER(4, 2) := 0;	--To store the lower/upper limit of time
        chk_cur    VARCHAR2(1) := 'N';-- To store the status that will be returned.
    BEGIN
		-- Deduct time zone factor from eff and term dates
        IF lifetrack_timezone_convert.is_timezone_enabled THEN
	-- Find the time zone factor.   This will help calculate the grace period for date conversion
            SELECT
                tz,
                decode(sign(tz), - 1,(24.00 + tz), 1, tz,
                       0)
            INTO
                tzone,
                tzone_chk
            FROM
                (
                    SELECT
                        to_number(replace(time_zone, ':', '.')) tz
                    FROM
                        chapters
                    WHERE
                            chapter_id = chpid
                        AND ROWNUM < 2
                );
	-- Calculate timezone applied effd
            lifetrack_timezone_convert.get_local_time(chpid, v_check_dt, check_dt);
	-- Calculate timezone applied termd, if NULL assign SYSDATE
            IF v_termd IS NULL THEN
                termd := lifetrack_timezone_convert.get_local_time(chpid, sysdate);
            ELSE
                termd := v_termd;
            END IF;

        ELSE
            IF sysdate BETWEEN v_effd AND nvl(v_termd, sysdate + 1) THEN
                chk_cur := 'Y';
            ELSE
                chk_cur := 'N';
            END IF;

            RETURN chk_cur;
        END IF;

  --DBMS_OUTPUT.PUT_LINE('1st Check 		: '||TRUNC(check_dt) ||' : '||TRUNC(v_effd)||' : '||TRUNC(termd));
        IF
            trunc(check_dt) >= trunc(v_effd)
            AND trunc(check_dt) <= trunc(termd)
        THEN
			-- The date falls clearly between the eff and term date, hence valid
            chk_cur := 'Y';
        ELSE
	--DBMS_OUTPUT.PUT_LINE('diff in hrs : '||ABS(TRUNC(check_dt)-TRUNC(v_effd)));
            IF tzone < 0 THEN
	-- If time zone is neagtive
                IF ( trunc(v_effd) - trunc(check_dt) ) = 1 THEN
					-- If the eff date is after check date (local) and diffrence is 1
					--IF tzone_chk > TO_NUMBER(TO_CHAR(check_dt,'HH24.MI'))   -- Error in logic fixed by IM 7173
                    IF tzone_chk < to_number(to_char(check_dt, 'HH24.MI')) THEN
						-- The hour minute part of check date falls within grace period (24 minus time zone ) of the date conversion
                        chk_cur := 'Y';
                    ELSE
                        chk_cur := 'N';
                    END IF;

                END IF;

            ELSIF tzone > 0 THEN
				-- If time zone is positive
                IF ( trunc(check_dt) - trunc(termd) ) = 1 THEN
                    IF tzone_chk < to_number(to_char(check_dt, 'HH24.MI')) THEN
						-- The hour minute part of check date is within grace period (time zone) of the date conversion
                        chk_cur := 'Y';
                    ELSE
                        chk_cur := 'N';
                    END IF;

                END IF;
            END IF;
        END IF;

			--DBMS_OUTPUT.PUT_LINE('*******************************************************************');
			--DBMS_OUTPUT.PUT_LINE('eff_date  		: '||TO_CHAR(effd,'MM/DD/YYYY HH24:MI')||' : '||TO_CHAR(ROUND(v_effd,'DD'),'MM/DD/YYYY'));
			--DBMS_OUTPUT.PUT_LINE('term_date 		: '||TO_CHAR(NVL(termd,SYSDATE),'MM/DD/YYYY HH24:MI')||' : '||TO_CHAR(NVL(termd,SYSDATE),'MM/DD/YYYY'));
			--DBMS_OUTPUT.PUT_LINE('v_check_dt		: '||TO_CHAR(v_check_dt,'MM/DD/YYYY HH24:MI'));
			--DBMS_OUTPUT.PUT_LINE('v_check_dt(local)	: '||TO_CHAR(lifetrack_timezone_convert.get_local_time(chpid,v_check_dt),'MM/DD/YYYY HH24.MI'));
			--DBMS_OUTPUT.PUT_LINE('time zone 		: '||tzone);
			--DBMS_OUTPUT.PUT_LINE('tzone_chk 		: '||tzone_chk);
			--DBMS_OUTPUT.PUT_LINE('chk_cur   		: '||chk_cur);
        RETURN chk_cur;
    END;

END lifetrack_timezone_convert;
/
