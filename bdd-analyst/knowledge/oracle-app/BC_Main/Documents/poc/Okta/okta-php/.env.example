# Database Configuration
DB_CONN=database_connection_string
DB_USER=database_username
DB_PASSWORD=database_password

# Okta Configuration
OKTA_METADATA_URL=https://example.okta.com/oauth2/default/.well-known/openid-configuration
OKTA_ONSITE_CLIENT_ID=client_id_here
OKTA_ONSITE_CLIENT_SECRET=client_secret_here
OKTA_ORACLE_CLIENT_ID=client_id_here
OKTA_ORACLE_CLIENT_SECRET=client_secret_here
OKTA_ONSITE_REDIRECT_URI=http://localhost/bconsiteapp/
OKTA_ORACLE_REDIRECT_URI=http://localhost/bcoracleapp/
OKTA_ONSITE_REDIRECT_URL=http://localhost/BCOnsiteUI/login/
OKTA_ORACLE_REDIRECT_URL=bcapp2024r1://

# Application Settings
OKTA_VERIFY_SSL=false
OKTA_SESSION_TIMEOUT=1800
OKTA_SESSION_MAX_LIFETIME=86400

# Environment
APP_ENV=dev
APP_DEBUG=true
SECURE_COOKIES=false
BASE_HREF=/okta/
