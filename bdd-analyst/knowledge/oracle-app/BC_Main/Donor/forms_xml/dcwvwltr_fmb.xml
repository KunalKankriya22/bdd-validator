      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;BEGIN&amp;#10;   --:global.program_version := '2.03.00';&amp;#10;   --:global.program_version := '3.01.00';&amp;#10;   --:global.program_version := '01';&amp;#10;   --:global.program_version := '02'; -- IM 2174&amp;#10;   --:global.program_version := '03'; -- IM 4866      by jairam kulkarni on 28-mar-2011&amp;#10;   --:global.program_version := '1.01.04';&amp;#10;   --:global.program_version := '04'; -- IM 8497&amp;#10;   --:global.program_version := '05'; -- IM 9174&amp;#10;&amp;#10;   -- Below Version Got Re-Updated from LT2018&amp;#10;     :global.program_version := '01';&amp;#10;     &amp;#10;   default_value('E','global.button_status');&amp;#10;   :system.message_level := '10';&amp;#10;&amp;#10;  -- :parameter.p_donor_id := '#DN00190862##';       &amp;#10;  -- :parameter.p_chapter_id := 'WAD';            &amp;#10;&amp;#10;   if :parameter.p_donor_id is null OR&amp;#10;      :parameter.p_chapter_id is null then&amp;#10;      show_error('18023');&amp;#10;      exit_form(no_validate);&amp;#10;   end if;&amp;#10;   :parameter.p_donor_id := replace( :parameter.p_donor_id, '#' );&amp;#10;   set_window_property('com_letters',&amp;#10;                       title,&amp;#10;                       '[' || :banner.prog_name || ' ' || :global.program_version || &amp;#10;                       ']               ' ||&amp;#10;                       'Communication Letters for - ' || :parameter.p_donor_id);&amp;#10;   go_block( 'don_com_letters' );&amp;#10;   execute_query;&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CALL_WINDOW_PROGRAM" ProgramUnitText="PROCEDURE call_window_program (p_window_name varchar2) IS&amp;#10;   pl_id   ParamList; &amp;#10;   pl_name VARCHAR2(10) := 'dondata'; &amp;#10;BEGIN &amp;#10;&amp;#10;   pl_id := Get_Parameter_List(pl_name); &amp;#10;   IF not Id_Null(pl_id) THEN &amp;#10;      destroy_parameter_list(pl_id);&amp;#10;   end if;&amp;#10;   pl_id := Create_Parameter_List(pl_name); &amp;#10;   IF Id_Null(pl_id) THEN&amp;#10;      Message('Error creating parameter list '||pl_name); &amp;#10;      RAISE Form_Trigger_Failure; &amp;#10;   END IF;&amp;#10;&amp;#10;   Add_Parameter(pl_id, 'p_donor_id',    TEXT_PARAMETER, '#' || :parameter.p_donor_id || '##');&amp;#10;   Add_Parameter(pl_id, 'p_chapter_id',  TEXT_PARAMETER, :global.chapter_id); &amp;#10;   call_form( lower(p_window_name) ,NO_HIDE ,NO_REPLACE ,NO_QUERY_ONLY ,pl_id);&amp;#10;END; &amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="SHOW_COM_LETTER" ProgramUnitText="PROCEDURE SHOW_COM_LETTER IS&amp;#10;BEGIN&amp;#10;&#x9; /* -- Commented by Kishore on 1011/2012. IM 9174&amp;#10;   begin&amp;#10;      select parameter_value&amp;#10;        into :global.MERGE_DIR&amp;#10;        from valid_parameters&amp;#10;       where --chapter_id = :global.chapter_id    -- COMMENTED BY JAIRAM FOR IM# 4866&amp;#10;         --and &amp;#10;         parameter_type = 'ALL'&amp;#10;         and parameter_code = 'DCOMM_DIR'&amp;#10;         and sysdate between eff_date and nvl(term_date, sysdate +1);&amp;#10;&amp;#10;      exception&amp;#10;         when others then&amp;#10;            show_error('18146');&amp;#10;            exit_form(no_validate);&amp;#10;   end;&amp;#10;   -- End of commented section */&amp;#10;&amp;#10;   clear_message;&amp;#10;   if :don_com_letters.donor_id is not null&amp;#10;      and :don_com_letters.letter_id is not null then&amp;#10;      go_block( 'donor_letter_text' );&amp;#10;      execute_query;&amp;#10;      go_block( 'don_com_letters' );&amp;#10;   end if;&amp;#10;END;" ProgramUnitType="Procedure"/>
