            <Trigger Name="WHEN-VALIDATE-ITEM" TriggerText="BEGIN&amp;#10;  IF  :DONATIONS.DON_OLD_COLL != :DONATIONS.DON_COLL_REF THEN&amp;#10;     show_error('0190');&amp;#10;     check_package_failure;&amp;#10;  END IF;&amp;#10;/****&amp;#10;SELECT  'x' &amp;#10;  INTO  :GLOBAL.x&amp;#10;  FROM  donations&amp;#10; WHERE  unit_id = :donations.unit_id&amp;#10;   AND  coll_date = :donations.don_old_coll;&amp;#10;Exception &amp;#10;  When NO_DATA_FOUND then&amp;#10;    message('No unit exists..');pause;&amp;#10;    raise form_trigger_failure;&amp;#10;****/&amp;#10;END ;"/>
