      <ProgramUnit Name="UPDATECOLLDATE" ProgramUnitText="PROCEDURE updateColldate (p_table_name   in varchar2,&amp;#10;                          p_don_new_coll in date,&amp;#10;                          p_don_old_coll in date,&amp;#10;                          p_don_unit_id  in varchar2)&amp;#10;IS&amp;#10;v_cursorid   integer;&amp;#10;v_rowupdate  integer;&amp;#10;v_updatestmt varchar2(300);&amp;#10;v_coll_date  varchar2(15):=to_char(p_don_old_coll,'dd-mon-yyyy');&amp;#10;TABLE_NOT_EXIST EXCEPTION;&amp;#10;PRAGMA EXCEPTION_INIT(TABLE_NOT_EXIST, -00942);&amp;#10;&amp;#10;BEGIN&amp;#10;&amp;#10;  v_cursorid := DBMS_SQL.OPEN_CURSOR ;&amp;#10;&amp;#10;/*  v_updatestmt :=  'Update ' || p_table_name ||' SET COLL_DATE = :newcolldate '||&amp;#10;                   ' WHERE unit_id = :unitid and coll_date = :oldcolldate ' ;&amp;#10;*/&amp;#10;&amp;#10;  v_updatestmt :=  'Update  donations '||' SET COLL_DATE = '||in_quotes(p_don_new_coll)||&amp;#10;                 ' WHERE unit_id = '||in_quotes(p_don_unit_id)||' and '||&amp;#10;                 ' coll_date = '||in_quotes(v_coll_date);&amp;#10;                 &amp;#10; -- message(v_updatestmt);pause;&amp;#10; DBMS_SQL.PARSE(v_cursorid, v_updatestmt,2);&amp;#10;&amp;#10;&amp;#10;-- DBMS_SQL.BIND_VARIABLE(v_cursorid, ':newcolldate',to_date(to_char(p_don_new_coll,'mm-dd-yyyy'),'mm-dd-yyyy'));     &amp;#10;&amp;#10;--DBMS_SQL.BIND_VARIABLE(v_cursorid, ':oldcolldate',to_date(to_char(p_don_old_coll,'mm-dd-yyyy'),'mm-dd-yyyy'));&amp;#10;&amp;#10;  --DBMS_SQL.BIND_VARIABLE(v_cursorid, ':unitid',p_don_unit_id);    &amp;#10;&amp;#10;  v_rowupdate := DBMS_SQL.EXECUTE(v_cursorid);&amp;#10;&amp;#10;&amp;#10;  DBMS_SQL.CLOSE_CURSOR(v_cursorid);&amp;#10; -- message(p_table_name);pause;&amp;#10;EXCEPTION&amp;#10; when TABLE_NOT_EXIST  THEN&amp;#10;Message('Msg: Cannot access database tables - '||p_table_name); pause;&amp;#10; WHEN OTHERS  THEN&amp;#10;   DBMS_SQL.CLOSE_CURSOR(v_cursorid);&amp;#10;   MESSAGE(SQLERRM);PAUSE;&amp;#10;   handle_error;&amp;#10;   check_package_failure;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;BEGIN&amp;#10;/***&amp;#10;   :GLOBAL.UNIT_ID       := '9201053'; &amp;#10;   :GLOBAL.DON_COLL_DATE := '10-04-2090';&amp;#10;   :GLOBAL.LAB_COLL_DATE := '03-16-2099';&amp;#10;***/&amp;#10; &amp;#10;&amp;#10;   if :global.unit_id is null then&amp;#10;      show_error('18023');&amp;#10;      exit_form(no_validate);&amp;#10;   end if;&amp;#10;      :DONATIONS.DON_COLL_REF     := to_date(:GLOBAL.DON_COLL_DATE,'MM-DD-YYYY');&amp;#10;      :DONATIONS.LAB_COLL_REF     := to_date(:GLOBAL.LAB_COLL_DATE,'MM-DD-YYYY') ;&amp;#10;      :DONATIONS.UNIT_ID          := :GLOBAL.UNIT_ID ;&amp;#10;&amp;#10;ITEM_CHANGE('DONATIONS.CHANGE_DATE','D');&amp;#10;/***&amp;#10;   set_window_property('win_donation',&amp;#10;                       title,&amp;#10;                       '[' || :banner.prog_name || ' - 1.01.00]     ' ||&amp;#10;                       'Updation of collection date for  - ' || :global.unit_id);&amp;#10;&amp;#10;****/&amp;#10;/*&amp;#10;   set_window_property('win_donation',&amp;#10;                       title,&amp;#10;                       '[' || :banner.prog_name || 'Rel: 01]     ' ||&amp;#10;                       'Update of collection date for  - ' || :global.unit_id);&amp;#10;&amp;#10;*/&amp;#10;/*   set_window_property('win_donation',&amp;#10;                       title,&amp;#10;                       '[' || :banner.prog_name || 'Rel: 02]     ' ||&amp;#10;                       'Update of collection date for  - ' || :global.unit_id); -- IM:8497 */&amp;#10; -- Rel: [03] -- Removed Duplicate Objects&amp;#10; &amp;#10;   -- Below Version Got Re-Updated from LT2018&amp;#10;     &amp;#10;     set_window_property('win_donation',&amp;#10;                       title,&amp;#10;                       '[' || :banner.prog_name || 'Rel: 01]     ' ||&amp;#10;                       'Update of collection date for  - ' || :global.unit_id); &amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
