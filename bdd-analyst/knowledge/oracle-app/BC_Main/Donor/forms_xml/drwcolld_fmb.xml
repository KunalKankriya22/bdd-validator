         <Item Name="DON_NEW_COLL" Justification="Start" DistanceBetweenRecords="0" Width="55" FillPattern="transparent" MaximumLength="10" RecordVisualAttributeGroupName="CURR_REC" BackColor="GRAY" CompressionQuality="None" XPosition="123" Required="false" FontName="Arial" YPosition="76" DatabaseItem="false" FontSize="1000" FontStyle="Plain" FontWeight="Bold" AutoHint="true" FontSpacing="Normal" ForegroundColor="black" FormatMask="FXMM-DD-YYYY" CanvasName="PAGE_DONATION" CaseRestriction="Mixed" Height="17" ConcealData="false" Hint="Enter Donor New Collection date.[MMDDYYYY]" Prompt="New Donor Coll Date:" ShowHorizontalScrollbar="false" NextNavigationItemName="CHANGE_DATE" TabPageName="" PromptAttachmentOffset="1" PromptAlignOffset="3" InsertAllowed="true" ItemType="Text Item" CopyValueFromItem="" DataType="Date" ImplementationClass="oracle.forms.fd.LAF_XP_TextField" UpdateAllowed="true" PrimaryKey="false" KeepCursorPosition="true" Label="Skill Desc" PreviousNavigationItemName="DON_OLD_COLL" QueryAllowed="true" Visible="true" QueryLength="5" QueryOnly="false" ShowVerticalScrollbar="false" LovName="">
            <Trigger Name="PRE-TEXT-ITEM" TriggerText="set_item_property('DONATIONS.DON_NEW_COLL', FORMAT_MASK , 'FXMMDDYYYY');&amp;#10;"/>
            <Trigger Name="POST-TEXT-ITEM" TriggerText="set_item_property('DONATIONS.DON_NEW_COLL', FORMAT_MASK , 'FXMM-DD-YYYY');&amp;#10;IF :donations.don_new_coll_dup is not null and :donations.don_new_coll is not null THEN&amp;#10;   ITEM_CHANGE('DONATIONS.CHANGE_DATE','E');&amp;#10;END IF;&amp;#10;"/>
            <Trigger Name="WHEN-VALIDATE-ITEM" TriggerText="DECLARE&amp;#10;   al_id             alert ;&amp;#10;   al_button        number ;&amp;#10;   sql_str    varchar2(500);&amp;#10;BEGIN&amp;#10;&amp;#10;IF :donations.don_new_coll  = :donations.don_old_coll THEN&amp;#10;   SHOW_ERROR('0125');&amp;#10;   check_package_failure;&amp;#10;END IF ;&amp;#10;IF :donations.don_new_coll_dup is NULL THEN&amp;#10;  IF :donations.don_new_coll not between :donations.don_old_coll-1 and :donations.don_old_coll+1 THEN&amp;#10;     SHOW_ERROR('7010');&amp;#10;     check_package_failure;&amp;#10;  END IF ;&amp;#10;END IF;&amp;#10;&amp;#10;IF :donations.don_new_coll_dup is NULL THEN&amp;#10;   :donations.don_new_coll_dup := :donations.don_new_coll ;&amp;#10;   :donations.don_new_coll  := NULL;&amp;#10;   raise form_trigger_failure;&amp;#10;ELSIF :donations.don_new_coll_dup != :donations.don_new_coll THEN&amp;#10;   SHOW_ERROR('16000');&amp;#10;   check_package_failure;&amp;#10;END IF;&amp;#10;&amp;#10;&amp;#10;IF :donations.don_new_coll != :donations.lab_coll_ref THEN&amp;#10;      al_id := Find_Alert('COLL_MISMATCH_ALERT'); &amp;#10;      IF Id_Null(al_id) THEN&amp;#10;         Message('COLL_MISMATCH_ALERT alert does not exist'); &amp;#10;         RAISE Form_Trigger_Failure; &amp;#10;      END IF ;&amp;#10;    set_alert_property(al_id,ALERT_MESSAGE_TEXT,'New Donor Coll Date not matching with Lab Coll Date.&amp;#10;Do you want to continue?');&amp;#10;                      &amp;#10;    set_alert_button_property(al_id, ALERT_BUTTON1, LABEL, 'Yes') ;&amp;#10;      set_alert_button_property(al_id, ALERT_BUTTON2, LABEL, 'No') ;&amp;#10;      al_button := Show_Alert(al_id); &amp;#10;      IF al_button = ALERT_BUTTON2 THEN &amp;#10;         raise form_trigger_failure;&amp;#10;      END IF;&amp;#10;&amp;#10;END IF;&amp;#10;END ;"/>
         </Item>
         <Item Name="LAB_COLL_REF" Justification="Start" Width="55" MaximumLength="10" BackColor="GRAY" CompressionQuality="None" XPosition="255" YPosition="76" DatabaseItem="false" AutoHint="true" CanvasName="PAGE_DONATION" CaseRestriction="Mixed" ParentType="29" Prompt="LAB Coll Date:" NextNavigationItemName="" PromptAttachmentOffset="1" PromptAlignOffset="3" PrimaryKey="false" PreviousNavigationItemName="" QueryAllowed="true" Visible="true" QueryLength="5" QueryOnly="false" DistanceBetweenRecords="0" FillPattern="transparent" Required="false" FontName="Arial" FontSize="1000" FontStyle="Plain" FontWeight="Bold" FontSpacing="Normal" ForegroundColor="black" FormatMask="FXMM-DD-YYYY" Height="17" ConcealData="false" Hint="Enter New Collection date.[MMDDYYYY]" ShowHorizontalScrollbar="false" TabPageName="" InsertAllowed="true" ItemType="Display Item" CopyValueFromItem="" DataType="Date" UpdateAllowed="true" ParentModule="drwcolld" ParentModuleType="12" ParentName="PC_DISPLAY" KeepCursorPosition="true" Label="Skill Desc" ShowVerticalScrollbar="false" LovName=""/>
         <Item Name="CHANGE_DATE" Width="70" FillPattern="transparent" CompressionQuality="None" XPosition="74" YPosition="119" DatabaseItem="false" AccessKey="D" FontStyle="Plain" FontWeight="Bold" AutoHint="true" FontSpacing="Normal" MouseNavigate="false" CanvasName="PAGE_DONATION" KeyboardNavigable="true" Height="17" Hint="Press Button to Print Units from LAB and DONOR withh differnt COLL DATE ." ShowHorizontalScrollbar="false" NextNavigationItemName="CHANGE_DATE" Iconic="false" TabPageName="" ItemType="Push Button" ImplementationClass="oracle.forms.fd.LAF_XP_Button" VisualAttributeName="BUTTON" Label="Change Date" DefaultButton="false" Visible="true" ShowVerticalScrollbar="false">
            <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="DECLARE&amp;#10;   al_id             alert ;&amp;#10;   al_button        number ;&amp;#10;   sql_str    varchar2(500);&amp;#10;  CURSOR C1 is&amp;#10;  SELECT description&amp;#10;    FROM valid_master_codes&amp;#10;   WHERE code_type = 'UPDAT'&amp;#10;     AND sysdate between eff_date and nvl(term_date, sysdate);&amp;#10;BEGIN&amp;#10;&amp;#10;      al_id := Find_Alert('CHOICE_ALERT'); &amp;#10;      IF Id_Null(al_id) THEN&amp;#10;         Message('User_Warning alert does not exist'); &amp;#10;         RAISE Form_Trigger_Failure; &amp;#10;      END IF ;&amp;#10;    set_alert_property(al_id,ALERT_MESSAGE_TEXT,'Do you really want to Update?');&amp;#10;                      &amp;#10;    set_alert_button_property(al_id, ALERT_BUTTON1, LABEL, 'Yes') ;&amp;#10;      set_alert_button_property(al_id, ALERT_BUTTON2, LABEL, 'No') ;&amp;#10;      al_button := Show_Alert(al_id); &amp;#10;&amp;#10;     IF al_button = ALERT_BUTTON1 THEN &amp;#10;       FOR C1_rec in C1&amp;#10;       LOOP&amp;#10;         &amp;#10;        UPDATECOLLDATE( UPPER(C1_rec.description), :DONATIONS.DON_NEW_COLL, :DONATIONS.DON_OLD_COLL, :DONATIONS.UNIT_ID);&amp;#10;        check_package_failure;&amp;#10;        :system.message_level := 10;&amp;#10;        COMMIT;&amp;#10;        :system.message_level := 0;&amp;#10;      END LOOP;&amp;#10;        show_error('9163');&amp;#10;        check_package_failure;&amp;#10;        :GLOBAL.DON_COLL_DATE := to_char(:DONATIONS.DON_NEW_COLL,'mm-dd-yyyy');&amp;#10;        CLEAR_BLOCK(NO_VALIDATE);&amp;#10;        exit_form(no_validate);&amp;#10;     ELSIF al_button = ALERT_BUTTON2 THEN&amp;#10;         raise form_trigger_failure ;&amp;#10;     END IF; &amp;#10;END;"/>
         </Item>
         <Item Name="CANCEL" Width="68" FillPattern="transparent" CompressionQuality="None" XPosition="171" YPosition="119" DatabaseItem="false" AccessKey="C" FontStyle="Plain" FontWeight="Bold" AutoHint="true" FontSpacing="Normal" MouseNavigate="false" CanvasName="PAGE_DONATION" KeyboardNavigable="false" Height="17" Hint="Press Button to Print Units from LAB and DONOR withh differnt COLL DATE ." ShowHorizontalScrollbar="false" NextNavigationItemName="CANCEL" Iconic="false" TabPageName="" ItemType="Push Button" ImplementationClass="oracle.forms.fd.LAF_XP_Button" DirtyInfo="true" VisualAttributeName="BUTTON" Label="Cancel" DefaultButton="false" Visible="true" ShowVerticalScrollbar="false">
