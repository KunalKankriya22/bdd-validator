      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;BEGIN&amp;#10; /*  Verified for Y2k... Sobha...06/99  */&amp;#10; --:global.program_version :='1.01.01';&amp;#10; --:global.program_version :='2.03.00';&amp;#10; --:global.program_version :='3.01.00';&#x9;&#x9;&amp;#10; --:global.program_version :='02';&amp;#10; --:global.program_version :='03'; -- Replaced WAD' with :global.chapter_id--01/12/11&amp;#10; --:global.program_version := '04'; -- IM:8497&amp;#10;  -- :global.program_version := '05'; -- Removed Duplicate Objects&amp;#10;  &amp;#10;   -- Below Version Got Re-Updated from LT2018&amp;#10;     :global.program_version := '01';&amp;#10;&amp;#10; &amp;#10; --default_value('WAD','global.chapter_id');&amp;#10; default_value(:global.chapter_id,'global.chapter_id');&amp;#10; default_value('DON','global.appl_id');&amp;#10;  :system.message_level :='10';&amp;#10; execute_trigger('util_banner');&amp;#10;END;" ProgramUnitType="Procedure"/>
