      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;BEGIN&amp;#10;   --:global.program_version := '1.01.00' ;&amp;#10;   --:global.program_version := '2.03.00' ;&amp;#10;   --:global.program_version := '3.01.00' ;&amp;#10;   --:global.program_version:='02';&amp;#10;   --:global.program_version := '03'; -- IM:8497&amp;#10;    -- :global.program_version := '04'; -- Removed Duplicate Objects&amp;#10;    &amp;#10;   -- Below Version Got Re-Updated from LT2018&amp;#10;     :global.program_version := '01';&amp;#10;&amp;#10;   &amp;#10;   read_image_file('lifelogo.bmp','BMP','banner.bc_logo');&amp;#10;   execute_trigger('util_banner');&amp;#10;&amp;#10;   :system.message_level := '10';&amp;#10;   default_value('DON','global.appl_id');&amp;#10;   load_news;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="LOAD_NEWS" ProgramUnitText="PROCEDURE load_news IS&amp;#10;   szNewsID      varchar2(20);&amp;#10;   szDescription varchar2(100);&amp;#10;   szEffDate     date;&amp;#10;   szTermDate    date;&amp;#10;   szStatus      varchar2(10);&amp;#10;   szNewsList    varchar2(200);&amp;#10;&amp;#10;   cursor cur_news is&amp;#10;          select news_id, description, eff_date, term_date&amp;#10;            from news_status&amp;#10;           where appl_id  = :global.appl_id&amp;#10;           order by upd_date desc;&amp;#10;&amp;#10;   cursor cur_news_status(p_appl_id varchar2,&amp;#10;                          p_news_id varchar2,&amp;#10;                          p_user_id varchar2) is&amp;#10;          select 'X'&amp;#10;            from news_log&amp;#10;           where appl_id  = p_appl_id&amp;#10;             and news_id  = p_news_id&amp;#10;             and user_id  = p_user_id;&amp;#10;&amp;#10;BEGIN&amp;#10;   clear_list('ctrl_block.news_list');&amp;#10;   open cur_news;&amp;#10;   loop&amp;#10;      fetch cur_news &amp;#10;       into szNewsID,&amp;#10;            szDescription,&amp;#10;            szEffDate,&amp;#10;            szTermDate;&amp;#10;      exit when cur_news%NOTFOUND;&amp;#10;      open cur_news_status(:global.appl_id,&amp;#10;                           szNewsID,&amp;#10;                           :banner.user_id);&amp;#10;      fetch cur_news_status &amp;#10;       into szStatus;&amp;#10;/* Modified and verified for Y2k.....Sobha....06/99  */&amp;#10;      if cur_news_status%NOTFOUND then&amp;#10;         szNewsList := rpad('NEW', 8) || rpad(szDescription, 58) || rpad(to_char(szEffDate, 'MM-DD-RR'), 10) || rpad(to_char(szTermDate, 'MM-DD-RR'), 10);&amp;#10;      else&amp;#10;         szNewsList := rpad(' ', 8)    || rpad(szDescription, 58) || rpad(to_char(szEffDate, 'MM-DD-RR'), 10) || rpad(to_char(szTermDate, 'MM-DD-RR'), 10);&amp;#10;      end if;&amp;#10;      if cur_news_status%ISOPEN then&amp;#10;         close cur_news_status;&amp;#10;      end if;&amp;#10;      add_list_element('ctrl_block.news_list',&amp;#10;                       rpad(to_char(cur_news%ROWCOUNT), 4),&amp;#10;                       szNewsList,&amp;#10;                       szNewsID);&amp;#10;   end loop;&amp;#10;   if cur_news%ISOPEN then&amp;#10;      close cur_news;&amp;#10;   end if;&amp;#10;   go_item('ctrl_block.news_list');&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="DISPLAY_NEWS" ProgramUnitText="PROCEDURE display_news IS&amp;#10;BEGIN&amp;#10;   set_block_property('news_table',&amp;#10;                      default_where,&amp;#10;                      'appl_id = :global.appl_id ' ||&amp;#10;                      ' and news_id = :ctrl_block.news_list ');&amp;#10;   --pitss synchronize;&amp;#10;   go_block('news_table');&amp;#10;   execute_query;&amp;#10;   go_block('ctrl_block');&amp;#10;   update_news_log;&amp;#10;   go_item('ctrl_block.news_list');&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="UPDATE_NEWS_LOG" ProgramUnitText="procedure update_news_log is&amp;#10;   szStatus  VARCHAR2(1);&amp;#10;begin&amp;#10;   select 'x' into :global.x&amp;#10;     from news_log&amp;#10;    where appl_id   = :global.appl_id&amp;#10;      and news_id   = :ctrl_block.news_list&amp;#10;      and user_id   = :banner.user_id;&amp;#10;exception&amp;#10;   when no_data_found then&amp;#10;      begin&amp;#10;         insert&amp;#10;           into news_log&amp;#10;                (appl_id,&amp;#10;                 news_id,&amp;#10;                 user_id,&amp;#10;                 access_date)&amp;#10;         values (:global.appl_id,&amp;#10;                 :ctrl_block.news_list,&amp;#10;                 :banner.user_id,&amp;#10;                 sysdate );&amp;#10;         exception&amp;#10;            when others then handle_error;&amp;#10;      end;&amp;#10;   when others then handle_error;&amp;#10;end;" ProgramUnitType="Procedure"/>
