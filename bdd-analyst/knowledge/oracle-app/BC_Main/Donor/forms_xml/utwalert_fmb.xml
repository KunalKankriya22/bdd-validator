      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10; alert_info lt_alert.payload_rt;&amp;#10;BEGIN&amp;#10;&#x9;--:global.program_version := '01';  -- Initial creation.&amp;#10;&#x9;:GLOBAL.PROGRAM_VERSION := '02'; -- Using png images and LAF instead of gif and read_image_file routine.&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9;HIDE_VIEW('BUTTON1_SC');&amp;#10;&#x9;HIDE_VIEW('BUTTON2_SC');&amp;#10;&#x9;HIDE_VIEW('BUTTON3_SC');&amp;#10;&amp;#10;&#x9;alert_info := lt_alert.payload;&#x9;&#x9;&amp;#10;&#x9;-- Set window title.&amp;#10;&#x9;set_window_property('WINDOW1',title, alert_info.title);&amp;#10;&#x9;-- Set Message&amp;#10;&#x9;:CTRL.MESSAGE := alert_info.message;&amp;#10;&amp;#10;&#x9;-- Set Image based on the alert style.&amp;#10;&#x9;IF alert_info.alert_style = 'Stop' THEN&amp;#10;&#x9;&#x9; Set_Custom_Property('LAF_BLOCK.LAF_BEAN', 1, 'ADD_IMAGE','1,/donor/ic_error_48.png,20,30,1,-1,-1');&amp;#10;&#x9;&#x9;--read_image_file('alertIcons/ic_error.gif','GIF','ctrl.img');&#x9;&amp;#10;&#x9;&#x9;--read_image_file('ed1c24-error-48.jpg','JPEG','ctrl.img');&#x9;&#x9;&amp;#10;&#x9;ELSIF alert_info.alert_style = 'Note' THEN&amp;#10;&#x9;&#x9;Set_Custom_Property('LAF_BLOCK.LAF_BEAN', 1, 'ADD_IMAGE','1,/donor/ic_msg_48.png,20,30,1,-1,-1');&amp;#10;&#x9;&#x9;--read_image_file('alertIcons/ic_msg.gif','GIF','ctrl.img');&#x9;&amp;#10;&#x9;ELSIF alert_info.alert_style = 'Caution' THEN&amp;#10;&#x9;&#x9;Set_Custom_Property('LAF_BLOCK.LAF_BEAN', 1, 'ADD_IMAGE','1,/donor/ic_warn_48.png,20,30,1,-1,-1');&amp;#10;&#x9;&#x9;--read_image_file('alertIcons/ic_warn.gif','GIF','ctrl.img');&amp;#10;&#x9;END IF;&amp;#10;&amp;#10;&#x9;-- One button alert&amp;#10;&#x9;IF alert_info.button1_lbl IS NOT NULL AND&amp;#10;&#x9;&#x9;alert_info.button2_lbl IS NULL AND&amp;#10;&#x9;&#x9;alert_info.button3_lbl IS NULL THEN&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;SHOW_VIEW('BUTTON1_SC');&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('BUTTON1.B1', LABEL, '&amp;' || alert_info.button1_lbl);&#x9;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;-- Go to default button.&amp;#10;&#x9;&#x9;GO_ITEM('BUTTON1.B1');&amp;#10;&#x9;&#x9;&#x9;&#x9;&amp;#10;&#x9; -- Two button alert&amp;#10;&#x9;ELSIF alert_info.button1_lbl IS NOT NULL AND&amp;#10;&#x9;&#x9;alert_info.button2_lbl IS NOT NULL AND&amp;#10;&#x9;&#x9;alert_info.button3_lbl IS NULL THEN&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;SHOW_VIEW('BUTTON2_SC');&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('BUTTON2.B1', LABEL, '&amp;' || alert_info.button1_lbl);&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('BUTTON2.B2', LABEL, '&amp;' || alert_info.button2_lbl);&#x9;&#x9;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;-- Go to Default button&amp;#10;&#x9;&#x9;IF alert_info.default_button = 'Button2' THEN&amp;#10;&#x9;&#x9;&#x9;GO_ITEM('BUTTON2.B2');&amp;#10;&#x9;&#x9;ELSE&amp;#10;&#x9;&#x9;&#x9;GO_ITEM('BUTTON2.B1');&amp;#10;&#x9;&#x9;END IF;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;--Three button alert&amp;#10;&#x9;ELSIF alert_info.button1_lbl IS NOT NULL AND&amp;#10;&#x9;&#x9;alert_info.button2_lbl IS NOT NULL AND&amp;#10;&#x9;&#x9;alert_info.button3_lbl IS NOT NULL THEN&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;SHOW_VIEW('BUTTON3_SC');&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('BUTTON3.B1', LABEL, '&amp;' || alert_info.button1_lbl);&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('BUTTON3.B2', LABEL, '&amp;' || alert_info.button2_lbl);&#x9;&#x9;&amp;#10;&#x9;&#x9;SET_ITEM_PROPERTY('BUTTON3.B3', LABEL, '&amp;' || alert_info.button3_lbl);&amp;#10;&amp;#10;&#x9;&#x9;-- Go to Default button&amp;#10;&#x9;&#x9;IF alert_info.default_button = 'Button3' THEN&amp;#10;&#x9;&#x9;&#x9;GO_ITEM('BUTTON3.B3');&amp;#10;&#x9;&#x9;ELSIF alert_info.default_button = 'Button2' THEN&amp;#10;&#x9;&#x9;&#x9;GO_ITEM('BUTTON3.B2');&amp;#10;&#x9;&#x9;ELSE&amp;#10;&#x9;&#x9;&#x9;GO_ITEM('BUTTON3.B1');&amp;#10;&#x9;&#x9;END IF;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;END IF;&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&amp;#10;&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" DirtyInfo="true" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN' ) ;&amp;#10;   End if ;&amp;#10;/*&amp;#10;      -- paint the Banner canevases --&amp;#10;   If :PARAMETER.PM$CANVAS is not null Then &amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN' ) ;&amp;#10;   End if ;&amp;#10;*/&amp;#10;&#x9;&amp;#10;&amp;#10;&amp;#10;End if;&amp;#10;initialise_windows;&amp;#10;&amp;#10;&amp;#10; &amp;#10; &amp;#10;"/>
