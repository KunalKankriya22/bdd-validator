      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;BEGIN&amp;#10;&#x9;--:global.program_version := '1.01.01';&amp;#10;&#x9;--:global.program_version := '2.03.00';&amp;#10;&#x9;--:global.program_version := '3.01.00';&amp;#10;&#x9;--:global.program_version := '01';&amp;#10;&#x9;--:global.program_version := '02'; &amp;#10;&#x9;--:global.program_version := '03'; &amp;#10;&#x9;--:global.program_version := '04'; -- IM:8497&amp;#10;&#x9;--:global.program_version := '05'; -- duplicate objects removal from GRP_LAF_STND&amp;#10;--&#x9;:global.program_version := '06'; -- SCR 21483 (Take care of the forms message that was occurring&amp;#10;&#x9;                                 -- when this window first appears on the screen)&amp;#10;&#x9;&amp;#10;&#x9;   -- Below Version Got Re-Updated from LT2018&amp;#10;     :global.program_version := '01';&amp;#10;     &amp;#10;     :system.message_level := '10';&amp;#10;   if :parameter.p_user_id is null or&amp;#10;      :parameter.p_chapter_id is null then&amp;#10;      show_error('18023');&amp;#10;      exit_form(no_validate);&amp;#10;   end if;&amp;#10;   begin&amp;#10;&#x9;:ctrl_block.act_passwd:= GET_APPLICATION_PROPERTY(PASSWORD);&amp;#10;--       select upper(appl_password) into :ctrl_block.act_passwd&amp;#10; --      from system_users &amp;#10;--&#x9;where user_id = :parameter.p_user_id and&amp;#10;--&#x9;      chapter_id = :parameter.p_chapter_id;&amp;#10;--   exception&amp;#10;--     when no_data_found then&amp;#10;--&#x9;show_error('19000');&amp;#10;--     when others then&amp;#10;--&#x9;handle_error;&amp;#10;   end;&amp;#10;   :ctrl_block.total_try := 0;&amp;#10;  go_item('ctrl_block.password');&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CHECK_AND_COMMIT" ProgramUnitText="PROCEDURE check_and_commit IS&amp;#10;&amp;#10;v_newpw varchar2(30);&amp;#10;&amp;#10;BEGIN&amp;#10;&amp;#10;-- Wing 6/20/00 secret key prefix added to give true password&amp;#10;  v_newpw := chr(73)||chr(68)||chr(69)||chr(77)||chr(69)||chr(82)||chr(65)||chr(87)||:ctrl_block.password;&amp;#10;&amp;#10;  if lt_password_policy.is_single_user_mode or lt_password_policy.is_strong_password then&amp;#10;  begin&amp;#10;  &#x9;&amp;#10;  --if :ctrl_block.act_passwd = v_newpw then&amp;#10;&#x9;&amp;#10;&#x9;if  lt_password_policy.check_hash(LT_USER_SESSION.get_userid,:ctrl_block.password) then&amp;#10;&#x9;:global.commit_yes_no := 'Y';&amp;#10;&#x9;exit_form(no_validate);&amp;#10;  else&amp;#10;&#x9;:ctrl_block.total_try := :ctrl_block.total_try + 1;&amp;#10;&amp;#10;&#x9;if :ctrl_block.total_try > 2 then&amp;#10;&#x9;&#x9;message('Three chances over !!!');&amp;#10;&#x9;&#x9;exit_form(no_validate);&amp;#10;&#x9;else&amp;#10;&#x9;&#x9;message('Password not matched, Try again.');&amp;#10;&#x9;end if;&amp;#10;&#x9;:ctrl_block.password:='';&amp;#10;&#x9;go_item('ctrl_block.password');&amp;#10;  end if;&amp;#10;  &amp;#10;  end;&amp;#10;---------------------------------------------------------------------------&#x9;&#x9;&amp;#10;  else&amp;#10;  &#x9;begin&amp;#10; &amp;#10;  if :ctrl_block.act_passwd = v_newpw then&amp;#10;&#x9;:global.commit_yes_no := 'Y';&amp;#10;&#x9;exit_form(no_validate);&amp;#10;  else&amp;#10;&#x9;:ctrl_block.total_try := :ctrl_block.total_try + 1;&amp;#10;&amp;#10;&#x9;if :ctrl_block.total_try > 2 then&amp;#10;&#x9;&#x9;message('Three chances over !!!');&amp;#10;&#x9;&#x9;exit_form(no_validate);&amp;#10;&#x9;else&amp;#10;&#x9;&#x9;message('Password not matched, Try again.');&amp;#10;&#x9;end if;&amp;#10;&#x9;:ctrl_block.password:='';&amp;#10;&#x9;go_item('ctrl_block.password');&amp;#10;  end if;&amp;#10;  &#x9;end;&amp;#10;  &#x9;end if;&amp;#10;&#x9;&amp;#10;END;" ProgramUnitType="Procedure"/>
