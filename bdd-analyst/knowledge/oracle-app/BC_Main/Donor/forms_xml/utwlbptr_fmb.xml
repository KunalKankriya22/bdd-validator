      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;   /* 4.01.01 */&amp;#10;   qry_str varchar2(600) := null;&amp;#10;   label_str varchar2(300) := 'WHERE CODE_TYPE = ''LPTT'' AND nvl(chapter_id, :global.chapter_id) = :global.chapter_id';&amp;#10;   label_order varchar2(100) := ' ORDER BY upper(code)';&amp;#10;BEGIN&amp;#10;   --:global.program_version := '01' ;&amp;#10;   :global.program_version := '02'; -- Chapter ID condition added. -- IM 529&amp;#10;   &amp;#10;&amp;#10;   default_value('PC','Global.bc_call_pgm');&amp;#10;   IF :GLOBAL.bc_call_pgm = 'LAPTOP' THEN&amp;#10;      label_str := 'WHERE CODE_TYPE = ''LLPTT''';&amp;#10;   END IF;&amp;#10;&amp;#10;   default_value(null,'GLOBAL.bc_tt_printer');&amp;#10;   set_window_property('win_stat',&amp;#10;                       title,&amp;#10;                       '[' || 'UTWLBPTR' || ' ' || :global.program_version || &amp;#10;                       ']               ' );&amp;#10;&amp;#10;   go_block('ctrl_blk_1');&amp;#10;   DECLARE&amp;#10;      rg_id    RecordGroup;&amp;#10;      errcode  NUMBER; &amp;#10;   BEGIN&amp;#10;      rg_id := Find_Group('BCLBLPTR');&amp;#10;      IF not Id_Null(rg_id) THEN &amp;#10;         delete_group(rg_id);&amp;#10;      END IF;&amp;#10;      qry_str :=  'SELECT  code ' || '|' || '|' || '''  -  ''' || '|' || '|' ||&amp;#10;                           'code_desc cd, code ' ||&amp;#10;                  'FROM RPT_MASTER_CODES ' ||&amp;#10;                  label_str || label_order;&amp;#10;      --message(qry_str); pause;&amp;#10;      rg_id := Create_Group_From_Query('BCLBLPTR', qry_str);&amp;#10;      errcode := Populate_Group( rg_id );&amp;#10;      Clear_List('CTRL_BLK_1.PRINTER_ID'); &amp;#10;      Populate_List('CTRL_BLK_1.PRINTER_ID',rg_id); &amp;#10;   END; &amp;#10;   GO_ITEM('CTRL_BLK_1.PRINTER_ID');&amp;#10;   :ctrl_blk_1.printer_id := :GLOBAL.bc_tt_printer;&amp;#10;   synchronize;&amp;#10;END;" ProgramUnitType="Procedure"/>
