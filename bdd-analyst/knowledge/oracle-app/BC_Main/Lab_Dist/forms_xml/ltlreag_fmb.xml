      <Trigger Name="WHEN-NEW-FORM-INSTANCE" FireInQuery="false" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN900' ) ;&amp;#10;   End if ;&amp;#10;&amp;#10;   -- paint the canevases --&amp;#10;   -- Addedby Kishore on 05/11/2011. IM 5478&amp;#10;   If :PARAMETER.PM$CANVAS is not null Then &amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN900' ) ;&amp;#10;   End if ;&amp;#10;   -- End of changes&amp;#10;End if;&amp;#10;------------------------------------------------------&amp;#10;--  end code added for the LAF project integration  --&amp;#10;------------------------------------------------------&amp;#10;InitForm;&amp;#10;:ctrl_block_1.chapter_id := :global.chapter_id;&amp;#10;go_block('display');&amp;#10;:system.message_level := 5;&amp;#10;execute_query(no_validate);&amp;#10;:system.message_level := 0;&amp;#10;IF get_block_property('DISPLAY',query_hits) = 0 THEN&amp;#10;   message('Err: No Kits Defined for test');&amp;#10;   exit_form(no_validate);&amp;#10;END IF;" DisplayInKeyboardHelp="true"/>
      <Trigger Name="POST-QUERY" TriggerText="---------------------------------------&amp;#10;--  LAF project : colorize each row  --&amp;#10;--                                     &amp;#10;  PKG_LOOK_AND_FEEL.Fill_Table('ODD') ;&amp;#10;--                                     &amp;#10;--  end LAF project  added code      --&amp;#10;---------------------------------------&amp;#10;"/>
