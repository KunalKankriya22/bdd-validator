         <Trigger Name="ON-CHECK-DELETE-MASTER" TriggerText="--&amp;#10;-- Begin default relation declare section&amp;#10;--&amp;#10;DECLARE&amp;#10;  Dummy_Define VARCHAR2(1);&amp;#10;  --&amp;#10;  -- Begin TEST_KIT_REAGENTS detail declare section&amp;#10;  --&amp;#10;  CURSOR TEST_KIT_REAGENTS_cur IS      &amp;#10;    SELECT 1 FROM TEST_KIT_REAGENTS     &amp;#10;    WHERE TEST_KIT_ID = :DISPLAY.TEST_KIT_ID;&amp;#10;  --&amp;#10;  -- End TEST_KIT_REAGENTS detail declare section&amp;#10;  --&amp;#10;--&amp;#10;-- End default relation declare section&amp;#10;--&amp;#10;--&amp;#10;-- Begin default relation program section&amp;#10;--&amp;#10;BEGIN&amp;#10;  --&amp;#10;  -- Begin TEST_KIT_REAGENTS detail program section&amp;#10;  --&amp;#10;  OPEN TEST_KIT_REAGENTS_cur;     &amp;#10;  FETCH TEST_KIT_REAGENTS_cur INTO Dummy_Define;     &amp;#10;  IF ( TEST_KIT_REAGENTS_cur%found ) THEN     &amp;#10;    Message('Cannot delete master record when matching detail records exist.');     &amp;#10;    CLOSE TEST_KIT_REAGENTS_cur;     &amp;#10;    RAISE Form_Trigger_Failure;     &amp;#10;  END IF;&amp;#10;  CLOSE TEST_KIT_REAGENTS_cur;&amp;#10;  --&amp;#10;  -- End TEST_KIT_REAGENTS detail program section&amp;#10;  --&amp;#10;END;&amp;#10;--&amp;#10;-- End default relation program section&amp;#10;--&amp;#10;"/>
