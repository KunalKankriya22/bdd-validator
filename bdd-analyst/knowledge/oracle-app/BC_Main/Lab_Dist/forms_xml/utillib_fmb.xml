      <Trigger Name="PRE-FORM" DirtyInfo="true" FireInQuery="false" TriggerText="--:global.program_version := '3.01.01';&amp;#10;--:global.program_version := '04'; -- Change made by Touqeer on 02/25/2011. (Added Timezone functions)&amp;#10;--:global.program_version := '05'; -- IM:8600; util_banner trigger - system_users query modified. 05/09/2012;&amp;#10;--:global.program_version := '06'; -- Duplicate objects removed from GRP_LAF_STND object group.&amp;#10;&amp;#10;-- Below Version Got Re-Updated from LT2018&amp;#10;  --:global.program_version := '01';&amp;#10;  :global.program_version := '02'; -- UTIL_BANNER trigger modified.&amp;#10;&amp;#10;execute_trigger('SBC_BANNER');&amp;#10;check_package_failure;" DisplayInKeyboardHelp="true"/>
      <Trigger Name="ON-ERROR" DirtyInfo="true" FireInQuery="true" TriggerText="begin&amp;#10;   if    error_code = 40100 -- at first record&amp;#10;   then&amp;#10;      show_error('1700');&amp;#10;   elsif error_code = 40102 -- record must be entered first&amp;#10;   then&amp;#10;      show_error('1701');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error('1702');&amp;#10;   elsif error_code = 40201 -- field is full&amp;#10;   then&amp;#10;      show_error('1703');&amp;#10;   elsif error_code = 40202 -- field must be entered&amp;#10;   then&amp;#10;       show_error('0080');&amp;#10;   elsif error_code = 40207 -- must be in range&amp;#10;   then&amp;#10;      show_error('1704');&amp;#10;   elsif error_code = 40208 -- form in query mode, cant update&amp;#10;   then&amp;#10;      show_error('1705');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error('5050');&amp;#10;   elsif error_code in (40400,40406,40407)-- transaction committed&amp;#10;   then&amp;#10;       show_error('8010');&amp;#10;   elsif error_code = 40401 -- no changes to commit&amp;#10;   then&amp;#10;       show_error('8013');&amp;#10;   elsif error_code in (50002,50003,50004, -- invalid date&amp;#10;                                50011,50012,50021,50023,50026)&amp;#10;   then&amp;#10;       show_error('1706');&amp;#10;   elsif error_code in (50006,50007,50009, -- invalid number&amp;#10;                                        50013,50014,50015,50016,50020)&amp;#10;   then&amp;#10;       show_error('1707');&amp;#10;   elsif error_code in (50017,50018,50019,50022) -- invalid time&amp;#10;   then&amp;#10;       show_error('5016');&amp;#10;   elsif error_code in ('0') -- invalid format&amp;#10;   then&amp;#10;       show_error('0022',GET_ITEM_PROPERTY(:system.cursor_item,FORMAT_MASK)); &amp;#10;   else&amp;#10;      message(substr(error_type||'-'||to_char (error_code)&amp;#10;       ||': '||error_text,1,80));&amp;#10;      raise form_trigger_failure;&amp;#10;   end if;&amp;#10;   check_package_failure;&amp;#10;    end;" DisplayInKeyboardHelp="true"/>
      <Trigger Name="KEY-HELP" DirtyInfo="true" FireInQuery="false" TriggerText=":global.hlp_form   := :system.current_form;&amp;#10;:global.hlp_block  := :system.current_block;&amp;#10;:global.hlp_field  := :system.current_field;&amp;#10;CALL_FORM( lower('GENHLP') ,QUERY_ONLY);&amp;#10;if  form_failure then&amp;#10;    message ('Err: Module GENHLP not found. Contact MIS');&amp;#10;    raise form_trigger_failure;&amp;#10;end if;" DisplayInKeyboardHelp="true"/>
