      <Trigger Name="UTIL_BANNER" DirtyInfo="true" FireInQuery="false" TriggerText="declare&amp;#10;&#x9;v_local_time date;&amp;#10;  l_status VARCHAR2(500);&#x9;&amp;#10;   PROCEDURE SHOW_HINT Is&amp;#10;      new_item_msg varchar2(80);&amp;#10;      f_block varchar2(30) := GET_FORM_PROPERTY(name_in('system.current_form'),FIRST_NAVIGATION_BLOCK);&amp;#10;      f_item varchar2(30);&amp;#10;   begin&amp;#10;      f_item := f_block || '.' || get_block_property(f_block,FIRST_ITEM);&amp;#10;      loop&amp;#10;         exit when get_item_property(f_item,NAVIGABLE) = 'TRUE' ;&amp;#10;         f_item := f_block || '.' || get_item_property(f_item,NEXTITEM);&amp;#10;      end loop;&amp;#10;      default_value('TRUE','global.show_hint');&amp;#10;      If get_item_property(f_item,AUTO_HINT) = 'TRUE' and :global.show_hint = 'TRUE' then&amp;#10;          :global.show_hint := 'FALSE';&amp;#10;         new_item_msg := get_item_property(f_item,HINT_TEXT);&amp;#10;         message(substr(new_item_msg,1,80),no_acknowledge);&amp;#10;      end if;&amp;#10;   END;&amp;#10;begin&amp;#10;&amp;#10;    default_value('UNKNOWN', 'global.program_version');&amp;#10;    default_value(null, 'GLOBAL.warehouse');&amp;#10;--&amp;#10;    default_value('SYSTEM NAME','global.system_name');&amp;#10;    default_value('MODULE NAME','global.module_name');&amp;#10;--&amp;#10;    :banner.system_name :=&amp;#10;        lpad( :global.system_name, length(:global.system_name) +&amp;#10;         floor((50 - length(:global.system_name))/2),' ');&amp;#10;    :banner.module_name :=&amp;#10;        lpad( :global.module_name, length(:global.module_name) +&amp;#10;         floor((50 - length(:global.module_name))/2),' ');&amp;#10;--&amp;#10;    null; --PitssCOn display_item('banner.module_name','Bold-underline');&amp;#10;    :banner.prog_name :=  substr(:system.current_form,instr(:system.current_form,'/',-1,1)+1,8);&amp;#10;    if  substr(LT_USER_SESSION.get_userid,1,4) = 'OPS$'&amp;#10;    then&amp;#10;        :banner.user_id  := substr(LT_USER_SESSION.get_userid,5,6) ;&amp;#10;    else&amp;#10;        :banner.user_id  := substr(LT_USER_SESSION.get_userid,1,6) ;&amp;#10;    end if;&amp;#10;--&amp;#10;    default_value ('N/A','global.db_id');&amp;#10;    if  :global.db_id = 'N/A'&amp;#10;    then&amp;#10;        begin&amp;#10;            select&amp;#10;          decode(substr(global_name,1,1),'W','D',substr(global_name,1,1))&amp;#10;            into :global.db_id&amp;#10;            from global_name;&amp;#10;        exception&amp;#10;            when others then handle_error;&amp;#10;        end;&amp;#10;    end if;&amp;#10;    :banner.db_id := :global.db_id;&amp;#10;    :banner.colon := ':';&amp;#10;--&amp;#10;    -- MLT 242; 08/01/2018&amp;#10;    l_status := SET_LAB_GLOBAL;&amp;#10;    &amp;#10;    IF l_status &lt;> 'OK' then&amp;#10;    &#x9;MESSAGE(l_status);&amp;#10;    &#x9;RAISE FORM_TRIGGER_FAILURE;&amp;#10;    END IF;&amp;#10;    &amp;#10;    show_hint;&amp;#10;&#x9;&#x9;------------&amp;#10;&amp;#10;    declare&amp;#10;    &#x9;v_local_time date;&amp;#10;    begin&amp;#10;    &#x9;if is_timezone_enabled then&amp;#10;         Lifetrack_timezone_convert.get_local_time(:global.chapter_id,sysdate,v_local_time);&amp;#10;         :banner.hdr_date := v_local_time;&amp;#10;         :banner.hdr_time := to_char(v_local_time,'hh24:mi');&amp;#10;&#x9;  &#x9;else&amp;#10;         :banner.hdr_date := sysdate;&amp;#10;         :banner.hdr_time := to_char(sysdate,'hh24:mi');&amp;#10;&#x9;  &#x9;end if;&amp;#10;    end;&amp;#10;    ---------- &#x9;&#x9;&amp;#10;    &amp;#10;    :BANNER.PROG_VERSION := BANNER_PROG_VERSION;&amp;#10;end ;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10; " DisplayInKeyboardHelp="true"/>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN1528' ) ;&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN1530' ) ;&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN1529' ) ;&amp;#10;   End if ;&amp;#10;&amp;#10;End if;&amp;#10;------------------------------------------------------&amp;#10;--  end code added for the LAF project integration  --&amp;#10;------------------------------------------------------&amp;#10;InitForm;"/>
