      <ProgramUnit Name="DUPLI_CHECK" ProgramUnitText="/* This Procedure  Checks Out Duplicate Records while entering...&amp;#10;    Creation date &#x9;&#x9;30-Jan-97&#x9;&amp;#10;*/&amp;#10;PROCEDURE dupli_check IS&amp;#10;BEGIN&amp;#10;  declare&amp;#10;   temp_v_cat_num      varchar2(10);&amp;#10;   temp_v_prd_type_cd  varchar2(5);&amp;#10;   temp_v_item_name    varchar2(50);&amp;#10;   temp_c_rec_no         VARCHAR2(2);&amp;#10;BEGIN&amp;#10;   temp_v_item_name := :system.trigger_item;&amp;#10;   temp_v_cat_num := :valid_container_products.catalog_number; &amp;#10;   temp_v_prd_type_cd := :valid_container_products.product_type;&amp;#10;   temp_c_rec_no := :system.trigger_record;&amp;#10;   go_record('1');&amp;#10;   WHILE :system.last_record = 'FALSE'&amp;#10;   LOOP&amp;#10;      IF :valid_container_products.catalog_number = temp_v_cat_num and&amp;#10;         :valid_container_products.product_type = temp_v_prd_type_cd and&amp;#10;         :system.trigger_record != temp_c_rec_no&amp;#10;      THEN&amp;#10;         go_record(temp_c_rec_no);&amp;#10;          go_item(temp_v_item_name);&amp;#10;                         show_error('0069');&amp;#10;                         check_package_failure;&amp;#10;      END IF;&amp;#10;      down;&amp;#10;   END LOOP;&amp;#10;  go_record(temp_c_rec_no);&amp;#10;  go_item(temp_v_item_name);&amp;#10;END;&amp;#10;END;" ProgramUnitType="Procedure"/>
