      <ProgramUnit Name="VALIDATE_RECORD" ProgramUnitText="procedure validate_record is&amp;#10;begin&amp;#10;  execute_trigger('validate_field');&amp;#10;  check_package_failure;&amp;#10;  loop&amp;#10;  exit when :system.cursor_field = 'VALID_INTER_OVERRIDES_STAGE.TERM_DATE';&amp;#10;    nullchk;&amp;#10;    check_package_failure;&amp;#10;    NEXT_ITEM;&amp;#10;  end loop;&amp;#10;end;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CHECK_DUPS" ProgramUnitText="procedure check_dups is&amp;#10;    current_record varchar2(3);&amp;#10;    current_field  varchar2(100);&amp;#10;    cue            varchar2(1);&amp;#10;    product        varchar2(5);&amp;#10;    inter_code     varchar2(4);&amp;#10;begin&amp;#10;  if :valid_inter_overrides_stage.rowid is null&amp;#10;  then&amp;#10;    select distinct 'x'&amp;#10;    into :GLOBAL.x&amp;#10;    from valid_inter_overrides_stage&amp;#10;    where donor_decision_code = :donor_decision_code&amp;#10;      and product_type = :product_type&amp;#10;      and inter_code = :inter_code;&amp;#10;    show_error('5238');&amp;#10;    check_package_failure;&amp;#10;  end if;&amp;#10;exception&amp;#10;  when no_data_found then&amp;#10;    current_field := :system.cursor_field;&amp;#10;    current_record := :system.cursor_record;&amp;#10;    cue := :donor_decision_code;&amp;#10;    product := :product_type;&amp;#10;    inter_code := :inter_code;&amp;#10;    go_record('1');&amp;#10;    loop&amp;#10;      if current_record != :system.cursor_record and&amp;#10;         cue = :donor_decision_code and&amp;#10;         product = :product_type and&amp;#10;         inter_code = :inter_code&amp;#10;      then&amp;#10;        go_record(current_record);&amp;#10;        show_error('5238');&amp;#10;        check_package_failure;&amp;#10;      end if;&amp;#10;    exit when :system.last_record = 'TRUE';&amp;#10;      down;&amp;#10;    end loop;&amp;#10;    go_record(current_record);&amp;#10;    GO_ITEM(current_field);&amp;#10;  when others then&amp;#10;    handle_error;&amp;#10;    check_package_failure;&amp;#10;end;" ProgramUnitType="Procedure"/>
