      <ProgramUnit Name="DISPLAY_ERRORS" ProgramUnitText="PROCEDURE display_errors (error_code in varchar,msg in varchar)IS&amp;#10;BEGIN&amp;#10;  &#x9;IF ERROR_CODE ='1000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;SHOW_ERROR('1606',MSG);&amp;#10;&amp;#10;            ELSIF ERROR_CODE ='2000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('1607',MSG);&amp;#10;          &#x9;   &amp;#10;          &#x9;   &amp;#10;          &#x9;   ELSIF ERROR_CODE ='3000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('1608',MSG);&amp;#10;          &#x9;   &amp;#10;          &#x9;   ELSIF ERROR_CODE ='4000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('1609',MSG);&amp;#10;          &#x9;   &amp;#10;          &#x9;   ELSIF ERROR_CODE ='5000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('1610',MSG);&amp;#10;&amp;#10;              ELSIF ERROR_CODE ='6000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('3102',MSG);&amp;#10;&amp;#10;END IF;&amp;#10;END;" ProgramUnitType="Procedure"/>
