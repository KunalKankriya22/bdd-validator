      <Trigger Name="ON-ERROR" ParentModule="UTILLIB" ParentModuleType="12" ParentName="ON-ERROR" ParentFilename="utillib.fmb" DirtyInfo="true" TriggerText="begin&amp;#10;   if    error_code = 40100 -- at first record&amp;#10;   then&amp;#10;      show_error('1700');&amp;#10;   elsif error_code = 40102 -- record must be entered first&amp;#10;   then&amp;#10;      show_error('1701');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error('1702');&amp;#10;   elsif error_code = 40201 -- field is full&amp;#10;   then&amp;#10;      show_error('1703');&amp;#10;   elsif error_code = 40202 -- field must be entered&amp;#10;   then&amp;#10;       show_error('0080');&amp;#10;   elsif error_code = 40207 -- must be in range&amp;#10;   then&amp;#10;      show_error('1323');&amp;#10;   elsif error_code = 40208 -- form in query mode, cant update&amp;#10;   then&amp;#10;      show_error('1705');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error('5050');&amp;#10;   elsif error_code in (40400,40406,40407)-- transaction committed&amp;#10;   then&amp;#10;       show_error('8010');&amp;#10;   elsif error_code = 40401 -- no changes to commit&amp;#10;   then&amp;#10;       show_error('8013');&amp;#10;   elsif error_code in (50002,50003,50004, -- invalid date&amp;#10;                                50011,50012,50021,50023,50026)&amp;#10;   then&amp;#10;       show_error('1706');&amp;#10;   elsif error_code in (50006,50007,50009, -- invalid number&amp;#10;                                        50013,50014,50015,50016,50020,40209)&amp;#10;   then&amp;#10;       show_error('1707');&amp;#10;   elsif error_code in (50017,50018,50019,50022) -- invalid time&amp;#10;   then&amp;#10;       show_error('5016');&amp;#10;   elsif error_code in ('0') -- invalid format&amp;#10;   then&amp;#10;       show_error('0022',GET_ITEM_PROPERTY(:system.cursor_item,FORMAT_MASK)); &amp;#10;   &amp;#10;   else&amp;#10;      message(substr(error_type||'-'||to_char (error_code)&amp;#10;       ||': '||error_text,1,80));&amp;#10;      raise form_trigger_failure;&amp;#10;   end if;&amp;#10;   check_package_failure;&amp;#10;    end;" ParentType="37"/>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" FireInQuery="false" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN2' ) ;&amp;#10;   End if ;&amp;#10;   -- paint the canevases --&amp;#10;   If :PARAMETER.PM$CANVAS is not null Then &amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN2' ) ;&amp;#10;   End if ;   &amp;#10;  &amp;#10;End if;&amp;#10;------------------------------------------------------&amp;#10;--  end code added for the LAF project integration  --&amp;#10;------------------------------------------------------&amp;#10;InitForm;&amp;#10;begin&amp;#10;--&amp;#10;    default_value ('DON','global.appl_id');&amp;#10;    if  :global.appl_id = 'NULL' then&amp;#10;        message ('Err: Application System not selected.');&amp;#10;        pause;&amp;#10;        exit_form(no_validate);&amp;#10;    end if;&amp;#10;--&amp;#10;:global.flag:='T';&amp;#10;    :ctrl_block_1.appl_id := :global.appl_id;&amp;#10;    go_block('LT_PASSWORD_CONFIG');&amp;#10;    execute_query; &amp;#10;   &amp;#10;end;" DisplayInKeyboardHelp="true"/>
