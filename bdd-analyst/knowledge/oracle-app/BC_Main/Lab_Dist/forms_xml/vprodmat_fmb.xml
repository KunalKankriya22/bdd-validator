            <Trigger Name="KEY-UP" FireInQuery="false" TriggerText="begin&amp;#10;    if :system.cursor_field is not null&amp;#10;    then&amp;#10;       execute_trigger('validate_Field');&amp;#10;       check_package_failure;&amp;#10;    else&amp;#10;       clear_record;&amp;#10;    end if;&amp;#10;    up;&amp;#10;end;" DisplayInKeyboardHelp="true"/>
            <Trigger Name="VALIDATE_FIELD" FireInQuery="false" TriggerText="declare&amp;#10;    temp_rec_no         VARCHAR2(1);&amp;#10;--HCL    temp_product_code   char(8);&amp;#10;    temp_v_product_type VARCHAR2(5);  --HCL&amp;#10;begin&amp;#10;    nullchk;&amp;#10;    check_package_failure;&amp;#10;    begin&amp;#10;&amp;#10;/*  HCL        select product_desc&amp;#10;        into   :ctrl_blk_2.s_product_code_desc&amp;#10;        from   valid_products&amp;#10;        where  product_code = :ctrl_blk_2.s_product_code and&amp;#10;               sysdate between eff_date and&amp;#10;               nvl(term_date,sysdate+365);  */&amp;#10;&amp;#10;--THE SELECT STATEMENT BELOW HAS BEEN CREATED BY HCL&amp;#10;&amp;#10;        SELECT product_type_desc &amp;#10;        INTO     :ctrl_blk_2.s_product_type_desc&amp;#10;        FROM    valid_product_types&amp;#10;        WHERE  product_type_code = :ctrl_blk_2.s_product_type &amp;#10;                     AND sysdate BETWEEN eff_date &amp;#10;                     AND nvl(term_date,sysdate+365);   &amp;#10;        exception&amp;#10;            when NO_DATA_FOUND&amp;#10;            then&amp;#10;--HCL               show_error('1205');&amp;#10;               show_error('1245');  --HCL&amp;#10;               check_package_failure;&amp;#10;    end;&amp;#10;    -- to check for existing combination for single bag&amp;#10;    -- configuration&amp;#10;    begin&amp;#10;        select 'x' into :GLOBAL.x&amp;#10;        from product_matrix&amp;#10;        where  bag_code = to_char(:s_no_of_bags) and&amp;#10;               :s_no_of_bags = 1 and&amp;#10;--HCL               product_code = :ctrl_blk_2.s_product_code;&amp;#10;               product_type = :ctrl_blk_2.s_product_type;  --HCL&amp;#10;        show_error('0156');&amp;#10;        check_package_failure;&amp;#10;        exception&amp;#10;           when NO_DATA_FOUND&amp;#10;           then&amp;#10;              null;&amp;#10;          when too_many_rows then show_error('0156');&amp;#10;                   check_package_failure;&amp;#10;          when OTHERS&amp;#10;           then&amp;#10;              handle_error;&amp;#10;              check_package_failure;&amp;#10;    end;&amp;#10;    temp_rec_no := :system.trigger_record;&amp;#10;&amp;#10;--HCL    temp_product_code := :ctrl_blk_2.s_product_code;&amp;#10;    temp_v_product_type := :ctrl_blk_2.s_product_type;  --HCL&amp;#10;&amp;#10;    go_record('1');&amp;#10;    loop&amp;#10;&amp;#10;--HCL       if :ctrl_blk_2.s_product_code = temp_product_code and&amp;#10;       IF :ctrl_blk_2.s_product_type = temp_v_product_type AND  --HCL   &amp;#10;           :system.trigger_record != temp_rec_no&amp;#10;       then&amp;#10;          go_record(temp_rec_no);&amp;#10;          show_error('0069');&amp;#10;          check_package_failure;&amp;#10;       end if;&amp;#10;       if :system.last_record = 'TRUE'&amp;#10;       then&amp;#10;          exit;&amp;#10;       else&amp;#10;          down;&amp;#10;       end if;&amp;#10;    end loop;&amp;#10;    go_record(temp_rec_no);&amp;#10;end;" DisplayInKeyboardHelp="true"/>
