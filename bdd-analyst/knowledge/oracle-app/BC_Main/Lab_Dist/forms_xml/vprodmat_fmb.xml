         <Trigger Name="KEY-COMMIT" FireInQuery="false" TriggerText="declare&amp;#10;    temp_set_id   number;&amp;#10;begin&amp;#10;    execute_trigger('validate_record');&amp;#10;    check_package_Failure;&amp;#10;    execute_trigger('check_duplicate');&amp;#10;    check_package_Failure;&amp;#10;    begin&amp;#10;        select nvl(max(set_id)+1,1)&amp;#10;        into   temp_set_id&amp;#10;        from   product_matrix;&amp;#10;        exception&amp;#10;            when OTHERS&amp;#10;            then&amp;#10;               message('1');&amp;#10;               handle_error;&amp;#10;               check_package_Failure;&amp;#10;    end;&amp;#10;    go_record('1');&amp;#10;    loop&amp;#10;        begin&amp;#10;            insert into product_matrix&amp;#10;--HCL            (bag_code, set_id, product_code, program_id)&amp;#10;               (bag_code,set_id,product_type,audit_key,program_id)  --HCL &amp;#10;            values (to_char(:s_no_of_bags), temp_set_id,&amp;#10;--HCL                    :ctrl_blk_2.s_product_code, :banner.prog_name);&amp;#10;                :ctrl_blk_2.s_product_type,audit_seq.nextval,:banner.prog_name);  --HCL&amp;#10;            exception&amp;#10;               when OTHERS&amp;#10;               then&amp;#10;                  message('Error in inserting in product_matrix');&amp;#10;                  handle_error;&amp;#10;                  check_package_Failure;&amp;#10;        end;&amp;#10;        if :system.last_record = 'TRUE'&amp;#10;        then&amp;#10;           exit;&amp;#10;        else&amp;#10;           down;&amp;#10;        end if;&amp;#10;    end loop;&amp;#10;        :system.message_level := 5;&amp;#10;  check_pass;&amp;#10;        :system.message_level := 0;&amp;#10;&amp;#10;    if form_failure&amp;#10;    then&amp;#10;       show_error('0230');&amp;#10;       check_package_failure;&amp;#10;       clear_block(NO_VALIDATE);&amp;#10;    else&amp;#10;       execute_trigger('key-clrfrm');&amp;#10;       show_error('8010');&amp;#10;       check_package_Failure;&amp;#10;    end if;&amp;#10;end;" DisplayInKeyboardHelp="true"/>
         <Trigger Name="CHECK_DUPLICATE" FireInQuery="false" TriggerText="declare&amp;#10;    temp_def_prod      varchar2(2000);&amp;#10;    temp_count         number;&amp;#10;begin&amp;#10;    go_record('1');&amp;#10;    temp_def_prod := '|';&amp;#10;    loop&amp;#10;--HCL       temp_def_prod := temp_def_prod||:ctrl_blk_2.s_product_code||'|';&amp;#10;       temp_def_prod := temp_def_prod||:ctrl_blk_2.s_product_type||'|';  --HCL  &amp;#10;       exit when :system.last_record = 'TRUE';&amp;#10;       down;&amp;#10;    end loop;&amp;#10;    temp_count := :system.cursor_record;&amp;#10;    begin&amp;#10;        select 'x' into :GLOBAL.x&amp;#10;        from product_matrix  a&amp;#10;        where a.bag_code = to_char(:s_no_of_bags)&amp;#10;--HCL            and temp_def_prod like '%|'||a.product_code||'|%'&amp;#10;            AND temp_def_prod LIKE '%|'||a.product_type||'|%'  --HCL&amp;#10;            and not exists&amp;#10;                   (select 'x'&amp;#10;                    from product_matrix  b&amp;#10;                    where a.set_id = b.set_id&amp;#10;                      and temp_def_prod not like&amp;#10;--HCL                          '%|'||b.product_code||'|%')&amp;#10;                            '%|'||b.product_type||'|%')  --HCL&amp;#10;          group by set_id&amp;#10;          having count(*) = temp_count;&amp;#10;        show_error('0156');&amp;#10;        check_package_failure;&amp;#10;        exception&amp;#10;            when NO_DATA_FOUND&amp;#10;            then&amp;#10;               null;&amp;#10;            when OTHERS&amp;#10;            then&amp;#10;             --message('Error in checking for duplicate combination');&amp;#10;               handle_error;&amp;#10;               check_package_failure;&amp;#10;    end;&amp;#10;end;" DisplayInKeyboardHelp="true"/>
         <Trigger Name="KEY-EXIT" FireInQuery="false" TriggerText="begin&amp;#10;    clear_block(NO_VALIDATE);&amp;#10;    GO_ITEM('s_no_of_bags');&amp;#10;end;" DisplayInKeyboardHelp="true"/>
