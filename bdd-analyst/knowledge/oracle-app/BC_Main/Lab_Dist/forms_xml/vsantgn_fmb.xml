      <ProgramUnit Name="COMMIT_TRANSACTION" ProgramUnitText="procedure commit_transaction is&amp;#10;-- this procedure commits all changes and display order number that has&amp;#10;-- been generated&amp;#10;begin&amp;#10;  if :system.form_status = 'CHANGED'&amp;#10;  then&amp;#10;    :system.message_level := 5;&amp;#10;    check_pass;&amp;#10;    :system.message_level := 0;&amp;#10;    if form_success&amp;#10;    then&amp;#10;      show_error_dist('0000');          /* transaction committed */&amp;#10;      check_package_failure;&amp;#10;    else&amp;#10;      clear_form(full_rollback);&amp;#10;      show_error_dist('0600');          /* unsuccessful commit   */&amp;#10;      check_package_failure;&amp;#10;    end if;&amp;#10;  else&amp;#10;    show_error_dist('0601');             /* no change to commit  */&amp;#10;    check_package_failure;&amp;#10;  end if;&amp;#10;end;" ProgramUnitType="Procedure"/>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" FireInQuery="false" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN1626' ) ;&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN1625' ) ;&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN1627' ) ;&amp;#10;   End if ;&amp;#10;   -- paint the canevases --&amp;#10;   If :PARAMETER.PM$CANVAS is not null Then &amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN1626' ) ;&amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN1625' ) ;&amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN1627' ) ;&amp;#10;   End if ;&amp;#10;   /*&amp;#10;   -- paint the block --&amp;#10;   Go_Block('ANTIGENS');&amp;#10;   PKG_LOOK_AND_FEEL.Paint_Block&amp;#10;   (&amp;#10;     PC$Block      => 'ANTIGENS'&amp;#10;    ,PC$BeanName   => 'LAF_BLOCK.LAF_BEAN1625'&amp;#10;    ,PC$VA_Name    => :PARAMETER.PM$VA&amp;#10;    ,PC$HeadClass  => :PARAMETER.PM$HEADER&amp;#10;    ,PC$BodyClass  => :PARAMETER.PM$BODY&amp;#10;    ,PC$TitleClass => :PARAMETER.PM$TITLE&amp;#10;    ,PC$Title      => null&amp;#10;    ,PB$ScrollBar  => false&amp;#10;   ) ;&amp;#10;  Go_Block('ANTIGENS');&amp;#10;  */&amp;#10;End if;&amp;#10;------------------------------------------------------&amp;#10;--  end code added for the LAF project integration  --&amp;#10;------------------------------------------------------&amp;#10;InitForm;&amp;#10;&amp;#10;--&amp;#10;go_block('antigens');&amp;#10;execute_query;" DisplayInKeyboardHelp="true"/>
      <Trigger Name="ON-ERROR" ParentModule="SRVLIB" ParentModuleType="12" ParentName="ON-ERROR" ParentFilename="srvlib.fmb" DirtyInfo="true" TriggerText="declare&amp;#10;  temp_code  number;&amp;#10;  temp_msg   VARCHAR2(80);&amp;#10;begin&amp;#10;   if    error_code = 40100 -- at first record&amp;#10;   then&amp;#10;      show_error_dist('0213');&amp;#10;   elsif error_code = 40102 -- record must be entered first&amp;#10;   then&amp;#10;      show_error_dist('0214');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error_dist('0215');&amp;#10;   elsif error_code = 40201 -- field is full&amp;#10;   then&amp;#10;      show_error_dist('0216');&amp;#10;   elsif error_code = 40202 -- field must be entered&amp;#10;   then&amp;#10;       show_error_dist('0204');&amp;#10;   elsif error_code = 40207 -- must be in range&amp;#10;   then&amp;#10;      show_error_dist('0217');&amp;#10;   elsif error_code = 40208 -- form in query mode, cant update&amp;#10;   then&amp;#10;      show_error_dist('0218');&amp;#10;   elsif error_code = 40209 -- invalid entry format&amp;#10;   then&amp;#10;      show_error_dist('0246');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error_dist('0215');&amp;#10;   elsif error_code in (40400,40406,40407)-- transaction committed&amp;#10;   then&amp;#10;       show_error_dist('0000');&amp;#10;   elsif error_code = 40401 -- no changes to commit&amp;#10;   then&amp;#10;       show_error_dist('0601');&amp;#10;   elsif error_code in (50002,50003,50004, -- invalid date&amp;#10;                        50011,50012,50021,50023,50026,0)&amp;#10;   then&amp;#10;        declare&amp;#10;             disp_format_mask varchar2(20);&amp;#10;        begin&amp;#10;           if upper(substr(get_item_property(:system.cursor_item, FORMAT_MASK),1,2))='FX' then&amp;#10;              disp_format_mask:=substr(get_item_property(:system.cursor_item, FORMAT_MASK),3);&amp;#10;          else&amp;#10;              disp_format_mask:= get_item_property(:system.cursor_item, FORMAT_MASK);&amp;#10;          end if;&amp;#10;          disp_format_mask := translate(disp_format_mask, 'R', 'Y');&amp;#10;          show_error_dist('0251',disp_format_mask);&amp;#10;          show_error_dist('0251',GET_ITEM_PROPERTY(:system.cursor_item,FORMAT_MASK));&amp;#10;       end;&amp;#10;   elsif error_code = 50025 -- no changes to commit&amp;#10;   then&amp;#10;       show_error_dist('0509');&amp;#10;   elsif error_code in (50006,50007,50009, -- invalid number&amp;#10;                        50013,50014,50015,50016,50020)&amp;#10;   then&amp;#10;       show_error_dist('0220');&amp;#10;   elsif error_code in (50017,50018,50019,50022) -- invalid time&amp;#10;   then&amp;#10;       show_error_dist('0331');&amp;#10;   elsif error_code in ('40209','40735') then&amp;#10;       null;&amp;#10;   else                          -- unhandled Forms errors&amp;#10;     message('FRMS ' || to_char(error_code) || ':' || error_text);&amp;#10;   end if;&amp;#10;   check_package_failure;&amp;#10;end;" ParentType="37"/>
      <Trigger Name="PRE-FORM" FireInQuery="false" TriggerText="begin&amp;#10;    --:global.program_version:='01';&amp;#10;    --:global.program_version:='02'; -- IM 2680&amp;#10;    --  :global.program_version:='03'; -- -- duplicate objects removal from GRP_LAF_STND&amp;#10;    &amp;#10;-- Below Version Got Re-Updated from LT2018&amp;#10;  :global.program_version := '01';&amp;#10;&amp;#10;    execute_trigger('sbc_banner');&amp;#10;    check_package_failure;&amp;#10;end;" DisplayInKeyboardHelp="true"/>
