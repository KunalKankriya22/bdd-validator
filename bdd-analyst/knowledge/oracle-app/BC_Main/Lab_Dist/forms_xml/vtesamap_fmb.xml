      <ProgramUnit Name="CHECK_FROM_TO_DATE" ProgramUnitText="FUNCTION Check_From_To_date(date_from date, date_to date )  RETURN boolean IS&amp;#10;BEGIN&amp;#10;&#x9;if to_char(date_from,'YYYY-MM-DD')>&amp;#10;&#x9;&#x9;to_char(date_to,'YYYY-MM-DD') then&amp;#10;&#x9;   return FALSE;&#x9;&amp;#10;&#x9;else&amp;#10;&#x9;   return TRUE;&#x9;&amp;#10;&#x9;end if;&#x9;&amp;#10;RETURN NULL; &amp;#10;END; " ProgramUnitType="Function"/>
      <ProgramUnit Name="VALIDATE_EFF_TERM_DATES" ProgramUnitText="PROCEDURE validate_eff_term_dates   (  eff_date in date,&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;     term_date in date,&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;     from_where in varchar2&#x9;)&#x9;&amp;#10;IS&amp;#10;&#x9;dt_chk&#x9;boolean;&amp;#10;&#x9;chp_sysdate DATE;&amp;#10;begin&amp;#10;&#x9;&amp;#10;&#x9; if eff_date is null then&amp;#10;&#x9;    show_error('5002');&amp;#10;&#x9;    check_package_failure;&amp;#10;&#x9; end if;&amp;#10;&#x9;&amp;#10;&#x9; chp_sysdate := lifetrack_timezone_convert.get_lcl_time(:GLOBAL.tz_enabled, :GLOBAL.tz_offset, SYSDATE);&amp;#10;&#x9; &amp;#10;&#x9; &amp;#10;&#x9; if eff_date &lt; trunc(chp_sysdate) and from_where = 'E'  then&amp;#10;&#x9;&#x9;show_error('5015');&amp;#10;&#x9;&#x9;check_package_failure;&amp;#10;&#x9; end if;&amp;#10;&#x9;&amp;#10;&#x9; if term_date is not null then&amp;#10;&#x9;   if term_date &lt; trunc(chp_sysdate) then&amp;#10;&#x9;&#x9; &#x9;show_error('3115');&amp;#10;&#x9;&#x9; &#x9;check_package_failure;&amp;#10;&#x9;   end if; &amp;#10;&#x9;   dt_chk := check_from_to_date(eff_date,term_date);&amp;#10;&#x9;   if dt_chk then&amp;#10;&#x9;     null;&amp;#10;&#x9;   else&amp;#10; &#x9;&#x9;&#x9; show_error('5004');&amp;#10;&#x9;&#x9;&#x9; check_package_failure;&amp;#10;&#x9;   end if;&amp;#10;&#x9; end if;&amp;#10;end;  " ProgramUnitType="Procedure"/>
      <ProgramUnit Name="COMPARAISON" ProgramUnitText="Function COMPARAISON (val1 varchar2, val2 varchar2)&amp;#10;Return number is&amp;#10;&#x9;answer number := 0;&amp;#10;Begin &amp;#10;&#x9; if val1 = val2 then &amp;#10;&#x9;  &#x9; answer := 1; &amp;#10;&#x9; end if;&amp;#10;&#x9; return(answer); &amp;#10;END;" ProgramUnitType="Function"/>
      <ProgramUnit Name="COMMIT_RECORDS" ProgramUnitText="PROCEDURE commit_records&amp;#10;IS&amp;#10;BEGIN&amp;#10;  IF :system.block_status IN ('NEW','CHANGED') THEN&amp;#10;    :system.message_level := 20;&amp;#10;    COMMIT_FORM;&amp;#10;    :system.message_level := 0;&amp;#10;    &amp;#10;    IF form_success THEN&amp;#10;      show_error('0000');&amp;#10;      check_package_failure;&amp;#10;    ELSE&amp;#10;      MESSAGE('error in coomit');&amp;#10;      raise form_trigger_failure;&amp;#10;    END IF;&amp;#10;    &amp;#10;  END IF;&amp;#10;END commit_records;" ProgramUnitType="Procedure"/>
