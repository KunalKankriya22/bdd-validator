LOAD DATA
INFILE '/home/sbcsys/conversion/data/table.50'
---INFILE './LIFED_UNIT_1.add'
---append 
INTO TABLE convert_units
(
 UNIT_ID              POSITION(001:015)  CHAR(15) NULLIF (UNIT_ID = BLANKS),
 COLL_DATE  POSITION(016:023)  DATE(8) "MMDDYYYY" NULLIF (COLL_DATE = BLANKS),
 LOT_NO               POSITION(024:053)  CHAR(30) NULLIF (LOT_NO = BLANKS),
 BAG_TYPE             POSITION(054:057)  CHAR(4)  NULLIF (BAG_TYPE = BLANKS),
 DRAW_CATEGORY_CODE   POSITION(058:062)  CHAR(5)  NULLIF (DRAW_CATEGORY_CODE = BLANKS),
 BLOOD_TYPE           POSITION(063:067)  CHAR(5)  NULLIF (BLOOD_TYPE = BLANKS),
 DISCARD_FLAG         POSITION(068:068)  CHAR(1)  NULLIF (DISCARD_FLAG = BLANKS),
 DONOR_PROCEDURE_TYPE POSITION(069:069)  CHAR(1)  NULLIF (DONOR_PROCEDURE_TYPE = BLANKS),
 DRIVE_ID             POSITION(070:079)  CHAR(10)  NULLIF (DRIVE_ID = BLANKS),
 IMPORT_FLAG          POSITION(080:080)  CHAR(1)  NULLIF (IMPORT_FLAG = BLANKS),
 INSERT_DATE          POSITION(081:092)  DATE(12) "MMDDYYYYHH24MI"     NULLIF (INSERT_DATE = BLANKS),
 UNIT_STATUS          POSITION(093:093)  CHAR(1)  NULLIF (UNIT_STATUS = BLANKS),
 SELF_DEFERRAL_FLAG   POSITION(094:094)  CHAR(1)  NULLIF (SELF_DEFERRAL_FLAG = BLANKS),
 DONOR_ID             POSITION(095:104)  CHAR(10) NULLIF (DONOR_ID = BLANKS),
 CHAPTER_ID           POSITION(105:108)  CHAR(4)  NULLIF (CHAPTER_ID = BLANKS),
 DRAW_STN             POSITION(109:113)  CHAR(5)  NULLIF (DRAW_STN = BLANKS))
