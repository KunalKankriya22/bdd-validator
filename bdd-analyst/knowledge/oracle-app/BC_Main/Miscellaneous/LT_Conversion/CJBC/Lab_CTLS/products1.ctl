LOAD DATA
INFILE '/ltdata/products.dat'
---INFILE './LIFED_PRODUCT_1B.bad'
append
INTO TABLE convert_products
(
 UNIT_ID              POSITION(001:015)  CHAR(15) NULLIF (UNIT_ID = BLANKS),
 COLL_DATE            POSITION(016:023)  DATE(8) "MMDDYYYY" NULLIF (COLL_DATE = BLANKS),
 PRODUCT_CODE         POSITION(024:031)  CHAR(8) NULLIF (PRODUCT_CODE = BLANKS),
 EXPIRY_DATE          POSITION(032:043)  DATE(12) "MMDDYYYYHH24MI" NULLIF (EXPIRY_DATE = BLANKS),
 SHIP_TICKET_NO       POSITION(044:057)  CHAR(14) NULLIF (SHIP_TICKET_NO = BLANKS),
 SHIPPED_TO           POSITION(058:067)  CHAR(10) NULLIF (SHIPPED_TO = BLANKS),
 SHIP_DATE            POSITION(068:075)  DATE(8) "MMDDYYYY" NULLIF (SHIP_DATE = BLANKS),
 DISCARD_FLAG         POSITION(076:076)  CHAR(1) NULLIF (DISCARD_FLAG = BLANKS),
 MFG_FLAG             POSITION(077:077)  CHAR(1) NULLIF (MFG_FLAG = BLANKS),
 TESTED_BLOOD_TYPE    POSITION(078:081)  CHAR(4) NULLIF (TESTED_BLOOD_TYPE = BLANKS),
 CONVERT_FLAG         POSITION(082:082)  CHAR(1) NULLIF (CONVERT_FLAG = BLANKS),
 RELABEL_PRODUCT_CODE POSITION(083:090)  CHAR(8) NULLIF (RELABEL_PRODUCT_CODE = BLANKS),
 POOLED_COMPONENT_ID  POSITION(091:098)  CHAR(8) NULLIF (POOLED_COMPONENT_ID = BLANKS),
 COMPONENT_VOLUME     POSITION(099:100)  INTEGER EXTERNAL NULLIF (COMPONENT_VOLUME = BLANKS),
 LABEL_USER_ID        POSITION(101:106)  CHAR(6) NULLIF (LABEL_USER_ID = BLANKS),
 LABEL_DATES          POSITION(107:114)  DATE(8) "MMDDYYYY" NULLIF (LABEL_DATES = BLANKS),
 COMPONENT_MASK       POSITION(115:116)  CHAR(2) NULLIF (COMPONENT_MASK = BLANKS),
 IMPORT_FLAG          POSITION(117:117)  CHAR(1) NULLIF (IMPORT_FLAG = BLANKS),
 IMPORTED_FROM        POSITION(118:167)  CHAR(50) NULLIF (IMPORTED_FROM = BLANKS),
 PATIENT_ID           POSITION(168:177)  CHAR(10) NULLIF (PATIENT_ID = BLANKS),
 TRANSFUSED_DATE      POSITION(178:185)  DATE(8) "MMDDYYYY" NULLIF (TRANSFUSED_DATE = BLANKS),
 INSERT_DATE          POSITION(186:193)  DATE(8) "MMDDYYYY" NULLIF (INSERT_DATE = BLANKS),
 FIRST_SEP_DATE       POSITION(194:205)  DATE "MMDDYYYYHH24MI" NULLIF (FIRST_SEP_DATE = BLANKS),
 CHAPTER_ID           POSITION(206:209)  CHAR(4) NULLIF (CHAPTER_ID = BLANKS),
 WAREHOUSE_ID         POSITION(210:210)  CHAR(1) NULLIF (WAREHOUSE_ID = BLANKS),
 REJECT_CODE          POSITION(211:215)  CHAR(5) NULLIF (REJECT_CODE = BLANKS))
