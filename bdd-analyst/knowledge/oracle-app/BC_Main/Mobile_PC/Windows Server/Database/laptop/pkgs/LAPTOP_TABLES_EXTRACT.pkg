create or replace PACKAGE "LAPTOP_TABLES_EXTRACT"
/*
----------------------------------------------------------------------------
PACKAGE  : LT_TABLE_EXTRACT
PURPOSE: Used to extract mobile PC data and generate text files or dat files
based on encryption.

-------------------------------------------------------------------------------
By      |     Date      |   Ver |  Remarks
-------------------------------------------------------------------------------
Ashok   |  11/27/2022   |   01  |
Ashok   |  01/03/2023   |   02  | set_debug_mode added. Merged TWO extract pkgs to one pkg.
Ashok   |  01/22/2023   |   03  | use table_insert_date for script or screen extract.
Ashok   |  01/30/2023   |   04  | do not count bdr files as part of extract count.
Ashok   |  02/08/2023   |   05  | get_extract_jobs INPUT parameters modified.
Ashok   |  02/14/2023   |   06  | get_extract_jobs query updated.
                                | bdr files processing issue. check V06
Ashok   |  04/15/2025   |   07  | gd_sysdate value modified to use sysdate - 2 seconds
                                | Added table_insert_Date condition for Delete from download_monitor table.
-----------------------------------------------------------------------------


Create or replace public synonym LAPTOP_TABLES_EXTRACT for LAPTOP.LAPTOP_TABLES_EXTRACT;
GRANT EXECUTE ON LAPTOP.LAPTOP_TABLES_EXTRACT TO DBADMN;

LAPTOP_TABLES_EXTRACT statuses
--  NULL - Job submitted.
-- 'Q'   - IN QUEUE - Job is in queue to be run
-- 'C'   - Completed.
-- 'E'   - Error.
*/
IS
    PROCEDURE start_job(shipment_id_in  IN VARCHAR2,
                        user_id_in      IN VARCHAR2,
                        upload_id_out   OUT VARCHAR2,
                        status_out      OUT VARCHAR2);

    PROCEDURE start_job(upload_id_out   OUT VARCHAR2,
                        status_out      OUT VARCHAR2);

    PROCEDURE insert_extract_job(   shipment_id_in IN VARCHAR2,
                                    user_id_in IN VARCHAR2,
                                    status_out OUT VARCHAR2);
    PROCEDURE insert_extract_job_script(   shipment_id_in IN VARCHAR2,
                                            user_id_in  IN VARCHAR2,
                                            status_out  OUT VARCHAR2);
    PROCEDURE run_extract_job;

    PROCEDURE run_extract_job_async(p_user_in IN VARCHAR2 DEFAULT NULL);

    TYPE strings_aat IS TABLE OF VARCHAR2(100)  INDEX BY PLS_INTEGER;

    FUNCTION get_upload_id RETURN VARCHAR2;

    PROCEDURE set_dubug_mode;

    PROCEDURE get_extract_jobs( p_user_in IN VARCHAR2,
                                p_drive_id_in IN VARCHAR2,
                                p_drive_date_in IN VARCHAR2,
                                p_recordset_out OUT SYS_REFCURSOR);


END LAPTOP_TABLES_EXTRACT;


/


create or replace PACKAGE BODY "LAPTOP_TABLES_EXTRACT" IS

    gc_extract_dir      CONSTANT VARCHAR2(10) := 'UTL_DIR';
    gc_extract_arch_dir CONSTANT VARCHAR2(10) := 'EXT_ARCH';

    gt_start            PLS_INTEGER;
    gv_enc_flag         VARCHAR2(1);
    gv_upload_id        VARCHAR2(100);
    gv_laptop_id        VARCHAR2(10);
    gv_genbdr_flag      VARCHAR2(1);
    gd_sysdate          DATE;
    gv_drive_id         VARCHAR2(20);
    gv_shipment_extract VARCHAR2(1);
    gv_status           VARCHAR2(2000);

    g_laptop_extracts_rec  laptop_extracts%ROWTYPE;


    g_transaction_ids_aa  DBMS_UTILITY.maxname_array;
    g_donor_ids_aa        DBMS_UTILITY.maxname_array;
    g_unit_ids_aa         DBMS_UTILITY.maxname_array;
    g_shipment_ids_aa     DBMS_UTILITY.maxname_array;
    g_employer_ids_aa     DBMS_UTILITY.maxname_array;
    g_survey_ids_aa       DBMS_UTILITY.maxname_array;
    g_note_ids_aa         DBMS_UTILITY.maxname_array;
    g_drive_ids_aa        DBMS_UTILITY.maxname_array;
    g_audit_keys_aa       DBMS_UTILITY.NUMBER_ARRAY;

    g_empty_name_aa        DBMS_UTILITY.maxname_array;
    g_empty_number_aa        DBMS_UTILITY.NUMBER_ARRAY;
    gb_print_hdr         BOOLEAN;
    gb_debug_mode       BOOLEAN := FALSE;

    TYPE laptop_details_rt IS RECORD (
        laptop_id           laptop_id_details.laptop_id%TYPE,
        extract_in_progress laptop_id_details.extract_in_progress%TYPE
    );
    g_laptop_details_rec laptop_details_rt;


    TYPE shipment_hdr_rt IS RECORD (
        shipper_no  VARCHAR2(100),
        ship_status VARCHAR2(10),
        ship_type   VARCHAR2(10),
        drive_id    VARCHAR2(10),
        insert_user VARCHAR2(30)
    );
   g_shipment_hdr_row shipment_hdr_rt;


    TYPE mobile_server_tables_aat IS TABLE OF mobile_server_tables%ROWTYPE
        INDEX BY PLS_INTEGER;
    g_tables_aa  mobile_server_tables_aat;

    FUNCTION get_upload_id RETURN VARCHAR2 IS
    BEGIN
        RETURN gv_upload_id;
    END get_upload_id;

    PROCEDURE set_dubug_mode IS
    BEGIN
        gb_debug_mode := TRUE;
    END set_dubug_mode;

    FUNCTION error_msg(loc_in IN VARCHAR2) RETURN VARCHAR2 IS
    BEGIN
        RETURN    loc_in
                    || ':: '
                    || SUBSTR(SQLERRM, 1, 200)
                    ||  '::Error BackTrace:: '
                    ||DBMS_UTILITY.format_error_backtrace;
    END error_msg;

    PROCEDURE log_msg(msg_in IN VARCHAR2) IS
    BEGIN
        IF gb_debug_mode THEN
            DBMS_OUTPUT.PUT_LINE(msg_in);
        END IF;
    END log_msg;

    PROCEDURE log_error(msg_in IN VARCHAR2, file_name_in IN VARCHAR2 DEFAULT NULL) IS
        rc SYS_REFCURSOR;
        lv_fileName VARCHAR2(200);
    BEGIN
        OPEN rc FOR 'SELECT ''' || msg_in || ''' FROM DUAL';

        log_msg('LOG_ERROR : ' || msg_in);

        IF file_name_in IS NOT NULL THEN
            lv_fileName := file_name_in;
        ELSIF gv_upload_id IS NOT NULL THEN
            lv_fileName := 'err_file'
                           || '-'
                           || NVL(gv_laptop_id, 'XX')
                           || '_'
                           || gv_upload_id
                           || '_'
                           || TO_CHAR(SYSDATE, 'mmddyyhh24miss')
                           || '.log';
        ELSE
            lv_fileName := 'err_file'
                           || '-'
                           || NVL(gv_laptop_id, 'XX')
                           || '_'
                           || TO_CHAR(SYSDATE, 'mmddyyhh24miss')
                           || '.log';
        END IF;

        extract_util.write_file(
            p_dataset   => rc,
            p_separator => CHR(124),
            p_label     => '',
            p_heading   => 'N',
            p_rowcount  => 'N',
            p_directory => gc_extract_dir,
            p_filename  => lv_fileName);

    END log_error;

    PROCEDURE mark_start
    IS
    BEGIN
      gt_start := DBMS_UTILITY.get_cpu_time;
    END mark_start;

    PROCEDURE show_elapsed (NAME_IN IN VARCHAR2)
    IS
    BEGIN
      log_msg (
            '"'
         || NAME_IN
         || '" elapsed CPU time: '
         || TO_CHAR ( (DBMS_UTILITY.get_cpu_time - gt_start) / 100)
         || ' seconds');
    END show_elapsed;

    FUNCTION get_param_value (
        p_param_code IN VARCHAR2
    ) RETURN VARCHAR2 IS
        lv_param_value VARCHAR2(10);
    BEGIN
        SELECT
            decode(COUNT(1), 0, 'N', MAX(parameter_value))
        INTO lv_param_value
        FROM
            valid_parameters
        WHERE
            parameter_code = p_param_code;

        RETURN lv_param_value;
    END get_param_value;

    FUNCTION get_header_row(drive_id_in IN VARCHAR2, upload_id_in IN VARCHAR2) RETURN laptop_extracts%ROWTYPE IS
        temp_rec laptop_extracts%ROWTYPE;
        lnExtractSeq NUMBER;
    BEGIN

        SELECT
            MAX(extract_seq)
        INTO
            lnExtractSeq
        FROM
            laptop_extracts
        WHERE
            drive_id = drive_id_in;

        temp_rec.upload_id    := upload_id_in;
        temp_rec.files_count  := 0; -- this is set after all files are extracted and before inserting
        temp_rec.drive_id     := drive_id_in;
        temp_rec.extract_seq  := NVL(lnExtractSeq, 0) + 1;
        temp_rec.insert_date  := SYSDATE;
        temp_rec.insert_user  := 'LAPTOP';

        RETURN temp_rec;
    END get_header_row;

    FUNCTION drive_chapter(drive_id_in IN VARCHAR2) RETURN VARCHAR2 IS
        lv_chapter VARCHAR2(10);
    BEGIN
        SELECT chapter_id into lv_chapter
          FROM drives
         WHERE drive_id = drive_id_in;

        RETURN lv_chapter;
    EXCEPTION
        WHEN OTHERS THEN
            RETURN 'ALL';
    END drive_chapter;

    PROCEDURE init_global_arrays IS

        FUNCTION get_employer_ids(donor_ids_aa_in IN DBMS_UTILITY.maxname_array)
            RETURN DBMS_UTILITY.maxname_array IS
            l_string_ids_aa DBMS_UTILITY.maxname_array;
        BEGIN
            SELECT distinct employer_id
                BULK COLLECT INTO l_string_ids_aa
              FROM donors
             WHERE donor_id IN (SELECT COLUMN_VALUE FROM TABLE(donor_ids_aa_in));

             RETURN l_string_ids_aa;
        END get_employer_ids;

        FUNCTION get_survey_ids(donor_ids_aa_in IN DBMS_UTILITY.maxname_array, drive_id_in IN VARCHAR2)
            RETURN DBMS_UTILITY.maxname_array IS
            l_string_ids_aa DBMS_UTILITY.maxname_array;
        BEGIN
            SELECT survey_id
                BULK COLLECT INTO l_string_ids_aa
              FROM donor_survey_resp_hdr
             WHERE donor_id IN (SELECT COLUMN_VALUE FROM TABLE(donor_ids_aa_in))
               AND drive_id = drive_id_in;

            RETURN l_string_ids_aa;
        END get_survey_ids;

        FUNCTION get_note_ids(donor_ids_aa_in IN DBMS_UTILITY.maxname_array, transaction_ids_aa_in IN DBMS_UTILITY.maxname_array)
            RETURN DBMS_UTILITY.maxname_array IS
            l_string_ids_aa DBMS_UTILITY.maxname_array;
        BEGIN
            SELECT note_id
             BULK COLLECT INTO l_string_ids_aa
              FROM (
                    -- donor interdiction note ids.
                    SELECT di.note_id
                      FROM donor_interdictions di
                     WHERE di.donor_id IN (SELECT COLUMN_VALUE FROM TABLE(donor_ids_aa_in))
                       AND di.note_id IS NOT NULL
                    UNION
                    -- donations note ids.
                    SELECT dn.note_id
                      FROM donations dn
                     WHERE dn.transaction_id IN (SELECT COLUMN_VALUE FROM TABLE(transaction_ids_aa_in))
                       AND dn.note_id IS NOT NULL
                    UNION
                    -- donors note ids
                    SELECT dn.note_id
                      FROM donors dn
                     WHERE dn.donor_id IN (SELECT COLUMN_VALUE FROM TABLE(donor_ids_aa_in))
                       AND dn.note_id IS NOT NULL
                    );

            RETURN l_string_ids_aa;
        END get_note_ids;

    BEGIN
        g_employer_ids_aa.DELETE;
        g_survey_ids_aa.DELETE;
        g_note_ids_aa.DELETE;
        g_shipment_ids_aa.DELETE;
        g_drive_ids_aa.DELETE;

        g_employer_ids_aa       := get_employer_ids(g_donor_ids_aa);
        g_survey_ids_aa         := get_survey_ids(g_donor_ids_aa, g_shipment_hdr_row.drive_id);
        g_note_ids_aa           := get_note_ids(g_donor_ids_aa, g_transaction_ids_aa);
        g_shipment_ids_aa(1)    := g_shipment_hdr_row.shipper_no;
        g_drive_ids_aa(1)       := g_shipment_hdr_row.drive_id;

    END init_global_arrays;

    PROCEDURE initialize IS
    BEGIN
        gv_enc_flag     := get_param_value('ENCRPT_REQ');
        gv_genbdr_flag  := get_param_value('GENBDR');
        gd_sysdate      := SYSDATE - INTERVAL '2' SECOND;
        gb_print_hdr    := TRUE;

        gv_upload_id := gv_laptop_id
                        || '_'
                        || TO_CHAR(gd_sysdate, 'mmddyyhh24miss')
                        || '_'
                        || drive_chapter(gv_drive_id);

        g_laptop_extracts_rec :=  get_header_row(gv_drive_id, gv_upload_id);
    END initialize;

    PROCEDURE set_extract_progress (
        laptop_id_in IN VARCHAR2,
        status_in IN VARCHAR2
    ) IS
    BEGIN
        UPDATE laptop_id_details
        SET
            extract_in_progress = status_in
        WHERE
            laptop_id = laptop_id_in;

        COMMIT;
    END set_extract_progress;

    FUNCTION get_audit_keys(dataset_in IN DBMS_UTILITY.maxname_array,
                              table_name_in IN VARCHAR2,
                              key_col_in IN VARCHAR2) RETURN DBMS_UTILITY.NUMBER_ARRAY IS
        lv_query VARCHAR2(2000);
        t_audit_keys_aa DBMS_UTILITY.NUMBER_ARRAY;
    BEGIN
      lv_query := 'SELECT audit_key ' ||
                   ' FROM ' || table_name_in ||
                   ' WHERE ' || key_col_in || ' IN ( SELECT COLUMN_VALUE FROM TABLE(:P_1))';

      EXECUTE IMMEDIATE lv_query BULK COLLECT INTO t_audit_keys_aa USING dataset_in;

      RETURN t_audit_keys_aa;
    END get_audit_keys;

    FUNCTION get_query(table_name_in IN VARCHAR2, key_col_in IN VARCHAR2 DEFAULT NULL, order_by_in IN VARCHAR2 DEFAULT NULL) RETURN VARCHAR2 IS
        lv_query VARCHAR2(2000);

        FUNCTION get_select_cols RETURN VARCHAR2 IS
            lv_select_cols VARCHAR2(1000);
        BEGIN
            -- tables with BLOB type have to be handled differently.
            -- TODO - move to global constants.
            IF table_name_in IN ('DONOR_CONSENTS','DONOR_PICTURES', 'DONOR_CONSENTS_ADT') THEN
                SELECT
                    LISTAGG(decode(data_type, 'BLOB', 'NULL', 'tb.' || column_name), ',') WITHIN GROUP(
                    ORDER BY
                        column_id
                    )
                INTO lv_select_cols
                FROM
                    all_tab_columns
                WHERE
                    table_name = table_name_in;
            ELSE
                lv_select_cols := 'tb.*';
            END IF;

            RETURN lv_select_cols;
        END get_select_cols;

        FUNCTION get_order_by_clause RETURN VARCHAR2 IS
            lv_order_by VARCHAR2(1000);
        BEGIN
            IF order_by_in IS NULL THEN
                lv_order_by := '';
            ELSE
                lv_order_by := 'ORDER BY ' || order_by_in;
            END IF;
            RETURN lv_order_by;
        END get_order_by_clause;
    BEGIN
        IF gv_shipment_extract = 'Y' THEN
            lv_query := 'SELECT ' || get_select_cols|| ' , dm.transaction_mode ' ||
                          'FROM ' || table_name_in || ' tb, download_monitor dm ' ||
                         'WHERE tb.audit_key = dm.table_audit_key ' ||
                           'AND dm.table_name = :P_1 ' ||
                           'AND ' || key_col_in || ' IN (SELECT column_value FROM TABLE(:P_2)) '||
                           get_order_by_clause;
        ELSE
            lv_query := 'SELECT ' || get_select_cols|| ' , dm.transaction_mode ' ||
                          'FROM ' || table_name_in || ' tb, download_monitor dm ' ||
                         'WHERE tb.audit_key = dm.table_audit_key ' ||
                           'AND dm.table_name = :P_1 ' ||
                           'AND dm.table_insert_date <= :P_2 ' ||
                           get_order_by_clause;
        END IF;

        RETURN lv_query;
    END get_query;


    PROCEDURE clear_download_monitor(   table_name_in   IN VARCHAR2,
                                        key_col_in      IN VARCHAR2,
                                        dataset_in     IN DBMS_UTILITY.MAXNAME_ARRAY)
    IS
        lv_query VARCHAR2(2000);
        temp_dataset_in strings_t;
    BEGIN
        SELECT column_value
         BULK COLLECT INTO temp_dataset_in
         FROM TABLE(dataset_in);

        lv_query := 'DELETE FROM download_monitor dm ' ||
                    ' WHERE dm.table_name = :P_1' ||
                    '   AND EXISTS (SELECT 1 ' ||
                                     'FROM ' || table_name_in || ' tb ' ||
                                     'WHERE tb.audit_key = dm.table_audit_key ' ||
                                     'AND ' || key_col_in || ' IN (SELECT column_value FROM TABLE(:P_2)) )';

        EXECUTE IMMEDIATE lv_query
                    USING table_name_in, temp_dataset_in;

        log_msg('--CDM--');
        log_msg('Query      : ' ||lv_query);
        log_msg('Deleted    : ' || table_name_in || ':' || SQL%ROWCOUNT ||  ' Rows');
        log_msg('-------');
    EXCEPTION
        WHEN OTHERS THEN
            gv_status := error_msg('CLEAR_DOWNLOAD_MONITOR');
    END clear_download_monitor;

    PROCEDURE clear_download_monitor(   table_name_in   IN VARCHAR2,
                                        key_col_in      IN VARCHAR2,
                                        dataset_in     IN DBMS_UTILITY.NUMBER_ARRAY)
    IS
        lv_query VARCHAR2(2000);
        temp_dataset_in numbers_t;
    BEGIN
        SELECT column_value
         BULK COLLECT INTO temp_dataset_in
         FROM TABLE(dataset_in);

        lv_query := 'DELETE FROM download_monitor dm ' ||
                    ' WHERE dm.table_name = :P_1' ||
                    '   AND EXISTS (SELECT 1 ' ||
                                     'FROM ' || table_name_in || ' tb ' ||
                                     'WHERE tb.audit_key = dm.table_audit_key ' ||
                                     'AND ' || key_col_in || ' IN (SELECT column_value FROM TABLE(:P_2)) )';

        EXECUTE IMMEDIATE lv_query
                    USING table_name_in, temp_dataset_in;

        log_msg('--CDM--');
        log_msg('Query      : ' ||lv_query);
        log_msg('Deleted    : ' || table_name_in || ':' || SQL%ROWCOUNT ||  ' Rows');
        log_msg('-------');
    EXCEPTION
        WHEN OTHERS THEN
            gv_status := error_msg('CLEAR_DOWNLOAD_MONITOR2');
    END clear_download_monitor;

    PROCEDURE write_tab_blob_to_file(   table_name_in IN VARCHAR2,
                                        key_col_in IN VARCHAR2,
                                        dataset_in IN DBMS_UTILITY.MAXNAME_ARRAY,
                                        order_by_in IN VARCHAR2 DEFAULT NULL) IS
        cv sys_refcursor;
        lv_query CLOB;
        temp_blob BLOB;
        lv_auditKey VARCHAR2(100);
        lv_fileName VARCHAR2(500);

    BEGIN
        FOR rec IN  (  SELECT table_name, column_name
                              FROM all_tab_columns
                             WHERE table_name = table_name_in
                               AND data_type = 'BLOB')
        LOOP

            lv_query := ' SELECT ' || rec.column_name || ' , dm.table_audit_key ' ||
                          ' FROM ' || rec.table_name || ' tb, download_monitor dm ' ||
                         ' WHERE tb.audit_key = dm.table_audit_key ' ||
                           ' AND dm.table_name = :P_1 ' ||
                           ' AND LENGTH( ' || rec.column_name || ' ) <> 0' ||
                           ' AND ' || key_col_in || ' IN (SELECT column_value FROM TABLE(:P_2)) ';


            OPEN cv FOR lv_query USING table_name_in, dataset_in;
            LOOP
                FETCH cv INTO temp_blob, lv_auditKey;
                EXIT WHEN cv%NOTFOUND;

                IF LENGTH(temp_blob) > 0 THEN
                    SELECT lv_auditKey
                                   || '-'
                                   || rec.table_name
                                   || '-'
                                   || rec.column_name
                                   || '-'
                                   || gv_upload_id
                                   || DECODE(gv_enc_flag, 'Y', '.enc', '.tif')
                      INTO lv_fileName
                      FROM DUAL;

                    extract_util.blob_to_file(  p_blob      => temp_blob,
                                                p_dir       => gc_extract_dir,
                                                p_filename  => lv_fileName,
                                                p_encrypt   => gv_enc_flag);
                END IF;
            END LOOP;
            CLOSE cv;

        END LOOP;
    EXCEPTION
        WHEN OTHERS THEN
            gv_status := error_msg('WRITE_TAB_BLOB_TO_FILE1');

            if cv%isopen then
                begin
                    close cv;
                exception
                    when invalid_cursor
                        then null;
                end;
            end if;
    END write_tab_blob_to_file;

    PROCEDURE write_tab_blob_to_file(   table_name_in IN VARCHAR2) IS
        cv sys_refcursor;
        lv_query CLOB;
        temp_blob BLOB;
        lv_auditKey VARCHAR2(100);
        lv_fileName VARCHAR2(500);

    BEGIN
        FOR rec IN  (  SELECT table_name, column_name
                              FROM all_tab_columns
                             WHERE table_name = table_name_in
                               AND data_type = 'BLOB')
        LOOP

            lv_query := ' SELECT ' || rec.column_name || ' , dm.table_audit_key ' ||
                          ' FROM ' || rec.table_name || ' tb, download_monitor dm ' ||
                         ' WHERE tb.audit_key = dm.table_audit_key ' ||
                           ' AND dm.table_name = :P_1 ' ||
                           ' AND dm.table_insert_date <= :P_2 ' ||
                           ' AND LENGTH( ' || rec.column_name || ' ) <> 0';


            OPEN cv FOR lv_query USING table_name_in, gd_sysdate;
            LOOP
                FETCH cv INTO temp_blob, lv_auditKey;
                EXIT WHEN cv%NOTFOUND;

                IF LENGTH(temp_blob) > 0 THEN
                    SELECT lv_auditKey
                                   || '-'
                                   || rec.table_name
                                   || '-'
                                   || rec.column_name
                                   || '-'
                                   || gv_upload_id
                                   || DECODE(gv_enc_flag, 'Y', '.enc', '.tif')
                      INTO lv_fileName
                      FROM DUAL;

                    extract_util.blob_to_file(  p_blob      => temp_blob,
                                                p_dir       => gc_extract_dir,
                                                p_filename  => lv_fileName,
                                                p_encrypt   => gv_enc_flag);
                END IF;
            END LOOP;
            CLOSE cv;

        END LOOP;
    EXCEPTION
        WHEN OTHERS THEN
            gv_status := error_msg('WRITE_TAB_BLOB_TO_FILE2');

            if cv%isopen then
                begin
                    close cv;
                exception
                    when invalid_cursor
                        then null;
                end;
            end if;
    END write_tab_blob_to_file;


    PROCEDURE write_consent_audit_blob_to_file(
                                table_name_in IN VARCHAR2,
                                key_col_in IN VARCHAR2 DEFAULT NULL,
                                dataset_in IN DBMS_UTILITY.NUMBER_ARRAY DEFAULT g_empty_number_aa,
                                order_by_in IN VARCHAR2 DEFAULT NULL) IS
        lv_fileName VARCHAR2(500);
    BEGIN

        -- Extract donor consents old_blob column
        FOR rec IN (SELECT
                        dca.column_name,
                        TO_CHAR(dca.audit_insert_dats,'MMDDYYHH24MISS') audit_date,
                        dca.old_blob,
                        b.table_audit_key
                    FROM
                        donor_consents_adt dca,
                        download_monitor b
                    WHERE
                            b.table_name = 'DONOR_CONSENTS_ADT'
                        AND dca.audit_key = b.table_audit_key
                        AND dca.column_name
                            IN ('DONOR_SIGNATURE', 'WITNESS_SIGNATURE')
                        AND LENGTH(dca.old_blob) <> 0
                        AND ((gv_shipment_extract = 'N' AND b.table_insert_date <= gd_sysdate)
                                OR
                             (gv_shipment_extract = 'Y' AND audit_key IN (SELECT COLUMN_VALUE FROM TABLE(dataset_in)))
                            )
                     ORDER BY dca.AUDIT_INSERT_DATS ASC)
        LOOP
             IF LENGTH(rec.old_blob) > 0 THEN
                 SELECT rec.table_audit_key
                               || '-'
                               || 'DONOR_CONSENTS_ADT'
                               || '-'
                               || 'OLD_BLOB'
                               || '-'
                               || rec.column_name
                               || '-'
                               || rec.audit_date
                               || '-'
                               || gv_upload_id
                               || DECODE(gv_enc_flag, 'Y', '.enc', '.tif')
                  INTO lv_fileName
                  FROM dual;

                 extract_util.blob_to_file( p_blob      => rec.old_blob,
                                            p_dir       => gc_extract_dir,
                                            p_filename  => lv_fileName,
                                            p_encrypt   => gv_enc_flag);
            END IF;
        END LOOP;


        -- Extract donor consents new_blob column
        FOR rec IN (SELECT
                        dca.column_name,
                        TO_CHAR(dca.audit_insert_dats,'MMDDYYHH24MISS') audit_date,
                        dca.new_blob,
                        b.table_audit_key
                    FROM
                        donor_consents_adt dca,
                        download_monitor b
                    WHERE
                            b.table_name = 'DONOR_CONSENTS_ADT'
                        AND dca.audit_key = b.table_audit_key
                        AND dca.column_name
                            IN ('DONOR_SIGNATURE', 'WITNESS_SIGNATURE')
                        AND LENGTH(dca.new_blob) <> 0
                        AND (gv_shipment_extract = 'N'
                                OR
                             (gv_shipment_extract = 'Y' AND audit_key IN (SELECT COLUMN_VALUE FROM TABLE(dataset_in)))
                            )
                     ORDER BY dca.AUDIT_INSERT_DATS ASC)
        LOOP
            IF LENGTH(rec.new_blob) > 0 THEN
             SELECT rec.table_audit_key
                           || '-'
                           || 'DONOR_CONSENTS_ADT'
                           || '-'
                           || 'NEW_BLOB'
                           || '-'
                           || rec.column_name
                           || '-'
                           || rec.audit_date
                           || '-'
                           || gv_upload_id
                           || DECODE(gv_enc_flag, 'Y', '.enc', '.tif')
                INTO lv_fileName
                FROM DUAL;

                 extract_util.blob_to_file( p_blob      => rec.new_blob,
                                            p_dir       => gc_extract_dir,
                                            p_filename  => lv_fileName,
                                            p_encrypt   => gv_enc_flag);
            END IF;
        END LOOP;

    EXCEPTION
        WHEN OTHERS THEN
            gv_status := error_msg('WRITE_CONSENT_AUDIT_BLOB_TO_FILE');

    END write_consent_audit_blob_to_file;

    PROCEDURE write_tab_to_file(table_name_in IN VARCHAR2)
    IS
        l_fname varchar2(100);
        rc sys_refcursor;
        lv_query VARCHAR2(2000);
    BEGIN
        SELECT LOWER(table_name_in)
                   || '-'
                   || gv_upload_id
                   || DECODE(gv_enc_flag, 'Y', '.dat', '.txt')
        INTO l_fname
        FROM dual;


        lv_query := get_query(table_name_in);


        log_msg('--Table to File Number---');
        log_msg('FileName       ' || l_fname);
        log_msg('Table Name     ' || table_name_in);
        log_msg('Query          ' || lv_query);
        log_msg('-----');

        OPEN rc FOR lv_query USING table_name_in, gd_sysdate;

        extract_util.write_file(
            p_dataset   => rc,
            p_separator => chr(124),
            p_label     => '',
            p_heading   => 'N',
            p_rowcount  => 'N',
            p_directory => gc_extract_dir,
            p_filename  => l_fname,
            p_encrypt   => gv_enc_flag);
    EXCEPTION
        WHEN OTHERS THEN
            gv_status := error_msg('WRITE_TAB_TO_FILE1');

            if rc%isopen then
                begin
                    close rc;
                exception
                    when invalid_cursor
                        then null;
                end;
            end if;
    END write_tab_to_file;

