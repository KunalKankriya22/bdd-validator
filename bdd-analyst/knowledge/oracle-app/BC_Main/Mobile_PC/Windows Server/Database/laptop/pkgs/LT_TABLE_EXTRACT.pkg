    PROCEDURE parm_val_prc (
        status_out OUT VARCHAR2
    ) IS
    BEGIN
        SELECT
            parameter_value
        INTO v_sep
        FROM
            valid_parameters
        WHERE
                parameter_code = 'EXTDLT'
            AND ROWNUM < 2;

        IF v_sep <> '|' THEN
            status_out := 'Err: parameter value is not correct in valid parameters table for code = EXTDLT';
        END IF;

        status_out := 'OK';

    EXCEPTION
        WHEN no_data_found THEN
            status_out := 'Err: Parameter value is not found in valid parameters table for code = EXTDLT';
        WHEN OTHERS THEN
            status_out := substr(sqlerrm, 1, 100);
    END;

    PROCEDURE download_prc (
        p_query      IN   VARCHAR2,
        p_separator  IN   VARCHAR2 DEFAULT ',',
        p_path       IN   VARCHAR2,
        p_filename   IN   VARCHAR2,
        p_status     OUT  VARCHAR2
    ) IS

        l_thecursor    INTEGER DEFAULT dbms_sql.open_cursor;
        v_in_file      utl_file.file_type;
        v_out_file     utl_file.file_type;
        v_new_line     VARCHAR2(2000);
        t_filename     VARCHAR2(100);
        t_temp_str     VARCHAR2(4000); -- 05/02/2012; IM:8527 -- Increased size from 1024 to 4000.
        t_encrypt_str  VARCHAR2(4000); -- 05/02/2012; IM:8527 -- Increased size from 1024 to 4000.
        t_len          NUMBER;
        t_new_len      NUMBER;
        t_char         VARCHAR2(1);
    BEGIN
        l_cnt := 0;
        p_status := 'OK';
        dbms_sql.parse(l_thecursor, p_query, dbms_sql.native);
        t_filename := substr(p_filename, 1, instr(p_filename, '.', -1))
                      || 'dat';
        --v_out_file := UTL_FILE.fopen (p_path, t_filename, 'w');
        v_out_file := utl_file.fopen(p_path, t_filename, 'w', 32767); -- 05/02/2012; IM:8527; Added max line size to be 32767 instead of default - 1024.
        --insert into log_tmp values(p_query);
        FOR i IN 1..255 LOOP
            BEGIN
                dbms_sql.define_column(l_thecursor, i, l_columnvalue, 2000);
                l_colcnt := i;
            EXCEPTION
                WHEN OTHERS THEN
                    IF ( sqlcode = -1007 ) THEN
                        EXIT;
                    ELSE
                        RAISE;
                    END IF;
            END;
        END LOOP;

        dbms_sql.define_column(l_thecursor, 1, l_columnvalue, 2000);
        l_status := dbms_sql.execute(l_thecursor);
        LOOP
            EXIT WHEN ( dbms_sql.fetch_rows(l_thecursor) <= 0 );
            l_separator := '';
            v_new_line := '';
            FOR i IN 1..l_colcnt LOOP
                dbms_sql.column_value(l_thecursor, i, l_columnvalue);
                v_new_line := v_new_line
                              || l_separator
                              || l_columnvalue;
                l_separator := p_separator;
            END LOOP;

            BEGIN
                t_temp_str := v_new_line;
                t_len := length(v_new_line);
                t_encrypt_str := NULL;
                FOR i IN 1..t_len LOOP
                    t_char := substr(t_temp_str, 1, 1);
                    t_new_len := t_len - i;
                    t_temp_str := substr(t_temp_str,(-1) * t_new_len);
                    t_encrypt_str := t_encrypt_str
                                     || chr(127 - ascii(t_char)); -- Modified on 04/12/2011; ((127 - ascii) instead of (ascii +17))
                END LOOP;

                t_encrypt_str := utl_raw.cast_to_raw(t_encrypt_str);
                utl_file.put_line(v_out_file, t_encrypt_str);
            EXCEPTION
                WHEN OTHERS THEN
                    -- dbms_output.put_line(sqlerrm);
                    utl_file.fclose(v_in_file);
                    utl_file.fclose(v_out_file);
                    p_status := 'Err: '
                                || sqlcode
                                || ': '
                                || substr(sqlerrm, 1, 100); -- added on 05/02/2012; IM:8527
                    EXIT;
            END;

            l_cnt := l_cnt + 1;
            dbms_application_info.set_client_info(l_cnt || ' rows are generated');
        END LOOP;

        dbms_sql.close_cursor(l_thecursor);
        IF utl_file.is_open(v_out_file) THEN
            utl_file.fclose(v_out_file);
        END IF;
    EXCEPTION
        WHEN utl_file.invalid_mode THEN
            p_status := 'Invalid Mode Parameter';
        WHEN utl_file.invalid_path THEN
            p_status := 'Invalid File Location';
        WHEN utl_file.invalid_filehandle THEN
            p_status := 'Invalid Filehandle';
        WHEN utl_file.invalid_operation THEN
            p_status := 'Invalid Operation';
        WHEN utl_file.read_error THEN
            p_status := 'Read Error';
        WHEN utl_file.internal_error THEN
            p_status := 'Internal Error';
        WHEN utl_file.charsetmismatch THEN
            p_status := 'Opened With FOPEN_NCHAR. But Later I/O Inconsistent';
        WHEN utl_file.file_open THEN
            p_status := 'File Already Opened';
        WHEN utl_file.invalid_maxlinesize THEN
            p_status := 'Line Size Exceeds 32K';
        WHEN utl_file.invalid_filename THEN
            p_status := 'Invalid File Name';
        WHEN utl_file.access_denied THEN
            p_status := 'File Access Denied By';
        WHEN utl_file.invalid_offset THEN
            p_status := 'FSEEK Param Less Than 0';
        WHEN OTHERS THEN
            p_status := 'Err: '
                        || sqlcode
                        || ': '
                        || substr(sqlerrm, 1, 100);
    END;
  /* Procedure download_prc */
    PROCEDURE write_blob_to_file (
        in_blob_loc   IN  BLOB,
        in_blob_file  IN  VARCHAR2
    ) -- SCR 11942; Donor Pictures
     AS

        v_buffer       RAW(32767);
        v_buffer_size  BINARY_INTEGER;
        v_amount       BINARY_INTEGER;
        v_offset       NUMBER(38) := 1;
        v_chunksize    INTEGER;
        v_out_file     utl_file.file_type;
        v_file_name    VARCHAR2(100);
        v_lob_loc      BLOB;
    BEGIN
    -- +-------------------------------------------------------------+
    -- | SELECT THE LOB LOCATOR                                      |
    -- +-------------------------------------------------------------+
        v_lob_loc := in_blob_loc;
        v_file_name := in_blob_file;

    -- +-------------------------------------------------------------+
    -- | FIND OUT THE CHUNKSIZE FOR THIS LOB COLUMN                  |
    -- +-------------------------------------------------------------+
        v_chunksize := dbms_lob.getchunksize(v_lob_loc);
        IF ( v_chunksize < 32767 ) THEN
            v_buffer_size := v_chunksize;
        ELSE
            v_buffer_size := 32767;
        END IF;

        v_amount := v_buffer_size;
    -- +-------------------------------------------------------------+
    -- | OPENING THE LOB IS OPTIONAL                                 |
    -- +-------------------------------------------------------------+
        dbms_lob.open(v_lob_loc, dbms_lob.lob_readonly);
    -- +-------------------------------------------------------------+
    -- | WRITE CONTENTS OF THE LOB TO A FILE                         |
    -- +-------------------------------------------------------------+
        v_out_file := utl_file.fopen(location => v_directory, filename => v_file_name,
                                    open_mode => 'wb',
                                    max_linesize => 32767);

        WHILE v_amount >= v_buffer_size LOOP
            dbms_lob.read(lob_loc => v_lob_loc, amount => v_amount, offset => v_offset,
                         buffer => v_buffer);

            v_offset := v_offset + v_amount;
            utl_file.put_raw(file => v_out_file, buffer => v_buffer,
                            autoflush => true);

            utl_file.fflush(file => v_out_file);
      -- +-------------------------------------------------------------+
    -- | IN 9i THERE IS CURRENTLY A                                  |
    -- | RESTRICTION OF A MAXIMUM OF 32K THAT CAN BE WRITTEN WITH    |
    -- | PUT_RAW UNLESS YOU INSERT NEW LINE CHARACTERS IN BETWEEN    |
    -- | THE DATA. IN 10i THERE IS A NEW BINARY MODE. WHEN FILES ARE |
    -- | OPENED WITH THIS MODE ANY AMOUNT OF RAW DATA CAN BE WRITTEN |
    -- | WITHOUT THE NEED FOR NEW LINES. IN SHORT, THIS IS A BUG     |
    -- | THAT, IF IT CREEPS UP IN ORACLE9i, THERE IS NO SOLUTION!    |
    -- +-------------------------------------------------------------+
    -- UTL_FILE.NEW_LINE(file => v_out_file);
        END LOOP;

        utl_file.fflush(file => v_out_file);
        utl_file.fclose(v_out_file);
    -- +-------------------------------------------------------------+
    -- | CLOSING THE LOB IS MANDATORY IF YOU HAVE OPENED IT          |
    -- +-------------------------------------------------------------+
        dbms_lob.close(v_lob_loc);
    EXCEPTION
        WHEN OTHERS THEN
      --DBMS_SQL.CLOSE_CURSOR(l_thecursor);
            do_log('Err: '
                   || sqlcode
                   || ': '
                   || substr(sqlerrm, 1, 100), false);

            raise_application_error('-20000', 'Error in lt_table_extract.Extract Pictures ::  '
                                              || sqlcode
                                              || ': '
                                              || substr(sqlerrm, 1, 1000));

    END write_blob_to_file;

    FUNCTION load_blob_from_file (
        p_dir_name   VARCHAR2,
        p_file_name  VARCHAR2
    ) RETURN BLOB AS
        dest_loc  BLOB := empty_blob();
        src_loc   BFILE := bfilename(p_dir_name, p_file_name);
    BEGIN
    -- Open source binary file from OS
        dbms_lob.open(src_loc, dbms_lob.lob_readonly);

    -- Create temporary LOB object
        dbms_lob.createtemporary(lob_loc => dest_loc, cache => true, dur => dbms_lob.session);

    -- Open temporary lob
        dbms_lob.open(dest_loc, dbms_lob.lob_readwrite);

    -- Load binary file into temporary LOB
        dbms_lob.loadfromfile(dest_lob => dest_loc, src_lob => src_loc, amount => dbms_lob.getlength(src_loc));

    -- Close lob objects
        dbms_lob.close(dest_loc);
        dbms_lob.close(src_loc);

    -- Return temporary LOB object
        RETURN dest_loc;
    END load_blob_from_file;

  /*
      This routine reads bdr file from LOGDR db location 
      and
      if encryption is set, converts the bdr file to bde and copies the file to UTL_DIR location.
      if encryption is not set, copies the bdr file to UTL_DIR location. 

      -- file placed in UTL_DIR will have upload_id attached at the end. This format is required for decrypting the file.

  */
    PROCEDURE process_bdr_files (
        p_status OUT VARCHAR2
    ) IS

        lv_logdr         VARCHAR2(100);
        temp_blob        BLOB := empty_blob();
        temp_file        VARCHAR2(100);
        lv_encrypt_flag  VARCHAR2(1);
    BEGIN
        p_status := 'OK';
    -- Get reports directory location
        BEGIN
            SELECT
                code_desc
            INTO lv_logdr
            FROM
                master_codes
            WHERE
                    code_type = 'LOGDR'
                AND code = 'UTIL'
                AND sysdate BETWEEN eff_date AND nvl(term_date, sysdate + 1);

        EXCEPTION
            WHEN no_data_found THEN
                p_status := 'Log Dir not maintained';
                RETURN;
            WHEN OTHERS THEN
                p_status := 'Error in fetching Log Dir: '
                            || substr(sqlerrm, 1, 500);
                RETURN;
        END;

        lv_encrypt_flag := get_param_value('ENCRPT_REQ');
        FOR rec IN (
            SELECT
                file_name
            FROM
                files_xt
            WHERE
                substr(file_name, - 3) = 'bdr'
        ) LOOP
            IF lv_encrypt_flag = 'Y' THEN
                --dbms_output.put_line('started processing ' || rec.file_name);
                temp_file := substr(rec.file_name, 1, length(rec.file_name) - 4)
                             || '-'
                             || lv_upload_id
                             || '.'
                             || 'bde';

                temp_blob := load_blob_from_file(lv_logdr, rec.file_name);
                encrypt_blob_to_file(temp_blob, temp_file, p_status);
                --dbms_output.put_line('Status ' || p_status);
                utl_file.fremove(lv_logdr, rec.file_name);
            ELSE
                temp_file := substr(rec.file_name, 1, length(rec.file_name) - 4)
                             || '-'
                             || lv_upload_id
                             || '.'
                             || 'bdr';

                utl_file.frename(lv_logdr, rec.file_name, v_directory, temp_file);
            END IF;
        END LOOP;

    END process_bdr_files;


END lt_table_extract;


/
