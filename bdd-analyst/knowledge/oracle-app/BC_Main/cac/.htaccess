# Apache configuration for BC_Agents
# Enable URL rewriting for clean URLs

RewriteEngine On

# Set application environment (change this per deployment)
# Options: dev, qa, prod
SetEnv APP_ENV qa

# Note: Security headers are handled at the server level in ssl.conf
# to avoid duplication and ensure consistent application across all requests

# Prevent access to sensitive files
<FilesMatch "\.(ini|env|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent access to configuration and shared directories
RedirectMatch 404 ^/shared/
RedirectMatch 404 ^/settings/
RedirectMatch 404 ^/logs/
RedirectMatch 404 ^/tmp/

# Route /bconsiteagentapp to bconsiteagentapp/index.php
RewriteRule ^bconsiteagentapp/?$ bconsiteagentapp/index.php [L]
RewriteRule ^bconsiteagentapp/(.*)$ bconsiteagentapp/index.php [L]

# Route /bcoracleagentapp to bcoracleagentapp/index.php
RewriteRule ^bcoracleagentapp/?$ bcoracleagentapp/index.php [L]
RewriteRule ^bcoracleagentapp/(.*)$ bcoracleagentapp/index.php [L]

# Health check endpoints
RewriteRule ^bconsiteagentapp/health$ bconsiteagentapp/index.php [L]
RewriteRule ^bcoracleagentapp/health$ bcoracleagentapp/index.php [L]
