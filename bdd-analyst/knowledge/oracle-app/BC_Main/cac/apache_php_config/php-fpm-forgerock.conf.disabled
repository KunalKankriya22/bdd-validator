[forgerock_pool]
; Pool name for ForgeRock integration
user = apache
group = apache

; Listen on a socket or TCP port
listen = 127.0.0.1:9000
listen.owner = apache
listen.group = apache
listen.mode = 0660

; Process management settings
pm = dynamic
pm.max_children = 50
pm.start_servers = 5
pm.min_spare_servers = 5
pm.max_spare_servers = 35

; CRITICAL: Environment variable configuration for ForgeRock headers
; Set clear_env to 'no' to preserve environment variables from Apache
clear_env = no

; Explicitly pass ForgeRock environment variables
env[DOD_EDI_PN_ID] = $DOD_EDI_PN_ID
env[UNIQUE_ID] = $UNIQUE_ID
env[PN_LST_NM] = $PN_LST_NM
env[PN_1ST_NM] = $PN_1ST_NM
env[PN_MI_NM] = $PN_MI_NM

; Also pass FastCGI prefixed versions
env[FCGI_DOD_EDI_PN_ID] = $FCGI_DOD_EDI_PN_ID
env[FCGI_UNIQUE_ID] = $FCGI_UNIQUE_ID
env[FCGI_PN_LST_NM] = $FCGI_PN_LST_NM
env[FCGI_PN_1ST_NM] = $FCGI_PN_1ST_NM
env[FCGI_PN_MI_NM] = $FCGI_PN_MI_NM

; Pass captured versions
env[CAPTURED_DOD_ID] = $CAPTURED_DOD_ID
env[CAPTURED_PN_LST] = $CAPTURED_PN_LST
env[CAPTURED_PN_1ST] = $CAPTURED_PN_1ST
env[CAPTURED_PN_MI] = $CAPTURED_PN_MI
env[CAPTURED_UNIQUE] = $CAPTURED_UNIQUE

; CRITICAL FIX: Enable FastCGI parameter passing
; This ensures environment variables are passed as FastCGI parameters
php_admin_value[fastcgi.logging] = 1
php_admin_flag[fastcgi.error_header] = on

; Enable variable order to include environment variables
php_admin_value[variables_order] = "EGPCS"

; Ensure $_ENV is populated
php_admin_value[auto_globals_jit] = 0

; Standard environment variables that might be needed
env[PATH] = /usr/local/bin:/usr/bin:/bin
env[TMP] = /tmp
env[TMPDIR] = /tmp
env[TEMP] = /tmp

; Security settings
security.limit_extensions = .php .phar

; Logging
php_admin_value[error_log] = /var/log/php-fpm/forgerock_pool.log
php_admin_flag[log_errors] = on
php_value[session.save_handler] = files
php_value[session.save_path] = /var/lib/php/session
