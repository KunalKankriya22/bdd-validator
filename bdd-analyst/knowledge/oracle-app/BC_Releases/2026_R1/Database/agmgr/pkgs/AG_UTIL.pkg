CREATE OR REPLACE PACKAGE AG_UTIL AS 

/*-----------------------------------------------------------------------------------
|| Author       : WellSky BC.
|| Description  : Antigens pkg utility 
|| Requirements : 
|| Version
|| 01   08/16/2024  New pkg creation.
||
*/-----------------------------------------------------------------------------------
    FUNCTION is_licensed RETURN BOOLEAN;
    
    FUNCTION version_no RETURN VARCHAR2;
END AG_UTIL;
/


CREATE OR REPLACE PACKAGE BODY AG_UTIL AS

    gv_version_no VARCHAR2(03) := '01';

    FUNCTION version_no RETURN VARCHAR2 IS
    BEGIN
        RETURN gv_version_no;
    END version_no;

    FUNCTION is_licensed RETURN BOOLEAN IS
        ln_cnt NUMBER;
    BEGIN
        SELECT COUNT(1)
          INTO ln_cnt
          FROM product_release
         WHERE product_id = 'AGMGR';
        
        IF ln_cnt = 0 THEN
            RETURN FALSE;
        ELSE
            RETURN TRUE;
        END IF;        
    END is_licensed;
    
END AG_UTIL;
/


