CREATE OR REPLACE PACKAGE DPQAGDTS AS 

/*-----------------------------------------------------------------------------------
|| Author       : WellSky BC.
|| Description  : Used by query screen.
||              : 
|| Requirements : 
|| Call Syntax  :
|| Version
|| 01   07/23/2024  MLT-7054 - New pkg creation.
||------2024.1.0 Release version 01----------------------------------------------------------------------------
||  
*/-----------------------------------------------------------------------------------
    FUNCTION testgroup_disp_order(test_id_in IN VARCHAR2) RETURN NUMBER;
    FUNCTION test_disp_order(test_id_in IN VARCHAR2) RETURN NUMBER; 
    FUNCTION version_no RETURN VARCHAR2;
    
END DPQAGDTS;


/


CREATE OR REPLACE PACKAGE BODY DPQAGDTS AS
    /*
        create or replace public synonym DPQAGDTS for AGMGR.DPQAGDTS;
        grant execute on AGMGR.DPQAGDTS to public;        
    */  

    gv_version_no VARCHAR2(03) := '01';
    
    FUNCTION version_no RETURN VARCHAR2 IS
    BEGIN
        RETURN gv_version_no;
    END version_no;
    
    FUNCTION testgroup_disp_order(test_id_in IN VARCHAR2) RETURN NUMBER IS
        lv_group VARCHAR2(10);
        ln_order NUMBER;
    BEGIN
        SELECT test_group INTO lv_group
          FROM valid_tests_don
         WHERE test_id = test_id_in
          AND  SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE +1);

        IF lv_group = 'AG' THEN
            SELECT grps.antigen_grp_disp_order INTO ln_order
              FROM valid_antigen_groups grps
             WHERE grps.ser_ag_test_id = test_id_in
               AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE +10);
        ELSE
            SELECT grps.antigen_grp_disp_order INTO ln_order
              FROM valid_antigen_groups grps
             WHERE grps.mol_ag_test_id = test_id_in
               AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE +10);
        END IF;

        RETURN ln_order; 
    EXCEPTION
        WHEN OTHERS THEN
            RETURN 0;
    END testgroup_disp_order;

    FUNCTION test_disp_order(test_id_in IN VARCHAR2) RETURN NUMBER IS
        lv_group VARCHAR2(10);
        ln_order NUMBER;
    BEGIN
        SELECT test_group INTO lv_group
          FROM valid_tests_don
         WHERE test_id = test_id_in
          AND  SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE +1);

        IF lv_group = 'AG' THEN
            SELECT grps.ser_test_disp_order INTO ln_order
              FROM valid_antigen_groups grps
             WHERE grps.ser_ag_test_id = test_id_in
               AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE +10);
        ELSE
            SELECT grps.mol_test_disp_order INTO ln_order
              FROM valid_antigen_groups grps
             WHERE grps.mol_ag_test_id = test_id_in
               AND SYSDATE BETWEEN eff_date AND NVL(term_date, SYSDATE +10);
        END IF;

        RETURN ln_order; 
    EXCEPTION
        WHEN OTHERS THEN
            RETURN 0;
    END test_disp_order;


END DPQAGDTS;

/
