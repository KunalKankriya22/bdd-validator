CREATE OR REPLACE PACKAGE DON_HLA_RBC IS
/* --------------------------------------------------------------------------
   PROGRAM VERSION    : 03
   PROGRAM AUTHOR     : CHANDRA
   LAST REVISION DATE : 07-03-2006
                      : 04 (08/10/11) for adding the PLRF type in the search
                      : 05 - Changed by Kishore on 09/05/2014.
                           - Changed code to populate the CMV status correctly in 
                             the HLA_RBC_MATCH_UNITS table.
                      : 06 - Changed by Kishore on 09/16/2014. IM 10207.
                      : 07   MLT- 6721

 This package consists of three procedures
   1. HLA_MATCH         : This procedure is used to match hla antigens 
                          with that of recepient. Depending upon the
                          request id (hla_rbc_request) abo match is
                          done. The output of all matching donors with
                          grade are stored in hla_rbc_match_lists table.
   2. RBC_MATCH         : This procedure is used to match rbc antigens
                          with that of recepient. Depending upon the 
                          request abo match as well as antibodies match
                          is performed. The output of matching donors 
                          is stored in hla_rbc_match_lists.
   3. RBC_GROUP_MATCH   : This procedure is used to match rbc group anti
                          gens match. This is an exact match search. That
                          is if group contains 5 diff antigens the donors
                          which are selected will have atleast those antigens
                          apart from others tests. The group request is also
                          stored as a dummy patient with rbc antigens. The 
                          output is stored in hla_rbc_match_lists.
   In all the three procedures data is not committed. The status value 
   returned should be of size 250 characters. Check for 'OK' for successful
   in the calling program else status contains the error message.

   4. HLARBC_PROC_CALLER: This procedure will be called from cron job or
                          dbms_job. This in turn will call one of the above
                          procedures depending upon the request id. This will
                          also populate hla_rbc_match_units if requested.
                          This procedure will commit the data after each request
                          is processed.
---------------------------------------------------------------------------- */

PROCEDURE HLA_MATCH 
                (p_request_id           IN      varchar2,
                 p_grade_level          IN      number,
                 p_total                OUT     number,
                 p_status               OUT     varchar2                
                );

PROCEDURE RBC_MATCH 
                (p_request_id           IN      varchar2,
                 p_total                OUT     number,
                 p_status               OUT     varchar2                
                );

PROCEDURE RBC_GROUP_MATCH 
                (p_request_id           IN      varchar2,
                 p_total                OUT     number,
                 p_status               OUT     varchar2                
                );
PROCEDURE POPULATE_UNITS_TABLE
                (p_request_id           IN    varchar2,
                 request_type           IN    varchar2,
                 p_status              OUT    varchar2
                 );
PROCEDURE HLARBC_PROC_CALLER;

END DON_HLA_RBC ;
/

CREATE OR REPLACE PACKAGE BODY DON_HLA_RBC IS

 debug_mode      boolean  := FALSE;
/*  Program Name        : HLA_MATCH   
    Date Creation       : 10/03/97
    Program Author      : Chandra
    Error no. used      : Err1 to Err19.
*/
PROCEDURE HLA_MATCH 
                (p_request_id           IN      varchar2,
                 p_grade_level          IN      number,
                 p_total                OUT     number,
                 p_status               OUT     varchar2                
                )
IS
 g_patient_id           varchar2(10);
 g_patient_a1           varchar2(6);
 g_patient_a2           varchar2(6);
 g_patient_b1           varchar2(6);
 g_patient_b2           varchar2(6);
 g_hla_pheno            varchar2(1);    --phenotype matching to be done if Y
 g_hla_anti             varchar2(1);    -- hla antibodies to be matched
 g_patient_abo          varchar2(5);    -- donor abo matching req if not null
 g_match_a1             varchar2(1);
 g_match_a2             varchar2(1);
 g_match_b1             varchar2(1);
 g_match_b2             varchar2(1);
 g_chapter_id           varchar2(4);
 g_check_antibody       varchar2(1);
 G_MAXSIZE              number;
 total_donors           number;
 
 

 CURSOR donors_anti_match IS
      Select donor_id,a1,a2,b1,b2 from donor_hla_antigens where
      A1 NOT IN (
            select associated_epitope_id from valid_hla_epitopes
             where public_epitope_id IN (
                         select v.public_epitope_id
                           from valid_hla_epitopes v,patient_hla_antibodies p
                          where p.patient_id = g_patient_id and 
                                p.locus = 'A' and
                                p.epitope_id = v.associated_epitope_id and
                                sysdate between v.eff_date and 
                                        nvl(v.term_date,sysdate+1)
                                        )
                 )  and
      A2 NOT IN (
            select associated_epitope_id from valid_hla_epitopes
             where public_epitope_id IN (
                        select v.public_epitope_id
                          from valid_hla_epitopes v,patient_hla_antibodies p
                         where p.patient_id = g_patient_id and
                               p.locus = 'A' and
                               p.epitope_id = v.associated_epitope_id and
                               sysdate between v.eff_date and 
                                        nvl(v.term_date,sysdate+1)
                                        )
                 ) and
      B1 NOT IN (
            select associated_epitope_id from valid_hla_epitopes
             where public_epitope_id IN (
                        select v.public_epitope_id
                          from valid_hla_epitopes v,patient_hla_antibodies p
                         where p.patient_id = g_patient_id and
                               p.locus = 'B' and
                               p.epitope_id = v.associated_epitope_id and
                               sysdate between v.eff_date and 
                                       nvl(v.term_date,sysdate+1)
                                       )
                 )  and
      B2 NOT IN (
            select associated_epitope_id from valid_hla_epitopes
             where public_epitope_id IN (
                        select v.public_epitope_id
                          from valid_hla_epitopes v,patient_hla_antibodies p
                         where p.patient_id = g_patient_id and
                               p.locus = 'B' and
                               p.epitope_id = v.associated_epitope_id and
                               sysdate between v.eff_date and 
                                         nvl(v.term_date,sysdate+1)
                                         )
                 )  ;


 CURSOR donors_match IS
    SELECT donor_id,a1,a2,b1,b2 FROM
         DONOR_HLA_ANTIGENS
    WHERE 
        A1 in (select associated_epitope_id from valid_hla_epitopes
                where public_epitope_id IN
                            (select public_epitope_id
                               from valid_hla_epitopes
                              where ( associated_epitope_id = g_patient_a1 or 
                                      associated_epitope_id = g_patient_a2 )and
                                      sysdate between eff_date and 
                                                     nvl(term_date,sysdate+1) 
                                    ) 
                             ) or
        A2 in (select associated_epitope_id from valid_hla_epitopes
                where public_epitope_id IN
                            (select public_epitope_id
                               from valid_hla_epitopes
                              where ( associated_epitope_id = g_patient_a1 or
                                      associated_epitope_id = g_patient_a2 ) and
                                      sysdate between eff_date and 
                                                     nvl(term_date,sysdate+1) 
                                    ) 
                            ) or
        B1 in (select associated_epitope_id from valid_hla_epitopes
                where public_epitope_id IN
                            (select public_epitope_id
                               from valid_hla_epitopes
                              where ( associated_epitope_id = g_patient_b1 or
                                      associated_epitope_id = g_patient_b2 ) and
                                      sysdate between eff_date and 
                                                      nvl(term_date,sysdate+1)
                                     ) 
                             ) or
        B2 in (select associated_epitope_id from valid_hla_epitopes
                where public_epitope_id IN
                            (select public_epitope_id
                               from valid_hla_epitopes
                              where ( associated_epitope_id = g_patient_b1 or
                                      associated_epitope_id = g_patient_b2 ) and
                                      sysdate between eff_date and 
                                                      nvl(term_date,sysdate+1)
                                    )  
              ) ;

 CURSOR grade_donors is
        SELECT grade_id,grade,grade_level FROM
                VALID_HLA_GRADING
        WHERE
                A1 = g_match_a1 and
                A2 = g_match_a2 and
                B1 = g_match_b1 and
                B2 = g_match_b2 and
                sysdate between eff_date and nvl(term_date,sysdate+1);

 /* -----------------------Declaration over-------------------------------*/ 
 
 FUNCTION match_two_epitopes
                        ( pat_epitope IN varchar2,
                          don_epitope IN varchar2) 
        RETURN varchar2 IS
 counter        number;
 counter2       number;
 loc_bond       varchar2(1);
 BEGIN
   
        if pat_epitope is null and don_epitope is null then 
                return 'D';
        end if;
        if pat_epitope is null and don_epitope is not null then 
                return 'D';
        end if;
        if pat_epitope is not null and don_epitope is null then
                return 'U';
        end if;
        if pat_epitope = don_epitope then
                return 'I';
        end if;
        begin
           select bond into loc_bond
             from  valid_strong_reactivity
            where
              ( (epitope_id_1 = pat_epitope and epitope_id_2 = don_epitope) or
                (epitope_id_1 = don_epitope and epitope_id_2 = pat_epitope)) and
                sysdate between eff_date and nvl(term_date,sysdate+1);
           return loc_bond;      /* returns S or C i.e strong or connecting */
        exception      
             when no_data_found then
                begin
                  select count(*) into counter2 
                    from valid_hla_epitopes v, valid_hla_epitopes h
                   where v.associated_epitope_id = pat_epitope and
                         v.public_epitope_id = h.public_epitope_id and
                         h.associated_epitope_id = don_epitope and
                         sysdate between v.eff_date and 
                                         nvl(v.term_date,sysdate+1)  and
                         sysdate between h.eff_date and 
                                         nvl(h.term_date,sysdate+1) ;
                  if counter2 > 0 then
                        return 'G'; 
                  else
                        return 'D';
                  end if;
                end;
             when others then
                return 'M';    --multiple rows into validation table
        end;    
 END;
                
 FUNCTION check_perm_dfrd (s_donor_id IN varchar2)
        RETURN varchar2 IS
 ddr_count number;
 Begin
     Begin              /* DDR HIT CHECK */
        ddr_count := 0;
        Select count(*) into ddr_count 
        from donor_deferral_registry
        where center_id = s_donor_id;
        if ddr_count > 0 then
                -- 'Permanently Deferred, Entry in Central DDR.';
                return 'Y';
        end if;
     exception
        when no_data_found then
                null;
        when others then
                null;
      end;              
     Begin               /* Local  perm def  in donor_interdiction */
        ddr_count := 0;
        Select count(*) into ddr_count
        from  donor_interdictions di, valid_interdictions vi
        where   (donor_id = s_donor_id) and
                di.inter_code = vi.inter_code and
                vi.deferral_flag = 'Y' and
                sysdate between di.eff_date and nvl(di.term_date,sysdate+1);
        --        vi.period_type = 'P';           
        --message('Count is :'||to_char(ddr_count));pause;
        if ddr_count >  0 then
                -- 'Donor is Perm deferred, entry in Local DDR.';
                return 'Y' ;
        end if;
     exception
        when no_data_found then
                null;
        when others then 
                null;
     End;
  return 'N';
 End; /* function check_perm_dfrd ends */       

 FUNCTION validate_and_init 
        RETURN varchar2 IS
  x varchar2(1);
  chk   number;
  Begin
        begin
          select parameter_value into G_MAXSIZE
            from valid_parameters 
           where parameter_code ='MAXDONRET' and
                 sysdate between eff_date and nvl(term_date,sysdate+1) and
                 rownum <2;
        exception
           when others then
                p_status := 'Err1. Parameter  MAXDONRET not defined';
                return 'NOTOK';
        end;
        begin
          select patient_id,hla_pheno,hla_anti,blood_type,chapter_id 
            into g_patient_id,g_hla_pheno,g_hla_anti,g_patient_abo,g_chapter_id
            from hla_rbc_request
           where request_id = p_request_id;
        exception
          when no_data_found then
                p_status := 'Err2. No request id found';
                return 'NOTOK';
          when others then
                p_status := 'Err3. SQL failed'||
                            substr(sqlerrm,1,100);
                return 'NOTOK';
        end;
        if g_hla_pheno = 'Y' and g_hla_anti = 'Y' then
                --p_status := 'Can not search by phenotype and antibodies';
                --return 'NOTOK';
                g_check_antibody := 'Y';
        else
                g_check_antibody := 'N';
        end if;
        if g_hla_pheno = 'Y' then
                begin
                  Select A1,A2,B1,B2 
                    into g_patient_a1,g_patient_a2,g_patient_b1,g_patient_b2
                    from patient_hla_antigens
                   where patient_id = g_patient_id;
                exception
                   when no_data_found then
                        p_status := 'Err4. Patient hla antigen not found';
                        return 'NOTOK';
                   when others then
                        p_status := 'Err5. SQL failed'||
                            substr(sqlerrm,1,100);
                        return 'NOTOK';
                end;      
        end if; /* g_hla_pheno */
        if g_hla_anti = 'Y' then    -- requested for antibodies search
            Begin
                Select count(*) into chk
                  from patient_hla_antibodies
                 where patient_id = g_patient_id;
             Exception
                 when no_data_found then
                        p_status := 'Err6. Patient hla antibodies not found';
                        return 'NOTOK';
                 when others then
                        p_status := 'Err7. SQL failed'||
                            substr(sqlerrm,1,100);
                        return 'NOTOK';
             End;  -- This will be a cursor as many antibodies may be present
             if chk = 0 then
                        /* p_status := 'Err8. Patient hla antibodies not found';
                        return 'NOTOK'; */
                        g_check_antibody := 'N';
             end if;    
        end if; /* g_hla_anti */           
        return 'OK';
    End; 
  /* ---------------Function validate_and_init  ends ---------------------  */ 

 PROCEDURE compute_match
                        (pa1            IN      varchar2,
                         pa2            IN      varchar2,
                         da1            IN      varchar2,
                         da2            IN      varchar2,
                        match_a1        OUT     varchar2,
                        match_a2        OUT     varchar2 )
 IS
   a1a1         varchar2(1);
   a1a2         varchar2(1);
   a2a1         varchar2(1);
   a2a2         varchar2(1);

 BEGIN
        a1a1 := match_two_epitopes(pa1,da1);
        a1a2 := match_two_epitopes(pa1,da2);
        a2a1 := match_two_epitopes(pa2,da1);
        a2a2 := match_two_epitopes(pa2,da2);
        Begin
           Select output_a1,output_a2
             into match_a1,match_a2
             from hla_interim_match
            where match_a1a1 = a1a1 
              and match_a1a2 = a1a2
              and match_a2a1 = a2a1
              and match_a2a2 = a2a2
              and sysdate between eff_date and nvl(term_date,sysdate+1);
            return; 
        Exception
           when others then
                match_a1 := 'D';
                match_a2 := 'D';
                return;
        End;

/*      This logic is changed and now the whole logic is in the
        table HLA_INTERIM_MATCH.

