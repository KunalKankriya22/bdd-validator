/* generating the new ID- Added by edwin for the 4.2 on 042209
*/
    PROCEDURE generate_new_id (
        param_id_type IN VARCHAR2,
        new_id        OUT VARCHAR2,
        err_flag      OUT VARCHAR2,
        err_msg       OUT VARCHAR2
    ) IS
        string_len   NUMBER;
        new_sequence NUMBER;
        lv_id_type VARCHAR2(20);
    BEGIN
        lv_id_type := param_id_type;
        
        IF param_id_type = 'DUPLI' THEN
            lv_id_type := 'DP';        
        END IF;
        
        SELECT
            nvl(last_sequence, 0) + 1
        INTO new_sequence
        FROM
            all_donor_ids
        WHERE
            id_type = lv_id_type
        FOR UPDATE OF last_sequence;


        
        string_len := length(lv_id_type);
        new_id := lv_id_type
                  || lpad(to_char(new_sequence), 10 - string_len, '0');

        BEGIN
            UPDATE all_donor_ids
            SET
                last_sequence = new_sequence,
                last_modified_date = sysdate
            WHERE
                id_type = lv_id_type;

            COMMIT;
        EXCEPTION
            WHEN OTHERS THEN
                IF sqlcode != -100501 THEN
                    err_flag := 'Y';
                    err_msg := substr(sqlerrm, 1, 75);
                END IF;
        END;

    EXCEPTION
        WHEN no_data_found THEN
            err_flag := 'Y';
            err_msg := 'ID type not found in ALL_DONOR_IDS, contact IS';
        WHEN OTHERS THEN
            IF sqlcode != -100501 THEN
                err_flag := 'Y';
                err_msg := substr(sqlerrm, 1, 75);
            END IF;
    END generate_new_id;

PROCEDURE GENERATE_TEMP_ID(new_temp_id out varchar2,
                         err_flag out varchar2,
                         err_msg out varchar2) IS
  string_len number ;
  new_sequence number ;
  szTempID    varchar2(10);

BEGIN

  err_flag:='N';

  select LT_TEMP_ID,nvl(counter_value,0) + 1
  into szTempID,new_sequence
  from LAPTOP_ID_DETAILS
  where rownum <2
  for update of counter_value;

  string_len := length(szTempID) ;
  new_temp_id := szTempID||lpad(to_char(new_sequence),10-string_len,'0') ;

  begin
    update LAPTOP_ID_DETAILS
    set counter_value= new_sequence;
  exception
      when others then
        if sqlcode != -100501 then
            err_flag := 'Y' ;
            err_msg  := 'Temp ID-'||substr(sqlerrm,1,75) ;
        end if;
  end ;

  commit;

EXCEPTION
    when no_data_found then
        err_flag := 'Y' ;
        err_msg  := 'LAPTOP_ID_DETAILS  table does not have entires '||
                    ' to generate temp IDs' ;
     when others then
       if  sqlcode != -100501
       then
          err_flag := 'Y' ;
          err_msg  := 'Temp ID-'||substr(sqlerrm,1,75) ;
       end if;

END GENERATE_TEMP_ID;

PROCEDURE DONOR_PLASMA_RBC_LOSS(p_donor_id   IN  VARCHAR2,
                                p_plasma     OUT NUMBER,
                                p_rbc        out NUMBER,
                                p_chapter_id IN varchar2)   IS
  CURSOR curr_loss(p_local_date in date) is select actual_plasma_loss,actual_rbc_loss,
                    donation_type, procedure_code from donations where
                    donor_id=p_donor_id and unit_id is not null and
                    coll_date between p_local_date-365 and p_local_date and
                    (BLEED_START_TIME_L1 is not null or
                    BLEED_START_TIME_L2 is not null or
                    BLEED_START_TIME_R1 is not null or
                    BLEED_START_TIME_R2 is not null) ;

 cum_rbc_loss     NUMBER:=0;
 cum_plasma_loss  NUMBER:=0;
 s_rbc_loss       NUMBER:=0;
 s_plasma_loss    NUMBER:=0;
 e_rbc_loss       NUMBER:=0;
 e_plasma_loss    NUMBER:=0;
 v_local_time date;
 v_local_date date;
v_timezone_active char(1);
BEGIN

 begin
  SELECT  NVL(time_zone_enabled,'N')
    INTO    v_timezone_active
    FROM    lt_application_config;
 exception
   when no_data_found then
     v_timezone_active := 'N';
 end;


   if v_timezone_active ='Y' then

   Lifetrack_timezone_convert.get_local_time(p_chapter_id,sysdate,v_local_time);
   v_local_date := v_local_time;
  else
         v_local_date := sysdate;

  end if;

 FOR Z in CURR_LOSS(v_local_date) loop

   select STANDARD_RBC_LOSS,STANDARD_PLASMA_LOSS ,ECV_RBC_LOSS,
          ECV_PLASMA_LOSS into s_rbc_loss,s_plasma_loss,
          e_rbc_loss,e_plasma_loss from valid_proc_codes where
          procedure_code=Z.procedure_code and
          v_local_date between eff_date and nvl(term_date,v_local_date+1);

    cum_rbc_loss:=cum_rbc_loss +
                  nvl(Z.actual_rbc_loss,(s_rbc_loss+e_rbc_loss));
    cum_plasma_loss:=cum_plasma_loss + nvl(Z.actual_plasma_loss,
                       (s_plasma_loss+e_plasma_loss));
 End Loop;

 p_plasma:=cum_plasma_loss;
 p_rbc   :=cum_rbc_loss;

END DONOR_PLASMA_RBC_LOSS;

PROCEDURE UPDATE_UNDER_PROCESSING_FLAG (p_donor_id in varchar2,
                                        p_drive_id in varchar2,
                                        p_lock_flag in varchar2) is

Begin

  If p_lock_flag='L'  then   -- lock it

    UPDATE ONLINE_STATUS set UNDER_PROCESSING_FLAG='L' where
   donor_id=p_donor_id and drive_id=p_drive_id and
    status_flag!='W' and under_processing_flag is null and rownum=1;

  Else
     UPDATE ONLINE_STATUS set UNDER_PROCESSING_FLAG=null where
    donor_id=p_donor_id and drive_id=p_drive_id and
    under_processing_flag='L';
  End If;

     commit;
End UPDATE_UNDER_PROCESSING_FLAG;

FUNCTION COMMENT_REQ_CHECK(P_DONATION_TYPE  IN VARCHAR2,
                                       P_PROCEDURE_CODE IN VARCHAR2,
                                       P_PHYSICAL_CODE  IN VARCHAR2,
                                       P_VALUE          IN VARCHAR2,
                                       P_GENDER         IN VARCHAR2
                                      )
RETURN VARCHAR2 IS
  ln_p_value  NUMBER;
  lv_data_type VARCHAR2(10);
  ln_dummy PLS_INTEGER;
  lv_return VARCHAR2(10) := 'FALSE';
BEGIN

  -- Determine value data type - C or N (Decimal is also considered as N)
  BEGIN
    select to_number(P_VALUE) into ln_p_value
     from dual;
    lv_data_type := 'N';
  EXCEPTION
    WHEN OTHERS THEN
      lv_data_type := 'C';
  END;

  -- Check if comment is required.
  BEGIN
    IF lv_data_type = 'C' THEN
      select 1 into ln_dummy
        from valid_physical_rules
       where donation_type = p_donation_type
         and procedure_code = p_procedure_code
         and physical_code = p_physical_code
         and gender in ('A', p_gender)
         and item_value = p_value
         and nvl(comment_req_flag, 'X') = 'Y'
         and sysdate between eff_date and nvl(term_date, sysdate + 1);

      lv_return := 'TRUE';
    ELSIF lv_data_type IN ('N', 'D') THEN
      FOR rec in
        (
          select item_operator, item_value, item_value_max
            from valid_physical_rules
           where donation_type = p_donation_type
             and procedure_code = p_procedure_code
             and physical_code = p_physical_code
             and gender in ('A', p_gender)
             and nvl(comment_req_flag,'X') = 'Y'
             and sysdate between eff_date and nvl(term_date, sysdate + 1)
             )
      LOOP
        IF rec.item_operator = 'BETWEEN' THEN
          IF ln_p_value NOT BETWEEN TO_NUMBER(rec.item_value) AND TO_NUMBER(rec.item_value_max) THEN
            lv_return := 'TRUE';
            EXIT;
          END IF;
        END IF;

        IF rec.item_operator = 'MORE' THEN
          IF ln_p_value > TO_NUMBER(rec.item_value) THEN
            lv_return := 'TRUE';
            EXIT;
          END IF;
        END IF;

        IF rec.item_operator = 'LESS' THEN
          IF ln_p_value < TO_NUMBER(rec.item_value) THEN
            lv_return := 'TRUE';
            EXIT;
          END IF;
        END IF;
      END LOOP;
    END IF;
    RETURN lv_return;
  EXCEPTION
    WHEN OTHERS THEN
      RETURN 'FALSE';
  END;
END COMMENT_REQ_CHECK;

PROCEDURE INSERT_MALE_FEMALE_INTER (pl_donor      in varchar2,
                                    pl_chapter_id in varchar2,
                                    pl_gender     in varchar2,
                                    pl_trans_id   in varchar2,
                                    pl_program_id in varchar2,
                                    pl_user_id    in varchar2,
                                    pl_out        out varchar2) is

  P_DONOR_ID        varchar2(10);
  P_CHAPTER_ID      varchar2(4);
  P_UNIT_ID         varchar2(10);
  P_TRANSACTION_ID  varchar2(10);
  P_INTER_CODE      varchar2(5);
  P_ORIGINATED_FROM varchar2(10);
  P_REASON_CODE     varchar2(5);
  P_USER_ID         varchar2(6);
  P_GROUP_MODE      varchar2(5);
  P_GROUP_ID        varchar2(5);
  P_PROGRAM_ID      varchar2(10);
  P_INCIDENT_DATE   date;
  P_TERM_DATE       date;
  P_COMMENTS        varchar2(100);
  P_STATUS          varchar2(200);
  nCount            NUMBER:=0;
  v_local_time			date;
  t_chp_id					chapters.chapter_id%type;
Begin
	-- Added by Kishore on 05/05/2011
 begin
    select chapter_id
      into t_chp_id
      from system_users
     where user_id = pl_user_id;
  exception
    when others then
      pl_out:='Could not retrieve data from the SYSTEM USERS table';
      return;
  end;


    v_local_time:=Lifetrack_timezone_convert.get_local_time(t_chp_id, sysdate);

  --get the intercode from the RHOLDS table
  p_status:='OK';

  If pl_gender='M' then
    P_ORIGINATED_FROM:='INTRMALE';
  Else
    P_ORIGINATED_FROM:='INTRFEMALE';
  End if;

  select nvl(count(*),0) into nCount from valid_regint_reasons where inter_reason=P_ORIGINATED_FROM and
  sysdate between eff_date and nvl(term_date,sysdate+1);

  If nCount > 0 then
    select inter_code into P_INTER_CODE from valid_regint_reasons where inter_reason=P_ORIGINATED_FROM and
    sysdate between eff_date and nvl(term_date,sysdate+1) and rownum=1;

    P_DONOR_ID:=pl_donor;
    --P_CHAPTER_ID:='WAD';
    P_CHAPTER_ID:=pl_chapter_id;
    P_TRANSACTION_ID:=pl_trans_id;
    p_REASON_CODE:=P_INTER_CODE;
    p_USER_ID:=pl_user_id;
    p_GROUP_MODE:=null;
    p_GROUP_ID:=NULL;
    p_PROGRAM_ID:=pl_program_id;
    p_INCIDENT_DATE:=trunc(v_local_time); --effective date as system date -- Changed "sysdate" to "v_local_time. Changed by Kishore on 05/05/2011
    p_TERM_DATE:=null;
    p_unit_id:=null;
    p_COMMENTS:='Gender related Interdiction';

    don_inter.inter_upgrade_place(P_DONOR_ID,
                        P_CHAPTER_ID,
                        P_UNIT_ID,
                        P_TRANSACTION_ID,
                        P_INTER_CODE,
                        NULL,
                        NULL,
                        P_USER_ID,
                        NULL,
                        NULL,
                        P_PROGRAM_ID,
                        P_INCIDENT_DATE,
                        P_TERM_DATE,
                        P_COMMENTS,
                        P_STATUS);

    pl_out:=p_status;

  End If;

EXCEPTION when others then
  pl_out:='Unable to place the gender realted interdiction-'||sqlerrm;
End INSERT_MALE_FEMALE_INTER;

    PROCEDURE pop_reason (
        p_transaction_id  IN   VARCHAR2,
        p_phy_code        IN   VARCHAR2,
        p_phy_value       IN   VARCHAR2,
        p_out_of_range    OUT  VARCHAR2,
        p_comment_req     OUT  VARCHAR2,
        p_inter_code      OUT  VARCHAR2,
        p_status          OUT  VARCHAR2
    ) IS

        vpr_tab            vpr_tab_type;
        vpr_tab_equip      vpr_tab_type;
        vpr_tab_equip_age  vpr_tab_type;
        lb_multi_rule      BOOLEAN := false;
        lb_value_in_range  BOOLEAN := false;
        ln_min             NUMBER;
        ln_max             NUMBER;
        ln_value           NUMBER;
        lv_equip_type      VARCHAR2(10);
        ln_age             NUMBER;
    BEGIN
        p_status := 'OK';
        p_out_of_range := NULL;
        p_comment_req := 'N';

        IF p_phy_value IS NULL THEN
            RETURN;
        END IF;


        -- Get rules for N,D datatype.
        SELECT
            vpr.item_value,
            vpr.item_value_max,
            vpr.item_operator,
            vpr.comment_req_flag,
            vpr.inter_code,
            vpr.equip_type,
            vpr.from_age,
            vpr.to_age,
            floor(months_between(sysdate, d.date_of_birth) / 12)           age,
            dn.equip_type                                                  AS don_equip_type
        BULK COLLECT
        INTO vpr_tab
        FROM
            valid_physical_rules  vpr,
            donations             dn,
            donors                d
        WHERE
                vpr.donation_type = dn.donation_type
            AND vpr.procedure_code = dn.procedure_code
            AND dn.donor_id = d.donor_id
            AND d.chapter_id = 'ALL'
            AND dn.transaction_id = p_transaction_id
            AND vpr.physical_code = p_phy_code
            AND vpr.gender IN (
                d.gender,
                'A'
            )
            AND vpr.data_type IN (
                'N',
                'D'
            )
            AND dn.coll_date BETWEEN vpr.eff_date AND nvl(vpr.term_date, dn.coll_date + 1);

        IF vpr_tab.count = 0 THEN
            p_status := 'INVALID';
            return;
        END IF;
        -- Filter by equipment.
        lv_equip_type := vpr_tab(vpr_tab.first).don_equip_type;
        ln_age := vpr_tab(vpr_tab.first).age;
        SELECT
            *
        BULK COLLECT
        INTO vpr_tab_equip
        FROM
            TABLE ( vpr_tab )
        WHERE
            equip_type IS NULL
            OR equip_type = lv_equip_type;

        lb_multi_rule := vpr_tab_equip.count > 1;

        -- Filter by equipment and age.
        SELECT
            *
        BULK COLLECT
        INTO vpr_tab_equip_age
        FROM
            TABLE ( vpr_tab_equip )
        WHERE
            from_age IS NULL
            OR ( ln_age BETWEEN from_age AND to_age );

        IF vpr_tab_equip_age.count = 0 THEN
            p_status := 'INVALID';
            return;
        END IF;

       ln_value := to_number(p_phy_value);

        FOR cur_rec IN (
            SELECT
                *
            FROM
                TABLE ( vpr_tab_equip_age )
        ) LOOP
            BEGIN
                IF cur_rec.item_operator = 'BETWEEN' THEN
                    ln_min := to_number(cur_rec.item_value);
                    ln_max := to_number(cur_rec.item_value_max);
                    lb_value_in_range := ln_value BETWEEN ln_min AND ln_max;

                    -- BETWEEN OPERATOR
                        -- In multi rule setup
                            -- in-range value with inter code is considered OUT OF RANGE.
                            -- in-range value without inter code is considered IN RANGE.
                        -- In single rule setup, out-of-range value is considered OUT OF RANGE.
                    IF lb_multi_rule THEN
                        IF
                            lb_value_in_range AND cur_rec.inter_code IS NOT NULL
                        THEN
                            p_out_of_range := 'Y';
                            p_comment_req := cur_rec.comment_req_flag;
                            p_inter_code := cur_rec.inter_code;
                        ELSIF
                            lb_value_in_range AND cur_rec.inter_code IS NULL
                        THEN
                            p_out_of_range := 'N';
                            p_comment_req := cur_rec.comment_req_flag;
                            p_inter_code := cur_rec.inter_code;
                        END IF;
                    ELSE
                        IF NOT lb_value_in_range THEN
                            p_out_of_range := 'Y';
                            p_comment_req := cur_rec.comment_req_flag;
                            p_inter_code := cur_rec.inter_code;
                        END IF;
                    END IF;

                ELSIF cur_rec.item_operator = 'INRANGE' THEN
                    ln_min := to_number(cur_rec.item_value);
                    ln_max := to_number(cur_rec.item_value_max);
                    lb_value_in_range := ln_value BETWEEN ln_min AND ln_max;

                    -- INRANGE OPERATOR
                        -- In multi rule setup
                            -- in-range value (with or without intercode) is considered IN RANGE.
                        -- In single rule setup, out-of-range value is considered OUT OF RANGE.
                    IF lb_multi_rule THEN
                        IF lb_value_in_range THEN
                            p_out_of_range := 'N';
                            p_comment_req := cur_rec.comment_req_flag;
                            p_inter_code := cur_rec.inter_code;
                        END IF;
                    ELSE
                        IF NOT lb_value_in_range THEN
                            p_out_of_range := 'Y';
                            p_comment_req := cur_rec.comment_req_flag;
                            p_inter_code := cur_rec.inter_code;
                        END IF;
                    END IF;

                ELSIF cur_rec.item_operator = 'MORE' THEN
                    -- MORE OPERATOR
                        -- In multi rule setup AND single rule setup
                            -- value GREATER than MIN value is considered OUT OF RANGE.
                    IF ln_value > to_number(cur_rec.item_value) THEN
                        p_out_of_range := 'Y';
                        p_comment_req := cur_rec.comment_req_flag;
                        p_inter_code := cur_rec.inter_code;
                    END IF;
                ELSIF cur_rec.item_operator = 'LESS' THEN
                    -- LESS OPERATOR
                        -- In multi rule setup AND single rule setup
                            -- value LESS than MIN value is considered OUT OF RANGE.
                    IF ln_value < to_number(cur_rec.item_value) THEN
                        p_out_of_range := 'Y';
                        p_comment_req := cur_rec.comment_req_flag;
                        p_inter_code := cur_rec.inter_code;
                    END IF;
                END IF;

                -- EXIT if out_of_range is calculated.
                IF p_out_of_range IS NOT NULL THEN
                    EXIT;
                END IF;
            EXCEPTION
                WHEN value_error THEN
                    NULL;
            END;
        END LOOP;

    END pop_reason;
    
    FUNCTION object_lock_time (
        p_pkg_name  IN  VARCHAR2,
        p_fcn_name  IN  VARCHAR2
    ) RETURN NUMBER IS

        CURSOR pkg_lock_cur IS
        SELECT
            locked_on
        FROM
            db_package_lock
        WHERE
                package_name = p_pkg_name
            AND function_name = nvl(p_fcn_name, function_name);

        l_locked_on    DATE;
        l_elapsed_min  NUMBER := 0;
    BEGIN
        OPEN pkg_lock_cur;
        FETCH pkg_lock_cur INTO l_locked_on;
        CLOSE pkg_lock_cur;
        IF l_locked_on IS NOT NULL THEN
            l_elapsed_min := ( sysdate - l_locked_on ) * 24 * 60;
        END IF;

        RETURN l_elapsed_min;
    END object_lock_time;

    FUNCTION is_object_locked (
        p_pkg_name  IN  VARCHAR2,
        p_fcn_name  IN  VARCHAR2
    ) RETURN BOOLEAN IS
        l_cnt NUMBER;
    BEGIN
        SELECT
            COUNT(1)
        INTO l_cnt
        FROM
            db_package_lock
        WHERE
                package_name = p_pkg_name
            AND function_name = nvl(p_fcn_name, function_name);

        IF l_cnt <> 0 THEN
            RETURN true;
        ELSE
            RETURN false;
        END IF;
    END is_object_locked;    
    
    PROCEDURE check_object_lock (
        p_pkg_name  IN   VARCHAR2,
        p_fcn_name  IN   VARCHAR2,
        p_flag_yn   OUT  VARCHAR2,
        p_lock_min  OUT  NUMBER
    ) IS
    BEGIN
        IF is_object_locked(p_pkg_name, p_fcn_name) THEN
            p_flag_yn := 'Y';
            p_lock_min := object_lock_time(p_pkg_name, p_fcn_name);
        ELSE
            p_flag_yn := 'N';
            p_lock_min := 0;
        END IF;
    END check_object_lock;

    PROCEDURE object_lock_unlock (
        p_pkg_name  IN  VARCHAR2,
        p_fcn_name  IN  VARCHAR2,
        p_user      IN  VARCHAR2,
        p_flag_ul   IN  VARCHAR2
    ) IS
        l_cnt NUMBER;
    BEGIN
        IF p_flag_ul = 'L' THEN
            INSERT INTO db_package_lock (
                package_name,
                function_name,
                locked_on,
                locked_by
            ) VALUES (
                p_pkg_name,
                p_fcn_name,
                sysdate,
                p_user
            );

        ELSIF p_flag_ul = 'U' THEN
            DELETE FROM db_package_lock
            WHERE
                    package_name = p_pkg_name
                AND function_name = nvl(p_fcn_name, function_name);

        END IF;

        COMMIT;
    END object_lock_unlock;
END don_std;
/
