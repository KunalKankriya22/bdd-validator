END don_std;
/
CREATE OR REPLACE PACKAGE BODY don_std IS


   -- following constant will be used to identify errors generated
   -- in this package as they will be logged in PROGRAM_ERRORS table.

   PACKAGE_NAME   CONSTANT varchar2(10)   := 'DON_STD'; -- ideitify package


/*
** This function RETURN 'TRUE' value, if donor had completed a
** pre-defined number of Apheresis procedures in the lifetime
** donations, else 'FALSE' is returned.
*/
   FUNCTION active_apheresis_donor
            (szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN VARCHAR2 IS

      UNIT_NAME             varchar2(32)   := null;
      szErrorMsg            varchar2(500)  := null;
      nApheresisDonations   NUMBER;
      nActiveStatusCount    NUMBER;
      szReturnStatus        VARCHAR2(6);

      cursor cur_apher_count (p_donor_id varchar2, p_chapter_id varchar2) is
             select count(*) aph_count
               from donations
              where donor_id   = p_donor_id
                --and chapter_id = p_chapter_id     --  IM5237
                and DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and procedure_code in (select code
                                         from valid_master_codes
                                        where code_type = 'APHER');

      cursor cur_limit (p_chapter_id varchar2) is
             select to_number(parameter_value)
               from valid_parameters
              where --chapter_id = p_chapter_id       --   IM5237
                DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and parameter_type = 'ALL'
                and parameter_code = 'APHACTIVST';

   BEGIN
      UNIT_NAME := 'active_apheresis_donor';
      open cur_apher_count(szDonorID, szChapterID);
      fetch cur_apher_count
       into nApheresisDonations;
      if cur_apher_count%NOTFOUND then
         nApheresisDonations := 0;
      end if;
      if cur_apher_count%ISOPEN then
         close cur_apher_count;
      end if;

      if nApheresisDonations > 0 then
         open cur_limit(szChapterID);
         fetch cur_limit
          into nActiveStatusCount;
         if cur_limit%NOTFOUND then
            nActiveStatusCount := 3;  -- if we dont find, the default value is 3
         end if;
         if cur_limit%ISOPEN then
            close cur_limit;
         end if;
         if nApheresisDonations > nActiveStatusCount then
            szReturnStatus := 'TRUE';
         else
            szReturnStatus := 'FALSE';
         end if;
      else
         szReturnStatus := 'FALSE';
      end if;
      return szReturnStatus;

      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Donors date range counts are calculated and returned.
**
** parameter    Description
** --------------------------------------------------
** 'CREDIT'             date range credit counts
** 'GALLON'             date range gallon count
** 'UNIT'               date range unit count
**
*/
   FUNCTION donor_range_counts
            (p_what      IN varchar2,
             szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type,
             szStartDate IN date,
             szEndDate   IN date)
             RETURN NUMBER IS

      UNIT_NAME             varchar2(32)   := null;
      szErrorMsg            varchar2(500)  := null;
      nDonorCount           NUMBER;
      nUnitCount            NUMBER;
      nCreditCount          NUMBER;
      nClaimedDons          NUMBER;
      szdonor               varchar2(10);

      cursor cur_donation (p_donor_id varchar2, p_chapter_id varchar2) is
             select donor_id, count(unit_id), sum(donations.credit_count)
               from donations
              where donor_id   = p_donor_id
                and --chapter_id = p_chapter_id   --  IM5237
                DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and unit_id    is not null
                and coll_date  between szStartDate
                                   and szEndDate
              group by donor_id;

      cursor cur_claimed (p_donor_id varchar2, p_chapter_id varchar2) is
             select nvl(donors.claimed_donation, 0)
               from donors
              where donor_id      = p_donor_id
                and --chapter_id    = p_chapter_id      --  IM5237
                DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id;

   BEGIN
      UNIT_NAME := 'donor_range_counts';
      open cur_donation(szDonorID, szChapterID);
      fetch cur_donation
       into szdonor, nUnitCount, nCreditCount;
      if cur_donation%NOTFOUND then
         nUnitCount   := 0;
         nCreditCount := 0;
      end if;
      if cur_donation%ISOPEN then
         close cur_donation;
      end if;

      open cur_claimed(szDonorID, szChapterID);
      fetch cur_claimed
       into nClaimedDons;
      if cur_claimed%NOTFOUND then
         nClaimedDons := 0;
      end if;
      if cur_claimed%ISOPEN then
         close cur_claimed;
      end if;

      if p_what = 'CREDIT' then
         nDonorCount := nCreditCount + nClaimedDons;
      elsif p_what = 'GALLON' then
         nDonorCount := FLOOR((nCreditCount + nClaimedDons)/8);
      elsif p_what = 'UNIT' then
         nDonorCount := nUnitCount;
      end if;
      return nDonorCount;

      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Donors date range credit count is calculated and returned.
*/
   FUNCTION donor_range_credit_count
            (szDonorID   IN donors.donor_id%type,
             szChapterID  IN donors.chapter_id%type,
             szStartDate IN date,
             szEndDate   IN date) RETURN NUMBER IS
   BEGIN
      return donor_range_counts('CREDIT', szDonorID, szChapterID,
                                 szStartDate, szEndDate);
   END;


/*
** Donors date range gallon count is calculated and returned.
*/
   FUNCTION donor_range_gallon_count
            (szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type,
             szStartDate IN date,
             szEndDate   IN date) RETURN NUMBER IS
   BEGIN
      return donor_range_counts('GALLON', szDonorID, szChapterID,
                                 szStartDate, szEndDate);
   END;


/*
** Donors date range unit count is calculated and returned.
*/
   FUNCTION donor_range_unit_count
            (szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type,
             szStartDate IN date,
             szEndDate   IN date) RETURN NUMBER IS
   BEGIN
      return donor_range_counts('UNIT', szDonorID, szChapterID,
                                 szStartDate, szEndDate);
   END;


/*
** Donors date range credit count for a specified procedure
** code is calculated and returned.
*/
   FUNCTION donor_range_proc_count
            (szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type,
             szProcCode  IN valid_proc_codes.procedure_code%type,
             szStartDate IN date,
             szEndDate   IN date)
            RETURN NUMBER IS

   cursor cur_proc_donation (p_donor_id varchar2,
                             p_chapter_id varchar2,
                             p_proc_code varchar2) is
          select donor_id,
                 sum(donations.credit_count)
            from donations
           where donor_id       = p_donor_id
             and --chapter_id     = p_chapter_id      --  IM5237
             DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
             and unit_id    is not null
             and procedure_code = p_proc_code
             and coll_date  between szStartDate
                                and szEndDate
           group by donor_id;

   szdonor         varchar2(10);
   nCreditCount      NUMBER;

   BEGIN
      open cur_proc_donation(szDonorID, szChapterID, szProcCode);
      fetch cur_proc_donation
       into szdonor, nCreditCount;
      if cur_proc_donation%NOTFOUND then
         nCreditCount := 0;
      end if;
      if cur_proc_donation%ISOPEN then
         close cur_proc_donation;
      end if;

      return nCreditCount;
   END;


/*
** Donors lifetime counts are calculated and returned.
**
** parameter    Description
** --------------------------------------------------
** 'CREDIT'             Lifetime credit counts
** 'GALLON'             Lifetime gallon count
** 'UNIT'               LifeTime unit count
**
*/
   FUNCTION donor_life_counts
            (p_what      IN varchar2,
             szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type)
             RETURN NUMBER IS

      UNIT_NAME         varchar2(32)   := null;
      szErrorMsg        varchar2(500)  := null;
      nDonorCount       NUMBER;
      nUnitCount        NUMBER;
      nDeferralCount    NUMBER; --Added by Lakshmi on 01/19/98
      nCreditCount      NUMBER;
      nClaimedDons      NUMBER;
      szdonor           varchar2(10);

      cursor cur_donation (p_donor_id varchar2, p_chapter_id varchar2) is
             select donor_id, count(unit_id), nvl(sum(donations.credit_count),0)
               from donations
              where donor_id   = p_donor_id
                --and --chapter_id = p_chapter_id     --    IM5237
                --DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and unit_id    is not null
                and donation_type!='SM'
              group by donor_id;

      -- Added by Lakshmi on 01/19/98 as req by Goudar

      cursor cur_deferral (p_donor_id varchar2, p_chapter_id varchar2) is
             select donor_id, count(*)
               from donations
              where donor_id   = p_donor_id
                --and --chapter_id = p_chapter_id         --  IM5237
                --DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and unit_id    is null
              group by donor_id;

      cursor cur_claimed (p_donor_id varchar2, p_chapter_id varchar2) is
             select nvl(donors.claimed_donation, 0)
               from donors
              where donor_id      = p_donor_id;
                --and --chapter_id    = p_chapter_id        --  IM5237
                --DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id;

   BEGIN
      UNIT_NAME := 'donor_life_count';
      open cur_donation(szDonorID, szChapterID);
      fetch cur_donation
       into szdonor, nUnitCount, nCreditCount;
      if cur_donation%NOTFOUND then
         nUnitCount   := 0;
         nCreditCount := 0;
      end if;
      if cur_donation%ISOPEN then
         close cur_donation;
      end if;

      open cur_deferral(szDonorID, szChapterID);
      fetch cur_deferral
       into szdonor, nDeferralCount;
      if cur_deferral%NOTFOUND then
         nDeferralCount   := 0;
      end if;
      if cur_deferral%ISOPEN then
         close cur_deferral;
      end if;

      open cur_claimed(szDonorID, szChapterID);
      fetch cur_claimed
       into nClaimedDons;
      if cur_claimed%NOTFOUND then
         nClaimedDons := 0;
      end if;
      if cur_claimed%ISOPEN then
         close cur_claimed;
      end if;

      if p_what = 'CREDIT' then
         nDonorCount := nCreditCount + nClaimedDons;
      elsif p_what = 'GALLON' then
         nDonorCount := FLOOR((nCreditCount + nClaimedDons)/8);
      elsif p_what = 'UNIT' then
         nDonorCount := nUnitCount;
      elsif p_what ='DEFER' then
         nDonorCount := nDeferralCount;
      end if;
      return nDonorCount;

      -- exception handing
      exception
         when others then
            null;

   END;



/*
** Donors lifetime donations credit count is calculated and returned.
*/
   FUNCTION donor_life_credit_count
            (szDonorID IN donors.donor_id%type,
            szChapterID IN donors.chapter_id%type) RETURN NUMBER IS
   BEGIN
      return donor_life_counts('CREDIT', szDonorID, szChapterID);
   END;


/*
** Donors lifetime gallon count is calculated and returned.
*/
   FUNCTION donor_life_gallon_count
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN NUMBER IS
   BEGIN
      return donor_life_counts('GALLON', szDonorID, szChapterID);
   END;


/*
** Donors lifetime donations unit count is calculated and returned.
*/
   FUNCTION donor_life_unit_count
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN NUMBER IS
   BEGIN
      return donor_life_counts('UNIT', szDonorID, szChapterID);
   END;

/*  Added by Lakshmi on 01/19/98 as req by Goudar
** Donors lifetime donations deferral count is calculated and returned.
*/
   FUNCTION donor_life_deferral_count
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN NUMBER IS
   BEGIN
      return donor_life_counts('DEFER', szDonorID, szChapterID);
   END;

/*
** Donors lifetime donations credit count for a specified procedure
** code is calculated and returned.
*/
   FUNCTION donor_life_proc_count
            (szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type,
             szProcCode  IN valid_proc_codes.procedure_code%type)
            RETURN NUMBER IS

      UNIT_NAME         varchar2(32)   := null;
      szErrorMsg        varchar2(500)  := null;
      szdonor           varchar2(10);
      nCreditCount      NUMBER;

      cursor cur_proc_donation (p_donor_id varchar2,
                                p_chapter_id varchar2,
                                p_proc_code varchar2) is
             select donor_id,
                    sum(donations.credit_count)
               from donations
              where donor_id       = p_donor_id
                and --chapter_id     = p_chapter_id         --      IM5237
                DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and procedure_code = p_proc_code
              group by donor_id;

   BEGIN
      UNIT_NAME := 'donor_life_proc_count';
      open cur_proc_donation(szDonorID, szChapterID, szProcCode);
      fetch cur_proc_donation
       into szdonor, nCreditCount;
      if cur_proc_donation%NOTFOUND then
         nCreditCount := 0;
      end if;
      if cur_proc_donation%ISOPEN then
         close cur_proc_donation;
      end if;

      return nCreditCount;

      -- exception handing
      exception
         when others then
            null;

   END;



/*
** Donors ytd counts are calculated and returned.
**
** parameter    Description
** --------------------------------------------------
** 'CREDIT'             Lifetime credit counts
** 'GALLON'             Lifetime gallon count
** 'UNIT'               LifeTime unit count
**
*/
   FUNCTION donor_ytd_count
            (p_what      IN varchar2,
             szDonorID   IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type)
             RETURN NUMBER IS

      UNIT_NAME             varchar2(32)   := null;
      szErrorMsg            varchar2(500)  := null;
      nDonorCount           NUMBER;
      nUnitCount            NUMBER;
      nCreditCount          NUMBER;
      nClaimedDons          NUMBER;

      cursor cur_donation (p_donor_id varchar2, p_chapter_id varchar2) is
             select count(unit_id), sum(donations.credit_count),
                    nvl(donors.claimed_donation, 0)
               from donations, donors
              where donors.donor_id      = p_donor_id
                and donations.donor_id   = donors.donor_id
                and donations.coll_date between trunc(sysdate, 'YYYY')
                                            and trunc(sysdate)
                and donations.unit_id    is not null
                and donations.donation_type!='SM'
                --and --donors.chapter_id    = p_chapter_id     --  IM5237
                --DECODE(donors.chapter_id,'ALL',p_chapter_id,donors.chapter_id) = p_chapter_id
                --and --donations.chapter_id = p_chapter_id     --  IM5237
                --DECODE(donations.chapter_id,'ALL',p_chapter_id,donations.chapter_id) = p_chapter_id
              group by donors.claimed_donation;

   BEGIN
      UNIT_NAME  := 'donor_ytd_count';
      open cur_donation(szDonorID, szChapterID);
      fetch cur_donation
       into nUnitCount, nCreditCount, nClaimedDons;
      if cur_donation%NOTFOUND then
         nUnitCount   := 0;
         nCreditCount := 0;
         nClaimedDons := 0;
      end if;
      if cur_donation%ISOPEN then
         close cur_donation;
      end if;

      if p_what = 'CREDIT' then
         nDonorCount := nCreditCount ;
      elsif p_what = 'GALLON' then
         nDonorCount := FLOOR((nCreditCount + nClaimedDons)/8);
      elsif p_what = 'UNIT' then
         nDonorCount := nUnitCount;
      end if;
      return nDonorCount;
      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Donors YTD donations credit count is calculated and returned.
*/
   FUNCTION donor_ytd_credit_count
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN NUMBER IS
   BEGIN
      return donor_ytd_count('CREDIT', szDonorID, szChapterID);
   END;


/*
** Donors YTD gallon count is calculated and returned.
*/
   FUNCTION donor_ytd_gallon_count
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN NUMBER IS
   BEGIN
      return donor_ytd_count('GALLON', szDonorID, szChapterID);
   END;


/*
** Donors lifetime donations unit count is calculated and returned.
*/
   FUNCTION donor_ytd_unit_count
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN NUMBER IS
   BEGIN
      return donor_ytd_count('UNIT', szDonorID, szChapterID);
   END;


/*
** Donors YTD donations credit count for a specified procedure
** code is calculated and returned.
*/
   FUNCTION donor_ytd_proc_count
            (szDonorID  IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type,
             szProcCode IN valid_proc_codes.procedure_code%type)
             RETURN NUMBER IS

      UNIT_NAME         varchar2(32)   := null;
      szErrorMsg        varchar2(500)  := null;
      szdonor           varchar2(10);
      nCreditCount      NUMBER;

      cursor cur_proc_donation (p_donor_id varchar2,
                                p_chapter_id varchar2,
                                p_proc_code varchar2) is
             select donor_id,
                    sum(donations.credit_count)
               from donations
              where donor_id       = p_donor_id
                and --  chapter_id     = p_chapter_id     --  IM5237
                DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and coll_date between trunc(sysdate, 'YYYY')
                                  and trunc(sysdate)
                and unit_id    is not null
                and procedure_code = p_proc_code
              group by donor_id;

   BEGIN
      UNIT_NAME  := 'donor_ytd_proc_count';
      open cur_proc_donation(szDonorID, szChapterID, szProcCode);
      fetch cur_proc_donation
       into szdonor, nCreditCount;
      if cur_proc_donation%NOTFOUND then
         nCreditCount := 0;
      end if;
      if cur_proc_donation%ISOPEN then
         close cur_proc_donation;
      end if;

      return nCreditCount;
      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Total RETURN NUMBER of donations attempts is returned, this excludes
** successful donations.
*/
   FUNCTION donations_attempted
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN NUMBER IS

      UNIT_NAME            varchar2(32)   := null;
      szErrorMsg           varchar2(500)  := null;
      nAttemptCount        NUMBER;

      cursor cur_don_attempts (p_donor_id varchar2, p_chapter_id varchar2) is
             select count(*)
               from donations
              where donor_id   = p_donor_id
                and --chapter_id = p_chapter_id
                DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and unit_id is NULL;

   BEGIN
      UNIT_NAME  := 'donations_attempted';
      open cur_don_attempts(szDonorID, szChapterID);
      fetch cur_don_attempts
       into nAttemptCount;
      if cur_don_attempts%NOTFOUND then
         nAttemptCount   := 0;
      end if;
      if cur_don_attempts%ISOPEN then
         close cur_don_attempts;
      end if;

      return nAttemptCount;

      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Donor age is calculated as on SYSDATE and is returned in years
** and returns age in years (is fractional)
*/
   FUNCTION donor_age (szDonorID IN donors.donor_id%type,
                       szChapterID IN donors.chapter_id%type)
                       RETURN NUMBER IS

      UNIT_NAME       varchar2(32)   := null;
      szErrorMsg      varchar2(500)  := null;
      nDonorAge       NUMBER;

   BEGIN
      UNIT_NAME := 'donor_age';
      select /*+ index(donors donors_pk) */
             months_between(sysdate, date_of_birth) / 12
        into nDonorAge
        from donors
       where donor_id   = szDonorID
         and --chapter_id = szChapterID;      --IM5237
         DECODE(chapter_id,'ALL',szChapterID,chapter_id) = szChapterID;

      return round(nDonorAge, 2);

      -- exception handing
      exception
         when others then
            null;

   END;

/*
** Return 'TRUE' if current donor has donated at any fixed
** site at-least once, else 'FALSE' is returned.
*/
   FUNCTION fixed_site_donor
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN VARCHAR2 IS

      UNIT_NAME             varchar2(32)   := null;
      szErrorMsg            varchar2(500)  := null;
      szReturnValue         VARCHAR2(5);

      cursor cur_fixed_site is
             select count(drives.drive_id)
               from drives, donations
              where donations.donor_id = szDonorID
                and donations.unit_id  is not null
                and drives.drive_id    = donations.drive_id
                and drives.location_id in (select site_id
                                             from fixed_sites);

   BEGIN
      UNIT_NAME := 'fixed_site_donor';
      open cur_fixed_site;
      fetch cur_fixed_site
       into szReturnValue;
      if cur_fixed_site%NOTFOUND then
         szReturnValue := 0;
      end if;
      if cur_fixed_site%ISOPEN then
         close cur_fixed_site;
      end if;

      if szReturnValue > 0 then
         return 'TRUE';
      else
         return 'FALSE';
      end if;

      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Date of last successful donation is returned.
*/
   FUNCTION last_donation_date
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN DATE IS

      UNIT_NAME             varchar2(32)   := null;
      szErrorMsg            varchar2(500)  := null;
      szLastDonationDate    date;

   cursor cur_last_donation (p_donor_id varchar2, p_chapter_id varchar2) is
          select max(coll_date)
            from donations
           where donor_id    = p_donor_id
             and --chapter_id  = p_chapter_id       --  IM5237
             DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
             and unit_id is not null;

   BEGIN
      UNIT_NAME := 'last_donation_date';
      open cur_last_donation(szDonorID, szChapterID);
      fetch cur_last_donation
       into szLastDonationDate;
      if cur_last_donation%NOTFOUND then
         szLastDonationdate := NULL;
      end if;
      if cur_last_donation%ISOPEN then
         close cur_last_donation;
      end if;

      return szLastDonationDate;

      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Procedure code for last successful donation is returned.
*/
   FUNCTION last_donation_proc_code
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN VARCHAR2 IS

      UNIT_NAME       varchar2(32)   := null;
      szErrorMsg      varchar2(500)  := null;
      szProcedureCode varchar2(5);
      szLastCollDate  date := last_donation_date(szDonorID, szChapterID);

   cursor cur_last_donation (p_coll_date date) is
          select procedure_code
            from donations
           where donor_id    = szDonorID
             and -- chapter_id  = szChapterID       --  IM5237
             DECODE(chapter_id,'ALL',szChapterID,chapter_id) = szChapterID
             and coll_date   = p_coll_date;

   BEGIN
      UNIT_NAME  := 'last_donation_proc_code';
      open cur_last_donation(szLastCollDate);
      fetch cur_last_donation
       into szProcedurecode;
      if cur_last_donation%NOTFOUND then
         szProcedureCode := NULL;
      end if;
      if cur_last_donation%ISOPEN then
         close cur_last_donation;
      end if;

      return szProcedureCode;

      -- exception handing
      exception
         when others then
            null;

   END;


/*
** Unit ID of last successful donation is returned.
*/
   FUNCTION last_donation_unit_id
            (szDonorID IN donors.donor_id%type,
             szChapterID IN donors.chapter_id%type) RETURN VARCHAR2 IS

      UNIT_NAME       varchar2(32)   := null;
      szErrorMsg      varchar2(500)  := null;
      szLastUnitID    varchar2(15);
      szLastCollDate  date := last_donation_date(szDonorID, szChapterID);

      cursor cur_last_donation (p_donor_id varchar2,
                                p_chapter_id varchar2,
                                p_coll_date  date) is
             select unit_id
               from donations
              where donor_id    = p_donor_id
                and --chapter_id  = p_chapter_id      --  IM5237
                DECODE(chapter_id,'ALL',p_chapter_id,chapter_id) = p_chapter_id
                and coll_date   = p_coll_date;


   BEGIN
      UNIT_NAME  := 'last_donation_unit_id';
      open cur_last_donation(szDonorID, szChapterID, szLastCollDate);
      fetch cur_last_donation
       into szLastUnitID;
      if cur_last_donation%NOTFOUND then
         szLastUnitID := NULL;
      end if;
      if cur_last_donation%ISOPEN then
         close cur_last_donation;
      end if;

      return szLastUnitID;

      -- exception handing
      exception
         when others then
            null;

   END;


   /*
   ** Returns donor information based on first parameter
   ** NAME    -> last_name + ', ' + suffix + ', ' + first_name + ', ' +
   **            middle_initial
   ** DOB     -> date of birth in MM-DD-YYYY format but as a char string
   ** ABO     -> abo group with code and desc
   ** EMAIL   -> returns email if available
   ** GENDER  -> returns M for Male and F for Female
   ** SSN     -> returns social security no
   ** ADDR    -> Street Address + ' ' + city + ', ' + state + ' ' + zip
   ** HOME    -> formatted home number
   ** WORK    -> formatted work phone number
   ** HAREA   -> home phone area code
   ** WAREA   -> work phone area code
   ** CITY    -> formatted work phone number
   ** STATE   -> formatted work phone number
   ** ZIP     -> formatted work phone number
   **
   ** in the case of unknown value of p_what fixed char string 'NULL'
   ** is returned. This is a good check too. If this is displayed on the
   ** screen, check the parameter passed
   */
   FUNCTION donor_std_info (p_what      IN varchar2,
                            szDonorID   IN donors.donor_id%type,
                            szChapterID IN donors.chapter_id%type)
                            RETURN VARCHAR2 IS

      UNIT_NAME             varchar2(32)  := null;
      szErrorMsg            varchar2(500)  := null;
      szFirstName           varchar2(50)  := null;
      szMiddleName          varchar2(50)  := null;
      szLastName            varchar2(50)  := null;
      szLastNameSuffix      varchar2(50)  := null;
      szDateOfBirth         varchar2(25)  := null;
      szGender              varchar2(10)  := null;
      nSSN                  number        := 0;
      szABODesc             varchar2(50)  := null;
      szStreetName          varchar2(50)  := null;
      szSuiteApt            varchar2(50)  := null;
      szCity                varchar2(50)  := null;
      szState               varchar2(50)  := null;
      szZip                 varchar2(50)  := null;
      szCounty              varchar2(50)  := null;
      szEmail               varchar2(128) := null;
      szReturnValue         varchar2(250) := 'NULL';
      szHAreaCode           varchar2(10)  := null;
      szHPhoneNumber        varchar2(10)  := null;
      szWAreaCode           varchar2(10)  := null;
      szWPhoneNumber        varchar2(10)  := null;
      nDonorWeight          NUMBER        := NULL;
   szExtension        varchar2(10) := null;


   cursor cur_donor is
          select /*+ index(donors donors_pk) */
                 a.first_name, a.middle_name, a.last_name,
                 nvl(a.last_name_suffix, ''), a.gender, a.ssn,
                 to_char(a.date_of_birth, 'MM-DD-YYYY'),
                 b.description, a.donor_weight
            from donors a, valid_master_codes b
           where a.donor_id     = szDonorID
             and b.code_type    = 'ABO'
             and b.code         = nvl(a.blood_type, 'NONE')
             and -- a.chapter_id   = szChapterID          --  IM5237
             DECODE(chapter_id,'ALL',szChapterID,chapter_id) = szChapterID
             and sysdate  between b.eff_date
                              and nvl(b.term_date, sysdate+1);

   cursor donor_address is
          select /*+ index(valid_city_state valid_city_state_pk) */
                 a.street_name, a.suite_apt,
                 a.h_area_code, a.h_phone_no,
                 a.d_area_code, a.d_phone_no, a.extension,
                 a.email,
                 b.city, b.state, b.zip, b.county
            from donor_addresses a, valid_city_state b
           where a.donor_id     = szDonorID
             and --a.chapter_id   = szChapterID         --  IM5237
             DECODE(chapter_id,'ALL',szChapterID,chapter_id) = szChapterID
             and a.address_type = 'RES'
             and b.usps_id      = a.usps_id
             and sysdate between b.eff_date
                             and nvl(b.term_date, sysdate+1);

   BEGIN
      UNIT_NAME  := 'don_std_info[' || p_what || ']';
      if p_what in ('NAME', 'ABO', 'GENDER', 'DOB', 'SSN', 'WEIGHT') then
         open cur_donor;
         fetch cur_donor
          into szFirstName,      szMiddleName, szLastName,
               szLastNameSuffix, szGender,     nSSN,
               szDateOfBirth,    szABODesc, nDonorWeight;
         if cur_donor%NOTFOUND then
            close cur_donor;
         end if;
         if cur_donor%isopen then
            close cur_donor;
         end if;
      elsif p_what in ('ADDR', 'HOME', 'WORK', 'EMAIL',
                       'CITY', 'STATE', 'ZIP', 'COUNTY',
                       'WAREA', 'HAREA') then
         open donor_address;
         fetch donor_address
          into szStreetName, szSuiteApt,
               szHAreaCode,  szHPhoneNumber,
               szWAreaCode,  szWPhoneNumber,
               szExtension,  szEmail,
               szCity, szState, szZip, szCounty;
         if donor_address%NOTFOUND then
            close donor_address;
         end if;
         if donor_address%isopen then
            close donor_address;
         end if;
      else
         szReturnValue := 'NULL';
         return szReturnValue;
      end if;
      if    p_what = 'NAME'   then
         -- return donor name
         szReturnValue := rtrim(szLastName);
         if szLastNameSuffix is not null then
            szReturnValue := szReturnValue || ' ' ||
                             rtrim(szLastNameSuffix);
         end if;
         szReturnValue := szReturnValue || ', ' ||
                          szfirstName   || ' ' ||
                          szMiddleName;
      elsif p_what = 'ABO'    then
         -- return donor abo
         szReturnValue := upper(substr(rtrim(szABODesc), 1, 6));
      elsif p_what = 'DOB'    then
         -- return donor date of birth
         szReturnValue := szDateOfBirth;
      elsif p_what = 'SSN'    then
         -- return donor ssn
         szReturnValue := to_char(nSSN);
      elsif p_what = 'WEIGHT'    then
         -- return donor weight
         szReturnValue := to_char(nDonorWeight);
      elsif p_what = 'GENDER' then
         -- return donor gender
         szReturnValue := szGender;
      elsif p_what = 'CITY' then
         -- return donor city
         szReturnValue := szCity;
      elsif p_what = 'STATE' then
         -- return donor State
         szReturnValue := szState;
      elsif p_what = 'ZIP' then
         -- return donor zip
         szReturnValue := szZip;
      elsif p_what = 'COUNTY' then
         -- return donor county
         szReturnValue := szCounty;
      elsif p_what = 'HAREA' then
         -- return donor home area code
         szReturnValue := szHAreaCode;
      elsif p_what = 'WAREA' then
         -- return donor work area code
         szReturnValue := szWAreaCode;
      elsif p_what = 'ADDR'   then
         -- return donor address
         szReturnValue := rtrim(szStreetName) || ' ' ||
                          rtrim(szSuiteApt)   || ' ' ||
                          szCity || ', ' || szState || ' ' || szZip;
      elsif p_what = 'HOME'   then
         -- return donor home number
         if szHPhoneNumber is not null and
            szHAreaCode is not null then
            szReturnValue := '(H)' || szHAreaCode || '-' ||
                                      substr(szHPhoneNumber, 1,3) || '-' ||
                                      substr(szHPhoneNumber, 4);
         else
            szReturnValue := 'Not Available';
         end if;
      elsif p_what = 'WORK'   then
         -- return donor work number
         if szWPhoneNumber is not null and
            szWAreaCode is not null then
            szReturnValue := '(B)' || szWAreaCode || '-' ||
                                      substr(szWPhoneNumber, 1,3) || '-' ||
                                      substr(szWPhoneNumber, 4);
            if szExtension is not null then
               szReturnValue := szReturnValue || ' #' || szExtension;
            end if;
         else
            szReturnValue := 'Not Available';
         end if;
      elsif p_what = 'EMAIL'  then
         -- return donor email adderess
         szReturnValue := rtrim(szEmail);
      else
         -- return NULL
         szReturnValue := 'NULL';
      end if;

      return szReturnValue;

      -- exception handing
      exception
         when others then
            null;

   END;


