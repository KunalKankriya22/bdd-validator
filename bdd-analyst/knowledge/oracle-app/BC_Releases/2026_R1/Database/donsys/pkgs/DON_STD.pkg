PRAGMA RESTRICT_REFERENCES (donor_zip, WNDS, WNPS);
PRAGMA RESTRICT_REFERENCES (donor_name, WNDS, WNPS);
PRAGMA RESTRICT_REFERENCES (donor_address, WNDS, WNPS);
PRAGMA RESTRICT_REFERENCES (donor_email, WNDS, WNPS);
