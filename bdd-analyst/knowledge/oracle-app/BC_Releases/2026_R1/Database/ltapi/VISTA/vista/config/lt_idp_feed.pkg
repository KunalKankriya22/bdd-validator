   connect util/util@tdon3
   drop public synonym vis_donation;
   drop public synonym vis_donor;
   create public synonym vis_donor for vista.vis_donor;
   create public synonym vis_donation for vista.vis_donation;
   grant select, insert, update, delete on vis_donor to lt_donor, ops$donsys;
   grant select, insert, update, delete on vis_donation to lt_donor, ops$donsys;

   connect ops$donsys/donsys@tdon3
   start u:\data_architecture\idp\lt_idp_feed.sql
   select lt_idp_feed.build_vista_donors('donor_DN0000982.DNR','WAD', null, 'ASTERISK') from dual;
   execute lt_idp_feed.load_vista_donation('vista_FC80125.PRO', 'ASTERISK');
*/

