         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.observ_code9 := SUBSTR(v_line, v_start, v_end);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 89
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.observ_code10 := SUBSTR(v_line, v_start, v_end);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 90
