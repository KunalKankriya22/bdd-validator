CREATE OR REPLACE PACKAGE lt_idp_feed IS
--------------------------------------------------------------------------
-- Package to build the extracts needed for converting LifeTrak data
-- into the format used to populate HCLL through DPU, version 2.0
--------------------------------------------------------------------------
   PROCEDURE LOG_ERROR(p_trans_id in varchar2,
                       p_msg_type in varchar2,
					   p_status in varchar2,
                       p_err_txt in varchar2);

   FUNCTION build_vista_donors(p_txn_id VARCHAR2
                               , p_chapter_id VARCHAR2 DEFAULT 'WAD'
                               , p_file VARCHAR2 DEFAULT NULL
                               , p_delim VARCHAR2 DEFAULT 'PIPE'
                               , p_char_mark VARCHAR2 DEFAULT 'NONE')
            RETURN VARCHAR2;

   PROCEDURE process_vista_donors(p_delim VARCHAR2 DEFAULT 'PIPE'
                               , p_char_mark VARCHAR2 DEFAULT 'NONE');

   PROCEDURE load_vista_donation(p_file VARCHAR2 DEFAULT NULL
                               , p_delim VARCHAR2 DEFAULT 'PIPE'
                               , p_char_mark VARCHAR2 DEFAULT 'NONE'
							   ,pTrans out VARCHAR2
							   ,pUnitID out VARCHAR2);

   PROCEDURE process_vista_donation(p_txn_id VARCHAR2
                                    ,p_unit_id VARCHAR2
                                   , pl_chapter_id VARCHAR2 DEFAULT 'WAD');

   PROCEDURE populate_idp_target_change(P_TARGET_ID     VARCHAR2,
                                           P_TARGET_TABLE  VARCHAR2,
                                           P_TARGET_FIELD  VARCHAR2,
                                           P_TARGET_VALUE  VARCHAR2,
                                           P_TARGET_CHANGE_DATE DATE);



END lt_idp_feed;
/

CREATE OR REPLACE PACKAGE BODY lt_idp_feed IS
--------------------------------------------------------------------------
/* -- Package to build the extracts needed for converting LifeTrak data
    -- into the format used to populate HCLL through DPU, version 2.0
    --Modified by Edwin 06/03/2010
    --Ver: 02  (added the INFOR in the list)
    --Ver: 03  (Added time zone and multip chapter  Edwin LT 2012
    --Ver: 04  IM: 10288 (Remove the hard coded WAD chapter and change from HOLD to HOLDS) - 12/03/14

    -- *******LT 2018 Implemenation resetting the version counter *********---

   Ver: 01  Edwin 12/14/17
   Ver: 02  Edwin 11/11/2020, MLT-3796
   Ver: 03  Edwin 11/23/2020 , MLT-3829
-------------------------------------------------------------------------------------------------

*/



   gv_loc   VARCHAR2(40) := '/u01/extracts';  -- default location for output files
   gv_chapter_id   VARCHAR2(10) := 'WAD';  -- default chapter_id


         --Procedure to populate the error log table
   PROCEDURE LOG_ERROR(p_trans_id in varchar2,
                       p_msg_type in varchar2,
					   p_status in varchar2,
                       p_err_txt in varchar2)
   is

      Begin
	   -- Rollback the exixting transactions and insert the error record

	   If p_status is not null then
	     update online_status set IDP_PROC_STATUS=p_status where transaction_id=p_trans_id;
	   End If;

       INSERT INTO IDP_IERROR_LOG(TRANSACTION_ID,MESSAGE_TYPE,STATUS,ERROR_TEXT,INSERT_USER,INSERT_DATE)
       VALUES (p_trans_id,p_msg_type,p_status,p_err_txt,'DONSYS',sysdate);

      Exception when others then
         dbms_output.put_line('Failure: error log'||sqlerrm);
         RAISE_APPLICATION_ERROR(-20010, 'Unable to Insert into error log file.-'||sqlerrm);
   End LOG_ERROR;

   PROCEDURE populate_idp_target_change(P_TARGET_ID     VARCHAR2,
                                           P_TARGET_TABLE  VARCHAR2,
                                           P_TARGET_FIELD  VARCHAR2,
                                           P_TARGET_VALUE  VARCHAR2,
                                           P_TARGET_CHANGE_DATE DATE)
      Is
	  Begin

             INSERT into IDP_TARGET_CHANGE(TARGET_CHANGE_ID,TARGET_SYSTEM,
                                           TARGET_ID,TARGET_TABLE,TARGET_FIELD,
                                           TARGET_VALUE,TARGET_CHANGE_DATE)
			 VALUES (vista_seq.nextval,'LifeTrak',P_TARGET_ID,P_TARGET_TABLE,
                                 P_TARGET_FIELD,P_TARGET_VALUE,P_TARGET_CHANGE_DATE);
      EXCEPTION when others then
            dbms_output.put_line('Failure: IDP TARGET:'||sqlerrm);
			LOG_ERROR(P_TARGET_ID,'ERR','ER',sqlerrm);
            RAISE_APPLICATION_ERROR(-20015, 'Unable to Insert into IDP_TARGET_CHANGE.-'||sqlerrm);
      END populate_idp_target_change;



   FUNCTION build_vista_donors(p_txn_id VARCHAR2
                               , p_chapter_id VARCHAR2 DEFAULT 'WAD'
                               , p_file VARCHAR2 DEFAULT NULL
                               , p_delim VARCHAR2 DEFAULT 'PIPE'
                               , p_char_mark VARCHAR2 DEFAULT 'NONE')
            RETURN VARCHAR2
   IS
      file_id        UTL_FILE.FILE_TYPE;
      v_dir          VARCHAR2(60); -- := '/tmp';
      v_file         VARCHAR2(40);
      v_line         VARCHAR2(1023);
      v_delim        VARCHAR2(3) := ',';    -- character used to separate fields
      v_cm           VARCHAR2(3) := '"';   -- character used to demark a string
      v_recd_ct      NUMBER := 0;
      v_ct           NUMBER := 0;
      CURSOR cr IS
         SELECT * FROM vista_donor
            where donation_id = p_txn_id
			  AND STATUS = 'W';
   BEGIN
      IF UPPER(p_delim) = 'COMMA' THEN
         v_delim := ',';
      ELSIF UPPER(p_delim) = 'TAB' THEN
         v_delim := '/t';
      ELSIF UPPER(p_delim) = 'TILDE' THEN
         v_delim := '~';
      ELSIF UPPER(p_delim) = 'ASTERISK' THEN
         v_delim := '*';
      ELSIF UPPER(p_delim) = 'PIPE' THEN
         v_delim := '|';
      ELSE
         v_delim := p_delim;
      END IF;
      IF UPPER(p_char_mark) = 'DOUBLE' THEN
         v_cm := '"';
      ELSIF UPPER(p_char_mark) = 'SINGLE' THEN
         v_cm := '''';
      ELSIF UPPER(p_char_mark) = 'NONE' THEN
         v_cm := '';
      ELSE
         v_cm := p_char_mark;
      END IF;

      IF p_file IS NOT NULL THEN
         v_file := p_file;
      ELSE
--         SELECT value INTO v_dir FROM sys.v$parameter where name = 'utl_file_dir';
         v_file := 'donor_'||LOWER(p_txn_id)||TO_CHAR(sysdate,'SSSSS')||'.DNR';
      END IF;

	  begin
	  	  select description into v_dir from valid_master_codes where code_type='IDPDR' and
	      code ='IDPPR' and sysdate between eff_date and nvl(term_date,sysdate+1);
	  exception when others then
	   v_dir:='/tmp';
	  end;


      file_id := utl_file.fopen(v_dir, v_file, 'w' );
      FOR rr IN cr LOOP
         v_recd_ct := v_recd_ct + 1;
         v_line := v_cm||rr.donation_id||v_cm||v_delim
                   ||v_cm||rr.donor_id||v_cm||v_delim
                   ||v_cm||rr.last_name||v_cm||v_delim
                   ||v_cm||rr.spouse_name||v_cm||v_delim
                   ||v_cm||rr.first_name||v_cm||v_delim
                   ||v_cm||rr.middle_name||v_cm||v_delim
                   ||v_cm||rr.location_code||v_cm||v_delim
                   ||v_cm||rr.unit_id||v_cm||v_delim
                   ||v_cm||rr.donation_type||v_cm||v_delim
                   ||v_cm||rr.procedure_code||v_cm||v_delim
                   ||v_cm||TO_CHAR(rr.visit_date, 'MM/DD/YYYY')||v_cm||v_delim
                   ||v_cm||rr.visit_time||v_cm||v_delim
                   ||v_cm||rr.gender||v_cm||v_delim
                   ||v_cm||rr.blood_type||v_cm||v_delim
                   ||v_cm||rr.platelet_count||v_cm||v_delim
                   ||v_cm||rr.cmv||v_cm||v_delim
                   ||v_cm||rr.hla||v_cm||v_delim
                   ||v_cm||rr.hematocrit||v_cm||v_delim
                   ||v_cm||rr.hemoglobin||v_cm||v_delim
                   ||v_cm||rr.cuso4||v_cm||v_delim
                   ||v_cm||rr.height||v_cm||v_delim
                   ||v_cm||rr.weight||v_cm||v_delim
                   ||v_cm||rr.platelet_eligible||v_cm||v_delim
                   ||v_cm||rr.plasma_eligible||v_cm||v_delim
                   ||v_cm||rr.rbc_eligible||v_cm||v_delim
                   ||v_cm||rr.whole_blood_eligible||v_cm||v_delim
                   ||v_cm||rr.national_id||v_cm||v_delim
                   ||v_cm||rr.ethnic_origin||v_cm||v_delim
                   ||v_cm||TO_CHAR(rr.date_of_birth, 'MM/DD/YYYY')||v_cm||v_delim
                   ||v_cm||rr.address1||v_cm||v_delim
                   ||v_cm||rr.address2||v_cm||v_delim
                   ||v_cm||rr.city||v_cm||v_delim
                   ||v_cm||rr.donor_state||v_cm||v_delim
                   ||v_cm||rr.postal_code||v_cm||v_delim
                   ||v_cm||rr.email||v_cm||v_delim
                   ||v_cm||rr.day_phone||v_cm||v_delim
                   ||v_cm||rr.night_phone||v_cm||v_delim
                   ||v_cm||rr.temperature||v_cm||v_delim
                   ||v_cm||rr.bp_systolic||v_cm||v_delim
                   ||v_cm||rr.bp_diastolic||v_cm||v_delim
                   ||v_cm||rr.pulse||v_cm||v_delim
                   ;
         utl_file.put_line(file_id, v_line);
      END LOOP;
      utl_file.fclose(file_id);

      RETURN 'build_vista_donors succeeded: '||to_char(v_recd_ct)||' records processed.';
   EXCEPTION
      WHEN NO_DATA_FOUND THEN
         utl_file.fclose(file_id);
         RETURN sqlerrm;
      WHEN utl_file.INVALID_PATH THEN
         RAISE_APPLICATION_ERROR(-20010,'Error in obtaining file path for '||v_file);
         return 'Failure 1';
      WHEN utl_file.INVALID_OPERATION THEN
         RAISE_APPLICATION_ERROR(-20010, 'Error in opening the file requested in '||v_file);
         return 'Failure 2';
      WHEN utl_file.READ_ERROR THEN
         RAISE_APPLICATION_ERROR(-20010, 'Error in reading a file '||v_file);
         return 'Failure 3';
      WHEN utl_file.WRITE_ERROR THEN
         RAISE_APPLICATION_ERROR(-20010, 'Error in writing to the file '||v_file);
         return 'Failure 4';
      WHEN utl_file.INTERNAL_ERROR THEN
         RAISE_APPLICATION_ERROR(-20010, 'Unspecified Internal Error in Util_File usage.');
         return 'Failure 5';
      WHEN utl_file.INVALID_MODE THEN
         RAISE_APPLICATION_ERROR(-20010, 'Invalid string for Util_File usages.');
         return 'Failure 6';
      WHEN OTHERS THEN
         RAISE_APPLICATION_ERROR(-20010, 'Undefined Error occurred while building file: '||SQLERRM);
         utl_file.fclose(file_id);
         return 'Failure 7';

   END build_vista_donors;

   PROCEDURE process_vista_donors(p_delim VARCHAR2 DEFAULT 'PIPE'
                               , p_char_mark VARCHAR2 DEFAULT 'NONE')
   IS
       CURSOR c_pending IS
	      select donation_id from vista_donor
		   WHERE status = 'P';
       TYPE don_id_tabtype IS
	      TABLE OF vista_donor.donation_id%TYPE
		  INDEX BY BINARY_INTEGER;
	   don_id_tab  don_id_tabtype;
	   row_nbr     BINARY_INTEGER := 0;
       v_result    VARCHAR2(200);
       v_sts       VARCHAR2(2);
   BEGIN
      FOR rp IN c_pending LOOP
	     row_nbr := row_nbr + 1;
		 don_id_tab(row_nbr) := rp.donation_id;
	  END LOOP;

      -- SET RECORDS TO WORKING STATUS TO AVOID OVERRUNS
	  FOR i IN 1 .. row_nbr LOOP
         UPDATE ONLINE_STATUS
		    SET idp_proc_status = 'W'
		  WHERE transaction_id = don_id_tab(i);
	  END LOOP;
      COMMIT;

	  FOR i IN 1 .. row_nbr LOOP
         v_result := build_vista_donors(don_id_tab(i), gv_chapter_id, null, p_delim, p_char_mark);
         IF INSTR(UPPER(v_result), 'ERROR') > 0 THEN
            v_sts := 'E';
		 ELSE
            v_sts := 'S';
		 END IF;
         UPDATE ONLINE_STATUS
		    SET idp_proc_status = v_sts
                , idp_proc_status_dats = sysdate
		  WHERE transaction_id = don_id_tab(i);
         COMMIT;
	  END LOOP;
   END process_vista_donors;

   PROCEDURE load_vista_donation(p_file VARCHAR2 DEFAULT NULL
                                 , p_delim VARCHAR2 DEFAULT 'PIPE'
                                 , p_char_mark VARCHAR2 DEFAULT 'NONE'
								 ,pTrans out VARCHAR2
								 ,pUnitID out VARCHAR2)
   IS
      file_id        UTL_FILE.FILE_TYPE;
      v_dir          VARCHAR2(60); -- := '/tmp';
      v_file         VARCHAR2(40);
      v_line         VARCHAR2(1023);
      v_delim        VARCHAR2(3) := ',';    -- character used to separate fields
      v_cm           VARCHAR2(3) := '"';   -- character used to demark a string
      v_ct           NUMBER := 0;
      v_recd_ct      NUMBER := 0;
      v_currdate     DATE := sysdate;

      v_vis_recd     vis_donation%ROWTYPE;
      v_start        NUMBER := 1;
      v_end          NUMBER;
   BEGIN
      IF UPPER(p_delim) = 'COMMA' THEN
         v_delim := ',';
      ELSIF UPPER(p_delim) = 'TAB' THEN
         v_delim := '/t';
      ELSIF UPPER(p_delim) = 'TILDE' THEN
         v_delim := '~';
      ELSIF UPPER(p_delim) = 'ASTERISK' THEN
         v_delim := '*';
      ELSIF UPPER(p_delim) = 'PIPE' THEN
         v_delim := '|';
      ELSE
         v_delim := p_delim;
      END IF;
      IF UPPER(p_char_mark) = 'DOUBLE' THEN
         v_cm := '"';
      ELSIF UPPER(p_char_mark) = 'SINGLE' THEN
         v_cm := '''';
      ELSIF UPPER(p_char_mark) = 'NONE' THEN
         v_cm := '';
      ELSE
         v_cm := p_char_mark;
      END IF;

      v_file := p_file;

	  --get the directory name
	  begin
	    select description into v_dir from valid_master_codes where code_type='IDPDR' and
		code='IDPPR' and sysdate between eff_date and nvl(term_date,sysdate+1);
	  exception when others then
          lt_idp_feed.LOG_ERROR('NA','ERR',null,'Log directory was not defined');
  		  commit;
		  return;
	  end;

      file_id := utl_file.fopen(v_dir, v_file, 'r');
     LOOP
         utl_file.get_line(file_id, v_line);

         v_ct := 0;               -- FIELD 1
         v_start := 1;
         v_end := INSTR(v_line, v_delim,1) - 1;
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.transaction_id := SUBSTR(v_line, v_start, v_end);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 2
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.is_solicited_flag := SUBSTR(v_line, v_start, 1);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 3
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.unit_number := SUBSTR(v_line, v_start, v_end);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 4
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.donor_id := SUBSTR(v_line, v_start, v_end);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 5
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.visit_date := TO_DATE(SUBSTR(v_line, v_start, v_end), 'MM/DD/YYYY');
         END IF;

         dbms_output.put_line('Edwin 1');

         v_ct := v_ct + 1;        -- FIELD 6
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.location_code := SUBSTR(v_line, v_start, v_end);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 7
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.donor_rejected := SUBSTR(v_line, v_start, v_end);
         END IF;

         v_ct := v_ct + 1;        -- FIELD 8
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.donor_height := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

         v_ct := v_ct + 1;        -- FIELD 9
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.donor_weight := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

         v_ct := v_ct + 1;        -- FIELD 10
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.donor_tbv := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		          dbms_output.put_line('Edwin 2');

         v_ct := v_ct + 1;        -- FIELD 11
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.pre_hematocrit := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		 		          dbms_output.put_line('Edwin 2a');

         v_ct := v_ct + 1;        -- FIELD 12
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.pre_hemoglobin := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		 		          dbms_output.put_line('Edwin 2b');

         v_ct := v_ct + 1;        -- FIELD 13
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.pre_platelet := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		 		          dbms_output.put_line('Edwin 2c');

         v_ct := v_ct + 1;        -- FIELD 14
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.pre_bp_systolic := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		 		          dbms_output.put_line('Edwin 2d');

         v_ct := v_ct + 1;        -- FIELD 15
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.pre_bp_diastolic := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		   dbms_output.put_line('Edwin 2e');

         v_ct := v_ct + 1;        -- FIELD 16
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.pre_temperature := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		   dbms_output.put_line('Edwin 2f');

         v_ct := v_ct + 1;        -- FIELD 17
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);

         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.pre_pulse := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

		 dbms_output.put_line('Data='||substr(v_line,v_start,v_end));

         v_ct := v_ct + 1;        -- FIELD 18
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.procedure_code:= SUBSTR(v_line, v_start, v_end);
         END IF;

		   dbms_output.put_line('Edwin 2h');

         v_ct := v_ct + 1;        -- FIELD 19
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.platelet_prod_code := SUBSTR(v_line, v_start, v_end);
         END IF;

		          dbms_output.put_line('Edwin 3');

         v_ct := v_ct + 1;        -- FIELD 20
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.platelet_yield := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
         END IF;

         v_ct := v_ct + 1;        -- FIELD 21
         v_start := INSTR(v_line, v_delim, 1, v_ct) + 1;
         v_end := (INSTR(v_line, v_delim,1, (v_ct + 1)) - 1)- INSTR(v_line, v_delim, 1, v_ct);
         IF SUBSTR(v_line, v_start, 1) <> v_delim THEN
            v_vis_recd.platelet_bag_vol := TO_NUMBER(SUBSTR(v_line, v_start, v_end));
