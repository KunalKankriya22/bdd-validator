      --Get vista physical findings for Pre-procedure Hematocrit

	  --Check for Hemotocrit
	   dbms_output.put_line('Step 8');

        --- Added as part of MLT 3829

       --- Get the paramerter 
       
        select nvl(count(*),0) into nPFCount from valid_parameters
        where parameter_code='VPFRECHK' and parameter_value='Y' and 
        g_local_time between eff_date and nvl(term_date, g_local_time+10);
 
    IF nPFCount > 0 then 

	  BEGIN

         Begin
            Select parameter_value into p_vista_hemat from valid_parameters where
            parameter_code='VHEMAT' and sysdate between eff_date and nvl(term_date,sysdate+1);
	     Exception when others then
             p_msg:='HEMATOCRIT was not defined in the SYSPARM table '||sqlerrm;
		     ROLLBACK;
             LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
             raise appl_excp;
         End;

         begin

           IS_PHY_ACCEPT(p_vista_hemat,v_recd.pre_hematocrit,szOridon,v_recd.procedure_code,g_donor_gender,
                         p_phy_inter,p_phy_status);
	     exception when others then
	       null;
	     end;

	   If p_phy_status!='OK' then
	      ROLLBACK;
              LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_phy_status);
              raise appl_excp;
          End if;

         If p_phy_inter is not null then
     			PLACE_INTER_ATTRIB(p_chapter_id,
	                           v_recd.donor_id,
	                           v_recd.transaction_id,
				   v_recd.unit_number,
				   p_vista_hemat,
				   v_recd.pre_hematocrit,
                                   null,
				  'INTER',
                                  p_phy_inter,      --This will be like NODON, 102D (Inter codes) or 02(Veni code), MI (for reaction code)
				  szCollDate,
				  p_status);

				 If p_status!='OK' then
				     ROLLBACK;
                                    LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_status);
                                   raise appl_excp;
  	                        End if;
        End if;
      /*EXCEPTION when others then
           p_msg:='Problem in placing the HEMATOCRIT related interdiction '||sqlerrm;
		   ROLLBACK;
           LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
           raise appl_excp;
		   */
      END;

      --Get vista physical findings for Pre-procedure Hemoglobin
	   dbms_output.put_line('Step 9');

	  BEGIN

         Begin
           Select parameter_value into p_vista_hemog from valid_parameters where
           parameter_code='VHEMOG' and sysdate between eff_date and nvl(term_date,sysdate+1);
        Exception when others then
           p_msg:='HEMOGLOBIN was not defined in the SYSPARM table '||sqlerrm;
		   ROLLBACK;
           LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
           raise appl_excp;
         End;


  	   begin
         IS_PHY_ACCEPT(p_vista_hemog,v_recd.pre_hemoglobin,szOridon,v_recd.procedure_code,g_donor_gender,
                       p_phy_inter,p_phy_status);
	   exception when others then
	    null;
	   end;
        dbms_output.put_line('Step 10-'||p_phy_status);
		
	   If p_phy_status!='OK' then
	      ROLLBACK;
          LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_phy_status);
          raise appl_excp;
       End if;
       If p_phy_inter is not null then
             	PLACE_INTER_ATTRIB(p_chapter_id,
	                               v_recd.donor_id,
	                               v_recd.transaction_id,
				       v_recd.unit_number,
				       p_vista_hemog,
				       v_recd.pre_hemoglobin,
                                       null,
				      'INTER',
                                      p_phy_inter,
				      szCollDate,
				     p_status);

                  If p_status!='OK' then
                     LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_status);
                     raise appl_excp;
                  End if;
       End If;

    /*  EXCEPTION when others then
           p_msg:='Problem in placing the HEMOGLOBIN related interdiction '||sqlerrm;
		   ROLLBACK;
           LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
           raise appl_excp;
	*/
      END;

	   dbms_output.put_line('Step 11');
      --Get vista physical findings for Pre-platelet count
	  BEGIN
         Begin
              Select parameter_value into p_vista_platelet from valid_parameters where
              parameter_code='VPLATE' and sysdate between eff_date and nvl(term_date,sysdate+1);
		 Exception when others then
             p_msg:='PLATELET was not defined in the SYSPARM table '||sqlerrm;
		     ROLLBACK;
             LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
             raise appl_excp;
		  End;

		 begin
           IS_PHY_ACCEPT(p_vista_platelet,v_recd.post_platelet,szOridon,v_recd.procedure_code,g_donor_gender,p_phy_inter,p_phy_status);
		 exception when others then
		   null;
		 end;

		 If p_phy_status!='OK' then
	       ROLLBACK;
           LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_phy_status);
           raise appl_excp;
        End if;

		 dbms_output.put_line('Step 12');
		 
         If p_phy_inter is not null then
             	PLACE_INTER_ATTRIB(p_chapter_id,
	                               v_recd.donor_id,
	                               v_recd.transaction_id,
				       v_recd.unit_number,
				       p_vista_platelet,
				       v_recd.post_platelet,
                                       null,
				       'INTER',
                                       p_phy_inter,
				       szCollDate,
				       p_status);

                  If p_status!='OK' then
				     ROLLBACK;
                     LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_status);
                     raise appl_excp;
                  End if;
          End if;

          --Update the physical findings table with the post platelet count value SCR# 2020 (3.3.0) release 
		  UPDATE DONATIONS set plt_post_count=v_recd.post_platelet where
		  transaction_id=v_recd.transaction_id;   
		  
		 dbms_output.put_line('Step 13');
      END;
    END IF;    ---- For nPFCount > 0 then 
	  
	  BEGIN
	     Begin
              Select parameter_value into p_vista_rbc from valid_parameters where
              parameter_code='VRBCRT' and sysdate between eff_date and nvl(term_date,sysdate+1);
		 Exception when others then
             p_msg:='RBC is not defined in the SYSPARM table for VRBC'||sqlerrm;
		     ROLLBACK;
             LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
             raise appl_excp;
		  End;

	     If nvl(v_recd.rinseback_flag,'0')='1' then 
		    null;
		 Else
		    Begin
			   select inter_code into rbcInter from valid_physical_rules where
			   donation_type=szOridon and procedure_code=v_recd.procedure_code and
			   physical_code=p_vista_rbc and data_type='C' and item_value='NO' and
			   sysdate between eff_date and nvl(term_date,sysdate+1);
			Exception when others then 
			  p_msg:='No interdiction is defined for '||p_vista_rbc||'-'||sqlerrm;
		      ROLLBACK;
              LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
			  raise appl_excp;
			End;
			
			PLACE_INTER_ATTRIB(p_chapter_id,
	                               v_recd.donor_id,
	                               v_recd.transaction_id,
				       v_recd.unit_number,
				       p_vista_rbc,
				       'NORET',
                                       null,
				      'INTER',
                                      rbcInter,
				     szCollDate,
				     p_status);

                  If p_status!='OK' then
				     ROLLBACK;
                     LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_status);
                     raise appl_excp;
                  End if;
			End if;     
  END;  	   			     
   dbms_output.put_line('Step 14');					 
              
END IF;  -- If the donor is rejected (reject flag=0 ) 

IF v_recd.donor_rejected='1' or v_recd.incomplete_proc_flag='1' then

    dbms_output.put_line('Donor Rejected='||v_recd.donor_rejected);
    If v_recd.reason_code IS NOT NULL THEN
         --If the reason code is not null, then the donor is rejected for some reason
		 --get the LT equvalent value from the conversion table and apply the interdiction

		Begin
   		    SELECT *  INTO v_reject FROM idp_conv_ref_values
             WHERE UPPER(source_id) = 'VISTA' AND UPPER(target_id) = 'LFTRK'
             AND source_value = v_recd.reason_code AND  source_code_type = 'REASN' and
             sysdate between eff_date and nvl(term_date,sysdate+1);
 		Exception
	        WHEN NO_DATA_FOUND then
			      ROLLBACK;
                  LOG_ERROR(v_recd.transaction_id,'ERR','ER','Reason Code '||v_recd.reason_code||' is not defined in the Conversion table');
                  raise appl_excp;
            WHEN OTHERS THEN
			      ROLLBACK;
                  LOG_ERROR(v_recd.transaction_id,'ERR','ER','Loc-20: '||sqlerrm);
                  raise appl_excp;
        End;

		       place_inter_attrib (p_chapter_id,
	                                v_recd.donor_id ,
	                                v_recd.transaction_id,
					v_recd.unit_number,
					'VISTA',
					nvl(v_recd.reason_code,v_recd.aborted_run_code),
                                       null,
					v_reject.target_code_type,
                                         v_reject.target_value,
					szCollDate,
					p_status );

 			  If p_status!='OK' then
			     ROLLBACK;
                 LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_status);
                 raise appl_excp;
             End if;
     Else
            --If the reason code is null,
             Begin
               INSERT INTO donor_interdictions (donor_id,chapter_id,inter_code,eff_date,inter_type,program_id,
			   insert_date,insert_user,audit_key)
               VALUES(v_recd.donor_id,loc_chapter_id,'VHOLD',TRUNC(LIFETRACK_TIMEZONE_CONVERT.get_local_time(p_chapter_id,sysdate)),
                       'HOLDS','IDPVISTA',trunc(sysdate),'VISTA',
			   audit_seq.nextval);
             Exception WHEN  others then
                  p_msg:='Unable to create interdiction in the DONOR INTERDICTIONS table '||sqlerrm;
				  ROLLBACK;
                  LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
                  raise appl_excp;
             end;
     End If;

END IF; -- For donor reject flag statement

  -- IF everything is fine, Successfull upload.
  LOG_ERROR(v_recd.transaction_id,'MSG','C','Uploaded Successfully');

  update online_status set IDP_PROC_STATUS='C',status_flag='C',
  PHELOB_START= NVL(LIFETRACK_TIMEZONE_CONVERT.get_gmt_time(p_chapter_id,start_time_l1), LIFETRACK_TIMEZONE_CONVERT.get_gmt_time(p_chapter_id,start_time_r1)),
  PHELOB_END  = NVL(LIFETRACK_TIMEZONE_CONVERT.get_gmt_time(p_chapter_id,end_time_l), LIFETRACK_TIMEZONE_CONVERT.get_gmt_time(p_chapter_id,end_time_r))
 where transaction_id=v_recd.transaction_id;

  COMMIT;
EXCEPTION
 WHEN appl_excp THEN
       COMMIT; --THis commit is to commit the log file
  WHEN OTHERS THEN
      ROLLBACK;
      LOG_ERROR(v_recd.transaction_id,'ERR','ER',p_msg);
	  commit; --THis commit is to commit the log file
END process_vista_donation;

