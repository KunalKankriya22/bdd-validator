CREATE OR REPLACE PACKAGE INITEXTRACT IS
  procedure main_proc(inp_file_name in varchar2);
  procedure schedule_extracts(p_file_name in varchar2,p_schedule_time in date);

  LogDir    VARCHAR2(70);
  logfile                UTL_FILE.FILE_TYPE;
 instfile               UTL_FILE.FILE_TYPE;

end INITEXTRACT;
/

create or replace package body INITEXTRACT is


procedure main_proc(inp_file_name in varchar2) is
 start_time   VARCHAR2(30);
 end_time     VARCHAR2(30);
 
Begin
      dbms_output.enable(50000000);
      begin
           select code_desc into LogDir from master_codes
           where code_type='LOGDR' and code='EXTRT' and sysdate
	   between eff_date and nvl(term_date,sysdate);
      exception
           when utl_file.invalid_path then 
               dbms_output.put_line('Invalid path or filename');
	       raise;
           when others then 
           dbms_output.put_line('Error in prepare_log_filename');
	   raise;
       end;

      begin

           logfile:=UTL_FILE.fopen(LogDir,inp_file_name, 'w');
       exception
	  when utl_file.invalid_path then
	   dbms_output.put_line('Invalid path or filename'); raise;
        end;
	  UTL_FILE.fclose(logfile);
End main_proc;

Procedure schedule_extracts(p_file_name in varchar2,p_schedule_time in date) as
 A NUMBER:=0;
Begin

insert into rgt_schedule_extract(file_name,extract_date_time,status) values
                                (p_file_name,p_schedule_time,null);
commit;

End schedule_extracts;

END INITEXTRACT;
/
drop public synonym INITEXTRACT
/
create public synonym INITEXTRACT for INITEXTRACT
/
grant execute on INITEXTRACT to public 
/

