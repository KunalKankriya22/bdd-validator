CREATE OR REPLACE PACKAGE LT_USER_SESSION AS 
/****************************************************************************\
 * LT_USER_SESSION - Database functions used for set and get the Application 
 * Username.
 * The functions get_userid should not be called before setting the userid with
 * set_userid
 ***************************************************************************
 * Version 1.0
 ***************************************************************************
 * Change History
 *   Fatih Acikgoz 22/MAR/2011 - Creation
 *
 *  Arun Samuel    04/18/2011	v 2.0	Code modified to enable package to 
 *                                      return current user in case the
 *                                      user is not set explicitly.
   Basker Edwinb   04/11/2016 V 3.0 Added more global values settings
   
   Ashok           10/14/2016 v04   timeout settings added to user session package.
   
   Ashok           01/18/2017 V05   get_tzone_offset signature modified to return VARCHAR2
   
   Ashok           05/29/2023 V06   tout_exit methods added
 *
\*****************************************************************************/

 PROCEDURE set_userid(p_user_id             IN VARCHAR2);
 PROCEDURE set_chapter_id(p_chapter_id      IN VARCHAR2);
 PROCEDURE set_warehouse_id(p_warehouse_id  IN VARCHAR2);
 PROCEDURE set_tzone_flag(p_tzone_flag      IN VARCHAR2);
 PROCEDURE set_tzone_offset(p_tzone_offset  IN VARCHAR2);


  -- Setter methods for timeout.
 PROCEDURE set_toutIdle(p_toutIdle          IN NUMBER);
 PROCEDURE set_toutWarn(p_toutWarn          IN NUMBER);
 PROCEDURE set_toutHtml(p_toutHtml          IN VARCHAR2);

  
 FUNCTION  get_userid return VARCHAR2;
 FUNCTION  get_chapter_id return VARCHAR2;
 FUNCTION  get_warehouse_id return VARCHAR2; 
 FUNCTION  get_tzone_flag return VARCHAR2;
 FUNCTION  get_tzone_offset return VARCHAR2; -- V05

 -- getter methods for timeout;
 FUNCTION get_toutIdle RETURN NUMBER;
 FUNCTION get_toutWarn RETURN NUMBER;
 FUNCTION get_toutHtml RETURN VARCHAR2;
 
 -- tout Exit methods. -- V06
 PROCEDURE set_toutExitImmediate(p_toutExit IN BOOLEAN);
 FUNCTION toutExitImmediate RETURN BOOLEAN;

 --Package Variable keeps the Value during the complete Oracle Session
 gv_userid         VARCHAR2(30);
 gv_chapter_id     VARCHAR2(4);
 gv_warehouse_id   VARCHAR2(2);
 gv_tzone_flag     VARCHAR2(1);
 gv_tzone_offset   VARCHAR2(15);
 gv_exit_session    BOOLEAN;

END LT_USER_SESSION;
/


CREATE OR REPLACE PACKAGE BODY LT_USER_SESSION AS
  temp1             VARCHAR2(30);
  ln_toutIdle       NUMBER := 0; -- Timeout Idle time in minutes.
  ln_toutWarn       NUMBER := 0; -- Timeout Alert time in minutes.
  lv_toutHtml       VARCHAR2(500) := NULL; -- Timeout EXIT application notify URL
  lb_toutExit       BOOLEAN := FALSE; -- Timeout exit.

  PROCEDURE set_userid(p_user_id  in VARCHAR2) AS
   BEGIN
    gv_userid:=p_user_id;

   END set_userid;

  PROCEDURE set_chapter_id( p_chapter_id   in VARCHAR2)  AS
  BEGIN
   gv_chapter_id:=p_chapter_id;
  END set_chapter_id;

  PROCEDURE set_warehouse_id( p_warehouse_id   in VARCHAR2)  AS
   BEGIN
    gv_warehouse_id:=p_warehouse_id;
  END set_warehouse_id;

  PROCEDURE set_tzone_flag( p_tzone_flag   in VARCHAR2)  AS
   BEGIN
    gv_tzone_flag:=p_tzone_flag;
  END set_tzone_flag;

  PROCEDURE set_tzone_offset( p_tzone_offset  in VARCHAR2)  AS
   BEGIN
    gv_tzone_offset:=p_tzone_offset;
  END set_tzone_offset;


  PROCEDURE set_toutIdle(p_toutIdle IN NUMBER) AS
  BEGIN
    ln_toutIdle := p_toutIdle;
  END set_toutIdle;

  PROCEDURE set_toutWarn(p_toutWarn IN NUMBER) AS
  BEGIN
    ln_toutWarn := p_toutWarn;
  END set_toutWarn;
  
  PROCEDURE set_toutHtml(p_toutHtml IN VARCHAR2) AS
  BEGIN
    lv_toutHtml := p_toutHtml;
  END set_toutHtml;  
  
  PROCEDURE set_toutExitImmediate(p_toutExit IN BOOLEAN) AS
  BEGIN
    lb_toutExit := p_toutExit;
  END set_toutExitImmediate;
  
/* ---- Below are the get functions ------- */

  FUNCTION get_userid return VARCHAR2 AS
  BEGIN
  	/* Ver : 2.0 NVL clause added */
    RETURN NVL(gv_userid,USER);
  END get_userid;

  FUNCTION get_chapter_id return VARCHAR2 AS
  BEGIN
   RETURN NVL(gv_chapter_id,'WAD');
  END get_chapter_id;


  FUNCTION get_warehouse_id return VARCHAR2 AS
  BEGIN
   RETURN NVL(gv_warehouse_id,'H');
  END get_warehouse_id;

  FUNCTION get_tzone_flag return VARCHAR2 AS
  BEGIN
   RETURN NVL(gv_tzone_flag,'N');
  END get_tzone_flag;


 FUNCTION get_tzone_offset return VARCHAR2 AS -- V05
 BEGIN
   RETURN NVL(gv_tzone_offset,'+00:00');
 END get_tzone_offset;


  FUNCTION get_toutIdle RETURN NUMBER AS
  BEGIN
    RETURN ln_toutIdle;
  END get_toutIdle;

  FUNCTION get_toutWarn RETURN NUMBER AS
  BEGIN
    RETURN ln_toutWarn;
  END get_toutWarn;
  
  FUNCTION get_toutHtml RETURN VARCHAR2 AS
  BEGIN
    RETURN lv_toutHtml;
  END get_toutHtml;  
  
  FUNCTION toutExitImmediate RETURN BOOLEAN AS
  BEGIN
    RETURN lb_toutExit;
  END toutExitImmediate;
  

END LT_USER_SESSION;
/
