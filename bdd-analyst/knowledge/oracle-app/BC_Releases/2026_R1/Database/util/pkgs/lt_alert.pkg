create or replace PACKAGE LT_ALERT AS 
/****************************************************************************\
 * LT_ERROR - Database functions used for set and get the Application 
 * Username.
 * The functions get_userid should not be called before setting the userid with
 * set_userid
 ***************************************************************************
 * Version 1.0
 ***************************************************************************
 * Change History
 *   
 *
 *  Ashok V    04/18/2011	v 2.0	Code modified to enable package to 
 *                                      return current user in case the
 *                                      user is not set explicitly.
 *
\*****************************************************************************/

    
  TYPE payload_rt IS RECORD
   (
      title           VARCHAR2(500),
      message         VARCHAR2(2000),
      alert_style     VARCHAR2(200), -- Stop, Caution, Note
      button1_lbl     VARCHAR2(100),
      button2_lbl     VARCHAR2(100),
      button3_lbl     VARCHAR2(100),
      default_button  VARCHAR2(20) -- Button1, Button2, Button3
   ); 
   
   
   -- setter methods session variables.
   PROCEDURE init_buttons;
   PROCEDURE set_button1;
   PROCEDURE set_button2;
   PROCEDURE set_button3;
   
   -- getter methods for session variables.
   FUNCTION button1 RETURN BOOLEAN;
   FUNCTION button2 RETURN BOOLEAN;
   FUNCTION button3 RETURN BOOLEAN;
   FUNCTION payload RETURN payload_rt;
   
   
   PROCEDURE init_choice;
   PROCEDURE init_warn;
   PROCEDURE init_inform;
   PROCEDURE init_error;
   PROCEDURE init_alert( p_payload payload_rt);
   PROCEDURE init;
   PROCEDURE set_property(p_property IN VARCHAR2, p_value IN VARCHAR2);
   FUNCTION get_property(p_property IN VARCHAR2) RETURN VARCHAR2;
END LT_ALERT;
/

create or replace PACKAGE BODY LT_ALERT AS

  -- session variables to store button press event.
  lb_button1 BOOLEAN := FALSE;
  lb_button2 BOOLEAN := FALSE;
  lb_button3 BOOLEAN := FALSE;  
  al_payload payload_rt; -- Record to store alert properties.
 
/* ---- setter functions ------- */
  PROCEDURE init_buttons AS
  BEGIN
    lb_button1 := FALSE;
    lb_button2 := FALSE;
    lb_button3 := FALSE;
  END init_buttons;

  PROCEDURE set_button1 AS
   BEGIN
    init_buttons;
    lb_button1 := TRUE;
   END set_button1;

  PROCEDURE set_button2 AS
   BEGIN
    init_buttons;
    lb_button2 := TRUE;
   END set_button2;
   
  PROCEDURE set_button3 AS
   BEGIN
    init_buttons;
    lb_button3 := TRUE;
   END set_button3;
   
  
/* ---- getter functions ------- */

  FUNCTION button1 return BOOLEAN AS
  BEGIN
    RETURN lb_button1;
  END button1;

  FUNCTION button2 return BOOLEAN AS
  BEGIN
    RETURN lb_button2;
  END button2;
  
  FUNCTION button3 return BOOLEAN AS
  BEGIN
    RETURN lb_button3;
  END button3;

  FUNCTION payload return payload_rt AS
  BEGIN
    RETURN al_payload;
  END payload;
  
  -- Choice Alert
  PROCEDURE init_choice IS
  BEGIN
    init;
    al_payload.title          := 'Decision Message';
    al_payload.message        := NULL;
    al_payload.alert_style    := 'Stop';
    al_payload.button1_lbl    := 'OK';
    al_payload.button2_lbl    := 'Cancel';
    al_payload.button3_lbl    := NULL;
    al_payload.default_button := 'Button1';
  END init_choice;

  -- Warn Alert
  PROCEDURE init_warn IS
  BEGIN
    init;
    al_payload.title          := 'Warning';
    al_payload.message        := NULL;
    al_payload.alert_style    := 'Caution';
    al_payload.button1_lbl    := 'OK';
    al_payload.button2_lbl    := NULL;
    al_payload.button3_lbl    := NULL;
    al_payload.default_button := 'Button1';
  END init_warn;

  -- Inform Alert
  PROCEDURE init_inform IS
  BEGIN
    init;
    al_payload.title          := 'Message';
    al_payload.message        := NULL;
    al_payload.alert_style    := 'Note';
    al_payload.button1_lbl    := 'OK';
    al_payload.button2_lbl    := NULL;
    al_payload.button3_lbl    := NULL;
    al_payload.default_button := 'Button1';
  END init_inform;

  -- Error Alert
  PROCEDURE init_error IS
  BEGIN
    init;
    al_payload.title          := 'Error Message';
    al_payload.message        := NULL;
    al_payload.alert_style    := 'Stop';
    al_payload.button1_lbl    := 'OK';
    al_payload.button2_lbl    := NULL;
    al_payload.button3_lbl    := NULL;
    al_payload.default_button := 'Button1';
  END init_error;


  PROCEDURE init_alert( p_payload payload_rt) IS
  BEGIN
    init;
    al_payload := p_payload;
  END init_alert;



  -- Initialize alert payload to NULL;
  PROCEDURE init IS
  BEGIN
    al_payload.title          := NULL;
    al_payload.message        := NULL;
    al_payload.alert_style    := NULL;
    al_payload.button1_lbl    := NULL;
    al_payload.button2_lbl    := NULL;
    al_payload.button3_lbl    := NULL;
    al_payload.default_button := NULL;  
  END init;
  
  -- Assign value to property.
  PROCEDURE set_property(p_property IN VARCHAR2, p_value IN VARCHAR2) IS
  BEGIN
    IF p_property = 'TITLE' THEN
      al_payload.title := p_value;
    ELSIF p_property = 'MESSAGE' THEN
      al_payload.message := p_value;
    ELSIF p_property = 'ALERTY_STYLE' THEN
      al_payload.alert_style := p_value;
    ELSIF p_property = 'BUTTON1_LABEL' THEN
      al_payload.button1_lbl := p_value;
    ELSIF p_property = 'BUTTON2_LABEL' THEN    
      al_payload.button2_lbl := p_value;
    ELSIF p_property = 'BUTTON3_LABEL' THEN
      al_payload.button3_lbl := p_value;
    ELSIF p_property = 'DEFAULT_BUTTON' THEN
      al_payload.default_button := p_value;
    END IF;
  END set_property;
  
  -- To retrieve the value for a property;
  FUNCTION get_property(p_property IN VARCHAR2) RETURN VARCHAR2 IS
    l_return VARCHAR2(2000);
  BEGIN
    IF p_property = 'TITLE' THEN
      l_return := NVL(al_payload.title,'Message');
    ELSIF p_property = 'MESSAGE' THEN
      l_return := al_payload.message;
    ELSIF p_property = 'ALERT_STYLE' THEN
      l_return := al_payload.alert_style;
    ELSIF p_property = 'BUTTON1_LABEL' THEN
      l_return := al_payload.button1_lbl;
    ELSIF p_property = 'BUTTON2_LABEL' THEN    
      l_return := al_payload.button2_lbl;
    ELSIF p_property = 'BUTTON3_LABEL' THEN
      l_return := al_payload.button3_lbl;
    ELSIF p_property = 'DEFAULT_BUTTON' THEN
      l_return := al_payload.default_button;
    END IF;  
    
    RETURN l_return;
  END get_property;  

 /* 
    al_payload.title          :=
    al_payload.message        :=
    al_payload.alert_style    :=
    al_payload.button1_lbl    :=
    al_payload.button2_lbl    :=
    al_payload.button3_lbl    :=
    al_payload.default_button := 
 
 */
 
 /*
  lt_alert.init_inform;
  lt_alert.init_choice;
  lt_alert.init_warn;
  lt_alert.init_error;
 */
 
  /*
  lt_alert.init_error;
  lt_alert.set_property('MESSAGE', 'TEXT');
  call_form('error'); -- set session variables.
  -- in the button - set lt_alert.set_button1 OR set_button2 or set_button3
  IF lt_alert.button1 THEN
    --handle error;
    NULL;
  END IF;
  
  ----------------------
  
  al_id := Find_Alert('Error_Alert'); 
  Set_Alert_Property(al_id, alert_message_text,text||add_msg ); 
  al_button := Show_Alert( al_id ); 
  */ 
END LT_ALERT;
/

Create or replace public synonym lt_alert for lt_alert;

Grant execute on lt_alert to lt_donor,util,ops$vista,ltapi;
 
