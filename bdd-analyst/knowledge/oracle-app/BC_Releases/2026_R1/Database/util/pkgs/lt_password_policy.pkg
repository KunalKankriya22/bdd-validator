                             pwd_in IN VARCHAR2, 
                             status_out OUT VARCHAR2);
END lt_password_policy;
/


CREATE OR REPLACE PACKAGE BODY lt_password_policy

 AS

  /*********************************************************************************
  Description   : This package contain routines for checking strong password
                          policy requirements related to Lifetrack Applications.

  Created by    : Hussein Abbas

  Created on    : March 25, 2011

  Version             : 1.0 (Initial)
  Version             : 2.0 Modifed by Hussein on 08-12-11; added code to check for
                          excluded special characters.
  Version             : 3.0  check_password_history routine modified.
  Version                 : 4.0  created another function called DOTNET_SAVE_HASH - Edwin 011619
  **********************************************************************************/

  lc_SUCCESS VARCHAR2(10) := 'SUCCESS';
  lc_FAIL    VARCHAR2(10) := 'FAIL';

  Procedure LOG_LOGIN_EVENT(APP_USER     IN VARCHAR2,
                            NEW_PASSWORD IN VARCHAR2,
                            WORK_STATION IN VARCHAR2,
                            AUDIT_EVENT  IN VARCHAR2);
  ------------------
  PROCEDURE check_strong_password(user_password in varchar2,
                                  ERROR_CODE    OUT VARCHAR2,
                                  MSG           OUT VARCHAR2) IS
    i             number;
    chr           varchar2(1) := '';
    num_count     number := 0;
    caps_count    number := 0;
    lower_count   number := 0;
    special_count number := 0;
    special_str   varchar2(100);

  BEGIN
    if length(user_password) < password_min_length then
      MSG        := (password_min_length || ' characters');
      ERROR_CODE := '1000';
      RETURN;
    end if;

    for i in 1 .. length(user_password) Loop
      CHR := SUBSTR(user_password, i, 1);

      ------check for numbers-------

      IF ASCII(CHR) BETWEEN (48) AND (57) THEN
        num_count := num_count + 1;

        ------check for upper case chars-------

      ELSIF ASCII(CHR) BETWEEN (65) AND (90) THEN
        caps_count := caps_count + 1;

        ------check for lower case chars-------

      ELSIF ASCII(CHR) BETWEEN (97) AND (122) THEN
        lower_count := lower_count + 1;

        ------check for special chars FROM LT_PASSWORD_CONFIG TABLE-------
      ELSE
        begin

          SELECT DISTINCT (PWD_SPECIAL)
            INTO special_str
            FROM LT_PASSWORD_CONFIG;

          if INSTR(special_str, CHR) > 0 THEN
            special_count := special_count + 1;

            ---------look for excluded special Characters---------
          ELSE
            MSG        := (' None Special characters');
            ERROR_CODE := '7000';
            RETURN;
          END IF;
        EXCEPTION
          WHEN NO_DATA_FOUND THEN
            MSG        := ('Special Characters');
            ERROR_CODE := '6000';
            RETURN;
        end;
      END IF;
    end loop;

    ---------check for min numbers----------

    if num_count < password_min_number then
      MSG        := (password_min_number || ' numbers');
      ERROR_CODE := '2000';
      RETURN;
    end if;

    --------check for min upper case chars----------

    if caps_count < password_min_upper_case then
      MSG        := (password_min_upper_case || ' characters');
      ERROR_CODE := '3000';
      RETURN;
    end if;

    ------------check for min lower case chars----------

    if lower_count < password_min_lower_case then
      MSG        := (password_min_lower_case || ' characters');
      ERROR_CODE := '4000';
      RETURN;
    end if;

    --------------check for min special chars----------

    if special_count < password_min_special then
      MSG        := (password_min_special || ' characters');
      ERROR_CODE := '5000';
      RETURN;
    end if;

  END check_strong_password;

    FUNCTION get_error(p_error_code IN VARCHAR2,
                       p_add_msg    IN VARCHAR2 := '') RETURN VARCHAR2 IS
      lv_err_text VARCHAR2(200);
    BEGIN
      select decode(error_type,
                    'E',
                    'Err:' || error_code,
                    'e',
                    'Err:' || error_code,
                    'M',
                    'Msg:' || error_code,
                    'm',
                    'Msg:' || error_code,
                    'W',
                    'Warn:' || error_code,
                    'w',
                    'Warn:' || error_code,
                    '' || error_code) || ': ' ||
             nvl(error, 'Error missing')
        into lv_err_text
        from valid_errors
       where error_code = p_error_code;

      lv_err_text := lv_err_text || p_add_msg;

      RETURN lv_err_text;
    EXCEPTION
      WHEN OTHERS THEN
        RETURN('Error in retrieving information for error code - ' ||
               p_error_code);
    END get_error;

  PROCEDURE ONS_CHECK_STRONG_PASSWORD( user_password in varchar2,
                                       ERROR_CODE    OUT VARCHAR2,
                                       MSG           OUT VARCHAR2) IS

    lv_add_msg       VARCHAR2(300);
    lb_check BOOLEAN;

  BEGIN
    IF user_password IS NULL THEN
      error_code := '0080';
      msg        := 'Password cannot be empty';
      RETURN;
    END IF;

    check_strong_password(user_password, error_code, lv_add_msg);
    msg := lv_add_msg;

    IF lv_add_msg IS NOT NULL then
      IF ERROR_CODE = '1000' THEN
        msg := get_error('16307', lv_add_msg);
      ELSIF ERROR_CODE = '7000' THEN
        msg := get_error('16321');
      ELSIF ERROR_CODE = '2000' THEN
        msg := get_error('16308', lv_add_msg);
      ELSIF ERROR_CODE = '3000' THEN
        msg := get_error('16309', lv_add_msg);
      ELSIF ERROR_CODE = '4000' THEN
        msg := get_error('16310', lv_add_msg);
      ELSIF ERROR_CODE = '5000' THEN
        msg := get_error('16311', lv_add_msg);
      ELSIF ERROR_CODE = '6000' THEN
        msg := get_error('3102', lv_add_msg);
      END IF;
    END IF;

  END ONS_CHECK_STRONG_PASSWORD;


  --Version     : 5.0  created dotnet_check_strong_password for dotnet app. -- 02/21/2019
  --Version     : 6.0  ons_check_strong_password routine modified to add user id as paramter. 10/07/2019 -- MLT 2558
  /*
   wrapper function for check_strong_password to return error code and msg in MSG parameter.
  */

  PROCEDURE ONS_CHECK_STRONG_PWD_RESET(  user_id       in varchar2,
                                              user_password in varchar2,
                                              old_password in varchar2,
                                              ERROR_CODE    OUT VARCHAR2,
                                              MSG           OUT VARCHAR2) IS

    lv_add_msg       VARCHAR2(300);
    lb_check BOOLEAN;
  BEGIN
    IF user_password IS NULL THEN
      error_code := '0080';
      msg        := 'Password cannot be empty';
      RETURN;
    END IF;

    lb_check := check_password_history(UPPER(user_id), user_password);

    IF NOT lb_check THEN
      error_code := '16336';
      msg        := get_error(error_code,
                              ' ' || password_history || ' password(s)'); -- cannot reuse the last 10 passwords.
      RETURN;
    END IF;

    -- V08
    lb_check := CHECK_MIN_CHAR_CHANGED(old_password, user_password);

    IF NOT lb_check THEN
      error_code := '16312';
      msg        := get_error(error_code,
                              ' ' || PASSWORD_MIN_CHAR_CHANGED || ' characters from OLD password'); -- cannot reuse the last 10 passwords.
      RETURN;
    END IF;
    ---

    -- V09 (moved strong password check to seperate routine). 
    -- It will be used to call from login button as well.
    ons_check_strong_password(user_password, ERROR_CODE, MSG);

  END ONS_CHECK_STRONG_PWD_RESET;

  FUNCTION IS_SINGLE_USER_MODE RETURN BOOLEAN IS

    FLAG        BOOLEAN;
    SINGLE_MODE varchar2(1);
  BEGIN

    BEGIN
      SELECT UPPER(SINGLE_USER)
        INTO SINGLE_MODE
        from lt_application_config;
      if SINGLE_MODE = 'Y' then
        FLAG := TRUE;
      else
        FLAG := FALSE;
      end if;

    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        FLAG := FALSE;
    END;
    RETURN FLAG;
  END IS_SINGLE_USER_MODE;

  FUNCTION is_strong_password RETURN BOOLEAN IS

    FLAG   BOOLEAN;
    strong varchar2(1);

  BEGIN

    BEGIN
      SELECT distinct (UPPER(STRONG_PWD_ENABLED))
        INTO strong
        from lt_application_config;
      if strong = 'Y' then
        FLAG := TRUE;
      else
        FLAG := FALSE;
      end if;
    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        FLAG := FALSE;
    END;
    RETURN FLAG;

  END is_strong_password;

  FUNCTION PASSWORD_HISTORY RETURN number IS
    PASS_HIST NUMBER;
  BEGIN
    SELECT DISTINCT (PWD_HISTORY) INTO PASS_HIST from LT_PASSWORD_CONFIG;
    return PASS_HIST;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN 0;
  END PASSWORD_HISTORY;

  FUNCTION PASSWORD_MIN_CHAR_CHANGED RETURN number IS
    MIN_CHAR_CHG number;

  BEGIN
    SELECT DISTINCT (PWD_MIN_CHAR_CHG)
      INTO MIN_CHAR_CHG
      from LT_PASSWORD_CONFIG;
    return MIN_CHAR_CHG;

  EXCEPTION

    WHEN NO_DATA_FOUND THEN
      RETURN 0;
  END PASSWORD_MIN_CHAR_CHANGED;

  FUNCTION password_min_length RETURN number IS
    min_length number;

  BEGIN
    SELECT DISTINCT (PWD_MIN_LENGTH)
      INTO min_length
      from LT_PASSWORD_CONFIG;
    return min_length;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN 0;
  END password_min_length;

  FUNCTION PASSWORD_MIN_LOWER_CASE RETURN number IS
    min_LOWER number;

  BEGIN
    SELECT DISTINCT (PWD_MIN_LOWER) INTO min_LOWER from LT_PASSWORD_CONFIG;
    return min_LOWER;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN 0;
  END PASSWORD_MIN_LOWER_CASE;

  FUNCTION PASSWORD_MIN_NUMBER RETURN number IS
    min_NUMBER number;
  BEGIN
    SELECT DISTINCT (PWD_MIN_NUMBER)
      INTO MIN_NUMBER
      from LT_PASSWORD_CONFIG;
    return min_NUMBER;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN 0;
  END PASSWORD_MIN_NUMBER;

  FUNCTION PASSWORD_MIN_SPECIAL RETURN number IS
    MIN_SPECIAL number;
  BEGIN
    SELECT distinct (pwd_min_special)
      INTO min_SPECIAL
      from lt_password_config;
    return min_SPECIAL;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN 0;
  END PASSWORD_MIN_SPECIAL;

  FUNCTION password_min_upper_case return number IS
    min_CAP number;
  BEGIN
    SELECT distinct (pwd_min_caps) INTO min_CAP from lt_password_config;
    return min_CAP;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN 0;
  END password_min_upper_case;

  FUNCTION CHECK_MIN_CHAR_CHANGED(OLD_PASS IN VARCHAR2,
                                  NEW_PASS IN VARCHAR2) RETURN BOOLEAN IS
    i  number;
    ii number := 0; -- MIN CHARS. CHANGED COUNTER--
    n  NUMBER;
  begin
    for i in 1 .. length(NEW_PASS) loop
      if substr(OLD_PASS, i, 1) = substr(NEW_PASS, i, 1) then
        ii := ii + 1;
      end if;

    end loop;

    if length(NEW_PASS) - ii < PASSWORD_MIN_CHAR_CHANGED then
      RETURN FALSE;
    ELSE
      RETURN TRUE;
    end if;
  END CHECK_MIN_CHAR_CHANGED;

  -- SCR 20552; hashing of password logic included in comparison. 04/25/2014
  FUNCTION check_password_history(APP_USER     IN VARCHAR2,
                                  NEW_PASSWORD IN VARCHAR2) RETURN BOOLEAN IS
    CURSOR user_pwd_cur(pwd_history_in NUMBER) IS
      SELECT old_password
        FROM (SELECT old_password
                FROM lt_password_history
               WHERE user_id = app_user
               ORDER BY reset_date DESC)
       WHERE ROWNUM <= pwd_history_in;
    l_pwd_hash RAW(50);
    l_return   BOOLEAN := TRUE;
  BEGIN
    l_pwd_hash := lt_password_policy.save_hash(new_password);
    FOR user_pwd_rec IN user_pwd_cur(password_history) LOOP
      IF user_pwd_rec.old_password = l_pwd_hash THEN
        l_return := FALSE;
        EXIT;
      END IF;
    END LOOP;
    -- returns TRUE by default
    -- returns FALSE if a match is found in the last 5 password changes where 5 is password_history in password config.
    RETURN l_return;
  END check_password_history;

  /* - SCR 20552 - routine modified on 04/25/2014.
  FUNCTION CHECK_PASSWORD_HISTORY(
                                  APP_USER     IN VARCHAR2 ,
                                  NEW_PASSWORD IN VARCHAR2 )
    RETURN BOOLEAN
  IS
    CURSOR CUR IS
      SELECT (ROWNUM), USER_ID, OLD_PASSWORD
        FROM LT_PASSWORD_HISTORY
      ORDER BY USER_ID ASC, RESET_DATE DESC;
    P_COUNT NUMBER:=0;
    U_COUNT NUMBER:=0;
  BEGIN
    FOR I IN CUR
    LOOP
      IF I.USER_ID=APP_USER THEN
          BEGIN
              U_COUNT := U_COUNT+1;
              IF U_COUNT <= PASSWORD_HISTORY THEN
                  IF I.OLD_PASSWORD = NEW_PASSWORD THEN
                    P_COUNT := P_COUNT+1;
                  END IF;
              ELSE
                  EXIT;
              END IF;
          END;
      END IF;
    END LOOP;
    IF P_COUNT >0 THEN
      RETURN FALSE;
    ELSE
      RETURN TRUE;
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN TRUE;
  END CHECK_PASSWORD_HISTORY ;
  */

  FUNCTION SAVE_HASH(NEW_PASSWORD IN VARCHAR2) RETURN RAW IS
    hashing raw(50);
  begin
    hashing := dbms_crypto.hash(UTL_I18N.STRING_TO_RAW(NEW_PASSWORD,
                                                       'AL32UTF8'),
                                dbms_crypto.hash_sh1);
    RETURN hashing;
  end SAVE_HASH;

  FUNCTION DOTNET_SAVE_HASH(P_USER_ID      IN VARCHAR2,
                            P_NEW_PASSWORD IN VARCHAR2) RETURN BOOLEAN IS
    hashing raw(50);
  BEGIN
    hashing := dbms_crypto.hash(UTL_I18N.STRING_TO_RAW(P_NEW_PASSWORD,
                                                       'AL32UTF8'),
                                dbms_crypto.hash_sh1);

    Begin
      UPDATE SYSTEM_USERS
         SET RESET_REQUEST          = 'N',
             password_modified_date = sysdate,
             LIFETRAK_PASSWORD      = HASHING
       WHERE SYSTEM_USERS.USER_ID = P_USER_ID;

      UPDATE LT_PASSWORD_HISTORY
         SET RESET_DATE = SYSDATE
       WHERE USER_ID = P_USER_ID
         AND RESET_DATE IS NULL;

      INSERT INTO LT_PASSWORD_HISTORY
      VALUES
        (P_USER_ID, hashing, SYSDATE, NULL);

      RETURN TRUE;

    Exception
      when others then
        RETURN FALSE;
    End;
    COMMIT;

  EXCEPTION
    when others then
      return FALSE;
  END DOTNET_SAVE_HASH;

  /*
  Wrapper function for CHECK_HASH called from /auth/login
  Checks user name password and logs login event to cac_audit_log table if log_event is set.
  log_event is set only in login page.  It is set to false in sign in page.
  */

  FUNCTION ONS_CHECK_HASH(APP_USER     IN VARCHAR2,
                           NEW_PASSWORD IN VARCHAR2,
                           WORK_STATION IN VARCHAR2,
                           LOG_EVENT    IN BOOLEAN) RETURN BOOLEAN IS

    lb_result BOOLEAN;
  BEGIN
    -- Authenticate user/password.
    lb_result := CHECK_HASH(app_user, new_password);

      -- if log event is enabled, log the login event to cac_audit_log table
    if log_event then
      if lb_result then
        LOG_LOGIN_EVENT(app_user, null, work_station, lc_SUCCESS);
      else
        LOG_LOGIN_EVENT(app_user, null, work_station, lc_FAIL);
      end if;
    end if;

    RETURN lb_result;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN FALSE;
  END ONS_CHECK_HASH;

  /*
  Inserts login event to cac_audit_log table.
  */
  Procedure LOG_LOGIN_EVENT(APP_USER     IN VARCHAR2,
                            NEW_PASSWORD IN VARCHAR2,
                            WORK_STATION IN VARCHAR2,
                            AUDIT_EVENT  IN VARCHAR2) is
    PRAGMA AUTONOMOUS_TRANSACTION;
  BEGIN
    insert into cac_audit_log
      (AUDIT_USER_NAME,
       AUDIT_PASSWORD,
       AUDIT_DATE_TIME,
       WORK_STATION,
       AUDIT_EVENT)
    values
      (APP_USER, NULL, SYSDATE, WORK_STATION, AUDIT_EVENT);
    COMMIT;
  END LOG_LOGIN_EVENT;

  /*
   Checks for consecutive password failed attempts and locks the user id.
  */
  FUNCTION PWD_LOCKOUT_LIMIT_REACHED(app_user IN VARCHAR2, ad_user IN VARCHAR2 DEFAULT NULL) RETURN BOOLEAN IS
    ln_lock_attempts NUMBER;
    ln_lock_interval NUMBER;
    ln_lock_period NUMBER;
    nCnt NUMBER;
  BEGIN
    SELECT pwd_lockout, pwd_lockout_interval, pwd_lockout_period
      INTO ln_lock_attempts, ln_lock_interval, ln_lock_period
      FROM lt_password_config
     WHERE rownum =1;

    if ln_lock_attempts > 0 then
      SELECT COUNT(1) INTO nCnt
        FROM (SELECT audit_event
                     FROM (SELECT audit_event
                             FROM cac_audit_log
                            WHERE audit_date_time BETWEEN
                                  SYSDATE - ln_lock_interval / 1440 AND SYSDATE
                              AND audit_user_name = NVL(app_user, ad_user)
                            ORDER BY audit_date_time desc)
                    WHERE ROWNUM <= ln_lock_attempts)
       WHERE audit_event = lc_FAIL;

       IF nCnt = ln_lock_attempts THEN
         UPDATE system_users
           SET is_password_locked = 'Y',
               lockout_date = SYSDATE,
               lockout_until = SYSDATE + ln_lock_period / 1440
           WHERE user_id = NVL(app_user, ad_user);
         COMMIT;
         RETURN TRUE;
       END IF;
    end if;

    RETURN FALSE;
  EXCEPTION
    WHEN no_data_found THEN
       RETURN FALSE;
  END PWD_LOCKOUT_LIMIT_REACHED;

  /*
  Checks password age and returns OK or EXPIRED as status.
  Also returns the number of days the password will expire if the password is not yet expired (OK status)
  */
  PROCEDURE ONS_CHECK_PASSWORD_AGE(APP_USER IN VARCHAR2, PWD_STATUS OUT VARCHAR2, PWD_EXPIRE_WARNING OUT NUMBER) IS
    ln_pwd_age NUMBER;
    ln_pwd_war NUMBER;
    ln_user_pwd_age NUMBER;
    ln_to_expire_days NUMBER;
  BEGIN
    -- default values;
    pwd_status := 'OK';
    pwd_expire_warning := 0;

    -- get password age configuration in days.
    SELECT pwd_intrvl, pwd_war_msg
      INTO ln_pwd_age, ln_pwd_war
      FROM lt_password_config
     WHERE ROWNUM = 1;

    -- check if pwd age is configured.
    IF ln_pwd_age > 0 THEN
      -- Get user password age.
      SELECT NVL(TRUNC(SYSDATE) - TRUNC(password_modified_date), ln_pwd_age+1)
        INTO ln_user_pwd_age
        FROM system_users
       WHERE user_id = UPPER(app_user); -- V08

      -- return to caller if password is expired indicating it in status.
      if ln_user_pwd_age >= ln_pwd_age then
        pwd_status := 'EXPIRED'; -- 'Application Password has expired!';
        RETURN;
      end if;

      -- if password is not expired, check the number of days it will expire.
      ln_to_expire_days := ln_pwd_age - ln_user_pwd_age;

      -- Alert the number of days to expire based on the password warning configuration.
      if ln_to_expire_days <= ln_pwd_war then
        pwd_status := 'OK';
        pwd_expire_warning := ln_to_expire_days;
        -- pwd_status := 'Your Application password will expire in ' || TO_CHAR(ln_to_expired_days) || ' days. Do you want to change your password now?';
        RETURN;
      end if;
    END IF;
  EXCEPTION
    WHEN no_data_found THEN
      pwd_status := 'NO DATA FOUND';
  END ONS_CHECK_PASSWORD_AGE;

  FUNCTION CHECK_HASH(APP_USER     IN VARCHAR2,
                      NEW_PASSWORD IN VARCHAR2) RETURN BOOLEAN IS
    CNT     NUMBER := 0;
    hashing raw(50);
  BEGIN
    hashing := dbms_crypto.hash(UTL_I18N.STRING_TO_RAW(NEW_PASSWORD,
                                                       'AL32UTF8'),
                                dbms_crypto.hash_sh1);
    SELECT COUNT(*)
      INTO CNT
      FROM SYSTEM_USERS
     WHERE USER_ID = APP_USER
       AND LIFETRAK_PASSWORD = HASHING;
    IF CNT = 0 THEN
      RETURN FALSE;
    ELSE
      RETURN TRUE;
    END IF;
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RETURN FALSE;
  END CHECK_HASH;

    PROCEDURE check_normal_password(pwd_in IN VARCHAR2, status_out OUT VARCHAR2) IS
    BEGIN
        status_out := 'OK';
        IF LTRIM(substr(pwd_in, 1, 1), 'ABCEDFGHIJKLMNOPQRSTUVWXYZ') IS NOT NULL THEN
            status_out := 'Error: First letter of password must be upper case alpha'; --V11
            RETURN;
        END IF;

        IF LTRIM(pwd_in, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ') is null then
            status_out := 'Error: A minimum of one numeric character is required';
            RETURN;
        END IF;

        IF LENGTH(pwd_in) < 6 THEN
            status_out := 'Error: Minimum length of password is 6 characters';
            RETURN;
        END IF;


    END check_normal_password;

    PROCEDURE RESET_PASSWORD(user_id_in IN VARCHAR2, 
                             pwd_in IN VARCHAR2, 
                             status_out OUT VARCHAR2) IS
        hashing        RAW (50);
        lv_errorCode   VARCHAR2(100); 
        lv_errorMsg    VARCHAR2(1000);
        nCnt           NUMBER;
    BEGIN
        status_out := 'OK';

        IF user_id_in IS NULL OR pwd_in IS NULL THEN
            status_out := get_error('0080', 'User ID, Password are required');
            RETURN;
        END IF;


        -- Check if user is valid.
        SELECT COUNT(1)
          INTO nCnt
          FROM system_users
         WHERE user_id = user_id_in;

        IF nCnt = 0 THEN
            status_out := 'Err: Invalid User';
        END IF;
        -------------

        IF is_strong_password THEN
            ons_check_strong_password(pwd_in, lv_errorCode, lv_errorMsg);
            IF lv_errorMsg IS NOT NULL THEN
                status_out := lv_errorMsg;
                RETURN;
            END IF;

            IF NOT check_password_history(user_id_in, pwd_in) THEN
                status_out := get_error('16313', 'Choose a New One');
                RETURN;            
            END IF;            
        ELSE
            check_normal_password(pwd_in, lv_errorMsg);
            IF lv_errorMsg <> 'OK' THEN
                status_out := lv_errorMsg;
                RETURN;
            END IF;
        END IF;

        hashing := lt_password_policy.save_hash (pwd_in);

        UPDATE system_users
           SET reset_request = 'Y',
               password_modified_date = SYSDATE,
               lifetrak_password = hashing
         WHERE system_users.user_id = user_id_in;

         UPDATE lt_password_history
            SET reset_date = SYSDATE
          WHERE user_id = user_id_in 
            AND reset_date IS NULL;

         INSERT INTO lt_password_history(user_id, old_password, actual_date, reset_date)
              VALUES (user_id_in, hashing, SYSDATE, NULL); 

         COMMIT; 
    EXCEPTION 
        WHEN OTHERS THEN
            status_out := SUBSTR(SQLERRM, 1, 1000);    
    END RESET_PASSWORD;
END lt_password_policy;
/
