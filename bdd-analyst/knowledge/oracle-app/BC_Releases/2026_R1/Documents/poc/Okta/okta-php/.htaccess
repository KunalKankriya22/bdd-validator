# Okta PHP Application .htaccess

# Protect against XSS, clickjacking, etc.
<IfModule mod_headers.c>
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-ancestors 'self'"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Remove PHP version information
    Header unset X-Powered-By
</IfModule>

# Disable directory listing
Options -Indexes

# Protect configuration files
<FilesMatch "^.*\.ini\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect .env files
<FilesMatch "^\.env.*">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect library files
<FilesMatch "^(common|auth|database|config)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect log files
<FilesMatch "^.*\.log$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP settings
<IfModule mod_php.c>
    # Hide PHP version
    php_flag expose_php Off
    
    # Disable remote file inclusion
    php_flag allow_url_fopen Off
    php_flag allow_url_include Off
    
    # Enable error logging but disable display
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log logs/php_errors.log
</IfModule>

# Redirect to HTTPS if not already using it
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Handle base path for webroot/okta
    # Only apply these rules if we're in the /okta directory
    RewriteCond %{REQUEST_URI} ^/okta/
    
    # Rewrite URLs for application paths
    RewriteRule ^okta/bconsiteapp/(.*)$ /okta/bconsiteapp/$1 [L]
    RewriteRule ^okta/bcoracleapp/(.*)$ /okta/bcoracleapp/$1 [L]
    RewriteRule ^okta/examples/(.*)$ /okta/examples/$1 [L]
    
    # Handle direct access to okta directory
    RewriteRule ^okta/?$ /okta/index.php [L]
</IfModule>
