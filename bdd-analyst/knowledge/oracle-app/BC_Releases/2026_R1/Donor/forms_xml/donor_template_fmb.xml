      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;BEGIN&amp;#10;&#x9;:global.program_version := '01';&amp;#10;END;&#x9;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="GET_COUNT" ProgramUnitText="/* PROCEDURE get_count IS&amp;#10;BEGIN&amp;#10;&amp;#10;   if  :ctrl_block_1.select = 'ALL' then   /* TOTAL NUMBER OF SPONSORS */&amp;#10;       if :ctrl_block_1.a_i != 'B' then     &amp;#10;                --message('a');pause;&amp;#10;        &#x9;   select  count(distinct sponsor_id) into :ctrl_block_1.total_sp from sponsors&amp;#10;&#x9;&#x9;    where  territory_id = :ctrl_block_1.territory_id&amp;#10;          and lob like nvl(:ctrl_block_1.lob,lob)&amp;#10;&#x9;&#x9;      and category like nvl(:ctrl_block_1.category,category) &amp;#10;                    and&#x9;   status = :ctrl_block_1.a_i and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0);&amp;#10;               select  sum(employee_base) into :ctrl_block.donor_base from sponsors&amp;#10;&#x9;   &#x9;    where   territory_id = :ctrl_block.territory_id&amp;#10;&#x9;            and lob like nvl(:ctrl_block.lob,lob)&amp;#10;&#x9;&#x9;      and category like nvl(:ctrl_block.category,category) &amp;#10;&#x9;                and status = :ctrl_block.a_i and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0);&amp;#10;        else&amp;#10;        &#x9;   select  count(distinct sponsor_id) into :ctrl_block.total_sp from sponsors&amp;#10;&#x9;&#x9;    where  territory_id = :ctrl_block.territory_id&amp;#10;&#x9;            and lob like nvl(:ctrl_block.lob,lob)&amp;#10;&#x9;&#x9;      and category like nvl(:ctrl_block.category,category) and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0);&amp;#10;               select  sum(employee_base) into :ctrl_block.donor_base from sponsors&amp;#10;&#x9;   &#x9;    where   territory_id = :ctrl_block.territory_id&amp;#10;&#x9;            and lob like nvl(:ctrl_block.lob,lob)&amp;#10;&#x9;&#x9;      and category like nvl(:ctrl_block.category,category) and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0);&amp;#10;        end if;  /* for a_i*/ &amp;#10;  else  &amp;#10;       if :ctrl_block.a_i != 'B' then     &amp;#10;  &#x9;      select  count(distinct sponsor_id) into :ctrl_block.total_sp from sponsors&amp;#10;&#x9;       where   territory_id = :ctrl_block.territory_id&amp;#10;               and lob like nvl(:ctrl_block.lob,lob)&amp;#10;&#x9;         and category like nvl(:ctrl_block.category,category) and&amp;#10;                   status = :ctrl_block.a_i and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0)&amp;#10;                   and SPONSOR_ID not in &amp;#10;                       (select distinct A.sponsor_id &amp;#10;                          from   drive_sponsors A, drives B &amp;#10;                         where  a.drive_id = b.drive_id &amp;#10;                           and    ((b.drive_date between :ctrl_block.s_date-56 and :ctrl_block.s_date)&amp;#10;                            OR (b.drive_date between :ctrl_block.E_date and :ctrl_block.E_date + 56)) );&amp;#10;&amp;#10;           select  sum(employee_base) into :ctrl_block.donor_base from sponsors&amp;#10;&#x9;      where   territory_id = :ctrl_block.territory_id&amp;#10;              and lob like nvl(:ctrl_block.lob,lob)&amp;#10;&#x9;        and category like nvl(:ctrl_block.category,category) and&amp;#10;                  status = :ctrl_block.a_i and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0)&amp;#10;                  and SPONSOR_ID not in &amp;#10;                  (select distinct A.sponsor_id &amp;#10;                     from   drive_sponsors A, drives B &amp;#10;                    where  a.drive_id = b.drive_id &amp;#10;                      and    ((b.drive_date between :ctrl_block.s_date-56 and :ctrl_block.s_date)&amp;#10;                       OR (b.drive_date between :ctrl_block.E_date and :ctrl_block.E_date + 56)) );&amp;#10;        else&amp;#10;  &#x9;      select  count(distinct sponsor_id) into :ctrl_block.total_sp from sponsors&amp;#10;&#x9;       where   territory_id = :ctrl_block.territory_id&amp;#10;               and lob like nvl(:ctrl_block.lob,lob)&amp;#10;&#x9;         and category like nvl(:ctrl_block.category,category) and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0)&amp;#10;                   and SPONSOR_ID not in &amp;#10;                       (select distinct A.sponsor_id &amp;#10;                          from   drive_sponsors A, drives B &amp;#10;                         where  a.drive_id = b.drive_id &amp;#10;                           and    ((b.drive_date between :ctrl_block.s_date-56 and :ctrl_block.s_date)&amp;#10;                            OR (b.drive_date between :ctrl_block.E_date and :ctrl_block.E_date + 56)) );&amp;#10;&amp;#10;           select  sum(employee_base) into :ctrl_block.donor_base from sponsors&amp;#10;&#x9;      where   territory_id = :ctrl_block.territory_id&amp;#10;              and lob like nvl(:ctrl_block.lob,lob)&amp;#10;&#x9;        and category like nvl(:ctrl_block.category,category) and&amp;#10;&#x9;&#x9;          NVL(employee_base,0) >= nvl(:ctrl_block.d_base,0)&amp;#10;                  and SPONSOR_ID not in &amp;#10;                  (select distinct A.sponsor_id &amp;#10;                     from   drive_sponsors A, drives B &amp;#10;                    where  a.drive_id = b.drive_id &amp;#10;                      and    ((b.drive_date between :ctrl_block.s_date-56 and :ctrl_block.s_date)&amp;#10;                       OR (b.drive_date between :ctrl_block.E_date and :ctrl_block.E_date + 56)) );&amp;#10;&amp;#10;        end if;&amp;#10;    end if;&amp;#10;END;*/&amp;#10;&amp;#10;"/>
