            <Trigger Name="WHEN-BUTTON-PRESSED" TriggerText="go_item('txt_print_id');&amp;#10;/*&amp;#10;insert into print_request_queue&amp;#10;(file_name,form_type,printer_name,request_date)&amp;#10;values&amp;#10;(:parameter.p_report_name ||&amp;#10;                 '_' || :parameter.p_parm_id || '_' || :parameter.p_user_name ||'.r',&amp;#10;&amp;#10;:parameter.p_form_type,:control_block.txt_print_id,sysdate);&amp;#10;:system.message_level := '5' ;&amp;#10;commit ;&amp;#10;:system.message_level := '0' ;&amp;#10;*/&amp;#10;/*declare&amp;#10; ret_val number ;&amp;#10; command varchar2(500) ;&amp;#10; filename varchar2(80) ;&amp;#10;&amp;#10; v_report_dir varchar2(80) ;&amp;#10;BEGIN&amp;#10;    -- Get report output directory --&amp;#10;  begin&amp;#10;    select parameter_value into v_report_dir&amp;#10;     from  valid_parameters&amp;#10;    where  parameter_code='UNIX_REPDR'&amp;#10;     and   chapter_id=:global.chapter_id ;&amp;#10;  exception&amp;#10;     when no_data_found then &amp;#10;       message('UNIX_REPDR parameter not set in VALID_PARAMETERS table');&amp;#10;       raise form_trigger_failure ;&amp;#10;     when others then &amp;#10;       handle_error ;&amp;#10;       check_package_failure ;&amp;#10;  end ;&amp;#10; filename := v_report_dir||'/' || :parameter.p_report_name ||&amp;#10;                 '_' || :parameter.p_parm_id || '_' || :parameter.p_user_name ||'.r';&amp;#10;&amp;#10;&amp;#10; if :s_forms_type = 'NORMAL' then&amp;#10;    command := 'lp '||filename ;&amp;#10; elsif :s_forms_type = 'COMPRESSED' then&amp;#10;    command := 'lp -oc '||filename ;&amp;#10; elsif :s_forms_type = 'LANDSCAPE' then&amp;#10;    command := 'lp -olandscape '||filename ;&amp;#10; end if ;&amp;#10;&amp;#10;ret_val := daemon.execute_system(command) ;&amp;#10;end ;*/"/>
