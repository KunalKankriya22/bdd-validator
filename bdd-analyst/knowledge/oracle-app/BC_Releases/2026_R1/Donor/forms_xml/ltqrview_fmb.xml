         <Trigger Name="WHEN-NEW-BLOCK-INSTANCE" TriggerText="declare&amp;#10;  filename varchar2(80) ;&amp;#10;  v_report_dir varchar2(40) ;&amp;#10;  in_file   Text_IO.File_Type;&amp;#10;  linebuf   VARCHAR2(200);&amp;#10;&amp;#10;BEGIN&amp;#10; begin&amp;#10;  select forms_type into :s_forms_type&amp;#10;   from  rpt_report_names&amp;#10;  where  appl_id in ('DON', 'ARCH')&amp;#10;   and   report_name = :parameter.p_report_name ;&amp;#10; exception&amp;#10;   when others then handle_error;&amp;#10;  raise form_trigger_failure ;&amp;#10; end ;&amp;#10; if :s_forms_type in ('LANDSCAPE','COMPRESSED') then&amp;#10;  set_item_property('REPORT_ITEM',VISUAL_ATTRIBUTE,'CHAR132_ATTR') ;&amp;#10; else&amp;#10;  set_item_property('REPORT_ITEM',VISUAL_ATTRIBUTE,'CHAR80_ATTR') ;&amp;#10; end if ;&amp;#10; &amp;#10;    /*-- Get report output directory --*/&amp;#10;  begin&amp;#10;    select parameter_value into v_report_dir&amp;#10;     from  valid_parameters&amp;#10;    where  parameter_code='REPOUTPUT'&amp;#10;      and  rownum=1;&amp;#10;    --  and   chapter_id=szChapter;--:global.chapter_id ;&amp;#10;  exception&amp;#10;     when no_data_found then &amp;#10;       message('UNIX_REPDR parameter not set in VALID_PARAMETERS table');&amp;#10;       raise form_trigger_failure ;&amp;#10;     when others then &amp;#10;       handle_error;&amp;#10;       check_package_failure;&amp;#10;  end ;&amp;#10; filename := lower(v_report_dir|| :parameter.p_report_name ||'_' || :parameter.p_parm_id ||&amp;#10;                         '_' || :parameter.p_user_name ||'.r');&amp;#10;                         &amp;#10; --filename:='R:\DRRUNADT_CJH_CJH.r';&amp;#10; --message('File:'||filename) ;pause;&amp;#10;--message(filename);pause;&amp;#10;&amp;#10;  in_file := Text_IO.Fopen(filename, 'r');&amp;#10; -- message('open');pause;&amp;#10;  LOOP&amp;#10; -- &#x9; message('open1');pause;&amp;#10;    Text_IO.Get_Line(in_file, linebuf);&amp;#10;    --  :report_item := LTrim(substr(linebuf,1,length(linebuf)-1)) ;&amp;#10;        :report_item := substr(linebuf,1,length(linebuf)) ;      --TR#000918&amp;#10;    --:report_item := LTrim(substr(linebuf,1,110) );&amp;#10;    next_record ;&amp;#10;--    Text_IO.Put(linebuf);&amp;#10;--    Text_IO.New_Line;&amp;#10;  END LOOP;&amp;#10;&amp;#10;EXCEPTION&amp;#10;  WHEN no_data_found THEN&amp;#10;    first_record ;&amp;#10;    Text_IO.Put_Line('Closing the file...');&amp;#10;    Text_IO.Fclose(in_file);&amp;#10;     when others then &amp;#10;   --  message(sqlerrm||filename);pause;&amp;#10;       show_error('18193');&amp;#10;       check_package_failure ;&amp;#10;      exit_form(no_validate);&amp;#10;END;"/>
