      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10;BEGIN&amp;#10;/*&#x9;&amp;#10;   set_window_property('win_donation',title,'UTWFMENU [Ver: 01 ] '||&amp;#10;                       'Access Path Window'); */&amp;#10;/* set_window_property('win_donation',title,'UTWFMENU [Ver: 02 ] '||&amp;#10;                       'Access Path Window');    */                    -- IM:8497&amp;#10;                       &amp;#10;   -- Below Version Got Re-Updated from LT2018&amp;#10;     &amp;#10;   set_window_property('win_donation',title,'UTWFMENU [Ver: 01 ] '||&amp;#10;                       'Access Path Window');&amp;#10;                       &amp;#10;   item_change('user_menu.mnemonic','D');&amp;#10;   item_change('user_menu.descrip','D');&amp;#10;   item_change('user_menu.exec_name','D');&amp;#10;   IF :PARAMETER.P_KEYWORD is not null THEN&amp;#10;      :ctrl_blk_1.keyword := :parameter.p_keyword;&amp;#10;      retrieve_data;&amp;#10;   ELSE&amp;#10;      go_item('ctrl_blk_1.keyword');&amp;#10;   END IF;&amp;#10;END;    " ProgramUnitType="Procedure"/>
      <ProgramUnit Name="RETRIEVE_DATA" ProgramUnitText="PROCEDURE RETRIEVE_DATA IS&amp;#10;BEGIN&amp;#10;   IF :ctrl_blk_1.keyword is null and &amp;#10;      :ctrl_blk_1.description is null and&amp;#10;      :ctrl_blk_1.fcn_id is null &amp;#10;   THEN &amp;#10;      go_item('ctrl_blk_1.keyword');&amp;#10;      show_error('19108');&amp;#10;   END IF;&amp;#10;   item_change('user_menu.mnemonic','E');&amp;#10;   item_change('user_menu.descrip','E');&amp;#10;   item_change('user_menu.exec_name','E');&amp;#10;   go_block('user_menu');&amp;#10;   :system.message_level := 10;&amp;#10;   execute_query;&amp;#10;   :system.message_level := 0;&amp;#10;   go_record(1);&amp;#10;   IF :system.cursor_value is null THEN&amp;#10;      go_item('ctrl_blk_1.keyword');&amp;#10;      show_error('11091');&amp;#10;   ELSE&amp;#10;      item_change('ctrl_blk_1.keyword','D');&amp;#10;      item_change('ctrl_blk_1.description','D');&amp;#10;      item_change('ctrl_blk_1.fcn_id','D');&amp;#10;      item_change('ctrl_blk_1.pb_retrieve','D');&amp;#10;      set_item_property('ctrl_blk_1.pb_keyword_lov',&amp;#10;                         enabled,property_false);&amp;#10;   END IF;&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="DISP_TREE" ProgramUnitText="PROCEDURE disp_tree IS&amp;#10;   cursor c1 is&amp;#10;      select rpad(mnemonic,10,' ') ||' -> '|| descrip tree_branch&amp;#10;      from menu_item&amp;#10;      where appl_id = 'DON'&amp;#10;      connect by prior MENU_ID = FCN_ID&amp;#10;      start with mnemonic = :user_menu.mnemonic;&amp;#10;   rg_id recordgroup;&amp;#10;   cl_id groupcolumn;&amp;#10;   ctr number(3) := 0;&amp;#10;BEGIN&amp;#10;   rg_id := find_group('TREE_ST');&amp;#10;   IF not ID_NULL(rg_id) THEN&amp;#10;      delete_group(rg_id);&amp;#10;   END IF;&amp;#10;   rg_id := CREATE_GROUP('TREE_ST');&amp;#10;   cl_id := ADD_GROUP_COLUMN(rg_id,'NODE',CHAR_COLUMN,100);&amp;#10;   for i in c1   &amp;#10;   loop&amp;#10;      ctr := ctr + 1;&amp;#10;      ADD_GROUP_ROW(rg_id, END_OF_GROUP);&amp;#10;      SET_GROUP_CHAR_CELL('TREE_ST.NODE',ctr,i.tree_branch);&amp;#10;   end loop;&amp;#10;   GO_BLOCK('CTRL_BLK_2');&amp;#10;   clear_block(no_validate);&amp;#10;   first_record;&amp;#10;   loop&amp;#10;      exit when ctr &lt; 1;&amp;#10;      :ctrl_blk_2.tree := get_group_char_cell('TREE_ST.NODE',ctr);&amp;#10;      ctr := ctr - 1;&amp;#10;      next_record;&amp;#10;   end loop;&amp;#10;   GO_BLOCK('USER_MENU');&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
