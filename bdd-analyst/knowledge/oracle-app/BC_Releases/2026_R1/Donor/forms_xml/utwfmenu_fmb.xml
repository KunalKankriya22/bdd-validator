      <Trigger Name="ON-MESSAGE" ParentModule="inherit" ParentModuleType="12" ParentName="ON-MESSAGE" ParentFilename="inherit" SubclassObjectGroup="true" TriggerText="DECLARE &amp;#10;  alert_button NUMBER; &amp;#10;  lv_errtyp VARCHAR2(3) := MESSAGE_TYPE;&amp;#10;  lv_errcod NUMBER := MESSAGE_CODE;&amp;#10;  lv_errtxt VARCHAR2(80) := MESSAGE_TEXT;&amp;#10;BEGIN &amp;#10;  IF lv_errcod = 41800 THEN &amp;#10;&#x9;show_error('1180');&amp;#10;&#x9;&amp;#10;  ELSE &amp;#10;        IF lv_errcod = 40350 THEN &amp;#10;         &#x9;show_error('18187');&amp;#10;          ELSE &amp;#10;             Message(lv_errtyp||'-'||to_char(lv_errcod)||':  '||lv_errtxt);&amp;#10;               RAISE Form_Trigger_Failure; &amp;#10;          END IF; &amp;#10;  END IF; &amp;#10;END; &amp;#10;&amp;#10;" ParentType="37"/>
