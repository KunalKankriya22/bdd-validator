      <Trigger Name="WHEN-NEW-FORM-INSTANCE" ParentModule="inherit" ParentModuleType="12" ParentName="WHEN-NEW-FORM-INSTANCE" ParentFilename="inherit" DirtyInfo="true" SubclassObjectGroup="true" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10;/* Set_Custom_Property( 'TOOLBAR.COMMIT_FORM', 1, 'SET_IMAGE','/donor/commit.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.CLEAR_FLD', 1, 'SET_IMAGE','/donor/clear_field.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.CLEAR_BLOCK', 1, 'SET_IMAGE','/donor/clear_block.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.CLEAR_RECORD', 1, 'SET_IMAGE','/donor/clear_record.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.INSERT', 1, 'SET_IMAGE','/donor/insert_record.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.DELETE_RECORD', 1, 'SET_IMAGE','/donor/delete_record.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.PREVIOUS_BLOCK', 1, 'SET_IMAGE','/donor/previous_block.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.NEXT_BLOCK', 1, 'SET_IMAGE','/donor/next_block.gif' ) ;&amp;#10;&amp;#10;Set_Custom_Property( 'TOOLBAR.CLEAR_FORM', 1, 'SET_IMAGE','/donor/clear_form.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.PB_ALERTS', 1, 'SET_IMAGE','/donor/alert_messages.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.PB_CALL_WINDOW', 1, 'SET_IMAGE','/donor/show_users.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.LIST_VALUES', 1, 'SET_IMAGE','/donor/list.gif' ) ;&amp;#10;&amp;#10;Set_Custom_Property( 'TOOLBAR.DISPLAY_ERROR', 1, 'SET_IMAGE','/donor/display_error.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.SHOW_KEYS', 1, 'SET_IMAGE','/donor/show_keys.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.HELP', 1, 'SET_IMAGE','/donor/help.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.PB_CAL', 1, 'SET_IMAGE','/donor/show_calendar.gif' ) ;&amp;#10;Set_Custom_Property( 'TOOLBAR.EXIT_FORM', 1, 'SET_IMAGE','/donor/exit.gif' ) ;&amp;#10;*/&amp;#10;      &amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN4' ) ;&amp;#10;   End if ;&amp;#10;   -- paint the canevases --&amp;#10;   If :PARAMETER.PM$CANVAS is not null Then &amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN4' ) ;&amp;#10;      PKG_LOOK_AND_FEEL.Paint_Canevas('.VTCanvas1', 'LAF_BLOCK.LAF_TOOLBAR' ) ;&amp;#10;   End if ;&amp;#10;   -- paint the block --&amp;#10;&amp;#10; &amp;#10;End if;&amp;#10;------------------------------------------------------&amp;#10;--  end code added for the LAF project integration  --&amp;#10;------------------------------------------------------&amp;#10;&amp;#10;-- IM:8497&amp;#10;DECLARE&amp;#10;&#x9;l_chp_id VARCHAR2(4);&amp;#10;&#x9;l_print_id VARCHAR2(40);&amp;#10;&#x9;l_error VARCHAR2(1000);&amp;#10;BEGIN&amp;#10;&#x9;populate_chapter_ID(l_chp_id, l_print_id, l_error);&amp;#10;&#x9;IF l_error IS NOT NULL THEN&amp;#10;&#x9;&#x9;IF l_error in ('9776','9777') THEN&amp;#10;&#x9;&#x9;&#x9;show_error(l_error); -- Message Type&amp;#10;&#x9;&#x9;&#x9;check_package_failure;&amp;#10;&#x9;&#x9;ELSE&amp;#10;&#x9;&#x9;&#x9;message('Err: ' || sqlcode || '-' || SUBSTR(sqlerrm, 1, 100));&amp;#10;&#x9;&#x9;&#x9;pause;&amp;#10;&#x9;&#x9;END IF;&#x9;&#x9;&amp;#10;&#x9;&#x9;exit_form(no_validate);&amp;#10;&#x9;ELSE&amp;#10;&#x9;&#x9;:global.chapter_id := l_chp_id;&amp;#10;&#x9;&#x9;:global.user_printer_id := l_print_id;&amp;#10;&#x9;END IF;&amp;#10;EXCEPTION&amp;#10;  WHEN OTHERS THEN&amp;#10;    message('Err: ' || sqlcode || '-' || SUBSTR(sqlerrm, 1, 100));pause;&amp;#10;    exit_form(no_validate);  &amp;#10;END;&amp;#10;---&amp;#10;/*&amp;#10;begin&amp;#10;    select chapter_id,&amp;#10;           print_id&amp;#10;    into   :global.chapter_id,&amp;#10;           :global.user_printer_id&amp;#10;    from   system_users&amp;#10;    where  user_id = LT_USER_SESSION.get_userid&amp;#10;      and  trunc(sysdate) between&amp;#10;           eff_date and nvl(term_date,sysdate+365);&amp;#10;exception&amp;#10;    when no_data_found then&amp;#10;        message ('Err: You are not authorized to access the system.');&amp;#10;        pause;&amp;#10;        exit_form(no_validate);&amp;#10;    when others then&amp;#10;        handle_error;&amp;#10;        exit_form(no_validate);&amp;#10;end;&amp;#10;--&amp;#10;*/&amp;#10;&amp;#10;declare&amp;#10;      win_1 window;&amp;#10;begin&amp;#10;get_institution;&amp;#10;check_package_failure;&amp;#10;--&amp;#10;default_value ('0','global.fcn_id');&amp;#10;default_value ('0','global.menu_id');&amp;#10;default_value ('0','global.mnemonic_name');&amp;#10;&amp;#10;&#x9;  &amp;#10;&#x9;/*   if UPPER(SUBSTR(GET_APPLICATION_PROPERTY(CURRENT_FORM),3,1)) != 'W' then&amp;#10;&#x9;   &#x9;Set_Window_Property(FORMS_MDI_WINDOW,WINDOW_STATE,MAXIMIZE);&amp;#10;&#x9;&#x9;Set_Window_Property(FORMS_MDI_WINDOW,title,'');&amp;#10;&#x9;&#x9;Set_Window_Property('win_slots',WINDOW_STATE,MAXIMIZE);&amp;#10;&#x9;   end if;&amp;#10;&amp;#10;read_image_file('lifelogo.bmp','BMP','banner.bc_logo');&amp;#10;execute_trigger('util_banner');&amp;#10;*/&amp;#10;initialise_windows;&amp;#10;--&amp;#10;check_package_failure;&amp;#10;&amp;#10;end;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;&amp;#10;declare&amp;#10;     msg number;&amp;#10;begin&amp;#10;    select count(msg_id)&amp;#10;    into   msg&amp;#10;    from   alert_log&amp;#10;    where  user_id = LT_USER_SESSION.get_userid&amp;#10;      and  read_date is null;&amp;#10;&#x9;&amp;#10;    if msg > 0 then&amp;#10;&#x9;set_item_property('toolbar.pb_alerts',label,'Msg: '||to_char(msg));&amp;#10;    end if;&amp;#10;exception&amp;#10;&#x9;when program_error then&amp;#10;&#x9;   null;&#x9;&#x9;&amp;#10;end;&amp;#10;" ParentType="37"/>
