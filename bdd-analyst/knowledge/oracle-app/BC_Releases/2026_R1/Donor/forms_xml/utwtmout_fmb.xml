      <ProgramUnit Name="DISPLAY_ERRORS" ProgramUnitText="PROCEDURE display_errors (error_code in varchar,msg in varchar)IS&amp;#10;BEGIN&amp;#10;  &#x9;IF ERROR_CODE ='1000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('16307',MSG);&amp;#10;          &#x9;&amp;#10;          &#x9;   ELSIF ERROR_CODE ='7000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('16321');&amp;#10;          &#x9;&amp;#10;&amp;#10;            ELSIF ERROR_CODE ='2000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('16308',MSG);&amp;#10;          &#x9;   &amp;#10;          &#x9;   &amp;#10;          &#x9;   ELSIF ERROR_CODE ='3000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('16309',MSG);&amp;#10;          &#x9;   &amp;#10;          &#x9;   ELSIF ERROR_CODE ='4000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('16310',MSG);&amp;#10;          &#x9;   &amp;#10;          &#x9;   ELSIF ERROR_CODE ='5000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('16311',MSG);&amp;#10;&amp;#10;              ELSIF ERROR_CODE ='6000' THEN&amp;#10;          &#x9;   &amp;#10;          &#x9;   SHOW_ERROR('3102',MSG);&amp;#10;&amp;#10;END IF;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="PASSWORD_MESSAGE" ProgramUnitText="PROCEDURE password_message (msg in varchar2) IS&amp;#10;al_button number;&amp;#10;al_id alert;&amp;#10;BEGIN&amp;#10;  &amp;#10;  al_id := Find_Alert('PASSWORD_Alert'); &amp;#10;&#x9;&#x9;  Set_Alert_Property(al_id, alert_message_text,MSG ); &amp;#10;&#x9;&#x9;  al_button := Show_Alert( al_id ); &amp;#10;  &amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="INITIALISE_WINDOWS" ProgramUnitText="PROCEDURE initialise_windows IS&amp;#10; currRec INTEGER;&amp;#10;BEGIN&amp;#10;&#x9;--:global.program_version := '01';&amp;#10;&#x9;--:global.program_version := '02';&amp;#10;&#x9;--:GLOBAL.program_version := '03'; -- IM 455 (parameter.p_calling_form added - used for timeout feature)&amp;#10;&#x9;--:global.program_version := '04'; -- re-inherited util_banner.&amp;#10;&#x9;:global.program_version := '05'; -- MLT-5862&amp;#10;&#x9;&amp;#10;&#x9;set_window_property('WINDOW1',title,'Inactivity Alert [Ver: ' || :global.program_version || ']');-- SCR 20552; -- 06/09/2014;&amp;#10;&#x9;set_timers;&amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="SET_USER_SESSION" ProgramUnitText="PROCEDURE SET_USER_SESSION IS&amp;#10;BEGIN&amp;#10;&#x9;-- took set_appl_global routine from logins screen and made changes.&amp;#10;&#x9;-- Assigning :GLOBAL.tz_offset and lt_user_session variables(chapter_id and tz_offset)&amp;#10;&#x9;&amp;#10;   :GLOBAL.tz_offset := '';&amp;#10;    &amp;#10;&#x9;&#x9;-- global.tz_offset variable is set here.&amp;#10;&#x9;&#x9;begin&amp;#10;        select ch.time_zone   &amp;#10;        into :GLOBAL.tz_offset&amp;#10;        from   system_users su, chapters ch&amp;#10;        where  UPPER(su.user_id) = LT_USER_SESSION.get_userid and&amp;#10;&#x9;&#x9;           su.chapter_id = ch.chapter_id and&amp;#10;&#x9;&#x9;           sysdate between ch.eff_date and nvl(ch.term_date,sysdate+365);&amp;#10;    exception&amp;#10;        when NO_DATA_FOUND&amp;#10;        then&amp;#10;            show_error('0130');&amp;#10;            check_package_failure;&amp;#10;        when OTHERS&amp;#10;        then&amp;#10;            message('Error in selecting chapter_id for user');&amp;#10;            handle_error;&amp;#10;            check_package_Failure;&amp;#10;    end;&amp;#10;    &amp;#10;    &amp;#10;    -- Set lt_user_session variables. -- LT2018&amp;#10;    lt_user_session.set_chapter_id(:GLOBAL.chapter_id);&amp;#10;    lt_user_session.set_tzone_offset(:GLOBAL.tz_offset);&amp;#10;    &amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="CANCEL_TIMER" ProgramUnitText="PROCEDURE Cancel_Timer( tm_name VARCHAR2 ) IS &amp;#10;&#x9;tm_id Timer; &amp;#10;BEGIN &amp;#10;&#x9;tm_id := Find_Timer( tm_name ); &amp;#10;&amp;#10;&#x9;IF NOT Id_Null(tm_id) THEN &amp;#10;&#x9;&#x9;Delete_Timer(tm_id); &amp;#10;&#x9;--ELSE &amp;#10;&#x9;&#x9;--Message('Timer '||tm_name||' has already been cancelled.'); &amp;#10;&#x9;END IF; &amp;#10;END; " ProgramUnitType="Procedure"/>
      <ProgramUnit Name="SET_DYN_LABEL" ProgramUnitText="PROCEDURE set_dyn_label(p_time_mins IN NUMBER) IS&amp;#10; item_id ITEM;&amp;#10;BEGIN&amp;#10;  item_id := FIND_ITEM('CTRL.DYN_LABEL');&amp;#10;  &amp;#10;  IF p_time_mins > 1 THEN&amp;#10;  &#x9;SET_ITEM_PROPERTY(item_id, PROMPT_TEXT,'in ' || p_time_mins|| ' minutes'); &amp;#10;  ELSE&amp;#10;  &#x9;SET_ITEM_PROPERTY(item_id, PROMPT_TEXT,'in ' || p_time_mins || ' minute'); &amp;#10;  END IF;&amp;#10;  &amp;#10;END;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="GLOBALVAR" ProgramUnitText="PACKAGE GLOBALVAR IS&amp;#10;  time_cntr NUMBER; -- this variable is used as a counter variable for time (minutes only).&amp;#10;END;" ProgramUnitType="Package Spec"/>
      <ProgramUnit Name="SET_TIMERS" ProgramUnitText="PROCEDURE set_Timers IS&amp;#10;&#x9;ln_milliSecs NUMBER;&amp;#10;&#x9;timer_id &#x9;&#x9; TIMER;&amp;#10;BEGIN&#x9;&#x9;&#x9;&amp;#10;&#x9;&amp;#10;&amp;#10;&#x9;-- Step1: Create a main timer (warning time) to exit out of the application.&amp;#10;&#x9;ln_milliSecs := lt_user_session.get_toutWarn * 60 * 1000;&amp;#10;&#x9;&amp;#10;&#x9;timer_id := Find_Timer('EXIT_TIMER'); &amp;#10;&#x9;&amp;#10;&#x9;-- If timer does not exist, create it &amp;#10;&#x9;IF Id_Null(timer_id) THEN &amp;#10;&#x9;&#x9;timer_id := CREATE_TIMER('EXIT_TIMER', ln_milliSecs , NO_REPEAT);&amp;#10;&#x9;else &amp;#10;&#x9;&#x9;SET_TIMER(timer_id, ln_milliSecs, NO_REPEAT);&amp;#10;&#x9;end if;&#x9;&amp;#10;&#x9;--&amp;#10;&#x9;&amp;#10;&amp;#10;&#x9;-- Step2: Turn off the client inactivity monitoring.&amp;#10;&#x9;-- we are in this screen only when an inactivity event occurs.&amp;#10;&#x9;-- So, we need to turn off the inactivity once the warning window is displayed.&amp;#10;&#x9;-- Again the monitoring is turned ON when CONTINUE button is pressed.&amp;#10;&#x9;&amp;#10;&#x9;SET_APPLICATION_PROPERTY(CLIENT_IDLE_TIME, 0); -- IM 424, 425&amp;#10;&#x9;&amp;#10;&#x9;--&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9;-- Step 3: Add another timer to display the running clock.&amp;#10;&#x9;-- Only minute changes are displayed so the timer is for 1 min.&amp;#10;&#x9;&amp;#10;&#x9;globalvar.time_cntr := lt_user_session.get_toutWarn;&amp;#10;&#x9;&amp;#10;&#x9;set_dyn_label(globalvar.time_cntr);&amp;#10;&#x9;&amp;#10;&#x9;timer_id := Find_Timer('WARN_REP_TIMER');&amp;#10;&#x9;&amp;#10;&#x9;-- If timer does not exist, create it &amp;#10;&#x9;IF Id_Null(timer_id) THEN &amp;#10;&#x9;&#x9;timer_id := CREATE_TIMER('WARN_REP_TIMER', 60000 , REPEAT);&amp;#10;&#x9;else &amp;#10;&#x9;&#x9;SET_TIMER(timer_id, 60000, REPEAT);&amp;#10;&#x9;end if;&#x9;&amp;#10;&#x9;-- &amp;#10;&#x9;&amp;#10;&#x9;----------------------------- &amp;#10;END;" ProgramUnitType="Procedure"/>
