      <Trigger Name="WHEN-TIMER-EXPIRED" DirtyInfo="true" TriggerText="DECLARE &amp;#10;&#x9;tm_name VARCHAR2(40); &amp;#10;BEGIN &amp;#10;&#x9;tm_name := GET_APPLICATION_PROPERTY(TIMER_NAME); &amp;#10;&amp;#10;&#x9;IF tm_name = 'EXIT_TIMER' THEN&amp;#10;&#x9;&#x9;-- cancel repeat timer.&amp;#10;&#x9;&#x9;cancel_timer('WARN_REP_TIMER');&#x9;&#x9;&amp;#10;&#x9;&#x9;--&amp;#10;&#x9;&#x9;lt_user_session.set_toutExitImmediate(TRUE); -- V05&amp;#10;&#x9;&#x9;EXIT_APP(:PARAMETER.P_CALLING_FORM);&amp;#10;&#x9;&#x9;/*&amp;#10;&#x9;  web.show_document('javascript:parent.close_applet()','_self'); &amp;#10;&#x9;  --web.show_document('java/dtimeout.html'); --?p_app=' || globalvar.g_html_tout); -- Explain to user that inactivity caused the app to close&amp;#10;&#x9;  --web.show_document('java/dtimeout.html?p_app=lifetrak'); -- Explain to user that inactivity caused the app to close&amp;#10;&#x9;  web.show_document('java/lifetraktout.html?jsessid=loggedout'); -- Explain to user that inactivity caused the app to close&amp;#10;&#x9;&#x9;exit_form(NO_VALIDATE);&amp;#10;&#x9;&#x9;*/&amp;#10;&#x9;ELSIF tm_name = 'WARN_REP_TIMER' THEN&amp;#10;&#x9;&#x9;-- IM 424, 425&amp;#10;&#x9;&#x9;-- Every time this timer is fired, reduce the time counter variable by 1 minute. (this is a minute timer)&amp;#10;&#x9;&#x9;globalvar.time_cntr := globalvar.time_cntr - 1;&amp;#10;&#x9;&#x9;set_dyn_label(globalvar.time_cntr);&#x9;&amp;#10;&#x9;END IF;&amp;#10;END;"/>
