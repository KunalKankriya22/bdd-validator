      <ProgramUnit Name="CLIENT_TEXTIO" ProgramUnitText="PROCEDURE client_textio IS&amp;#10;&amp;#10;--begin&amp;#10;l_out_file  client_Text_IO.File_Type;&amp;#10;&#x9;v_record varchar2(2000);&amp;#10;  &amp;#10;  v_insert_counter NUMBER;&amp;#10;  v_rec_counter NUMBER;&amp;#10;  &amp;#10;  l_filename   varchar2(2000)  ;-- := :global.user_home ||'\helloworld.txt';&amp;#10;  l_copy_name  varchar2(2000)  ;-- := :global.arlog_home ||'\copy of helloworld.txt';&amp;#10;  l_success    boolean;&amp;#10;&amp;#10;--LOGDR&#x9;FILOC&#x9;D:\Lifetrak\test_results&#x9;4/20/2011&#x9;&#x9;4/20/2011 2:33:06 PM&#x9;1092705&#x9;VMASTCD&amp;#10;--LOGDR&#x9;ARLOC&#x9;D:\Lifetrak\test_results\archive&#x9;4/20/2011&#x9;&#x9;4/20/2011 2:28:53 PM&#x9;1092706&#x9;VMASTCD&amp;#10;&amp;#10;&amp;#10;    err_code      number;&amp;#10;    err_msg       VARCHAR2(80);&amp;#10;    &amp;#10;    v_line_counter number;&amp;#10;    &amp;#10;    v_lifetrak_format varchar2(1) :='N';&amp;#10;    &amp;#10;    v_user_id varchar2(20);&amp;#10;&amp;#10;    v_file_name varchar2(300);&amp;#10;&amp;#10;&amp;#10;BEGIN&amp;#10;&#x9;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;v_line_counter:=0;&amp;#10;&#x9;&amp;#10;l_out_file := client_Text_IO.Fopen(:s_file_name,'r');&amp;#10;&#x9;&amp;#10;&#x9;--:global.user_home ||'\helloworld.txt', 'r');&amp;#10;&#x9;&amp;#10;&#x9;&amp;#10;&#x9; if  substr(user,1,4) = 'OPS$'&amp;#10;    then&amp;#10;       v_user_id  := substr(user,5,6) ;&amp;#10;    else&amp;#10;       v_user_id  := substr(user,1,6) ;&amp;#10;    end if;&amp;#10;&#x9;&amp;#10;v_file_name := substr(:s_file_name,instr(:s_file_name,'\',-1)+1,length(:s_file_name));&amp;#10;&#x9;&amp;#10;&#x9;LOOP&amp;#10;&#x9;client_text_io.get_line(l_out_file, v_record);&amp;#10;&#x9;&amp;#10;&#x9;--v_rec_counter :=v_rec_counter+1;&amp;#10;&#x9;&amp;#10;&#x9;-- the first record will have FH: if its a lifetrak format&amp;#10;&#x9;&#x9;&amp;#10;&#x9; IF v_line_counter =0 and v_record is not null and v_lifetrak_format &lt;>'Y' then&amp;#10;&#x9; &#x9;IF substr(v_record,1,3) ='FH:' THEN &amp;#10;&#x9; &#x9;&#x9;v_lifetrak_format :='Y';&amp;#10;&#x9; &#x9; v_record := substr(v_record,1,13) ||:CHAPTER_ID||substr(v_record,17,length(v_record));&amp;#10;&#x9; &#x9;END IF;&#x9;&amp;#10;&#x9; end if;&#x9;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;--IF v_record is not null THEN&amp;#10;&#x9;&#x9;IF nvl(length(replace (v_record,' ','')),0) >0 THEN&amp;#10;  &#x9;&#x9; &amp;#10;  &#x9;&#x9; If v_lifetrak_format='Y' then&amp;#10;  &#x9;&#x9; &#x9;  v_line_counter :=v_line_counter+1;&amp;#10;&#x9;&#x9; &amp;#10;&#x9;       insert into LT_INTERFACE_FILES (CHAPTER_ID,&amp;#10;&#x9;                                       FILE_ID,&amp;#10;&#x9;                                       DATA_STRING ,&amp;#10;&#x9;                                       INSERT_DATE,&amp;#10;&#x9;                                       line_order,&amp;#10;&#x9;                                       lifetrak_format,&amp;#10;&#x9;                                       INSERT_USER,&amp;#10;&#x9;                                       EXTERNAL_SOURCE)&amp;#10;                                 VALUES(:CHAPTER_ID,&amp;#10;                                         v_file_name,&amp;#10;                                         v_record,&amp;#10;                                         :s_date,&amp;#10;                                         v_line_counter,&amp;#10;                                          v_lifetrak_format,&amp;#10;                                          :banner.user_id,&amp;#10;                                          'DOD');&#x9; &amp;#10; &amp;#10;  &#x9;&#x9; Else   -- Surround file must be stored in a different table&amp;#10;  &#x9;&#x9; &#x9;&amp;#10;        insert into TEST_RESULT_STAGING (CHAPTER_ID,&amp;#10;&#x9;                                       DATA_STRING,&amp;#10;&#x9;                                       EXTERNAL_SOURCE ,&amp;#10;&#x9;                                       FILE_ID,&amp;#10;&#x9;                                       PROCESSED_FLAG,&amp;#10;&#x9;                                       PROCESSED_DATE,&amp;#10;&#x9;                                       RECORD_ID,&amp;#10;&#x9;                                       INSERT_DATE,&amp;#10;&#x9;                                       INSERT_USER)&amp;#10;                                 VALUES(:CHAPTER_ID,&amp;#10;                                         v_record,&amp;#10;                                         'DOD',&amp;#10;                                         v_file_name,&amp;#10;                                         null,&amp;#10;                                         null,&amp;#10;                                         100,&amp;#10;                                         sysdate,&amp;#10;                                         :banner.user_id);&amp;#10;                                          &#x9; &amp;#10;&amp;#10;  &#x9;&#x9; &amp;#10;  &#x9;&#x9; End If;&amp;#10;  &#x9;&#x9; &amp;#10;  END IF;&amp;#10;&#x9;&amp;#10;&#x9;END LOOP;&amp;#10;&amp;#10;EXCEPTION&amp;#10;&#x9;WHEN NO_DATA_FOUND THEN&amp;#10;&#x9;&#x9;client_text_io.fclose (l_out_file);&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;commit;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l_filename :=:s_file_name; -- :global.user_home||'\'||substr(:s_file_name,instr(:s_file_name,'\',-1)+1,length(:s_file_name));&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l_copy_name:=:global.arlog_home||'\'||substr(:s_file_name,instr(:s_file_name,'\',-1)+1,length(:s_file_name));&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;l_success := webutil_file.copy_file(l_filename,l_copy_name);&amp;#10;            if l_success &amp;#10;    &#x9;&#x9;&#x9;&#x9;then&amp;#10;       &#x9;&#x9;&#x9;      &#x9;&#x9;&#x9;&#x9;&amp;#10;       &#x9;&#x9;&#x9;&#x9;show_error('0410');&amp;#10;       &#x9;&#x9;&#x9;&#x9;&amp;#10;       &#x9;&#x9;&#x9;&#x9;l_success := webutil_file.delete_file(l_filename);&amp;#10;    &#x9;&#x9;&#x9;&#x9;&#x9;if l_success &amp;#10;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;then&amp;#10;       &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--message('Delete of file successfull');&amp;#10;       &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;message('Copy of file successfull');&amp;#10;       &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;go_item('CTRL_BLOCK_1.CHAPTER_ID');&amp;#10;       &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;:CHAPTER_ID :=null;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;        :CHAPTER_NAME :=null;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;        :S_FILE_NAME :=null;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;        clear_message;&amp;#10;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;else&amp;#10;    &#x9; &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;message('Delete failed');&amp;#10;    &#x9;&#x9;&#x9;&#x9;&#x9;&#x9;end if;&amp;#10;       &#x9;&#x9;&#x9;&#x9;&amp;#10;       &#x9;&#x9;&#x9;&#x9;&amp;#10;    &#x9;&#x9;&#x9;&#x9;else&#x9;&amp;#10;    &#x9; &#x9;&#x9;&#x9;&#x9;message('Copy failed');&#x9;&amp;#10;    &#x9;&#x9;&#x9;&#x9;end if;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&amp;#10;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&amp;#10;&#x9;&#x9;&#x9;&amp;#10;&#x9;&#x9;&#x9;&amp;#10;&#x9;&#x9;&#x9;&amp;#10;&#x9;when others then&amp;#10;&#x9;&amp;#10;&#x9;    show_error('0411');&amp;#10;&#x9;    err_code := sqlcode;&amp;#10;      err_msg  := substr(sqlerrm,1,75);&amp;#10;        rollback;&amp;#10;        insert&#x9;into lifetrak_api_log(SOURCE_ID,INTERNAL_ID,LOG_TEXT,EXTERNAL_ID,INSERT_DATE,PROGRAM_ID )&amp;#10;&#x9;      values('DOD','LIFETRAK',err_code||'-'||err_msg,:s_file_name,:s_date,'AIIFUPLD');&amp;#10;&#x9; &amp;#10;&#x9;      commit;&amp;#10;&#x9; --message(:CHAPTER_ID||','||:s_file_name||','||v_record||','||sysdate);&amp;#10;&#x9; --message(:CHAPTER_ID||','||:s_file_name||','||v_record||','||sysdate);&#x9;&#x9;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;&amp;#10;&#x9;&#x9;--TEXT_IO.FCLOSE(file_handle);&amp;#10;  &#x9;--client_text_io.get_line(l_out_file, v_record);&amp;#10;  &#x9;--'At '||TO_CHAR(SYSDATE,'HH24:MI')||' ' &amp;#10;&#x9;  --                                  ||webutil_clientinfo.get_user_name||' wrote:');&amp;#10;&#x9;&amp;#10;&#x9;&#x9;--client_text_io.put_line(l_out_file, :builtins.text_io_item);&amp;#10;END;&amp;#10;" ProgramUnitType="Procedure"/>
