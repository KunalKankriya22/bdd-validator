      <ProgramUnit Name="DISPLAY_PROCESSING_FACILITY" ProgramUnitText="-- Display current Processing Facility Details.&amp;#10;PROCEDURE DISPLAY_PROCESSING_FACILITY(in_collid_audit_key NUMBER) IS&amp;#10;&#x9;s_coll_name VARCHAR2(100);&amp;#10;&#x9;s_address_1 VARCHAR2(100);&amp;#10;&#x9;s_address_2 VARCHAR2(100);&amp;#10;&#x9;CURSOR cur_proc_fac IS&amp;#10;&#x9;  SELECT INITCAP(coll_name), INITCAP(coll_address_1),  INITCAP(city || ', ' || state || ', ' || zip)&amp;#10;&#x9;    FROM valid_collection_agencies&amp;#10;&#x9;   WHERE audit_key = in_collid_audit_key;&amp;#10;BEGIN&amp;#10;&#x9;IF in_collid_audit_key IS NOT NULL THEN&amp;#10;&#x9;&#x9;OPEN cur_proc_fac;&amp;#10;&#x9;&#x9;FETCH cur_proc_fac INTO s_coll_name, s_address_1, s_address_2;&amp;#10;&#x9;&#x9;CLOSE cur_proc_fac;&#x9;&#x9;&amp;#10;&#x9;END IF;&amp;#10;&amp;#10;&#x9;:CTRL_BLK_1.S_PROC_FACILITY := s_coll_name || CHR(10) || s_address_1 || CHR(10) || s_address_2;&amp;#10;END;&amp;#10;--" ProgramUnitType="Procedure"/>
      <RecordGroup Name="PROCESSING_FACILITY_LOV1" DirtyInfo="true" RecordGroupFetchSize="0" RecordGroupQuery="SELECT &amp;#10; audit_key,&amp;#10; coll_id,&amp;#10; registration_no,&amp;#10; INITCAP(coll_name || ', ' || coll_address_1 || ', ' || city || ', ' || state || ', ' || zip) processing_facility,&amp;#10; licence_no,&amp;#10; INITCAP(licence_address_1 || ', ' || licence_city || ', ' || licence_state || ', ' || licence_zip) licence_details&amp;#10;FROM valid_collection_agencies&amp;#10;WHERE chapter_id = :global.chapter_id&amp;#10;AND contract_id = 'INTERNAL'&amp;#10;AND coll_id &lt;> 'CDBAR'&amp;#10;AND sysdate between eff_date and nvl(term_date, sysdate + 365)&amp;#10;ORDER BY 4&amp;#10;" RecordGroupType="Query">
         <RecordGroupColumn Name="AUDIT_KEY" DirtyInfo="true" ColumnDataType="Number" MaximumLength="23" DataLengthSemantics="Null"/>
         <RecordGroupColumn Name="COLL_ID" DirtyInfo="true" ColumnDataType="Character" MaximumLength="5" DataLengthSemantics="BYTE"/>
         <RecordGroupColumn Name="REGISTRATION_NO" DirtyInfo="true" ColumnDataType="Character" MaximumLength="40" DataLengthSemantics="BYTE"/>
         <RecordGroupColumn Name="PROCESSING_FACILITY" DirtyInfo="true" ColumnDataType="Character" MaximumLength="201" DataLengthSemantics="BYTE"/>
         <RecordGroupColumn Name="LICENCE_NO" DirtyInfo="true" ColumnDataType="Character" MaximumLength="40" DataLengthSemantics="BYTE"/>
         <RecordGroupColumn Name="LICENCE_DETAILS" DirtyInfo="true" ColumnDataType="Character" MaximumLength="149" DataLengthSemantics="BYTE"/>
      </RecordGroup>
      <RecordGroup Name="AGLBL_PRINTER_LOV" DirtyInfo="true" RecordGroupFetchSize="0" RecordGroupQuery="SELECT&amp;#10;    code, code_desc&amp;#10;FROM&amp;#10;    rpt_master_codes&amp;#10;WHERE&amp;#10;        appl_id = 'DON'&amp;#10;    AND code_type = 'AGTPTR' &amp;#10;    AND location_id = :global.warehouse&amp;#10;    AND nvl(chapter_id, :global.chapter_id) = :global.chapter_id&amp;#10;ORDER BY SEQ" RecordGroupType="Query">
         <RecordGroupColumn Name="CODE" DirtyInfo="true" ColumnDataType="Character" MaximumLength="40" DataLengthSemantics="BYTE"/>
         <RecordGroupColumn Name="CODE_DESC" DirtyInfo="true" ColumnDataType="Character" MaximumLength="30" DataLengthSemantics="BYTE"/>
      </RecordGroup>
