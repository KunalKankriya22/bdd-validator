      <Trigger Name="SBC_BANNER" ParentModule="sbclib" ParentModuleType="12" ParentName="SBC_BANNER" ParentFilename="sbclib.fmb" DirtyInfo="true" SubclassObjectGroup="true" TriggerText="declare&amp;#10;   temp_x varchar2(1);&amp;#10;   disp_wh varchar2(3) := null;&amp;#10;   prog_name varchar2(8) := substr(:system.current_form,instr(:system.current_form,'/',-1,1)+1,8);&amp;#10;   l_status VARCHAR2(500);&amp;#10;   PROCEDURE SHOW_HINT Is&amp;#10;      new_item_msg varchar2(80);&amp;#10;      f_block varchar2(30) := GET_FORM_PROPERTY(name_in('system.current_form'),FIRST_NAVIGATION_BLOCK);&amp;#10;      f_item varchar2(80);&amp;#10;   begin&amp;#10;      f_item := f_block || '.' || get_block_property(f_block,FIRST_ITEM);&amp;#10;      loop&amp;#10;         exit when get_item_property(f_item,NAVIGABLE) = 'TRUE' ;&amp;#10;         f_item := f_block || '.' || get_item_property(f_item,NEXTITEM);&amp;#10;      end loop;&amp;#10;       default_value('TRUE','global.show_hint');&amp;#10;      If get_item_property(f_item,AUTO_HINT) = 'TRUE' and :global.show_hint = 'TRUE' then&amp;#10;         :global.show_hint  := 'FALSE';   &amp;#10;         new_item_msg := get_item_property(f_item,HINT_TEXT);&amp;#10;         message(substr(new_item_msg,1,80),no_acknowledge);&amp;#10;      end if;&amp;#10;   END;&amp;#10;begin&amp;#10;    default_value(null,'GLOBAL.warehouse');&amp;#10;    default_value(null,'GLOBAL.label_printer');&amp;#10; &#x9;&#x9;default_value(null,'GLOBAL.aglbl_printer');&amp;#10;-------------   &amp;#10;    -- IM:8600;06/26/2012&amp;#10;    validate_user_lab;&amp;#10;    --&amp;#10;    &amp;#10;    -- MLT 242; 08/01/2018&amp;#10;    l_status := SET_LAB_GLOBAL;&amp;#10;    &amp;#10;    IF l_status &lt;> 'OK' then&amp;#10;    &#x9;MESSAGE(l_status);&amp;#10;    &#x9;RAISE FORM_TRIGGER_FAILURE;&amp;#10;    END IF;&amp;#10;    &amp;#10;    show_hint;&amp;#10;&#x9;&#x9;------------&amp;#10;     &amp;#10;    -- Added on 02/16/2011; Timezone conversion code;&amp;#10;    declare&amp;#10;    &#x9;v_local_time date;&amp;#10;    begin&amp;#10;    &#x9;if is_timezone_enabled then&amp;#10;         Lifetrack_timezone_convert.get_local_time(:global.chapter_id,sysdate,v_local_time);&amp;#10;         :banner.hdr_date := v_local_time;&amp;#10;         :banner.hdr_time := to_char(v_local_time,'hh24:mi');&amp;#10;&#x9;  &#x9;else&amp;#10;         :banner.hdr_date := sysdate;&amp;#10;         :banner.hdr_time := to_char(sysdate,'hh24:mi');&amp;#10;&#x9;  &#x9;end if;&amp;#10;    end;&amp;#10;    ----------         &amp;#10;-----------------------    &amp;#10;    &amp;#10;    IF :GLOBAL.warehouse is not null THEN&amp;#10;        disp_wh := '[' || :GLOBAL.warehouse || ']';        &amp;#10;        BEGIN                                       -- modified on 02/16/2011; global.chapter_id condition added to rpt_master_codes;&amp;#10;           SELECT distinct 'x' INTO temp_x&amp;#10;           FROM rpt_master_codes &amp;#10;           WHERE  APPL_ID = 'DON' -- LT2018&amp;#10;           AND code_type = 'LBLPGM'&amp;#10;           AND code = prog_name&amp;#10;           AND nvl(chapter_id, :global.chapter_id) = :global.chapter_id;&amp;#10;&amp;#10;           IF :GLOBAL.label_printer IS NULL THEN&amp;#10;               BEGIN         &amp;#10;                   SELECT distinct 'x' INTO temp_x&amp;#10;                   FROM rpt_master_codes &amp;#10;                   WHERE  APPL_ID = 'DON' -- LT2018&amp;#10;                   AND code_type = 'LBLPTR'&amp;#10;                   AND location_id = :GLOBAL.warehouse&amp;#10;                   AND nvl(chapter_id, :global.chapter_id) = :global.chapter_id;&amp;#10;                   &amp;#10;                   Call_Form( lower('ASGLBLPT'));&amp;#10;               EXCEPTION&amp;#10;                    WHEN no_data_found THEN&amp;#10;                         null;&amp;#10;                    WHEN others THEN&amp;#10;                         handle_error;&amp;#10;               END;&amp;#10;            END IF;  &amp;#10;       EXCEPTION&amp;#10;           WHEN no_data_found THEN&amp;#10;                null;&amp;#10;           WHEN others THEN &amp;#10;                handle_error;&amp;#10;       END;&amp;#10;    END IF;        &amp;#10;    :GLOBAL.code_scheme := ''; --HCLC Code128&amp;#10;    --commented on 02/16/2011; Timezone code added above; Change for DoD&amp;#10;    /*&amp;#10;    :banner.hdr_date := sysdate; &amp;#10;    :banner.hdr_time := to_char(sysdate,'hh24:mi');&amp;#10;    */&amp;#10;    default_value('UNKNOWN', 'global.program_version');&amp;#10;--&amp;#10;    default_value('SYSTEM NAME','global.system_name');&amp;#10;    default_value('MODULE NAME','global.module_name');&amp;#10;--&amp;#10;    :banner.system_name :=&amp;#10;        lpad( :global.system_name, NVL(length(:global.system_name), 0) +&amp;#10;         floor((50 - NVL(length(:global.system_name), 0))/2),' ');&amp;#10;    :banner.module_name :=&amp;#10;        lpad( :global.module_name, NVL(length(:global.module_name), 0) +&amp;#10;         floor((50 - NVL(length(:global.module_name), 0))/2),' ');&amp;#10;--&amp;#10;    null; --PitssCOn display_item('banner.module_name','Bold-underline');&amp;#10;    :banner.prog_name := prog_name;&amp;#10;    if  substr(LT_USER_SESSION.get_userid,1,4) = 'OPS$'&amp;#10;    then&amp;#10;        :banner.user_id  := substr(LT_USER_SESSION.get_userid,5,6) ;&amp;#10;    else&amp;#10;        :banner.user_id  := substr(LT_USER_SESSION.get_userid,1,6) ;&amp;#10;    end if;&amp;#10;--&amp;#10;    default_value ('N/A','global.db_id');&amp;#10;    if  :global.db_id = 'N/A'&amp;#10;    then&amp;#10;        begin&amp;#10;            select&amp;#10;          decode(substr(global_name,3,1),'W','D',substr(global_name,3,1))   -- MLT- 4760&amp;#10;            into :global.db_id&amp;#10;            from global_name;&amp;#10;        exception&amp;#10;            when others then handle_error;&amp;#10;        end;&amp;#10;    end if;&amp;#10;    :banner.db_id := :global.db_id;&amp;#10;    :banner.colon := ':';&amp;#10;--&amp;#10;    :BANNER.PROG_VERSION := BANNER_PROG_VERSION;  &amp;#10;end ;" ParentType="37"/>
      <Trigger Name="PRE-FORM" TriggerText="default_value(null, 'GLOBAL.program_version');&amp;#10;default_value(null,'GLOBAL.AGLBL_PRINTER');&amp;#10;:GLOBAL.base_prg_version:= :GLOBAL.program_version;&amp;#10;--:GLOBAL.program_version := '01';&amp;#10;--:GLOBAL.program_version := '02'; -- IM 2488&amp;#10;--:GLOBAL.program_version := '03'; -- timezone issue. got OG_COMMON from sbclib and subclassed.  by jairam on 11-apr-2011&amp;#10;--:GLOBAL.program_version := '04'; /* IM 5208 4/14/11 Julius */&amp;#10;--:GLOBAL.program_version := '05'; -- IM# 5316&amp;#10;--:GLOBAL.program_version := '06'; -- Processing Facility Selection changes added.&amp;#10;--:global.program_version := '07'; -- Duplicate Objects removed from GRP_LAF_STND object group.&amp;#10;--:global.program_version := '08'; -- synchronize commented out - causing webutil errors.&amp;#10;&amp;#10;-- Below Version Got Re-Updated from LT2018&amp;#10;  --:global.program_version := '01';&amp;#10;  :global.program_version := '02'; -- MLT-7079&amp;#10;&amp;#10;execute_trigger('sbc_banner');&amp;#10;check_package_failure;&amp;#10;--synchronize;"/>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" FireInQuery="false" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN14' ) ;&amp;#10;   End if ;&amp;#10;   -- paint the canevases --&amp;#10;   If :PARAMETER.PM$CANVAS is not null Then &amp;#10;   &#x9; IF GET_APPLICATION_PROPERTY(DISPLAY_WIDTH) = 1152 THEN&amp;#10;   &#x9; &#x9;PKG_LOOK_AND_FEEL.Paint_Canevas('.canvas2', 'LAF_BLOCK.LAF_BEAN14' ) ;&amp;#10;     ELSE&amp;#10;     &#x9;PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN14' ) ;&amp;#10;     END IF;&amp;#10;   End if ;&amp;#10;&amp;#10;End if;&amp;#10;------------------------------------------------------&amp;#10;--  end code added for the LAF project integration  --&amp;#10;------------------------------------------------------&amp;#10;InitForm;&amp;#10;&amp;#10;declare&amp;#10;  temp_printer varchar2(15);&amp;#10;begin&amp;#10;    select code &amp;#10;    into temp_printer&amp;#10;    from rpt_master_codes&amp;#10;    where appl_id = 'DON' -- LT2018&amp;#10;    and code_type = 'LBLPTR'&amp;#10;    and location_id = :GLOBAL.warehouse&amp;#10;    AND nvl(chapter_id, :global.chapter_id) = :global.chapter_id; -- IM 5208&amp;#10;    :GLOBAL.label_printer := temp_printer;&amp;#10;    :GLOBAL.program_version := :GLOBAL.base_prg_version;&amp;#10;    exit_form(no_validate); &amp;#10;Exception &amp;#10;    When NO_DATA_FOUND then&amp;#10;         :GLOBAL.label_printer := null;&amp;#10;         exit_form(no_validate); &amp;#10;    When TOO_MANY_ROWS then&amp;#10;         default_value(null,'GLOBAL.label_printer');&amp;#10;         :ctrl_blk_1.clbl_ptr := :GLOBAL.label_printer;&amp;#10;         GO_BLOCK('rpt_master_codes');&amp;#10;         execute_query(no_validate);&amp;#10;         first_record;&amp;#10;         -- Added on 08/02/2012&amp;#10;         IF :ctrl_blk_1.clbl_ptr IS NOT NULL THEN&amp;#10;&#x9;         :CTRL_BLK_1.CUR_REC := NULL;&amp;#10;&#x9;         LOOP         &#x9;&amp;#10;&#x9;         &#x9;IF UPPER(:RPT_MASTER_CODES.CODE) = UPPER(:CTRL_BLK_1.CLBL_PTR) THEN&amp;#10;&#x9;         &#x9;&#x9;:CTRL_BLK_1.CUR_REC := :SYSTEM.CURSOR_RECORD;&amp;#10;&#x9;         &#x9;&#x9;EXIT;&amp;#10;&#x9;         &#x9;END IF;&amp;#10;&#x9;         &#x9;&amp;#10;&#x9;         &#x9;IF :SYSTEM.LAST_RECORD = 'TRUE' THEN&amp;#10;&#x9;         &#x9;&#x9;EXIT;&amp;#10;&#x9;         &#x9;ELSE&amp;#10;&#x9;         &#x9;&#x9;NEXT_RECORD;&amp;#10;&#x9;         &#x9;END IF;         &amp;#10;&#x9;         END LOOP;&amp;#10;         END IF;&amp;#10;         ------&amp;#10;         --PitssCOn display_item('rpt_master_codes.code','Bold-underline');&amp;#10;         --PitssCOn display_item('rpt_master_codes.code_desc','Bold-underline');&amp;#10;End;&amp;#10;&amp;#10;-- Added in LT47SP1.&amp;#10;default_value(null,'GLOBAL.COLLID_AUDIT_KEY');&amp;#10;DISPLAY_PROCESSING_FACILITY(in_collid_audit_key => :GLOBAL.COLLID_AUDIT_KEY); -- Displays current processing facility on screen.&amp;#10;&amp;#10;:CTRL_BLK_1.AGLBL_PTR := :GLOBAL.AGLBL_PRINTER;" DisplayInKeyboardHelp="true"/>
