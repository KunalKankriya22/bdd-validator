      <ProgramUnit Name="IS_TIMEZONE_ENABLED" ProgramUnitText="FUNCTION is_timezone_enabled RETURN BOOLEAN &amp;#10;IS&amp;#10;&#x9;/* Changed the lookup table to LT_APPLICATION_CONFIG&amp;#10;&#x9;to ensure consistency ,  on March 22, 2011&amp;#10;&#x9;*/&amp;#10;&#x9;&amp;#10;&#x9;v_timezone_active CHAR(1);&amp;#10;&#x9;&amp;#10;BEGIN&amp;#10;&amp;#10;&#x9;/*&amp;#10;&#x9;SELECT&#x9;time_zone_active&amp;#10;&#x9;INTO &#x9;v_timezone_active&amp;#10;  FROM &#x9;time_zone_enabled;&amp;#10;  */&amp;#10;&amp;#10;&#x9;SELECT&#x9;NVL(time_zone_enabled,'N')  &amp;#10;  INTO &#x9;&#x9;v_timezone_active&amp;#10;  FROM&#x9;&#x9;lt_application_config;&amp;#10;&amp;#10;&#x9;IF v_timezone_active ='Y' &amp;#10;&#x9;THEN&amp;#10;&#x9;&#x9;RETURN TRUE;&amp;#10;&#x9;ELSE&amp;#10;&#x9;&#x9;RETURN FALSE;&amp;#10;&#x9;END IF;&amp;#10;  &amp;#10;EXCEPTION&amp;#10;&#x9;WHEN NO_DATA_FOUND &amp;#10;&#x9;THEN&amp;#10;&#x9;&#x9;MESSAGE('No record in lt_application_config table!');&amp;#10;&#x9;&#x9;RETURN FALSE;&amp;#10;&#x9;WHEN OTHERS &amp;#10;&#x9;THEN&amp;#10;&#x9;&#x9;RETURN FALSE;&amp;#10;END;&amp;#10;" ProgramUnitType="Function"/>
      <RecordGroup Name="RG_WAREHOUSE_ID" RecordGroupFetchSize="0" RecordGroupQuery="select distinct warehouse_id , code_desc from valid_warehouse_users vwu, vserv_master vm where upper(vwu.user_id) = upper(LT_USER_SESSION.get_userid) and warehouse_id = code and code_type = 'LTYPE' and sysdate between vwu.eff_date and nvl(vwu.term_date,sysdate) and sysdate between vm.eff_date and nvl(vm.term_date, sysdate)" RecordGroupType="Query">
         <RecordGroupColumn Name="WAREHOUSE_ID" ColumnDataType="Character" MaximumLength="1"/>
         <RecordGroupColumn Name="CODE_DESC" ColumnDataType="Character" MaximumLength="50"/>
      </RecordGroup>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" FireInQuery="false" TriggerText="------------------------------------------------------&amp;#10;--    Code added for the LAF project integration    --&amp;#10;------------------------------------------------------&amp;#10; dbms_lock.sleep(2/10);&amp;#10; If PKG_Look_And_Feel.Open_Css(:PARAMETER.PM$CSS_FILENAME) Then&amp;#10;   If :PARAMETER.PM$GUI is not null Then&amp;#10;      -- read the global GUI properties --&amp;#10;      PKG_LOOK_AND_FEEL.Set_GUI_Properties( :PARAMETER.PM$GUI, 'LAF_BLOCK.LAF_BEAN15' ) ;&amp;#10;   End if ;&amp;#10;   -- paint the canevases --&amp;#10;   If :PARAMETER.PM$CANVAS is not null Then &amp;#10;     PKG_LOOK_AND_FEEL.Paint_Canevas(:PARAMETER.PM$CANVAS, 'LAF_BLOCK.LAF_BEAN15' ) ;&amp;#10;   End if ;&amp;#10;&amp;#10;End if;&amp;#10;------------------------------------------------------&amp;#10;--  end code added for the LAF project integration  --&amp;#10;------------------------------------------------------&amp;#10;&amp;#10;declare&amp;#10;  lov_flag  BOOLEAN;&amp;#10;  temp_printer varchar2(15);&amp;#10;  v_local_time DATE;&amp;#10;begin&amp;#10;&#x9;  -- Added by Kishore on 06/30/2011&amp;#10;    begin&amp;#10;&#x9;    select system_users.chapter_id     &amp;#10;        into :GLOBAL.chapter_id&amp;#10;        from  system_users&amp;#10;        where upper(user_id) = LT_USER_SESSION.get_userid;&amp;#10;          --and sysdate between system_users.eff_date and nvl(system_users.term_date, sysdate + 365); --IM:8600&amp;#10;    exception&amp;#10;      when NO_DATA_FOUND then&amp;#10;        message('Error in selecting chapter_id for user');&amp;#10;        exit_form(no_validate);&amp;#10;      when OTHERS then&amp;#10;        message('Error in selecting chapter_id for user');&amp;#10;        exit_form(no_validate);&amp;#10;    end;&amp;#10;&#x9;  -- End of change&amp;#10;&amp;#10;    --:global.program_version:='01';&amp;#10;    --:global.program_version:='02'; -- Added chapter id clause to below query. Added by Kishore on 06/30/2011&amp;#10;    --:global.program_Version := '03'; -- IM:8600; &amp;#10;    :global.program_version := '04'; -- Duplicate Objects Removed from GRP_LAF_STND object group.&amp;#10; &amp;#10;&#x9;&#x9; &amp;#10;&#x9;&#x9;-- IM:8600&amp;#10;&#x9;&#x9;if is_timezone_enabled then&amp;#10;&#x9;    Lifetrack_timezone_convert.get_local_time(:global.chapter_id, sysdate, v_local_time);&amp;#10;&#x9;&#x9;else&amp;#10;&#x9;    v_local_time := sysdate;&amp;#10;&#x9;&#x9;end if;&amp;#10;&#x9;&#x9;-- End of change&amp;#10;    &amp;#10;    select distinct warehouse_id, printer_id &amp;#10;    into :GLOBAL.warehouse, temp_printer&amp;#10;    from valid_warehouse_users &amp;#10;    where upper(user_id) = upper(LT_USER_SESSION.get_userid)&amp;#10;    and chapter_id = :global.chapter_id -- Added by Kishore on 06/30/2011 &amp;#10;    and v_local_time between eff_date and nvl(term_date,v_local_time+365)&amp;#10;    and exists (select 'x' from vserv_master &amp;#10;                      where code_type = 'LTYPE'&amp;#10;                      and code = valid_warehouse_users.warehouse_id&amp;#10;                      and sysdate between eff_date and nvl(term_date,sysdate)); &amp;#10;    BEGIN&amp;#10;         update system_users &amp;#10;         set warehouse_id = :Global.warehouse,&amp;#10;               print_id = nvl(temp_printer, print_id)&amp;#10;         where user_id = LT_USER_SESSION.get_userid;&amp;#10;         :system.message_level := 5;&amp;#10;         commit;&amp;#10;         :system.message_level := 0;&amp;#10;    EXCEPTION&amp;#10;        when others then &amp;#10;            null;&amp;#10;    END;&amp;#10;    :GLOBAL.startup_form_status := 'SUCCESS';&amp;#10;    exit_form(no_validate); &amp;#10;Exception &amp;#10;    When NO_DATA_FOUND then&amp;#10;         message('No warehouse has been defined for you. Contact your Supervisor');&amp;#10;         exit_form(no_validate);&amp;#10;    When TOO_MANY_ROWS then&amp;#10;         execute_query(no_validate);&amp;#10;         first_record;&amp;#10;         --PitssCOn display_item('valid_warehouse_users.warehouse_id','Bold-underline');&amp;#10;         --PitssCOn display_item('valid_warehouse_users.warehouse_desc','Bold-underline');&amp;#10;End;" DisplayInKeyboardHelp="true"/>
