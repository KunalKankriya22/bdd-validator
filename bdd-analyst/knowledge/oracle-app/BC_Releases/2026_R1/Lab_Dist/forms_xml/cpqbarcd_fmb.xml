            <Trigger Name="KEY-NEXT-ITEM" FireInQuery="false" TriggerText="DECLARE&amp;#10;   field_len number;&amp;#10;   start_1 VARCHAR2(1);&amp;#10;   start_2 VARCHAR2(1);&amp;#10;   term_1 VARCHAR2(1);&amp;#10;   term_2 VARCHAR2(1);&amp;#10;BEGIN&amp;#10;   select nvl(NVL(length(:ctrl_blk_1.s_scan_field), 0), 0) into field_len&amp;#10;      from dual;&amp;#10;   if (field_len &lt; 2) then&amp;#10;      message ('MESSAGE:  You must scan in a barcode,  or hit EXIT.');&amp;#10;      raise form_trigger_failure;&amp;#10;   end if;&amp;#10;   select upper(substr(:ctrl_blk_1.s_scan_field, 1, 1)) into start_1&amp;#10;      from dual;&amp;#10;   select upper(substr(:ctrl_blk_1.s_scan_field, 2, 1)) into start_2&amp;#10;      from dual;&amp;#10;   select upper(substr(:ctrl_blk_1.s_scan_field, field_len, 1))&amp;#10;      into term_1&amp;#10;      from dual;&amp;#10;   select upper(substr(:ctrl_blk_1.s_scan_field, field_len-1, 1))&amp;#10;      into term_2&amp;#10;      from dual;&amp;#10;   go_block('display');&amp;#10;   clear_block;&amp;#10;   go_block('ctrl_blk_1');&amp;#10;   if (field_len = 5) then&amp;#10;      if (start_1 = 'D' and term_1 = 'B') then&amp;#10;         if (term_2 = '$') then&amp;#10;            execute_trigger ('primary_collection_label');&amp;#10;         elsif (term_2 = '+') then&amp;#10;            execute_trigger ('satellite_transfer_label');&amp;#10;         elsif (term_2 = '0') then&amp;#10;            execute_trigger ('blood_type_label');&amp;#10;         else&amp;#10;            execute_trigger ('scan_error');&amp;#10;         end if;&amp;#10;      else&amp;#10;         execute_trigger ('scan_error');&amp;#10;      end if;&amp;#10;   elsif (field_len = 6) then&amp;#10;      if (start_1 = 'C' and term_2 = '3' and term_1 = 'B') then&amp;#10;         execute_trigger ('attribute_label');&amp;#10;      else&amp;#10;         execute_trigger ('scan_error');&amp;#10;      end if;&amp;#10;   elsif (field_len = 7) then&amp;#10;      if (start_1 = 'A' and term_1 = 'C') then&amp;#10;         execute_trigger ('expire_date_label');&amp;#10;      elsif (start_1 = 'B' and term_1 = 'D') then&amp;#10;         execute_trigger ('donor_exclusion_label');&amp;#10;      else&amp;#10;         execute_trigger ('scan_error');&amp;#10;      end if;&amp;#10;   elsif (field_len = 8) then&amp;#10;      if (start_1 = 'A' and term_1 = 'C') then&amp;#10;         execute_trigger ('expire_date_label');&amp;#10;      else&amp;#10;         execute_trigger ('scan_error');&amp;#10;      end if;&amp;#10;   elsif (field_len = 9) then&amp;#10;      if (start_1 = 'A' and start_2 = '0' and&amp;#10;          term_2 = '3' and term_1 = 'B') then&amp;#10;         execute_trigger ('component_label');&amp;#10;      elsif (start_1 = 'D' and term_1 = 'D') then&amp;#10;         execute_trigger ('unit_label');&amp;#10;      else&amp;#10;         execute_trigger ('scan_error');&amp;#10;      end if;&amp;#10;   elsif (field_len = 11) then&amp;#10;      if (start_1 = 'A' and start_2 = '0' and&amp;#10;          term_2 = '1' and term_1 = 'B') then&amp;#10;         execute_trigger ('registration_label');&amp;#10;      else&amp;#10;         execute_trigger ('scan_error');&amp;#10;      end if;&amp;#10;   else&amp;#10;      execute_trigger ('scan_error');&amp;#10;   end if;&amp;#10;END;" DisplayInKeyboardHelp="true"/>
         </Item>
