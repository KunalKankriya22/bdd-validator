      <Trigger Name="ATTRIBUTE_LABEL" FireInQuery="false" TriggerText="BEGIN&amp;#10;   go_block ('display');&amp;#10;   :display.barcode_type := 'Special Attribute Label';&amp;#10;   select substr(:ctrl_blk_1.s_scan_field,2,3)&amp;#10;     into :display.barcode_value&amp;#10;     from dual;&amp;#10;   BEGIN&amp;#10;      select label_interpretation into :display.barcode_inter&amp;#10;        from barcode_values&amp;#10;       where label_type = 'ATTR'&amp;#10;         and label_value = substr(:ctrl_blk_1.s_scan_field,2,3)&amp;#10;         and sysdate between eff_date and nvl(term_date,  sysdate+1);&amp;#10;      EXCEPTION&amp;#10;         when NO_DATA_FOUND then&amp;#10;            execute_trigger ('read_error');&amp;#10;         when OTHERS then&amp;#10;            handle_error;&amp;#10;            check_package_failure;&amp;#10;   END;&amp;#10;   go_block('ctrl_blk_1');&amp;#10;           GO_ITEM ('s_scan_field');&amp;#10;           CLEAR_ITEM;&amp;#10;END;" DisplayInKeyboardHelp="true"/>
