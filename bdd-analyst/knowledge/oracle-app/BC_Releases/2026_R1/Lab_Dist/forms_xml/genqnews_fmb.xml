      <ProgramUnit Name="USER_QUERY" ProgramUnitText="procedure user_query is&amp;#10;    cursor c1 is&amp;#10;        select substr(rtrim(user_last_name) || ', ' ||&amp;#10;                      rtrim(user_first_name),1,50) user_name&amp;#10;        from   fcn_grp_priv fgp, system_users&amp;#10;        where  fgp.user_id = system_users.user_id&amp;#10;        and chapter_id = :GLOBAL.chapter_id&amp;#10;                                     /*MODIFIED BY HCL CONSULTING*/&amp;#10;          and  not exists (select *&amp;#10;                           from   news_log&amp;#10;                           where  user_id = substr(fgp.user_id,5,6)&amp;#10;                             and  news_id = :news_status_info.news_id&amp;#10;                             and  appl_id = :s_appl_id)&amp;#10;          and  acc_priv > 0&amp;#10;          and  appl_id = :s_appl_id&amp;#10;    order by 1;&amp;#10;begin&amp;#10;  go_block('user_info');&amp;#10;   for c1_rec in c1&amp;#10;    loop&amp;#10;       :user_info.s_user_name := c1_rec.user_name;&amp;#10;       down;&amp;#10;    end loop;&amp;#10;  if :system.last_record = 'TRUE'&amp;#10;  then&amp;#10;     clear_record;&amp;#10;     go_record(1);&amp;#10;  end if;&amp;#10;         SET_ITEM_PROPERTY('USER_INFO.S_USER_NAME',INSERT_ALLOWED,PROPERTY_FALSE);&amp;#10;  SET_ITEM_PROPERTY( 'USER_INFO.S_USER_NAME', UPDATEABLE, PROPERTY_FALSE );&amp;#10;  GO_ITEM('news_status_info.news_id');&amp;#10;end;" ProgramUnitType="Procedure"/>
      <RecordGroup Name="CTRL_BLK_1_NEWS_ID_LOV0" RecordGroupFetchSize="0" RecordGroupQuery="select news_status.news_id, description from news_status where news_status.appl_id = :s_appl_id and not exists (select * from news_log where news_log.news_id = news_status.news_id and news_log.appl_id = news_status.appl_id) union select news_log.news_id, description from news_log, news_status where news_log.news_id = news_status.news_id and news_log.appl_id = news_status.appl_id and not exists (select * from fcn_grp_priv fgp where news_log.user_id = fgp.user_id and news_log.appl_id = fgp.appl_id) and news_log.appl_id = :s_appl_id order by 1" RecordGroupType="Query">
