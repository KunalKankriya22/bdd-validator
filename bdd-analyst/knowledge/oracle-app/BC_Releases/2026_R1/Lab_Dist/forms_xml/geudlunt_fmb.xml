            <Trigger Name="VALIDATE_FIELD" TriggerText="DECLARE&amp;#10;  temp_count   number;&amp;#10;  v_status  number;&amp;#10;BEGIN&amp;#10; nullchk;&amp;#10; check_package_failure;&amp;#10; &amp;#10; :ctrl_blk_1.units_yes := 'N'; -- set in appl_rep_columns - post_query if units are found.&amp;#10; &amp;#10;/* Check whether unihas any pooled products*/&amp;#10;begin&amp;#10;  select distinct 'x' into :global.x&amp;#10;    from units&amp;#10;   where unit_id = :ctrl_blk_1.unit_id&amp;#10;      and chapter_id = :GLOBAL.chapter_id&amp;#10;      and contract_id = 'POOL';&amp;#10;&amp;#10;      :ctrl_blk_1.unit_id :='';&amp;#10;      go_item('ctrl_blk_1.s_unit_id');&amp;#10;      clear_item;  &amp;#10;      show_error('0048');&amp;#10;      check_package_failure;&amp;#10;&amp;#10;exception&amp;#10;  when no_data_found then&amp;#10;&amp;#10; -- Check whether the units exists in Components table, if yes check whether&amp;#10; -- the products are in Lab&amp;#10;  begin&amp;#10;      select count(*) &amp;#10;      into temp_count&amp;#10;      from components&amp;#10;     where unit_id = :ctrl_blk_1.unit_id&amp;#10;      and chapter_id = :GLOBAL.chapter_id;&amp;#10;       if temp_count > 0 then&amp;#10;         begin&amp;#10;          select count(*)&amp;#10;             into v_status&amp;#10;           from components&amp;#10;          where unit_id = :ctrl_blk_1.unit_id&amp;#10;            and chapter_id = :GLOBAL.chapter_id&amp;#10;            and component_status != 'L';&amp;#10;             if v_status > 0 then&amp;#10;                :ctrl_blk_1.unit_id :='';&amp;#10;                go_item('ctrl_blk_1.s_unit_id');&amp;#10;                clear_item;  &amp;#10;                show_error('0047');&amp;#10;                check_package_failure;&amp;#10;            else&amp;#10;                find_units(:ctrl_blk_1.unit_id) ;&amp;#10;             end if;&amp;#10;          exception&amp;#10;             when others then&amp;#10;               handle_error;&amp;#10;   