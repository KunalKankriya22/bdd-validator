      <Trigger Name="KEY-COMMIT" DirtyInfo="true" TriggerText="declare&amp;#10;     log_path  varchar2(30);&amp;#10;     succ_log  varchar2(50);&amp;#10;     err_log     varchar2(50);&amp;#10;     succ_log_file  varchar2(50);&amp;#10;     err_log_file     varchar2(50);&amp;#10;     al_button  number; &amp;#10;     temp_printer  VARCHAR2(10);&amp;#10;     usr_id        varchar2(15) := name_in('banner.user_id'); &amp;#10;     s_print_id    varchar2(80);&amp;#10;     temp_count    number;&amp;#10;     v_local_time  date;&amp;#10;     v_local_date  date;&amp;#10;begin&amp;#10;&#x9;&amp;#10;&#x9;  if is_timezone_enabled then&amp;#10;&#x9;  &amp;#10;&#x9;  &#x9;&#x9;Lifetrack_timezone_convert.get_local_time(:global.chapter_id,sysdate,v_local_time);&amp;#10;&#x9;&#x9; &#x9;&#x9; v_local_date := v_local_time;&amp;#10;&#x9;&#x9;else &amp;#10;&#x9;&#x9;&#x9;   v_local_date := sysdate;&amp;#10;&#x9;&#x9;end if;&amp;#10;&#x9;  &#x9;&amp;#10;      begin&amp;#10;        select nvl(print_id, 'hplaser3si')&amp;#10;        into   temp_printer&amp;#10;        from   system_users&amp;#10;        where  chapter_id  = :GLOBAL.chapter_id&amp;#10;          and  (   user_id = usr_id&amp;#10;                or user_id = 'OPS$' || usr_id);&amp;#10;        exception&amp;#10;          when no_data_found&amp;#10;          then&amp;#10;            null;&amp;#10;          when others&amp;#10;          then&amp;#10;            handle_error;&amp;#10;            check_package_failure;&amp;#10;        end;&amp;#10;    -- IM 474    &amp;#10;&#x9;&#x9;DECLARE&amp;#10;&#x9;&#x9;&#x9;alert_info lt_alert.payload_rt;&amp;#10;&#x9;&#x9;BEGIN&amp;#10;     &#x9;alert_info.title &#x9;&#x9;&#x9;&#x9;&#x9;:= NULL;&amp;#10;     &#x9;alert_info.message &#x9;&#x9;&#x9;&#x9;:= 'Products will be moved to Distribution. Do you wish to continue?';&amp;#10;     &#x9;alert_info.alert_style &#x9;&#x9;:= 'Caution';&amp;#10;     &#x9;alert_info.button1_lbl &#x9;&#x9;:= 'Yes';&amp;#10;     &#x9;alert_info.button2_lbl &#x9;&#x9;:= 'No';&amp;#10;     &#x9;alert_info.button3_lbl &#x9;&#x9;:= NULL;&amp;#10;     &#x9;alert_info.default_button := 'Button1';&amp;#10;     &#x9;&amp;#10;     &#x9;lt_alert.init_alert(alert_info);&amp;#10;     &#x9;CALL_FORM( LOWER('utwalert.fmx') ,NO_HIDE ,NO_REPLACE);&#x9;&amp;#10;        &amp;#10;        &amp;#10;      --al_button := show_alert('al_chkin'); -- IM 474&amp;#10;      --If al_button = alert_button1 then -- IM 474&amp;#10;      If lt_alert.button1&#x9;THEN&amp;#10;--      show_error_dist('9200','Products will be moved to Distribution');&amp;#10; &#x9;       :ctrl_blk_1.start_dats := v_local_date;--sysdate;&amp;#10;           impbchkn.impbchkn(:GLOBAL.warehouse,:global.chapter_id);&amp;#10;          :ctrl_blk_1.end_dats := v_local_date;--sysdate;&amp;#10;--          show_error_dist('9300','Product Check-in complete');&amp;#10;         begin&amp;#10;          select code_desc&amp;#10;          into     log_path&amp;#10;          from   vserv_master&amp;#10;          where code_type = 'MISC'&amp;#10;          and     code         =  'LOGDR'&amp;#10;          and     sysdate between eff_date and nvl(term_date,sysdate);&amp;#10;         &amp;#10;        exception&amp;#10;          when others then&amp;#10;             handle_error;&amp;#10;             check_package_failure;&amp;#10;        end;&amp;#10;          succ_log_file:='IMPBCHKN_SUC_'||to_char(sysdate,'MMDDYYHH24MI')||'.log';&amp;#10;          err_log_file:='IMPBCHKN_ERR_'||to_char(sysdate,'MMDDYYHH24MI')||'.log';&amp;#10;          &amp;#10;          succ_log := log_path||'/'||succ_log_file;  --'IMPBCHKN_SUC_'||to_char(sysdate,'MMDDYYHH24MI')||'.log';&amp;#10;          err_log := log_path||'/'||err_log_file; --'IMPBCHKN_ERR_'||to_char(sysdate,'MMDDYYHH24MI')||'.log';&amp;#10;          &amp;#10;          /* Added to get the reprint capability */&amp;#10;          --HOST('cp -f '||succ_log||' $REPOUTPUT/IMPBCHKN_SUC_'||:banner.user_id||'.r', NO_PROMPT);&amp;#10;          --HOST('cp -f '||err_log||' $REPOUTPUT/IMPBCHKN_ERR_'||:banner.user_id||'.r', NO_PROMPT);&amp;#10;          BEGIN&amp;#10;            SELECT count(*)&amp;#10;              INTO  temp_count&amp;#10;            FROM   rpt_parm&amp;#10;           WHERE  appl_id = 'DON'&amp;#10;            AND   user_name = :banner.user_id&amp;#10;           AND   report_name = 'IMPBCHKN' &amp;#10;           AND chapter_id = :GLOBAL.chapter_id -- IM 713&amp;#10;           AND   parm_id = 'SUC';&amp;#10;          &amp;#10;            IF temp_count = 0 THEN&amp;#10;             BEGIN&amp;#10;              INSERT into rpt_parm&amp;#10;              (appl_id,user_name,report_name,parm_id,&amp;#10;               parm_date,submit_date,output_file,report_status, chapter_id) -- IM 713 (chapter_id added)&amp;#10;              VALUES&amp;#10;              ('DON',:banner.user_id, 'IMPBCHKN',&amp;#10;                'SUC',sysdate,sysdate,succ_log_file,'C', :GLOBAL.chapter_id);&amp;#10;             EXCEPTION&amp;#10;               when OTHERS then&amp;#10;                  handle_error;&amp;#10;             END;&amp;#10;           ELSE&amp;#10;             BEGIN&amp;#10;                 UPDATE rpt_parm&amp;#10;                  set parm_date = sysdate,&amp;#10;                        submit_date = sysdate,&amp;#10;                        output_file=succ_log_file&amp;#10;                  where appl_id = 'DON'&amp;#10;                    and   user_name = :banner.user_id&amp;#10;                     and  report_name = 'IMPBCHKN'&amp;#10;                     and chapter_id = :GLOBAL.chapter_id -- IM 713&amp;#10;                     and  parm_id = 'SUC';&amp;#10;             EXCEPTION&amp;#10;                 when others  then&amp;#10;                       handle_error;&amp;#10;                       check_package_failure;&amp;#10;              END;  &amp;#10;        END IF;&amp;#10;         EXCEPTION&amp;#10;            when OTHERS&amp;#10;            then&amp;#10;               handle_error;&amp;#10;               check_package_failure;&amp;#10;         END;&amp;#10;         BEGIN&amp;#10;            SELECT count(*)&amp;#10;              INTO  temp_count&amp;#10;            FROM   rpt_parm&amp;#10;           WHERE  appl_id = 'DON'&amp;#10;            AND   user_name = :banner.user_id&amp;#10;           AND   report_name = 'IMPBCHKN' &amp;#10;           AND chapter_id = :GLOBAL.chapter_id -- IM 713&amp;#10;           AND   parm_id = 'ERR';&amp;#10;          &amp;#10;            IF temp_count = 0 THEN&amp;#10;             BEGIN&amp;#10;              INSERT into rpt_parm&amp;#10;              (appl_id,user_name,report_name,parm_id,&amp;#10;               parm_date,submit_date,output_file,report_status, chapter_id) -- IM 713 (chapter_id added)&amp;#10;              VALUES&amp;#10;              ('DON',:banner.user_id, 'IMPBCHKN',&amp;#10;                'ERR', sysdate,sysdate,err_log_file,'C', :GLOBAL.chapter_id);&amp;#10;          EXCEPTION&amp;#10;               when OTHERS then&amp;#10;                  handle_error;&amp;#10;         END;&amp;#10;         ELSE&amp;#10;             BEGIN&amp;#10;                 UPDATE rpt_parm&amp;#10;                  set parm_date = sysdate,&amp;#10;                        submit_date = sysdate,&amp;#10;                        output_file=err_log_file&amp;#10;                  where appl_id = 'DON'&amp;#10;                    and   user_name = :banner.user_id&amp;#10;                     and  report_name = 'IMPBCHKN'&amp;#10;                     and chapter_id = :GLOBAL.chapter_id -- IM 713&amp;#10;                     and  parm_id = 'ERR';&amp;#10;             EXCEPTION&amp;#10;                 when others  then&amp;#10;                       handle_error;&amp;#10;                       check_package_failure;&amp;#10;              END;  &amp;#10;        END IF;&amp;#10;         EXCEPTION&amp;#10;            when OTHERS&amp;#10;            then&amp;#10;               handle_error;&amp;#10;               check_package_failure;&amp;#10;         END; &amp;#10;         :system.message_level := 5;&amp;#10;          commit;&amp;#10;         :system.message_level :=0; &amp;#10;          --HOST('lp -d  '||temp_printer||' '||succ_log||' '||err_log, NO_PROMPT);&amp;#10;          message('Product Check-in complete !');pause;&amp;#10; --         al_button := show_alert('al_msg'); &amp;#10;     end if; -- alert if;&amp;#10;    END; -- IM 474&amp;#10;    &amp;#10;    execute_trigger('Key-Clrfrm');&amp;#10;exception&amp;#10;   when others then&amp;#10;       message(sqlerrm); &amp;#10;      raise form_trigger_failure;&amp;#10;end;&amp;#10;"/>
