      <Trigger Name="PRE-FORM" FireInQuery="false" TriggerText="--:global.program_version := '01';&amp;#10;--:global.program_version := '02';  --Rel: 4.5.0 (not able to view the log files SUC and ERR)&amp;#10;--:global.program_version := '03';  --Rel: 4.5.0 (not able to view the log files SUC and ERR): problem in the update statement&amp;#10;--:global.program_version := '04'; -- IM 5083&amp;#10;--  :global.program_version := '05'; -- Duplicate objects removal from GRP_LAF_STND object class.&amp;#10;&amp;#10;-- Below Version Got Re-Updated from LT2018&amp;#10;--:global.program_version := '01';&amp;#10;--:global.program_version := '02';&amp;#10;--:global.program_version := '03'; -- IM 474&amp;#10;:global.program_version := '04'; -- IM 713 (chapter ID added to rpt_parm query)&amp;#10;&amp;#10;execute_trigger('SBC_BANNER');&amp;#10;check_package_failure;" DisplayInKeyboardHelp="true"/>
