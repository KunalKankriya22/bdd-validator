      <ProgramUnit Name="PERFORM_COMMIT" ProgramUnitText="PROCEDURE perform_commit IS&amp;#10;     log_path  varchar2(30);&amp;#10;     succ_log  varchar2(150);&amp;#10;     succ_file varchar2(100);&amp;#10;     err_log     varchar2(150);&amp;#10;     err_file    varchar2(150);&amp;#10;     &amp;#10;     al_button  number; &amp;#10;     temp_printer  VARCHAR2(10);&amp;#10;     usr_id        varchar2(15) := name_in('banner.user_id'); &amp;#10;     s_print_id    varchar2(80);&amp;#10;     temp_count    number;&amp;#10;     data_file   varchar2(50);&amp;#10;     v_local_time date;&amp;#10;begin&amp;#10;        begin&amp;#10;        select nvl(print_id, 'hplaser3si')&amp;#10;        into   temp_printer&amp;#10;        from   system_users&amp;#10;        where  chapter_id  = :GLOBAL.chapter_id&amp;#10;          and  (   user_id = usr_id&amp;#10;                or user_id = 'OPS$' || usr_id);&amp;#10;        exception&amp;#10;          when no_data_found&amp;#10;          then&amp;#10;            null;&amp;#10;          when others&amp;#10;          then&amp;#10;            handle_error;&amp;#10;            check_package_failure;&amp;#10;      end;&amp;#10;      al_button := show_alert('al_chkin');&amp;#10;      If al_button = alert_button1 then&amp;#10;          :ctrl_blk_1.start_dats := sysdate;&amp;#10;&#x9;   &#x9;    &amp;#10;&#x9;   &#x9;    -- time zone change --03/10/11--sandip&amp;#10;&#x9; &#x9;   if Is_TIMEZONE_ENABLED then&amp;#10;&#x9;      &#x9;Lifetrack_timezone_convert.get_local_time(:global.chapter_id,to_date(to_char(:ctrl_blk_1.start_dats,'MM-DD-YY HH24:MI'),'MM-DD-YY HH24:MI'),v_local_time);&amp;#10;&#x9;&#x9;&#x9;   &#x9;:ctrl_blk_1.s_start_dats := to_date(to_char(v_local_time,'MM-DD-YY HH24:MI'),'MM-DD-YY HH24:MI');&amp;#10;&#x9;&#x9;&#x9; else&amp;#10;&#x9;&#x9;&#x9;   &#x9;:ctrl_blk_1.s_start_dats := to_date(to_char(sysdate,'MM-DD-YY HH24:MI'),'MM-DD-YY HH24:MI');&amp;#10;&#x9;&#x9;   end if;           &amp;#10;&#x9;          &amp;#10;          --lthcllin.lthcllin(:GLOBAL.warehouse, :ctrl_blk_1.facility, :ctrl_blk_1.start_dats); -- Commented by Kishore on 01/10/2013. IM 5775&amp;#10;          lthcllin.lthcllin(:GLOBAL.warehouse, :ctrl_blk_1.facility, :ctrl_blk_1.start_dats, :global.chapter_id); -- Added by Kishore on 01/10/2013. IM 5775&amp;#10;          :ctrl_blk_1.end_dats := sysdate;&amp;#10;          &amp;#10;&#x9; &#x9;   if Is_TIMEZONE_ENABLED then&amp;#10;&#x9;      &#x9;Lifetrack_timezone_convert.get_local_time(:global.chapter_id,to_date(to_char(:ctrl_blk_1.end_dats,'MM-DD-YY HH24:MI'),'MM-DD-YY HH24:MI'),v_local_time);&amp;#10;&#x9;&#x9;&#x9;   &#x9;:ctrl_blk_1.s_end_dats := to_date(to_char(v_local_time,'MM-DD-YY HH24:MI'),'MM-DD-YY HH24:MI');&amp;#10;&#x9;&#x9;&#x9; else&amp;#10;&#x9;&#x9;&#x9;   &#x9;:ctrl_blk_1.s_end_dats := to_date(to_char(sysdate,'MM-DD-YY HH24:MI'),'MM-DD-YY HH24:MI');&amp;#10;&#x9;&#x9;   end if;                   &amp;#10;          &amp;#10;         begin&amp;#10;          select code_desc&amp;#10;          into     log_path&amp;#10;          from   vserv_master&amp;#10;          where code_type = 'MISC'&amp;#10;          and     code         =  'LOGDR'&amp;#10;          and     sysdate between eff_date and nvl(term_date,sysdate);&amp;#10;        exception&amp;#10;          when others then&amp;#10;             handle_error;&amp;#10;             check_package_failure;&amp;#10;        end;&amp;#10;          succ_log := log_path||'/'||'LTHCLLIN_SUC_'||to_char(:ctrl_blk_1.start_dats,'MMDDYYHH24MISS')||'.log';&amp;#10;          succ_file:='LTHCLLIN_SUC_'||to_char(:ctrl_blk_1.start_dats,'MMDDYYHH24MISS')||'.log';&amp;#10;          &amp;#10;          err_log := log_path||'/'||'LTHCLLIN_ERR_'||to_char(:ctrl_blk_1.start_dats,'MMDDYYHH24MISS')||'.log';&amp;#10;          err_file:='LTHCLLIN_ERR_'||to_char(:ctrl_blk_1.start_dats,'MMDDYYHH24MISS')||'.log';&amp;#10;          &amp;#10;          /* Added to get the reprint capability */&amp;#10;          --HOST('cp -f '||succ_log||' $REPOUTPUT/LTHCLLIN_SUC_'||:banner.user_id||'.r', NO_PROMPT);  for 4.1.0&amp;#10;          --HOST('cp -f '||err_log||' $REPOUTPUT/LTHCLLIN_ERR_'||:banner.user_id||'.r', NO_PROMPT);&amp;#10;          BEGIN&amp;#10;            SELECT count(*)&amp;#10;              INTO  temp_count&amp;#10;            FROM   rpt_parm&amp;#10;           WHERE  appl_id = 'DON'&amp;#10;            AND   user_name = :banner.user_id&amp;#10;           AND   report_name = 'LTHCLLIN' &amp;#10;           AND   parm_id = 'SUC';&amp;#10;          &amp;#10;            IF temp_count = 0 THEN&amp;#10;             BEGIN&amp;#10;              INSERT into rpt_parm&amp;#10;              (appl_id,user_name,report_name,parm_id,&amp;#10;               parm_date,submit_date,report_status,output_file)&amp;#10;              VALUES&amp;#10;              ('DON',:banner.user_id, 'LTHCLLIN',&amp;#10;                'SUC',sysdate,sysdate,'C',succ_file);&amp;#10;             EXCEPTION&amp;#10;               when OTHERS then&amp;#10;                  handle_error;&amp;#10;             END;&amp;#10;           ELSE&amp;#10;             BEGIN&amp;#10;                 UPDATE rpt_parm&amp;#10;                    set parm_date = sysdate,&amp;#10;                        submit_date = sysdate,&amp;#10;                        output_file = succ_file &amp;#10;                  where appl_id = 'DON'&amp;#10;                    and user_name = :banner.user_id&amp;#10;                    and report_name = 'LTHCLLIN'&amp;#10;                    and parm_id = 'SUC';&amp;#10;             EXCEPTION&amp;#10;                 when others  then&amp;#10;                       handle_error;&amp;#10;                       check_package_failure;&amp;#10;              END;  &amp;#10;        END IF;&amp;#10;         EXCEPTION&amp;#10;            when OTHERS&amp;#10;            then&amp;#10;               handle_error;&amp;#10;               check_package_failure;&amp;#10;         END;&amp;#10;         BEGIN&amp;#10;            SELECT count(*)&amp;#10;              INTO temp_count&amp;#10;              FROM rpt_parm&amp;#10;             WHERE appl_id = 'DON'&amp;#10;               AND user_name = :banner.user_id&amp;#10;               AND report_name = 'LTHCLLIN' &amp;#10;               AND parm_id = 'ERR';&amp;#10;          &amp;#10;            IF temp_count = 0 THEN&amp;#10;             BEGIN&amp;#10;              INSERT into rpt_parm&amp;#10;              (appl_id,user_name,report_name,parm_id,&amp;#10;               parm_date,submit_date,report_status,output_file)&amp;#10;              VALUES&amp;#10;              ('DON',:banner.user_id, 'LTHCLLIN',&amp;#10;                'ERR', sysdate,sysdate,'C',err_file);&amp;#10;          EXCEPTION&amp;#10;               when OTHERS then&amp;#10;                  handle_error;&amp;#10;         END;&amp;#10;         ELSE&amp;#10;             BEGIN&amp;#10;                 UPDATE rpt_parm&amp;#10;                    set parm_date = sysdate,&amp;#10;                        submit_date = sysdate,&amp;#10;                        output_file = err_file&amp;#10;                  where appl_id = 'DON'&amp;#10;                    and user_name = :banner.user_id&amp;#10;                    and report_name = 'LTHCLLIN'&amp;#10;                    and parm_id = 'ERR';&amp;#10;             EXCEPTION&amp;#10;                 when others  then&amp;#10;                       handle_error;&amp;#10;                       check_package_failure;&amp;#10;              END;  &amp;#10;        END IF;&amp;#10;         EXCEPTION&amp;#10;            when OTHERS&amp;#10;            then&amp;#10;               handle_error;&amp;#10;               check_package_failure;&amp;#10;         END; &amp;#10;         :system.message_level := 5;&amp;#10;          commit;&amp;#10;         :system.message_level :=0; &amp;#10;          HOST('ltsndhcll.sh '||'LTHCLLIN_'||to_char(:ctrl_blk_1.start_dats,'MMDDYYHH24MISS')||'.dat');      &amp;#10;          HOST('lp -d  '||temp_printer||' '||succ_log||' '||err_log, NO_PROMPT);&amp;#10;          message('Transfer complete !');pause;&amp;#10; --         al_button := show_alert('al_msg'); &amp;#10;     end if;&amp;#10;     execute_trigger('Key-Clrfrm');&amp;#10;exception&amp;#10;   when others then&amp;#10;       message(sqlerrm); &amp;#10;      raise form_trigger_failure;&amp;#10;end;&amp;#10;" ProgramUnitType="Procedure"/>
