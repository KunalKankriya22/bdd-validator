      <ProgramUnit Name="RESEQUENCE" ProgramUnitText="PROCEDURE RESEQUENCE IS&amp;#10;   rg_id  RecordGroup;&amp;#10;   gc_id1  GroupColumn;&amp;#10;   gc_id2  GroupColumn;&amp;#10;   ctr     number(3) := 0;&amp;#10;   temp_rec number;&amp;#10;   temp_seq number;  &amp;#10;   rec_no number(3);&amp;#10;BEGIN&amp;#10;    /* Put all record no's and sequences in an array (record_group) &amp;#10;        leave the terminated ones*/&amp;#10;   go_block('band_results');&amp;#10;   rec_no := :system.cursor_record; &amp;#10;   go_record('1');&amp;#10;   rg_id := create_group('SORT_GRP');&amp;#10;   gc_id1 := add_group_column('SORT_GRP', 'RECNUM',NUMBER_COLUMN);&amp;#10;   gc_id2 := add_group_column('SORT_GRP','SEQNUM',NUMBER_COLUMN);&amp;#10;   loop&amp;#10;       ctr := ctr + 1;&amp;#10;       ADD_GROUP_ROW(rg_id,END_OF_GROUP);&amp;#10;       SET_GROUP_NUMBER_CELL(gc_id1,ctr,:SYSTEM.cursor_record);&amp;#10;       SET_GROUP_NUMBER_CELL(gc_id2,ctr,:band_results.s_result_seq);&amp;#10;       exit when :system.last_record = 'TRUE';&amp;#10;       down;&amp;#10;   end loop; &amp;#10;   /* Bubble sort the record group on sequence */&amp;#10;   for i in 1 .. ctr - 1&amp;#10;   loop&amp;#10;       for j in i+1 .. ctr&amp;#10;       loop&amp;#10;           IF  GET_GROUP_NUMBER_CELL(gc_id2,i) > &amp;#10;                GET_GROUP_NUMBER_CELL(gc_id2,j)&amp;#10;           THEN&amp;#10;               temp_seq := get_group_number_cell(gc_id2,i);&amp;#10;               temp_rec := get_group_number_cell(gc_id1,i); &amp;#10;               set_group_number_cell(gc_id1,i,get_group_number_cell(gc_id1,j)); &amp;#10;               set_group_number_cell(gc_id2,i,get_group_number_cell(gc_id2,j));&amp;#10;               set_group_number_cell(gc_id1,j,temp_rec); &amp;#10;               set_group_number_cell(gc_id2,j,temp_seq); &amp;#10;          END IF;&amp;#10;       end loop;&amp;#10;   end loop; &amp;#10;   /* reassign the sequence numbers to records */&amp;#10;   for k in 1 .. ctr&amp;#10;   loop   &amp;#10;       go_record(get_group_number_cell(gc_id1,k));&amp;#10;       :band_results.s_result_seq := k-1;&amp;#10;   end loop;&amp;#10;   delete_group(rg_id);&amp;#10;   go_record(rec_no); &amp;#10;end;&amp;#10;&amp;#10;        &amp;#10;" ProgramUnitType="Procedure"/>
      <ProgramUnit Name="DUPLI_CHECK" ProgramUnitText=" PROCEDURE dupli_check IS&amp;#10;   temp_cur_record      varchar2(2);&amp;#10;    temp_result             varchar2(2);&amp;#10;    temp_current_record    varchar2(2);&amp;#10;BEGIN&amp;#10;     IF :result is not null THEN&amp;#10;       temp_cur_record   := :system.trigger_record;&amp;#10;       temp_current_record := :system.cursor_record;&amp;#10;       temp_result := :result;&amp;#10;       go_record('1');&amp;#10;       loop&amp;#10;                if :result = temp_result and&amp;#10;                :system.trigger_record != temp_cur_record&amp;#10;                then&amp;#10;                      go_record(temp_cur_record);&amp;#10;                      GO_ITEM('result');&amp;#10;                      show_error('0319');&amp;#10;                      check_package_failure;&amp;#10;                end if;  &amp;#10;                if :system.last_record = 'TRUE'&amp;#10;                then&amp;#10;                      exit;&amp;#10;                else&amp;#10;                     down;&amp;#10;                end if;&amp;#10;       end loop;&amp;#10;     --  first_record;&amp;#10;    go_record(temp_current_record);&amp;#10;   end if;&amp;#10;END;" ProgramUnitType="Procedure"/>
