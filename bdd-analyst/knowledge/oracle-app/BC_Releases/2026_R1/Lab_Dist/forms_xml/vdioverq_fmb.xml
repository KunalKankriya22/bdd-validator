      <Trigger Name="ON-ERROR" ParentModule="SBCLIB" ParentModuleType="12" ParentName="ON-ERROR" ParentFilename="sbclib.fmb" DirtyInfo="true" TriggerText="declare &amp;#10;       disp_format_mask                        varchar2(50);&amp;#10;begin&amp;#10;   if    error_code = 40100 -- at first record&amp;#10;   then&amp;#10;      show_error_dist('1700');&amp;#10;   elsif error_code = 40102 -- record must be entered first&amp;#10;   then&amp;#10;      show_error_dist('1701');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error_dist('1702');&amp;#10;   elsif error_code = 40201 -- field is full&amp;#10;   then&amp;#10;      show_error_dist('1703');&amp;#10;   elsif error_code = 40202 -- field must be entered&amp;#10;   then&amp;#10;       show_error_dist('0080');&amp;#10;   elsif error_code = 40207 -- must be in range&amp;#10;   then&amp;#10;      show_error_dist('1704');&amp;#10;   elsif error_code = 40208 -- form in query mode, cant update&amp;#10;   then&amp;#10;      show_error_dist('1705');&amp;#10;   elsif error_code = 40200 -- field protected against update&amp;#10;   then&amp;#10;      show_error_dist('5050');&amp;#10;   elsif error_code in (40400,40406,40407)-- transaction committed&amp;#10;   then&amp;#10;       show_error_dist('8010');&amp;#10;   elsif error_code = 40401 -- no changes to commit&amp;#10;   then&amp;#10;       show_error_dist('8013');&amp;#10;   elsif error_code in (50002,50003,50004, -- invalid date&amp;#10;                                50011,50012,50021,50023,50025,50026,0)&amp;#10;   then&amp;#10;        if upper(substr(get_item_property(:system.cursor_item, FORMAT_MASK),1,2)) ='FX' then&amp;#10;           disp_format_mask:=substr(get_item_property(:system.cursor_item, FORMAT_MASK),3);&amp;#10;       else&amp;#10;           disp_format_mask:= get_item_property(:system.cursor_item, FORMAT_MASK);&amp;#10;       end if;&amp;#10;       disp_format_mask := translate(disp_format_mask, 'R', 'Y');&amp;#10;       show_error_dist('0022',disp_format_mask);&amp;#10;   elsif error_code in (50006,50007,50009, -- invalid number&amp;#10;                                        50013,50014,50015,50016,50020)&amp;#10;   then&amp;#10;       show_error_dist('1707');&amp;#10;   elsif error_code in (50017,50018,50019,50022) -- invalid time&amp;#10;   then&amp;#10;       show_error_dist('5016');&amp;#10;   elsif error_code in ('40209','40735') then&amp;#10;       null;&amp;#10;&amp;#10;    /*Added by HCLC for removing double message */ &amp;#10;   elsif error_code = 41000 then -- This function is not available&amp;#10;       null;&amp;#10;   else&amp;#10;      message(substr(error_type||'-'||to_char (error_code)&amp;#10;       ||': '||error_text,1,80));&amp;#10;      raise form_trigger_failure;&amp;#10;   end if;&amp;#10;   check_package_failure;&amp;#10;    end;" ParentType="37"/>
