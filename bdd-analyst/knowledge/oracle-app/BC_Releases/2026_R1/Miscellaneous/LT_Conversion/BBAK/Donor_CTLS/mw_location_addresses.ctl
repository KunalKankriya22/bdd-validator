LOAD DATA
INFILE '/ltdata/sponsor_address.dat'
APPEND
INTO TABLE mw_sponsor_addresses
(
 ADDRESS_ID      POSITION(001:010)   CHAR(10)  NULLIF (ADDRESS_ID = BLANKS),
 CHAPTER_ID      POSITION(011:014)   CHAR(4)  NULLIF (CHAPTER_ID = BLANKS),
 STREET_NAME     POSITION(015:064)   CHAR(50)  NULLIF (STREET_NAME = BLANKS),
 SUITE_NUMBER    POSITION(065:074)   CHAR(10)  NULLIF (SUITE_NUMBER = BLANKS),
 CITY            POSITION(075:114)   CHAR(40)  NULLIF (CITY = BLANKS),
 STATE           POSITION(115:116)   CHAR(2)  NULLIF (STATE = BLANKS),
 ZIP_CODE        POSITION(117:126)   CHAR(10)  NULLIF (ZIP_CODE = BLANKS),
 USPS_ID         POSITION(127:132)   INTEGER EXTERNAL NULLIF (USPS_ID = BLANKS),
 DAY_AREA_CODE   POSITION(133:137)   CHAR(5)  NULLIF (DAY_AREA_CODE = BLANKS),
 DAY_PHONE_NUM   POSITION(138:145)   CHAR(8)  NULLIF (DAY_PHONE_NUM = BLANKS),
 HOME_AREA_CODE  POSITION(146:150)   CHAR(5)  NULLIF (HOME_AREA_CODE = BLANKS),
 HOME_PHONE_NUM  POSITION(151:158)   CHAR(8)  NULLIF (HOME_PHONE_NUM = BLANKS),
 PAGER           POSITION(159:172)   CHAR(14)  NULLIF (PAGER = BLANKS),
 EFFECTIVE_DATE  POSITION(172:179)   DATE(8) "MMDDYYYY" 
                                        NULLIF (EFFECTIVE_DATE = BLANKS),
 TERM_DATE       POSITION(181:188)   DATE(8) "MMDDYYYY"
                                        NULLIF (TERM_DATE = BLANKS),
 MAPSCO          POSITION(189:198)   CHAR(10)  NULLIF (MAPSCO = BLANKS),
 CONTACT_ID      POSITION(199:208)   CHAR(10)  NULLIF (CONTACT_ID = BLANKS),
 ADDRESS_TYPE    POSITION(209:212)   CHAR(4)  NULLIF (ADDRESS_TYPE = BLANKS),
 SPONSOR_ID      POSITION(224:233)   CHAR(10) NULLIF(SPONSOR_ID = BLANKS) 
)
