 COMPONENT_MASK       POSITION(123:124)  CHAR(2) NULLIF (COMPONENT_MASK = BLANKS),
IMPORT_FLAG          POSITION(125:125)  CHAR(1) NULLIF (IMPORT_FLAG = BLANKS),
