LOAD DATA
INFILE '/ltdata/unit_attrib.dat'
APPEND
INTO TABLE convert_unit_attributes
(
 UNIT_ID    POSITION(001:015)    CHAR(15) NULLIF (UNIT_ID = BLANKS),
 COLL_DATE  POSITION(016:023)    DATE(8) "MMDDYYYY" NULLIF (COLL_DATE = BLANKS),
 CHAPTER_ID POSITION(024:027)    CHAR(4)  NULLIF (CHAPTER_ID = BLANKS),
 ATTRIB_GROUP POSITION(028:032)  CHAR(5)  NULLIF (ATTRIB_GROUP = BLANKS),
 ATTRIB_CODE POSITION(033:037) CHAR(5)    NULLIF (ATTRIB_CODE = BLANKS),
 ATTRIB_DATE    POSITION(038:045)  DATE(8) "MMDDYYYY"  NULLIF (ATTRIB_DATE = BLANKS))
