LOAD DATA
INFILE '/ltdata/unit_interdictions.dat'
INTO TABLE convert_unit_interdictions
(
 UNIT_ID    POSITION(001:015)    CHAR(15) NULLIF (UNIT_ID = BLANKS),
 COLL_DATE  POSITION(016:023)    DATE(8) "MMDDYYYY" NULLIF (COLL_DATE = BLANKS),
 CHAPTER_ID POSITION(024:027)    CHAR(4)  NULLIF (CHAPTER_ID = BLANKS),
 REJECT_CODE POSITION(028:031)   CHAR(4) NULLIF (REJECT_CODE = BLANKS),
 REJECT_DATE POSITION(032:039) DATE(8) "MMDDYYYY" NULLIF (REJECT_DATE = BLANKS),
 REJECT_BY   POSITION(040:045)   CHAR(6) NULLIF (REJECT_BY = BLANKS))
