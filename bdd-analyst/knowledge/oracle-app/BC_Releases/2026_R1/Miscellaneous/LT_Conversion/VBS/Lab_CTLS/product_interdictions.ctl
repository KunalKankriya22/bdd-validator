LOAD DATA
INFILE '/ltdata/product_interdictions.dat'
APPEND
INTO TABLE convert_product_interdictions
(
 UNIT_ID    POSITION(001:015)    CHAR(15) NULLIF (UNIT_ID = BLANKS),
 COLL_DATE  POSITION(016:023)    DATE(8) "MMDDYYYY" NULLIF (COLL_DATE = BLANKS),
 CHAPTER_ID POSITION(024:027)    CHAR(4)  NULLIF (CHAPTER_ID = BLANKS),
 PRODUCT_CODE POSITION(028:035)  CHAR(8)  NULLIF (PRODUCT_CODE = BLANKS),
 REJECT_CODE  POSITION(036:039)  CHAR(4)  NULLIF (REJECT_CODE = BLANKS),
 REJECT_DATE POSITION(040:047) DATE(8) "MMDDYYYY" NULLIF (REJECT_DATE = BLANKS),
 REJECT_BY    POSITION(048:053)  CHAR(6)  NULLIF (REJECT_BY = BLANKS))
