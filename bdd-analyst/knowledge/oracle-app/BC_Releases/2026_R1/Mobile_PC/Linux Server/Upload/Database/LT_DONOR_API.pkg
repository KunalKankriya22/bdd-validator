  procedure rollback_and_exit(pl_err_msg  in varchar2) is
    c_code   CONSTANT INTEGER := SQLCODE;
      error_output    log_text_tab;
      PROCEDURE log_err(str IN VARCHAR2) IS
      BEGIN
        error_output(NVL(error_output.LAST, 0) + 1) := str;
      END log_err;
  Begin
    dbms_output.put_line(pl_err_msg);
     ROLLBACK;

     log_msg(pl_err_msg, 'E');
     log_err(pl_err_msg);
     log_err(c_code);
     log_err(DBMS_UTILITY.format_call_stack);
     log_err(DBMS_UTILITY.format_error_stack);
     log_err(DBMS_UTILITY.format_error_backtrace);
     write_to_file( gc_logs_dir,
                    'MAIN_UPLOAD-'|| NVL(gl_upload_id, 'XX') || '-' || gv_sysdate || '.err',
                    error_output);
     error_output.DELETE;
    dump_output;

    raise_application_error('-20000', 'Aborting');
  End rollback_and_exit;

END LT_DONOR_API;





