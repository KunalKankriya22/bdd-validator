    FUNCTION GET_STATUS(tblName_in IN VARCHAR2) RETURN VARCHAR2 IS
      l_query VARCHAR2(10000);
      l_status VARCHAR2(1000);
    BEGIN
      l_query := '
            SELECT LISTAGG(txt,'', '')
            WITHIN GROUP (ORDER BY txt)
            FROM (
                  SELECT NVL(lt_upload_status,''N'') ||'' - '' || COUNT(1) txt
                   FROM ' || tblName_in ||'
                  WHERE upload_id = :upl_id
                  GROUP BY lt_upload_status
            )';

      EXECUTE IMMEDIATE l_query
        INTO l_status
       USING p_upload_id;

      IF l_status IS NULL THEN
        RETURN NULL;
      ELSE
        RETURN 'Processed (' || NVL(l_status,'0') || ') Record(s)';
      END IF;
    EXCEPTION
      WHEN OTHERS THEN
        RETURN NULL;
    END get_status;

    ----------------------------------------------
    ---Main routine starts here for Onsite processing
    ------------------------------------------------
  BEGIN

    dbms_output.enable(50000000);
    szExtApplID := p_os_appl_name;

    gl_upload_id := p_upload_id;
    gl_laptop_id := SUBSTR(p_upload_id, 0, INSTR(p_upload_id, '_')-1);  
    gl_drive_id  := p_drive_id;


    gl_write_file := p_write_to_file;
    gv_sysdate := TO_CHAR(SYSDATE, 'MMDDYYHH24MISS');

    g_log_output.DELETE;
    g_err_output.DELETE;
    g_log_record.DELETE;

    log_msg('ONSITE_PROCESSOR','***API to main tables started***');
    COMMIT;

