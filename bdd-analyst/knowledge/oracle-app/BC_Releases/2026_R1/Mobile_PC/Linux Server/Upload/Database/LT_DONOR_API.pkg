    PROCEDURE process_donation_tubes (
        pl_status     OUT  VARCHAR2
    ) AS

        CURSOR api_cur(p_trn_mode VARCHAR2) IS
        SELECT
            TRANSACTION_ID,
            UNIT_ID,
            TUBE_TYPE,
            INSERT_DATE,
            INSERT_USER,
            PROGRAM_ID,
            AUDIT_KEY
        FROM
            api_donation_tubes
        WHERE
            lt_upload_date IS NULL
            AND upload_id = p_upload_id
            AND transaction_mode = p_trn_mode;

        TYPE t_dt_row_type IS TABLE OF donation_tubes%rowtype INDEX BY PLS_INTEGER;
        lt_api_rows    t_dt_row_type;
        lt_main_rows   t_dt_row_type;

        ln_api_auditKey NUMBER;
        lv_api_errorMsg VARCHAR2(1000);

        skip_record EXCEPTION;

        PROCEDURE table_getIds (
            auditKey_in  IN   NUMBER,
            donorId_out  OUT  VARCHAR2,
            transId_out  OUT  VARCHAR2,
            status_out   OUT  VARCHAR2
        ) IS
        BEGIN
            donorId_out := NULL;
            SELECT
                transaction_id
            INTO transId_out
            FROM
                donation_tubes
            WHERE
                audit_key = auditKey_in;

            status_out := 'OK';
        EXCEPTION
            WHEN no_data_found THEN
                status_out := gl_tableName || '-' || auditKey_in || '- No Data Found';
        END table_getIds;

        PROCEDURE load_main_rows(rec_in IN donation_tubes%ROWTYPE) IS
        BEGIN
            lt_main_rows(NVL(lt_main_rows.LAST, 0) + 1) := rec_in;
        END load_main_rows;

