                END LOOP;
        END update_api_success;

        PROCEDURE update_api_failure(trn_mode_in IN VARCHAR2) IS
            lc_failure VARCHAR2(1) := 'F';
        BEGIN
            FORALL indx IN 1 .. gt_api_f_akeys.COUNT SAVE EXCEPTIONS
                UPDATE api_donor_survey_resp_hdr
                SET
                    lt_upload_date = SYSDATE,
                    lt_upload_status = lc_failure,
                    lt_upload_error = gt_api_f_akeys(indx).fail_msg
                WHERE upload_id = p_upload_id
                  AND transaction_mode = trn_mode_in
                  AND audit_key = gt_api_f_akeys(indx).audit_key;
        EXCEPTION
            WHEN ex_dml_errors THEN
                FOR i IN 1 .. SQL%BULK_EXCEPTIONS.COUNT LOOP
                    ln_api_auditKey := gt_api_f_akeys(SQL%BULK_EXCEPTIONS(i).error_index).audit_key;
                    lv_api_errorMsg := SUBSTR(SQLERRM(-SQL%BULK_EXCEPTIONS(i).ERROR_CODE),1, 1000);
                    log_msg(gl_tableName || ' API failure status update -' || ln_api_auditKey || ':'|| lv_api_errorMsg, 'E');
                END LOOP;
        END update_api_failure;

        PROCEDURE cleanup_vars IS
        BEGIN
            lt_main_rows.DELETE;
            cleanup_akey_tables;
        END cleanup_vars;

        PROCEDURE process_inserts IS
            main_row        donor_survey_resp_hdr%rowtype;
        BEGIN
            cleanup_vars;

            FOR indx IN 1 .. lt_api_rows.COUNT LOOP
                BEGIN
                    main_row := lt_api_rows(indx);
                    -- convert audit key
                    convert_audit_key_new(lt_api_rows(indx).audit_key, main_row.audit_key, p_status);
                    IF p_status <> 'OK' THEN
                        RAISE skip_record;
                    END IF;

                    -- Get Donor Id
                    try_get_donor_id(lt_api_rows(indx).donor_id, main_row.donor_id, p_status);
                    IF p_status <> 'OK' THEN
                        RAISE skip_record;
                    END IF;

                    load_main_rows(main_row);
                    load_success_auditkey(lt_api_rows(indx).audit_key);
                    log_msg(gl_TableName || ' audit key insert -' || lt_api_rows(indx).audit_key || ':' || main_row.audit_key);
                EXCEPTION
                    WHEN skip_record THEN
                        load_failure_auditkey(lt_api_rows(indx).audit_key, p_status);
                        log_msg(gl_TableName || ' audit key insert -' || lt_api_rows(indx).audit_key || ':'|| p_status, 'E');
                END;
            END LOOP;
        END process_inserts;

        PROCEDURE process_updates IS
            main_row        donor_survey_resp_hdr%rowtype;
        BEGIN
            cleanup_vars;

            FOR indx IN 1 .. lt_api_rows.COUNT LOOP
                DECLARE
                    lnCount NUMBER;
                    lnAuditKey NUMBER;
                    lvDonorId   VARCHAR2(20);
                    lvTransId   VARCHAR2(20);
                BEGIN
                    main_row := lt_api_rows(indx);

                    SELECT
                        COUNT(1)
                    INTO lnCount
                    FROM
                        donor_survey_resp_hdr
                    WHERE
                        audit_key = lt_api_rows(indx).audit_key;

                    IF lnCount = 0 THEN
                        --if the incoming audit key is temporary , not in the main system

                        -- then get the LT audit key from the conversion table
                        get_audit_key(lt_api_rows(indx).audit_key, lnAuditKey, p_status);
                        IF p_status <> 'OK' THEN
                            RAISE skip_record;
                        END IF;

                        -- Get IDs
                        table_getIds(lnAuditKey, lvDonorId, lvTransId, p_status);
                        IF p_status <> 'OK' THEN
                            RAISE skip_record;
                        END IF;

                        main_row.audit_key := lnAuditKey;
                        main_row.donor_id := lvDonorId;

                    END IF;

                    load_main_rows(main_row);
                    load_success_auditkey(lt_api_rows(indx).audit_key);
                    log_msg(gl_TableName || ' audit key update - ' || main_row.audit_key);

                EXCEPTION
                    WHEN skip_record THEN
                        load_failure_auditkey(lt_api_rows(indx).audit_key, p_status);
                        log_msg(gl_TableName || ' audit key update -' || lt_api_rows(indx).audit_key || ':'|| p_status, 'E');
                END;
            END LOOP;
        END process_updates;

        PROCEDURE process_api_records(trn_mode_in VARCHAR2) IS
        BEGIN
            lt_api_rows.DELETE;

            OPEN api_cur(trn_mode_in);
            LOOP
                FETCH api_cur
                BULK COLLECT INTO lt_api_rows
                LIMIT gc_limit;

                log_msg('API Recs Fetched ' || lt_api_rows.COUNT);

                EXIT WHEN lt_api_rows.COUNT = 0;

                IF trn_mode_in = 'I' THEN
                    process_inserts;
                    insert_main_rows;
                    insert_auditkeys_conversion;
                ELSIF trn_mode_in = 'U' THEN
                    process_updates;
                    update_main_rows;
                END IF;

                update_api_success(trn_mode_in);

                update_api_failure(trn_mode_in);

            END LOOP;

            close api_cur;
        END process_api_records;


    BEGIN
        pl_status := 'OK';
        gl_tableName := 'DONOR_SURVEY_RESP_HDR';

        process_api_records('I');

        process_api_records('U');

        cleanup_vars;
    EXCEPTION
        WHEN OTHERS THEN
            pl_status := l_debug_msg
                         || ' - '
                         || substr(sqlerrm, 1, 1000);
    END process_donor_survey_resp_hdr;

