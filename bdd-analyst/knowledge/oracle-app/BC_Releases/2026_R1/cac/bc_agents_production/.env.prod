# Production Environment Configuration
# Database Configuration
DB_CONN=DBADMN_QASDB
DB_USER=/
DB_PASSWORD=

# Oracle Wallet Authentication (set to true to skip password validation)
USE_WALLET_AUTH=true

# Application Configuration
LOG_LEVEL=ERROR
ENVIRONMENT=production

# Application Redirect URLs
BCONSITEAGENT_REDIRECT_URL=https://cac2026.health.mil/BCOnsiteUI/login/
BCORACLEAGENT_REDIRECT_URL=bcapp2026r1-prddb://

# Agent Configuration
AGENT_MAP_EDI=DOD_EDI_PN_ID
AGENT_MAP_UNIQUE=UNIQUE_ID

# Security Configuration
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_HOUR=100
ENABLE_HTTPS_REDIRECT=true
